let host_members : :map;
let host_members = list.fold (fn m [k, v] -> m.[k => v]) %{} host_member_list;

/// Runtime functions that may block, so that they take the stack and are jumped to
/// rather than called: `name => arguments`.
let machine_natives : :map;
let machine_natives = %{"join_m!" => 1, "recv_m!" => 1, "await_message_m!" => 2, "sleep_until_m!" => 1,
                       "io_read_m!" => 2, "io_write_m!" => 2, "net_accept_m!" => 1, "net_connect_m!" => 2,
                       "tls_handshake_m!" => 1, "ffi_call_m!" => 2, "child_wait_m!" => 2};

let native_call : :any -> :string -> :string -> [:integer] -> Env -> St -> [Expr, St];
let native_call cx module_ member args env s = match native_named cx module_ member {
    Option.none => missing_member cx module_ member s,
    Option.some(fn_name) =>
        if arity_of_native cx fn_name == list.length args { native_exactly fn_name cx args env s }
        else {
            let [f, s1] = wrapper_of_native cx fn_name s;
            lazies cx args env s1 (fn atoms _ s2 -> [Expr.apply f atoms, s2])
        },
};

/// What the VM has and this has not built is refused, since a program using it would
/// fail where it should not. Anything else is the program's own mistake, and as under the
/// VM it is an error when it is reached, which a program may be testing for.
let vm_only : :map;
let vm_only = list.fold (fn m k -> m.[k => true]) %{} [
    "std.vm.eval_image!", "std.vm.open_image!", "std.vm.call_image!", "std.vm.close_image!", "std.vm.image_function",
    "std.vm.pure_image_function", "std.vm.locate_image!", "std.vm.image_digest", "std.vm.share_arenas", "std.vm.node_section", "std.vm.index_section",
];

let missing_member : :any -> :string -> :string -> St -> [Expr, St];
let missing_member cx module_ member s = {
    let full = str.concat_all [module_, ".", member];
    if map.has full vm_only || module_ == "std.browser" {
        not_built cx (str.concat_all ["`", full, "`"]) s
    } else {
        let [path, s1] = intern_string module_ s;
        let [name, s2] = intern_string member s1;
        let [x, s3] = fresh (St.set_natives ((St.natives s2).["no_such_member!" => true]) s2);
        [Expr.bind x (Rhs.native "no_such_member!" [Atom.address path, Atom.address name]) (Expr.ret (Atom.var x)), s3]
    }
};

/// `vm.host_members`'s table: `module.member arity` a line.
let host_table : :any -> :string;
let host_table cx = str.join_str "\n" (list.map (fn [full, fn_name] ->
    str.concat_all [full, " ", to_string (arity_of_native cx fn_name)]) host_member_list);

let native_named : :any -> :string -> :string -> :any;
let native_named cx module_ member =
    // The library names runtime functions directly: that is what `rt.native` is. A
    // native's own `!` is the dialect's, for reading memory, and is not the library's
    // business: to it, an answer that depends only on its arguments is pure.
    if module_ == "rt.native" { Option.some (member + "!") }
    else { member_or_its_twin (str.concat_all [module_, ".", member]) };

/// A name with or without its `!` finds the same member: purity is the caller's to check,
/// and the VM looks both up.
let member_or_its_twin : :string -> :any;
let member_or_its_twin full = match map.lookup full host_members {
    Option.some(found) => Option.some found,
    Option.none => map.lookup (if str.ends_with "!" full { str.slice 0 (len full - 1) full } else { full + "!" }) host_members,
};

/// A host module as a value: a map from its members' names to functions, which is all that
/// can be done with one. It is built only for a program that does this.
let module_value : :any -> :string -> St -> [Expr, St];
let module_value cx path s = {
    let prefix = path + ".";
    let members = list.filter (fn [full, _] -> str.starts_with prefix full) host_member_list;
    let rec fill rest current st = match rest {
        [] => {
            let [wrapped, st1] = fresh st;
            let [text, st2] = intern_string path st1;
            [Expr.bind wrapped (Rhs.native "module_of!" [current, Atom.address text]) (Expr.ret (Atom.var wrapped)), st2]
        },
        [[full, fn_name], ..more] => {
            let name = str.slice (len prefix) (len full - len prefix) full;
            let [key, s1] = intern_string name st;
            let [f, s2] = wrapper_of_native cx fn_name s1;
            let [x, s3] = fresh s2;
            let [after, s4] = fill more (Atom.var x) s3;
            [Expr.bind x (Rhs.native "map_put!" [current, Atom.address key, f]) after, s4]
        },
    };
    let s0 = list.fold (fn st name -> St.set_natives ((St.natives st).[name => true]) st) s ["map_empty!", "map_put!"];
    let [m, s5] = fresh s0;
    let [path_text, s6] = intern_string path (St.set_natives ((St.natives s5).["module_of!" => true]) s5);
    let [body, s7] = fill members (Atom.var m) s6;
    [Expr.bind m (Rhs.native "map_empty!" []) body, s7]
};

/// `value.member`, where the value is not named at the top level.
let dynamic_member : :any -> image.Node -> Env -> St -> [Expr, St];
let dynamic_member cx n env s = {
    let [name, s1] = intern_string (image.string cx.[:img] (image.Node.b n)) s;
    value cx (image.Node.a n) env (St.set_natives ((St.natives s1).["member_of!" => true]) s1) (fn object _ s2 -> {
        let [x, s3] = fresh s2;
        [Expr.bind x (Rhs.native "member_of!" [object, Atom.address name]) (Expr.ret (Atom.var x)), s3]
    })
};

let not_built : :any -> :string -> St -> [Expr, St];
let not_built cx what s =
    [Expr.raise_text "not compiled", refuse_in cx.[:name] (what + " is not compiled yet") s];

/// How many arguments a runtime function takes, the context aside. Its own image says.
let arity_of_native : :any -> :string -> :integer;
let arity_of_native cx fn_name = match map.lookup fn_name machine_natives {
    Option.some(n) => n,
    Option.none => match map.lookup fn_name library_natives {
        Option.some(n) => n,
        Option.none => cx.[:native_arity].[fn_name else 0],
    },
};

/// Host members that are functions of the library, which must force what they send.
let library_natives : :map;
let library_natives = %{"kill_value!" => 2, "remove_all!" => 1, "mkdir_all!" => 1, "walk!" => 1, "list_dir!" => 1,
                        "exec!" => 2, "exec_for!" => 3, "exec_in!" => 4, "exec_with!" => 5, "exec_joined!" => 5,
                        "share!" => 1, "trunk_of" => 1, "trunk_concat" => 2, "trunk_contains" => 2, "trunk_index_of" => 2,
                        "trunk_count" => 2, "trunk_lookup" => 2, "trunk_put" => 3, "ed25519_public" => 1,
                        "ed25519_sign" => 2, "ed25519_verify" => 3, "wire_encode" => 1, "wire_decode" => 1,
                        "wire_pack" => 1, "json_encode" => 1, "os_replace!" => 2, "os_pty_spawn!" => 6, "ffi_function!" => 4, "ffi_pure_function!" => 4, "ffi_call!" => 2, "ffi_locate!" => 1, "ffi_release!" => 1, "ffi_alive!" => 1, "ffi_owned!" => 1, "ffi_buffer!" => 1, "ffi_size!" => 1, "ffi_address!" => 1, "ffi_peek!" => 3, "ffi_poke!" => 4, "ffi_read!" => 3, "ffi_read_string!" => 2, "ffi_write!" => 3, "ffi_sizeof" => 1, "ffi_alignof" => 1, "ffi_payload_index" => 1, "ffi_open!" => 1, "ffi_close!" => 1, "ffi_bind!" => 4, "ffi_load!" => 4, "ffi_alloc!" => 1, "ffi_free!" => 1, "ffi_read_cstr!" => 1, "ffi_read_u8!" => 2, "ffi_write_u8!" => 3, "tls_connect!" => 2, "tls_accept!" => 2, "tls_info!" => 1, "as_tensor" => 1, "tensor_to_list" => 1, "t_zeros" => 1, "t_ones" => 1, "t_fill" => 2, "t_identity" => 1, "t_range" => 1, "t_random" => 2, "t_random_like" => 2, "t_shape" => 1, "t_rank" => 1, "t_size" => 1, "t_device" => 1, "t_dtype" => 1, "t_reshape" => 2, "t_transpose" => 1, "t_at" => 2, "t_matmul" => 2, "t_dot" => 2, "t_outer" => 2, "t_sum" => 1, "t_sum_tensor" => 1, "t_minimum" => 1, "t_maximum" => 1, "t_mean" => 1, "t_norm" => 1, "t_sum_axis" => 2, "t_min_axis" => 2, "t_max_axis" => 2, "t_argmin_axis" => 2, "t_argmax_axis" => 2, "t_sqrt" => 1, "t_exp" => 1, "t_log" => 1, "t_abs" => 1, "t_tanh" => 1, "t_sin" => 1, "t_cos" => 1, "t_relu" => 1, "t_sigmoid" => 1, "t_floor" => 1, "t_ceil" => 1, "t_round" => 1, "t_sign" => 1, "t_erf" => 1, "t_max" => 2, "t_min" => 2, "t_pow" => 2, "t_lt" => 2, "t_le" => 2, "t_gt" => 2, "t_ge" => 2, "t_eq" => 2, "t_ne" => 2, "t_fill_like" => 2, "t_repeat" => 2, "t_slice" => 3, "t_take" => 2, "t_concat" => 1, "t_one_hot" => 2, "t_normal" => 2, "t_to_bytes" => 1, "t_im2col" => 5, "t_permute" => 2, "t_col2im" => 6, "t_of_bytes" => 2, "t_gpu" => 1, "t_gpu64" => 1, "t_host" => 1, "t_gpu_available" => 1, "t_gpu_name" => 1, "t_cpu_kernels" => 1};

let native_exactly : :string -> :any -> [:integer] -> Env -> St -> [Expr, St];
let native_exactly fn_name cx args env s =
    if map.has fn_name library_natives { library_call cx fn_name args env s }
    else {
        let lazy_at = native_lazy.[fn_name else []];
        let rec go i ns acc env1 s1 = match ns {
            [] => {
                let [e, s2] = native_tail fn_name (list.reverse acc) (St.set_natives ((St.natives s1).[fn_name => true]) s1);
                [e, s2]
            },
            [n, ..rest] =>
                if list.contains i lazy_at { lazily cx n env1 s1 (fn a env2 s2 -> go (i + 1) rest (list.cons a acc) env2 s2) }
                else { value cx n env1 s1 (fn a env2 s2 -> go (i + 1) rest (list.cons a acc) env2 s2) },
        };
        go 0 args [] env s
    };

/// The call itself, as the end of a function: a jump for one that may block.
let native_tail : :string -> [Atom] -> St -> [Expr, St];
let native_tail fn_name atoms s =
    if map.has fn_name machine_natives { [Expr.call ("@m_" + fn_name) atoms, s] }
    else {
        let [x, s1] = fresh s;
        [Expr.bind x (Rhs.native fn_name atoms)
            (if answers_unforced.[fn_name else false] { Expr.enter (Atom.var x) } else { Expr.ret (Atom.var x) }), s1]
    };

/// A native as a function value: a function of its arity that forces each argument
/// and calls it, made once. This is what a partial application or `map io.close!` holds.
let wrapper_of_native : :any -> :string -> St -> [Atom, St];
let wrapper_of_native cx fn_name s = {
    let symbol = "@wn" + mangled fn_name;
    if map.has fn_name library_natives { wrapper_of_library cx fn_name s }
    else if (St.wrapped s).[symbol else false] { [static_closure symbol, s] } else {
        let n = arity_of_native cx fn_name;
        let [params, s1] = fresh_many n (St.set_natives ((St.natives s).[fn_name => true]) s);
        let [body, s2] = forcing_all params [] fn_name s1;
        let f = Function.make symbol symbol :function true params [] body fn_name [];
        [static_closure symbol, s2 |> St.set_wrapped ((St.wrapped s2).[symbol => true])
                                   |> St.set_functions (list.cons f (St.functions s2))]
    }
};

/// A symbol's part from a name that may hold what LLVM does not allow bare.
let mangled : :string -> :string;
let mangled name = str.replace "!" "_x" name;

let forcing_all : [:integer] -> [Atom] -> :string -> St -> [Expr, St];
let forcing_all params done fn_name s = match params {
    [] => {
        native_tail fn_name (list.reverse done) s
    },
    [p, ..rest] =>
        if list.contains (list.length done) native_lazy.[fn_name else []] {
            forcing_all rest (list.cons (Atom.var p) done) fn_name s
        } else {
            let [y, s1] = fresh s;
            let [after, s2] = forcing_all rest (list.cons (Atom.var y) done) fn_name s1;
            [seq_of y (Expr.enter (Atom.var p)) after, s2]
        },
};

/// A library builtin as a function value: the library's function has a closure of its
/// own, under the name the machine resolves.
let wrapper_of_library : :any -> :string -> St -> [Atom, St];
let wrapper_of_library cx name s = {
    let symbol = "@wl" + mangled name;
    if (St.wrapped s).[symbol else false] { [static_closure symbol, s] } else {
        let n = cx.[:lib_arity].[name else 1];
        let [params, s1] = fresh_many n (St.set_needed_lib ((St.needed_lib s).[name => true]) s);
        let body = Expr.call ("@lib_" + name) (list.map (fn p -> Atom.var p) params);
        let f = Function.make symbol symbol :function false params [] body name [];
        [static_closure symbol, s1 |> St.set_wrapped ((St.wrapped s1).[symbol => true])
                                   |> St.set_functions (list.cons f (St.functions s1))]
    }
};

/// Builtin number `id` as a value, where it is one.
let builtin_value : :any -> :integer -> St -> [Atom, St];
let builtin_value cx id s = {
    let name = names_of_builtins.[id];
    match [map.lookup name library_builtins, map.lookup name native_builtins] {
        [Option.some(fn_name), _] => wrapper_of_library cx fn_name s,
        [_, Option.some(fn_name)] => wrapper_of_native cx fn_name s,
        _ => match name {
            "raise!" => wrapper_of_library cx "raise_any!" s,
            "_list_cons" => wrapper_of_library cx "cons_of" s,
            "_match_is_cons" => wrapper_of_library cx "is_cons_of" s,
            "_list_is_empty" => wrapper_of_library cx "is_empty_of" s,
            "_match_head" => wrapper_of_library cx "head_of" s,
            "_match_tail" => wrapper_of_library cx "tail_of" s,
            _ => [Atom.word unit_word, refuse_in cx.[:name] (str.concat_all ["the builtin `", name, "` as a value is not compiled yet"]) s],
        },
    }
};

/// `module.member` of a host module as a value.
let host_value : :any -> image.Node -> St -> [Atom, St];
let host_value cx n s = {
    let g = image.global cx.[:img] (image.Node.a (image.node cx.[:img] (image.Node.a n)));
    let path = image.import_path cx.[:img] (image.Global.target g);
    let member = image.string cx.[:img] (image.Node.b n);
    match native_named cx path member {
        Option.some(fn_name) => wrapper_of_native cx fn_name s,
        Option.none => {
            // Not there at all: an error when it is reached, by a function that raises it.
            let [path_text, s1] = intern_string path s;
            let [name_text, s2] = intern_string member s1;
            let [params, s3] = fresh_many 1 s2;
            let [id, s4] = fresh s3;
            let [x, s5] = fresh s4;
            let symbol = "@wm" + to_string id;
            let body = Expr.bind x (Rhs.native "no_such_member!" [Atom.address path_text, Atom.address name_text]) (Expr.ret (Atom.var x));
            let f = Function.make symbol symbol :function true params [] body member [];
            [static_closure symbol, s5 |> St.set_natives ((St.natives s5).["no_such_member!" => true])
                                       |> St.set_functions (list.cons f (St.functions s5))]
        },
    }
};

/// A builtin, in three kinds: written out here, a runtime function, or a function
/// of the library (mind/std/rt/lib.dr), which is ordinary Dream.
let builtin : :any -> :string -> [:integer] -> Env -> St -> [Expr, St];
let builtin cx name args env s = match [name, args] {
    ["raise!", [e]] => value cx e env s (fn v _ s1 -> [Expr.raised v, s1]),
    ["_list_cons", [h, t]] => lazily_alloc cx "cons" [h, t] env s (fn x _ s1 -> [Expr.ret x, s1]),
    ["_list_cons", _] => {
        let [f, s1] = wrapper_of_library cx "cons_of" s;
        lazies cx args env s1 (fn atoms _ s2 -> [Expr.apply f atoms, s2])
    },
    ["_list_is_cons_unused", _] => [Expr.raise_text "", s],
    ["_match_is_cons", [l]] => tested cx (fn a -> Rhs.has_kind a 5) l env s (fn x _ s1 -> [Expr.ret x, s1]),
    ["_list_is_empty", [l]] => tested cx (fn a -> Rhs.same a nil_word) l env s (fn x _ s1 -> [Expr.ret x, s1]),
    ["_match_head", [l]] => list_part cx 0 l env s,
    ["_match_tail", [l]] => list_part cx 1 l env s,
    ["_list_tail", [l]] => native_exactly "list_tail!" cx [l] env s,
    _ => match [map.lookup name library_builtins, map.lookup name native_builtins] {
        [Option.some(fn_name), _] =>
            if cx.[:lib_arity].[fn_name else 1] == list.length args { library_call cx fn_name args env s }
            else {
                let [f, s1] = wrapper_of_library cx fn_name s;
                lazies cx args env s1 (fn atoms _ s2 -> [Expr.apply f atoms, s2])
            },
        [_, Option.some(fn_name)] =>
            if arity_of_native cx fn_name == list.length args { native_exactly fn_name cx args env s }
            else {
                let [f, s1] = wrapper_of_native cx fn_name s;
                lazies cx args env s1 (fn atoms _ s2 -> [Expr.apply f atoms, s2])
            },
        _ => not_built cx (str.concat_all ["the builtin `", name, "`"]) s,
    },
};

let list_part : :any -> :integer -> :integer -> Env -> St -> [Expr, St];
let list_part cx index l env s = value cx l env s (fn list_ _ s1 -> {
    let [x, s2] = fresh s1;
    [Expr.bind x (Rhs.field list_ index) (Expr.enter (Atom.var x)), s2]
});

let library_builtins : :map;
let library_builtins = %{
    "to_string" => "show", "len" => "length", "strict!" => "deep!", "_str_concat" => "concat_list",
    "_str_of_chars" => "str_of_chars", "_str_of_bytes" => "str_of_bytes", "_array_of_list" => "array_of_list",
    "compare" => "compare_values", "_sort_keyed" => "sort_keyed", "_str_interp" => "str_interp",
    "_settled" => "settle", "_forced" => "forced", "type_assert" => "type_assert", "_match_fail" => "match_fail",
    "_error_trace!" => "error_trace!", "send!" => "send_value!", "_tensor_matmul" => "t_matmul", "_tensor_of_bytes" => "t_of_bytes",
    "_indexed" => "indexed", "_append_rev" => "append_rev", "_rev_onto" => "rev_onto", "_str_append_rev" => "str_append_rev",
    "_set_of" => "set_of", "_set_add" => "set_add", "_set_lookup" => "set_lookup", "_set_refresh" => "set_refresh",
    "_memo_cells" => "memo_cells", "_tally" => "tally", "_tally_lookup" => "tally_lookup", "_list_drop" => "list_drop",
    "_index_new" => "index_new", "_index_find" => "index_find", "_heap_of" => "heap_of", "_heap_push" => "heap_push",
    "_heap_empty" => "heap_empty", "_heap_min" => "heap_min", "_heap_pop" => "heap_pop", "_trunk_of" => "trunk_of",
    "_trunk_recall" => "trunk_recall", "_trunk_lookup" => "trunk_lookup",
};

let native_builtins : :map;
let native_builtins = %{
    "type_of" => "type_of!", "_str_byte" => "str_byte_any!", "_str_slice" => "str_slice_any!",
    "_str_le" => "str_le!", "_str_find" => "str_find_any!", "_error_new" => "error_new!",
    "_error_kind" => "error_kind!", "_error_payload" => "error_payload!", "_str_rfind" => "str_rfind!",
    "_str_span" => "str_span!", "_str_upto" => "str_upto!", "_str_span_back" => "str_span_back!",
    "_str_char_count" => "str_char_count!", "_str_ascii_case" => "str_ascii_case!", "_str_chars" => "str_chars!",
    "_char_code" => "char_code!", "_char_of_code" => "char_of_code!", "_to_float" => "to_float!",
    "_float_bytes" => "float_bytes!", "_float_of_bytes" => "float_of_bytes!", "_to_int" => "to_int!",
    "_parse_int" => "parse_int!", "_parse_float" => "parse_float!", "_array_new" => "array_new!",
    "_array_to_list" => "array_to_list!", "_map_has" => "map_has!", "_map_remove" => "map_remove!",
    "_map_pairs" => "map_pairs!", "_record_is" => "record_is!", "_record_id" => "record_id!",
    "_record_fields" => "record_fields!", "_record_of" => "record_of!", "_match_at" => "match_at!",
    "_match_key" => "match_key!", "_pow" => "pow!", "_to_existing_atom" => "to_existing_atom!", "_list_tail" => "list_tail!", "_data_count" => "data_count!", "_data_at" => "data_at!", "_trunk_to_list" => "trunk_to_list!", "_trunk_at" => "trunk_read!",
    "_trunk_push" => "trunk_push!", "_trunk_set" => "trunk_set!", "spawn!" => "spawn!", "join!" => "join_m!",
    "recv!" => "recv_m!", "self!" => "self!", "_mailbox_peek!" => "mailbox_peek!",
    "_mailbox_take!" => "mailbox_take!", "_await_message!" => "await_message_m!", "_deadline_in!" => "deadline_in!",
};

/// Which arguments a native takes as they stand: by position, the rest being forced.
let native_lazy : :map;
let native_lazy = %{
    "array_new!" => [1], "error_new!" => [1], "array_store!" => [2], "new_cons!" => [0, 1], "spawn!" => [0],
    "trunk_push!" => [0], "trunk_cons!" => [0], "trunk_set!" => [1],
};

/// Natives that answer what they found without forcing it.
let answers_unforced : :map;
let answers_unforced = %{"match_at!" => true, "list_head!" => true, "list_tail!" => true, "trunk_read!" => true, "error_payload!" => true};

let library_call : :any -> :string -> [:integer] -> Env -> St -> [Expr, St];
let library_call cx name args env s =
    lazies cx args env (St.set_needed_lib ((St.needed_lib s).[name => true]) s)
        (fn atoms _ s1 -> [Expr.call (str.concat_all ["@lib_", name]) atoms, s1]);

let strict_args : :any -> [:integer] -> Env -> St -> :any -> [Expr, St];
let strict_args cx args env s k = {
    let rec go ns acc env1 s1 = match ns {
        [] => k (list.reverse acc) env1 s1,
        [n, ..rest] => value cx n env1 s1 (fn a env2 s2 -> go rest (list.cons a acc) env2 s2),
    };
    go args [] env s
};

/// Each of `args` as an atom, evaluating none of them.
let lazies : :any -> [:integer] -> Env -> St -> :any -> [Expr, St];
let lazies cx args env s k = {
    let rec go ns acc env1 s1 = match ns {
        [] => k (list.reverse acc) env1 s1,
        [n, ..rest] => lazily cx n env1 s1 (fn a env2 s2 -> go rest (list.cons a acc) env2 s2),
    };
    go args [] env s
};

let lazily_alloc : :any -> :string -> [:integer] -> Env -> St -> :any -> [Expr, St];
let lazily_alloc cx info kids env s k =
    lazies cx kids env s (fn atoms env1 s1 -> bound (Rhs.alloc info atoms) k env1 s1 true);

/// `n` as an atom, with nothing evaluated: built in place where building it cannot
/// be observed, and suspended otherwise. A division is not built in place, because
/// raising is observable; a list is, because its elements stay lazy.
let lazily : :any -> :integer -> Env -> St -> :any -> [Expr, St];
let lazily cx i env s k = {
    let n = image.node cx.[:img] i;
    let op = image.Node.op n;
    let a = image.Node.a n;
    match op {
        8 => match map.lookup a (Env.slots env) {
            Option.some(atom) => k atom env s,
            Option.none => hole_read cx a env s k,
        },
        9 => k (Env.captures env).[a] env s,
        o if o == 1 || o == 2 || o == 3 || o == 4 || o == 5 || o == 6 || o == 7 => value cx i env s k,
        10 => {
            let g = image.global cx.[:img] a;
            let f = image.Global.target g;
            if image.Global.kind g != 0 { suspended cx i env s k }
            else {
                let fr = image.func cx.[:img] f;
                let symbol = symbol_of cx.[:unit] f;
                if image.Func.arity fr > 0 { k (static_closure symbol) env (queue cx f s) }
                else if image.Func.flags fr & image.func_impure != 0 { suspended cx i env s k }
                else { k (Atom.address (caf_symbol (once_symbol cx f))) env (queue_once cx f s) }
            }
        },
        o if o == 17 || o == 18 => closure_of cx a env s k,
        o if (o >= 21 && o <= 23 || o >= 26 && o <= 31) && ready_operand cx a env && ready_operand cx (image.Node.b n) env => {
            let [symbol, payload, _, s1] = lifted_thunk cx i env s;
            let [x, s2] = fresh s1;
            let name = match o { 21 => "add", 22 => "sub", 23 => "mul", _ => comparison_ops.[o] };
            let atom_of = fn m -> atom_ready cx m env;
            let [ax, s3] = atom_of a s2;
            let [bx, s4] = atom_of (image.Node.b n) s3;
            let [rest, s5] = k (Atom.var x) env s4;
            [Expr.bind x (Rhs.speculate name ax bx symbol payload) rest, s5]
        },
        11 => {
            let [f, s1] = builtin_value cx a s;
            k f env s1
        },
        12 => {
            let object = image.node cx.[:img] a;
            if image.Node.op object == 10 && image.Global.kind (image.global cx.[:img] (image.Node.a object)) == 1 {
                let [f, s1] = host_value cx n s;
                k f env s1
            } else { suspended cx i env s k }
        },
        36 => list_literal cx (image.kids cx.[:img] a (image.Node.b n)) env s k,
        44 => lazily_alloc cx "cons" [a, image.Node.b n] env s k,
        37 => {
            let kids = image.kids cx.[:img] a (image.Node.b n);
            lazies cx kids env s (fn atoms env1 s1 ->
                bound (Rhs.alloc "array" (list.cons (Atom.word (fixnum_word (list.length atoms))) atoms)) k env1 s1 true)
        },
        81 => {
            let kids = image.kids cx.[:img] a (image.Node.b n);
            let id_name = image.atom cx.[:img] (image.Node.c n % 2147483648);
            let [id, s0] = intern_atom id_name s;
            let parts = str.split "." id_name;
            let variant = image.Node.c n >= 2147483648;
            let shown = if variant { list.drop (list.length parts - 2) parts } else { list.drop (list.length parts - 1) parts };
            let [type_atom, s00] = intern_atom (list.head shown) s0;
            let s1 = St.set_records ((St.records s00).[id => [type_atom, str.join_str "." shown]]) s00;
            lazies cx kids env s1 (fn atoms env1 s2 ->
                bound (Rhs.alloc "record" (list.append [Atom.word (fixnum_word (list.length atoms)),
                                                        Atom.word (immediate_word 3 id)] atoms)) k env1 s2 true)
        },
        _ => suspended cx i env s k,
    }
};

/// A slot read before anything is in it, which is how `let rec` is written: a word
/// stands in, and the binding patches it when it comes.
let hole_read : :any -> :integer -> Env -> St -> :any -> [Expr, St];
let hole_read cx slot env s k =
    k (Atom.word "0") env (refuse_in cx.[:name] "a value that refers to itself outside a closure or suspension" s);

let list_literal : :any -> [:integer] -> Env -> St -> :any -> [Expr, St];
let list_literal cx kids env s k =
    lazies cx kids env s (fn atoms env1 s1 -> {
        let rec build rest tail_atom s2 = match rest {
            [] => k tail_atom (mark_forced tail_atom env1) s2,
            [h, ..more] => {
                let [x, s3] = fresh s2;
                let [e, s4] = build more (Atom.var x) s3;
                [Expr.bind x (Rhs.alloc "cons" [h, tail_atom]) e, s4]
            },
        };
        build (list.reverse atoms) (Atom.word nil_word) s1
    });

/// The frame `n` will read, as captures: the variables holding the slots and captures
/// it names. A slot it reads that nothing has bound yet is a hole, to be patched.
let captured : :any -> :integer -> Env -> [[:any]];
let captured cx i env = {
    let [slots, caps, bound_inside] = reads cx.[:img] i;
    let from_slots = list.map (fn slot -> [:slot, slot, map.lookup slot (Env.slots env)])
        (list.filter (fn slot -> map.has slot (Env.slots env) || not (map.has slot bound_inside))
                     (list.sort (map.keys slots)));
    let from_caps = list.map (fn c -> [:cap, c, Option.some (Env.captures env).[c]]) (list.sort (map.keys caps));
    list.append from_slots from_caps
};

/// What a lifted body starts with: its parameters, for the same slots and captures.
let lifted_env : [[:any]] -> [:integer] -> Env -> Env;
let lifted_env pieces vars env = {
    let forced_from = fn piece -> match piece.[2] {
        Option.some(atom) => forced_atom env atom,
        Option.none => false,
    };
    list.fold (fn e [piece, v] -> {
        let e1 = if forced_from piece { mark_forced (Atom.var v) e } else { e };
        match piece.[0] {
            :slot => Env.set_slots ((Env.slots e1).[piece.[1] => Atom.var v]) e1,
            _ => Env.set_captures ((Env.captures e1).[piece.[1] => Atom.var v]) e1,
        }
    }) (Env.make %{} %{} %{} []) (list.zip pieces vars)
};

let fresh_many : :integer -> St -> [[:integer], St];
let fresh_many n s = {
    let start = St.next s;
    [list.range start (start + n), St.set_next (start + n) s]
};

/// `n` suspended: its code lifted to a function of what it reads, and an object
/// holding those. A thunk with nothing to hold still takes a word, which is where
/// the update writes its answer.
let suspended : :any -> :integer -> Env -> St -> :any -> [Expr, St];
let suspended cx i env s k = {
    let [symbol, payload, holes, s4] = lifted_thunk cx i env s;
    let [x, s5] = fresh s4;
    let var = Atom.var x;
    let env1 = Env.set_holes (list.append (list.map (fn [index, slot] -> [var, index, slot]) holes) (Env.holes env)) env;
    let [rest, s6] = k var env1 s5;
    [Expr.bind x (Rhs.alloc symbol payload) rest, s6]
};

/// `i` lifted out as a thunk's function: its info, what to allocate it with, and what is not
/// bound yet.
let lifted_thunk : :any -> :integer -> Env -> St -> [:any];
let lifted_thunk cx i env s = {
    let pieces = captured cx i env;
    let [vars, s1] = fresh_many (list.length pieces) s;
    let [id, s2] = fresh s1;
    let inner = lifted_env pieces vars env;
    let [body, s3] = tail cx i inner s2;
    let symbol = str.concat_all ["@t", cx.[:unit], to_string id];
    let f = Function.make symbol symbol :thunk false [] vars body (cx.[:name] + " (suspended)")
        (match cx.[:place] { [n, path, line, col] => [n, path, line, col, 1], _ => [] });
    let s4 = St.set_functions (list.cons f (St.functions s3)) s3;
    let values_ = list.map (fn piece -> match piece.[2] {
        Option.some(atom) => atom,
        Option.none => Atom.word "0",
    }) pieces;
    let holes = list.filter_map (fn [index, piece] -> match piece.[2] {
        Option.none => [index, piece.[1]],
        _ => (),
    }) (list.enumerate pieces);
    [symbol, (if list.is_empty values_ { [Atom.word "1"] } else { values_ }), holes, s4]
};

/// An operand that can be read without evaluating anything: a small literal, or what has been
/// evaluated already.
let ready_operand : :any -> :integer -> Env -> :bool;
let ready_operand cx i env = {
    let n = image.node cx.[:img] i;
    match image.Node.op n {
        1 => fits_fixnum (image.integer cx.[:img] (image.Node.a n)),
        8 => match map.lookup (image.Node.a n) (Env.slots env) {
            Option.some(atom) => forced_atom env atom,
            Option.none => false,
        },
        9 => forced_atom env (Env.captures env).[image.Node.a n],
        _ => false,
    }
};

let atom_ready : :any -> :integer -> Env -> St -> [Atom, St];
let atom_ready cx i env s = {
    let n = image.node cx.[:img] i;
    match image.Node.op n {
        1 => [Atom.word (fixnum_word (image.integer cx.[:img] (image.Node.a n))), s],
        8 => [(Env.slots env).[image.Node.a n], s],
        _ => [(Env.captures env).[image.Node.a n], s],
    }
};

/// A closure of image function `f`, reading what its descriptors say.
let closure_of : :any -> :integer -> Env -> St -> :any -> [Expr, St];
let closure_of cx f env s k = {
    let descriptors = capture_descriptors cx.[:img] f;
    let symbol = symbol_of cx.[:unit] f;
    let s1 = queue cx f s;
    if list.is_empty descriptors { k (static_closure symbol) env s1 }
    else {
        let pieces = list.map (fn d ->
            if d >= 2147483648 { [:cap, d - 2147483648, Option.some (Env.captures env).[d - 2147483648]] }
            else { [:slot, d, map.lookup d (Env.slots env)] }) descriptors;
        let values_ = list.map (fn piece -> match piece.[2] {
            Option.some(atom) => atom,
            Option.none => Atom.word "0",
        }) pieces;
        let holes = list.filter_map (fn [index, piece] -> match piece.[2] {
            Option.none => [index, piece.[1]],
            _ => (),
        }) (list.enumerate pieces);
        let [x, s2] = fresh s1;
        let var = Atom.var x;
        let env1 = Env.set_holes (list.append (list.map (fn [index, slot] -> [var, index, slot]) holes) (Env.holes env)) (mark_forced var env);
        let [rest, s3] = k var env1 s2;
        [Expr.bind x (Rhs.alloc (str.concat_all ["@c", cx.[:unit], to_string f]) values_) rest, s3]
    }
};

/// A block's statements, in order. A `let` binds, suspended unless the compiler marked
/// it strict; a statement that is not last is run only if marked as having effects.
let block : :any -> [:integer] -> Env -> St -> [Expr, St];
let block cx statements env s = match statements {
    [] => [Expr.ret (Atom.word unit_word), s],
    [only] => if image.Node.op (image.node cx.[:img] only) == 16 { statement cx only [] env s } else { tail cx only env s },
    [first, ..rest] => statement cx first rest env s,
};

let flag_strict = 1;

let statement : :any -> :integer -> [:integer] -> Env -> St -> [Expr, St];
let statement cx i rest env s = {
    let n = image.node cx.[:img] i;
    let strict = image.Node.flags n & flag_strict != 0;
    if image.Node.op n == 16 {
        let slot = image.Node.a n;
        let target_op = image.Node.op (image.node cx.[:img] (image.Node.b n));
        let suspends = target_op == 17 || target_op == 18;
        let binding = fn atom env1 s1 -> settle_holes slot atom (Env.set_slots ((Env.slots env1).[slot => atom]) env1) s1
            (fn env2 s2 -> block cx rest env2 s2);
        // A local that what follows is sure to force costs nothing to evaluate now, and saves
        // its suspension. With effects about, what follows may do one first.
        let demanded = not strict && not suspends && slot < 60 && cx.[:pure else false] && bound_in cx (image.Node.b n) env
            && (forced_by_block cx.[:img] cx.[:strict] rest %{} 0 >> slot) & 1 == 1;
        if (strict || demanded) && not suspends { value cx (image.Node.b n) env s binding }
        else { lazily cx (image.Node.b n) env s binding }
    }
    else if strict {
        let [x, s1] = fresh s;
        let [e, s2] = tail cx i env s1;
        let [after, s3] = block cx rest env s2;
        [seq_of x e after, s3]
    }
    else { block cx rest env s }
};

/// `slot` has a value now, so what captured it before it did can be given it.
let settle_holes : :integer -> Atom -> Env -> St -> :any -> [Expr, St];
let settle_holes slot atom env s k = {
    let [waiting, others] = list.partition (fn h -> h.[2] == slot) (Env.holes env);
    let env1 = Env.set_holes others env;
    let [body, s1] = k env1 s;
    list.fold (fn [e, st] h -> {
        let [x, st1] = fresh st;
        [Expr.bind x (Rhs.patch h.[0] h.[1] atom) e, st1]
    }) [body, s1] waiting
};

/// The parameters `mask` names forced, in order; `current` is what each is called by now, and
/// `again` the same call with those.
let forcing_params : :integer -> [:integer] -> [:integer] -> :any -> [:integer] -> Env -> St -> :any -> [Expr, St];
let forcing_params mask todo current again keep env s k = match todo {
    [] => k env s,
    [i, ..rest] => {
        let v = current.[i];
        let [x, s1] = fresh s;
        let now = list.map (fn [j, c] -> if j == i { x } else { c }) (list.enumerate current);
        let var = Atom.var x;
        let env1 = mark_forced var (Env.set_slots ((Env.slots env).[i => var]) env);
        let [after, s2] = forcing_params mask rest now again keep env1 s1 k;
        let live = list.sort (list.unique (list.append keep (list.filter (fn c -> c != v) current)));
        [Expr.entry_force (Atom.var v) x live (again now) after, s2]
    },
};

/// Image function `f` as a core function, in the form it was asked for.
let translate : :any -> :integer -> :atom -> St -> St;
let translate cx f how s = {
    let fr = image.func cx.[:img] f;
    let symbol = if how == :caf { once_symbol cx f } else { symbol_of cx.[:unit] f };
    let [params, s1] = fresh_many (image.Func.arity fr) s;
    let [caps, s2] = fresh_many (image.Func.captures fr) s1;
    let name = image.string cx.[:img] (image.Func.name fr);
    let slots = list.fold (fn m [i, v] -> m.[i => Atom.var v]) %{} (list.enumerate params);
    let captures = list.fold (fn m [i, v] -> m.[i => Atom.var v]) %{} (list.enumerate caps);
    let env = Env.make slots captures %{} [];
    let place = [name, image.func_source cx.[:img] f, image.func_line cx.[:img] f, image.func_col cx.[:img] f];
    let cx1 = cx |> (fn c -> c.[:name => name]) |> (fn c -> c.[:place => place])
                 |> (fn c -> c.[:pure => not (may_effect cx.[:img] f)]);
    // What every path forces is forced first, so that the body knows it has it: a test of what
    // is evaluated then goes away, and what is built from it can be built now.
    let wanted = if how == :function { (Demand.masks cx.[:strict]).[f else 0] } else { 0 };
    let indices = list.filter (fn i -> i < 60 && (wanted >> i) & 1 == 1) (list.range 0 (list.length params));
    let self_symbol = symbol_of cx.[:unit] f;
    let [self_var, s2a] = fresh s2;
    let has_self = not (list.is_empty caps) && not (list.is_empty indices);
    let again = fn current -> {
        let args = list.map (fn c -> Atom.var c) current;
        if has_self { Expr.call_closure (Atom.var self_var) self_symbol args } else { Expr.call self_symbol args }
    };
    let [forced_body, s3] = forcing_params wanted indices params again (if has_self { [self_var] } else { [] }) env s2a
        (fn env1 s21 -> tail cx1 (image.Func.body fr) env1 s21);
    let body = if has_self { Expr.bind self_var Rhs.self_closure forced_body } else { forced_body };
    let func_ = Function.make symbol symbol how (image.Func.flags fr & image.func_impure != 0) params caps body name
        (list.append place [0]);
    St.set_functions (list.cons func_ (St.functions s3)) s3
};

/// A program, from what `units` hold: `unit => image`. `roots` are `[unit, function]`,
/// and everything they reach comes with them.
let program : :map -> [[:any]] -> :map -> :map -> :map -> St -> St;
let program units roots lib_names native_arity lib_arity s = {
    let masks = map.map_values strict_masks units;
    let rec go s1 seen lib_seen = match St.queued s1 {
        [] => {
            let wanted = list.filter (fn n -> not (lib_seen.[n else false])) (map.keys (St.needed_lib s1));
            match wanted {
                [] => s1,
                [name, ..rest] => match map.lookup name lib_names {
                    Option.none => go (refuse_in "the library" (str.concat_all ["it has no `", name, "`"]) (St.set_needed_lib (map.remove name (St.needed_lib s1)) s1)) seen lib_seen,
                    Option.some(f) => go (St.set_queued [["l", f, :function]] s1) seen lib_seen.[name => true],
                },
            }
        },
        [[unit, f, how], ..rest] => {
            let s2 = St.set_queued rest s1;
            let key = str.concat_all [unit, to_string f, to_string how];
            if seen.[key else false] { go s2 seen lib_seen }
            else {
                let cx = %{:img => units.[unit], :unit => unit, :name => "", :native_arity => native_arity, :lib_arity => lib_arity, :strict => masks.[unit]};
                go (translate cx f how s2) seen.[key => true] lib_seen
            }
        },
    };
    go (St.set_queued roots s) %{} %{}
};
