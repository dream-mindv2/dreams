// The core: what an image's execution trees mean, with evaluation order explicit.
//
// A node says "this is lazy" by where it stands, and leaves the machine to work out
// the rest. Here every thunk is an allocation, every force is an `enter`, and what
// happens next is a syntactic part of the term. That is what makes the two things
// the machine needs simple: what must survive a suspension is the free variables of
// what comes after it, so a frame holds nothing dead and a list being consumed is
// not pinned by a frame that has finished with it; and strictness and unboxing,
// when they come, are questions about this form.
//
// The shape is one rule. `Seq(x, e, rest)` runs `e` to its answer, which it gives by
// `ret`, and runs `rest` with that as `x`: a frame is pushed for `rest`, and `e`
// behaves as any function does. A `match` in the middle of a function and a call are
// therefore the same thing, and there are no join points.
//
// Translation refuses what is not built yet, by name, rather than guess.

import std.list;
import std.map;
import std.str;

import dreams.aot.image;
import dreams.builtins;

union Atom {
    /// A variable of the current function.
    var(id : :integer),
    /// A value known now: its 64-bit word, as text.
    word(text : :string),
    /// The address of something static.
    address(symbol : :string),
}

union Rhs {
    /// Small-integer arithmetic done now if it can be, on evaluated operands, and otherwise
    /// the suspension (`symbol`, `payload`) that would have been made.
    /// The closure this function was entered with, at its entry.
    self_closure,
    speculate(op : :string, a : Atom, b : Atom, symbol : :string, payload : [Atom]),
    /// `+` and the rest, on values in hand.
    arith(op : :string, a : Atom, b : Atom),
    /// `==` and the rest, answering a boolean or a suspended comparison.
    compare(op : :string, a : Atom, b : Atom),
    /// A runtime function, forced arguments, which answers 0 to raise.
    native(name : :string, args : [Atom]),
    /// One that answers 0 for "nothing there", which is not an error.
    peek(name : :string, args : [Atom]),
    /// An object: its info and payload words, which may hold holes.
    alloc(info : :string, args : [Atom]),
    /// A payload word of `object` set after the fact, for what refers to itself.
    patch(object : Atom, index : :integer, value : Atom),
    /// A payload word read, unforced: a list's head, say.
    field(object : Atom, index : :integer),
    /// Whether an evaluated value is an object of this kind.
    has_kind(a : Atom, kind : :integer),
    /// Whether an evaluated value is exactly this word.
    same(a : Atom, word : :string),
    is_fix(a : Atom),
    is_int(a : Atom),
    /// Whether it is an immediate of this kind.
    has_tag(a : Atom, tag : :integer),
    is_list(a : Atom),
}

union Expr {
    /// Answer an atom already in weak head normal form.
    ret(a : Atom),
    /// Evaluate an atom, and answer that.
    enter(a : Atom),
    /// A function of known arity, with exactly its arguments.
    call(symbol : :string, args : [Atom]),
    /// At a function's entry: go on with `a` as `x` if it is evaluated, and otherwise evaluate it
    /// in a frame holding `live` and run `retry`, the same call again with `x` in its place.
    /// So the body exists once, and the common case stores nothing.
    entry_force(a : Atom, x : :integer, live : [:integer], retry : Expr, body : Expr),
    /// A closure whose code is known, with exactly its arguments.
    call_closure(f : Atom, symbol : :string, args : [Atom]),
    /// A value in weak head normal form applied to arguments.
    apply(f : Atom, args : [Atom]),
    /// An evaluated boolean decides.
    choose(a : Atom, yes : Expr, no : Expr),
    seq(x : :integer, live : [:integer], e : Expr, rest : Expr),
    /// Run `body`, whose answer is the answer. If it raises, run `handler` with the
    /// error as `x`, in a frame holding `live`, what the handler needs.
    catching(x : :integer, live : [:integer], body : Expr, handler : Expr, cleanup : :bool),
    bind(x : :integer, rhs : Rhs, rest : Expr),
    raise_text(text : :string),
    /// `raise!`, which knows where it was written.
    raised(a : Atom),
}

/// A function of the core: a global, a closure's code, or a thunk's.
group Function {
    symbol : :string,
    info : :string,
    how : :atom,
    impure : :bool,
    params : [:integer],
    captures : [:integer],
    body : Expr,
    name : :string,
    place : [:any],
}

/// Everything translation has found so far. Threaded rather than kept, as all state
/// is here; `next` numbers variables and lifted functions across the whole program.
group St {
    next : :integer,
    functions : [Function],
    queued : [[:any]],
    strings : %{:string => :string},
    floats : :map,
    atoms : %{:string => :integer},
    natives : :map,
    refused : [:string],
    needed_lib : :map,
    wrapped : :map,
    records : :map,
}

/// The slots of the function being translated: a slot's atom, and which variables are
/// already evaluated, which spares the machine a test and a frame.
group Env {
    slots : :map,
    captures : :map,
    forced : :map,
    holes : [[:any]],
}

let empty_st : St;
let empty_st = St.make 0 [] [] %{} %{} %{} %{} [] %{} %{} %{};

let fresh : St -> [:integer, St];
let fresh s = [St.next s, St.set_next (St.next s + 1) s];

let refuse_in : :string -> :string -> St -> St;
let refuse_in where why s = St.set_refused (list.cons (str.concat_all [where, ": ", why]) (St.refused s)) s;

// --- words -----------------------------------------------------------------------
//
// How a value is one word, the compiler's half of what mind/std/rt/main.dr says.

let fixnum_word : :integer -> :string;
let fixnum_word n = to_string (n * 2 + 1);
let immediate_word : :integer -> :integer -> :string;
let immediate_word kind payload = to_string (payload * 256 + kind * 8 + 2);
let unit_word = immediate_word 0 0;
let false_word = immediate_word 1 0;
let true_word = immediate_word 1 1;
let nil_word = immediate_word 4 0;
let char_word : :integer -> :string;
let char_word c = immediate_word 2 c;

/// Fixnums are 63 bits; what is larger is a bignum, which is not built yet.
let fits_fixnum : :integer -> :bool;
let fits_fixnum n = n >= -4611686018427387904 && n < 4611686018427387904;

// --- free variables ----------------------------------------------------------------

let atom_vars : Atom -> [:integer];
let atom_vars a = match a { Atom.var(i) => [i], _ => [] };

let rhs_vars : Rhs -> [:integer];
let rhs_vars r = match r {
    Rhs.self_closure => [],
    Rhs.speculate(_, a, b, _, payload) => list.concat [atom_vars a, atom_vars b, list.flat_map atom_vars payload],
    Rhs.arith(_, a, b) => list.append (atom_vars a) (atom_vars b),
    Rhs.compare(_, a, b) => list.append (atom_vars a) (atom_vars b),
    Rhs.native(_, args) => list.flat_map atom_vars args,
    Rhs.peek(_, args) => list.flat_map atom_vars args,
    Rhs.alloc(_, args) => list.flat_map atom_vars args,
    Rhs.patch(o, _, v) => list.append (atom_vars o) (atom_vars v),
    Rhs.field(o, _) => atom_vars o,
    Rhs.has_kind(a, _) => atom_vars a,
    Rhs.same(a, _) => atom_vars a,
    Rhs.is_fix(a) => atom_vars a,
    Rhs.is_int(a) => atom_vars a,
    Rhs.has_tag(a, _) => atom_vars a,
    Rhs.is_list(a) => atom_vars a,
};

/// The variables `e` reads and does not bind, as a set. A `seq` holds its own, so
/// this stops there and a long body is not walked once per statement in it.
let free : Expr -> :map;
let free e = match e {
    Expr.ret(a) => set_of (atom_vars a),
    Expr.enter(a) => set_of (atom_vars a),
    Expr.call(_, args) => set_of (list.flat_map atom_vars args),
    Expr.entry_force(a, x, live, _, body) => union_of (set_of (atom_vars a)) (union_of (set_of live) (map.remove x (free body))),
    Expr.call_closure(f, _, args) => set_of (list.append (atom_vars f) (list.flat_map atom_vars args)),
    Expr.apply(f, args) => set_of (list.append (atom_vars f) (list.flat_map atom_vars args)),
    Expr.choose(a, y, n) => union_of (set_of (atom_vars a)) (union_of (free y) (free n)),
    Expr.seq(x, live, inner, _) => union_of (free inner) (set_of live),
    Expr.catching(x, live, body, _, _) => union_of (free body) (set_of live),
    Expr.bind(x, r, rest) => union_of (set_of (rhs_vars r)) (map.remove x (free rest)),
    Expr.raise_text(_) => %{},
    Expr.raised(a) => set_of (atom_vars a),
};

let set_of : [:integer] -> :map;
let set_of xs = list.fold (fn m x -> m.[x => true]) %{} xs;

let union_of : :map -> :map -> :map;
let union_of a b = list.fold (fn m x -> m.[x => true]) a (map.keys b);

/// `seq` with what `rest` needs written down, in a fixed order so that a program
/// compiles to the same bytes each time.
let seq_of : :integer -> Expr -> Expr -> Expr;
let seq_of x e rest = Expr.seq x (list.sort (map.keys (map.remove x (free rest)))) e rest;

// --- what a node reads ------------------------------------------------------------

/// The nodes directly under `n`, as the format lays them out. What suspends is a
/// question about all of these, so it is answered once.
let node_kids : image.Image -> image.Node -> [:integer];
let node_kids img n = {
    let op = image.Node.op n;
    let a = image.Node.a n;
    let b = image.Node.b n;
    let c = image.Node.c n;
    let present = fn xs -> list.filter (fn k -> k != image.no_node) xs;
    match op {
        12 => [a], 16 => [b], 19 => [a, b], 20 => [a], 34 => [a], 35 => [a], 78 => [a],
        13 => list.cons a (image.kids img b c),
        14 => present [a, b, c],
        15 => image.kids img a b,
        36 => image.kids img a b,
        37 => image.kids img a b,
        38 => image.kids img a (b * 2),
        39 => present [a, b, c],
        40 => [a, b, c],
        41 => list.cons a (image.kids img b c),
        42 => list.cons a (image.kids img b c),
        43 => [a], 44 => [a, b], 45 => [a], 46 => [a], 84 => [a], 85 => [a],
        81 => image.kids img a b,
        82 => list.cons a (image.kids img b (c * 2)),
        83 => [a, b],
        o if o >= 21 && o <= 33 => [a, b],
        o if o >= 47 && o <= 74 => image.kids img b c,
        o if o >= 75 && o <= 77 => [a, b],
        o if o == 79 || o == 80 => [a, b],
        _ => [],
    }
};

// --- strictness -----------------------------------------------------------------------------
//
// Which parameters of a pure function are always forced when a call to it is. A caller can then
// evaluate such an argument itself rather than allocate a suspension that the callee forces at
// once, which was the largest cost a lazy program had here. The answer is a mask per function,
// the greatest fixed point: every parameter is assumed strict, and that is taken back until
// nothing changes, so that a recursive function's own calls can count as forcing.
//
// What this gives up is which of two errors is seen, when a call has two arguments that raise.
// That is all it gives up: a parameter is only strict if the call would have forced it, so a
// program that finished still finishes. It is why an impure function has no mask, since there
// an effect could come first, and why nothing under a `try!` counts, since the raise would then
// happen outside it.

/// What the analysis knows: each function's mask, and which calls have a known closure.
group Demand {
    masks : :map,
    calls : :map,
}

/// The parameters `i` forces, as a mask. `lets` says what forcing a local forces.
let forced_by : image.Image -> Demand -> :integer -> :map -> :integer;
let forced_by img d i lets = if i == image.no_node { 0 } else {
    let n = image.node img i;
    let op = image.Node.op n;
    let a = image.Node.a n;
    let b = image.Node.b n;
    let c = image.Node.c n;
    let of_ = fn k -> forced_by img d k lets;
    match op {
        8 => match map.lookup a lets {
            Option.some(m) => m,
            Option.none => if a < 60 { 1 << a } else { 0 },
        },
        13 => forced_by_call img d a (image.kids img b c) lets,
        14 => of_ a | (of_ b & (if c == image.no_node { 0 } else { of_ c })),
        15 => forced_by_block img d (image.kids img a b) lets 0,
        20 => of_ a,
        o if o == 32 || o == 33 => of_ a,
        o if o == 34 || o == 35 || o == 43 || o == 45 || o == 46 || o == 84 || o == 85 || o == 78 => of_ a,
        o if o >= 21 && o <= 31 => of_ a | of_ b,
        o if o == 75 || o == 76 || o == 77 || o == 79 || o == 80 => of_ a | of_ b,
        39 => of_ a,
        o if o >= 47 && o <= 74 => forced_by_builtin img d names_of_builtins.[a] (image.kids img b c) lets,
        41 => forced_by_arms img d (of_ a) (image.kids img b c) lets,
        42 => forced_by_arms img d (of_ a) (image.kids img b c) lets,
        _ => 0,
    }
};

/// A builtin that is a native forces what it takes but for its declared lazy positions.
let forced_by_builtin : image.Image -> Demand -> :string -> [:integer] -> :map -> :integer;
let forced_by_builtin img d name args lets = match map.lookup name native_builtins {
    Option.some(native) => if str.ends_with "!" name || map.has native library_natives { 0 } else {
        let lazy_at = native_lazy.[native else []];
        list.fold (fn acc [k, arg] -> if list.contains k lazy_at { acc } else { acc | forced_by img d arg lets })
            0 (list.enumerate args)
    },
    Option.none => 0,
};

/// The function a call runs, if that is known and it is called with exactly its arguments.
let known_callee : image.Image -> Demand -> :integer -> :integer -> Option :integer;
let known_callee img d callee count = {
    let n = image.node img callee;
    let f = match image.Node.op n {
        10 => {
            let g = image.global img (image.Node.a n);
            if image.Global.kind g == 0 { image.Global.target g } else { 0 - 1 }
        },
        o if o == 8 || o == 9 => (Demand.calls d).[callee else 0 - 1],
        _ => 0 - 1,
    };
    if f >= 0 && image.Func.arity (image.func img f) == count { Option.some f } else { Option.none }
};

let forced_by_call : image.Image -> Demand -> :integer -> [:integer] -> :map -> :integer;
let forced_by_call img d callee args lets = {
    let wanted = match known_callee img d callee (list.length args) {
        Option.some(f) => (Demand.masks d).[f else 0],
        Option.none => 0,
    };
    let own = if image.Node.op (image.node img callee) == 8 { forced_by img d callee lets } else { 0 };
    list.fold (fn acc [k, arg] ->
        if k < 60 && (wanted >> k) & 1 == 1 { acc | forced_by img d arg lets } else { acc })
        own (list.enumerate args)
};

/// A switch forces its subject, and what every arm and its fallback force.
let forced_by_arms : image.Image -> Demand -> :integer -> [:integer] -> :map -> :integer;
let forced_by_arms img d subject kids lets = {
    let rec arms rest !acc = match rest {
        [fallback] => acc & forced_by img d fallback lets,
        [_, target, ..more] => arms more (acc & forced_by img d target lets),
        _ => 0,
    };
    subject | arms kids (0 - 1)
};

let forced_by_block : image.Image -> Demand -> [:integer] -> :map -> :integer -> :integer;
let forced_by_block img d statements lets acc = match statements {
    [] => acc,
    [i, ..rest] => {
        let n = image.node img i;
        let strict = image.Node.flags n & flag_strict != 0;
        if image.Node.op n == 16 {
            let m = forced_by img d (image.Node.b n) lets;
            forced_by_block img d rest lets.[image.Node.a n => m] (if strict { acc | m } else { acc })
        } else if rest == [] || strict {
            forced_by_block img d rest lets (acc | forced_by img d i lets)
        } else { forced_by_block img d rest lets acc }
    },
};

// A local function is usually called by name where it is in scope, and `let rec go` by its own
// capture inside itself. Which one a read of a slot or capture means is known by walking from
// the binding, and that makes a call direct and lets the strictness above see through it. One
// node may be shared between functions, so a read that means two things means nothing.

let note_call : :map -> :integer -> :integer -> :map;
let note_call calls node f = match map.lookup node calls {
    Option.some(known) => if known == f { calls } else { calls.[node => 0 - 1] },
    Option.none => calls.[node => f],
};

let closure_calls_in : image.Image -> :integer -> :map -> :map -> :map -> :map;
let closure_calls_in img i scope caps calls = if i == image.no_node { calls } else {
    let n = image.node img i;
    let op = image.Node.op n;
    let a = image.Node.a n;
    let each = fn kids acc -> list.fold (fn cs k -> closure_calls_in img k scope caps cs) acc kids;
    match op {
        15 => {
            let [_, out] = list.fold (fn [sc, cs] st -> {
                let node = image.node img st;
                if image.Node.op node == 16 {
                    let target = image.node img (image.Node.b node);
                    let is_fn = image.Node.op target == 17 || image.Node.op target == 18;
                    let sc1 = if is_fn { sc.[image.Node.a node => image.Node.a target] } else { map.remove (image.Node.a node) sc };
                    [sc1, closure_calls_in img (image.Node.b node) sc1 caps cs]
                } else { [sc, closure_calls_in img st sc caps cs] }
            }) [scope, calls] (image.kids img a (image.Node.b n));
            out
        },
        13 => {
            let callee = image.node img a;
            let found = match image.Node.op callee {
                8 => scope.[image.Node.a callee else 0 - 1],
                9 => caps.[image.Node.a callee else 0 - 1],
                _ => 0 - 1,
            };
            let cs = if image.Node.op callee == 8 || image.Node.op callee == 9 { note_call calls a found } else { calls };
            each (image.kids img (image.Node.b n) (image.Node.c n)) (closure_calls_in img a scope caps cs)
        },
        o if o == 17 || o == 18 => {
            let inner = list.fold (fn m [k, d] -> {
                let known = if d >= 2147483648 { caps.[d - 2147483648 else 0 - 1] } else { scope.[d else 0 - 1] };
                if known >= 0 { m.[k => known] } else { m }
            }) %{} (list.enumerate (capture_descriptors img a));
            closure_calls_in img (image.Func.body (image.func img a)) %{} inner calls
        },
        _ => each (node_kids img n) calls,
    }
};

let closure_calls : image.Image -> :map;
let closure_calls img = list.fold (fn cs f -> {
    let fr = image.func img f;
    if image.Func.captures fr == 0 { closure_calls_in img (image.Func.body fr) %{} %{} cs } else { cs }
}) %{} (list.range 0 (image.count img "FUNC"));

/// Whether a function may perform effects: named so, or with a body the compiler marked. A lambda
/// has no name to be impure by, and is held to the second, as the VM does (`callee_is_impure`).
let flag_impure = 2;

let may_effect : image.Image -> :integer -> :bool;
let may_effect img f = {
    let fr = image.func img f;
    image.Func.flags fr & image.func_impure != 0
        || (image.Func.body fr != image.no_node && image.Node.flags (image.node img (image.Func.body fr)) & flag_impure != 0)
};

/// The masks of an image's functions, by function.
let strict_masks : image.Image -> Demand;
let strict_masks img = {
    let calls = closure_calls img;
    let eligible = list.filter (fn f -> {
        let fr = image.func img f;
        image.Func.arity fr > 0 && not (may_effect img f)
    }) (list.range 0 (image.count img "FUNC"));
    let start = list.fold (fn m f -> {
        let arity = image.Func.arity (image.func img f);
        m.[f => (1 << (if arity > 60 { 60 } else { arity })) - 1]
    }) %{} eligible;
    let rec round masks = {
        let [next, changed] = list.fold (fn [m, ch] f -> {
            let old = m.[f];
            if old == 0 { [m, ch] } else {
                let now = old & forced_by img (Demand.make m calls) (image.Func.body (image.func img f)) %{};
                if now == old { [m, ch] } else { [m.[f => now], true] }
            }
        }) [masks, false] eligible;
        if changed { round next } else { next }
    };
    Demand.make (round start) calls
};

/// Whether evaluating `i` now rather than later could not be seen, in a function with effects:
/// only pure calls and arithmetic on what it has. A pure function's arguments are all like that.
let effect_free : image.Image -> :integer -> :bool;
let effect_free img i = image.Node.flags (image.node img i) & flag_impure == 0;

/// Whether everything `i` reads has a value yet, which `let rec` may not.
let bound_in : :any -> :integer -> Env -> :bool;
let bound_in cx i env = {
    let [slots, _, made] = reads cx.[:img] i;
    list.all (fn v -> made.[v else false] || map.has v (Env.slots env)) (map.keys slots)
};

/// Each of `args` as an atom, those `mask` names evaluated. A slot not yet bound is `let rec`,
/// and only suspending can read that.
let call_args : :any -> :integer -> [:integer] -> Env -> St -> :any -> [Expr, St];
let call_args cx mask args env s k = {
    let bound_here = bound_in cx;
    let rec go ns !at acc env1 s1 = match ns {
        [] => k (list.reverse acc) env1 s1,
        [n, ..rest] => {
            let now = at < 60 && (mask >> at) & 1 == 1 && (cx.[:pure else false] || effect_free cx.[:img] n) && bound_here n env1;
            (if now { value } else { lazily }) cx n env1 s1 (fn a env2 s2 -> go rest (at + 1) (list.cons a acc) env2 s2)
        },
    };
    go args 0 [] env s
};

/// What `n` reads of the frame it runs in: `[slots, captures, bound]`, each a set.
let reads : image.Image -> :integer -> [:map];
let reads img root = {
    let rec walk work seen slots caps bound = match work {
        [] => [slots, caps, bound],
        [i, ..rest] => if seen.[i else false] { walk rest seen slots caps bound } else {
            let n = image.node img i;
            let op = image.Node.op n;
            let seen1 = seen.[i => true];
            match op {
                8 => walk rest seen1 slots.[image.Node.a n => true] caps bound,
                9 => walk rest seen1 slots caps.[image.Node.a n => true] bound,
                16 => walk (list.cons (image.Node.b n) rest) seen1 slots caps bound.[image.Node.a n => true],
                o if o == 17 || o == 18 => {
                    let [s1, c1] = capture_reads img (image.Node.a n) slots caps;
                    walk rest seen1 s1 c1 bound
                },
                _ => walk (list.append (node_kids img n) rest) seen1 slots caps bound,
            }
        },
    };
    walk [root] %{} %{} %{} %{}
};

/// What building a closure of function `f` reads of the frame it is built in: the
/// format's capture descriptors, high bit for a capture of the parent's.
let capture_reads : image.Image -> :integer -> :map -> :map -> [:map];
let capture_reads img f slots caps = {
    let rec_ = image.func img f;
    list.fold (fn [s, c] d ->
        if d >= 2147483648 { [s, c.[d - 2147483648 => true]] } else { [s.[d => true], c] })
        [slots, caps] (capture_descriptors img f)
};

let capture_descriptors : image.Image -> :integer -> [:integer];
let capture_descriptors img f = image.kids img (image.func_captures_at img f) (image.Func.captures (image.func img f));

// --- translation -------------------------------------------------------------------
//
// In continuation-passing style at compile time: `value` is given what to do with an
// atom, because what comes next may be in a frame or may be the next instruction, and
// only the node being translated knows which.

let names_of_builtins = builtins.names;

let symbol_of : :string -> :integer -> :string;
let symbol_of prefix f = str.concat_all ["@", prefix, to_string f];

let forced_atom : Env -> Atom -> :bool;
let forced_atom env a = match a {
    Atom.var(i) => (Env.forced env).[i else false],
    Atom.word(_) => true,
    Atom.address(_) => false,
};

let mark_forced : Atom -> Env -> Env;
let mark_forced a env = match a {
    Atom.var(i) => Env.set_forced ((Env.forced env).[i => true]) env,
    _ => env,
};

let queue : :any -> :integer -> St -> St;
let queue cx f s = St.set_queued (list.cons [cx.[:unit], f, :function] (St.queued s)) s;

/// A parameterless pure function named at the top level is a value, computed once. The
/// same function reached by a `$( .. )` is a function of nothing, a value of its own,
/// and so one image function may be compiled as both; what decides is how it was reached.
let queue_once : :any -> :integer -> St -> St;
let queue_once cx f s = St.set_queued (list.cons [cx.[:unit], f, :caf] (St.queued s)) s;

let once_symbol : :any -> :integer -> :string;
let once_symbol cx f = str.concat_all ["@v", cx.[:unit], to_string f];

let intern_string : :string -> St -> [:string, St];
let intern_string text s = match map.lookup text (St.strings s) {
    Option.some(symbol) => [symbol, s],
    Option.none => {
        let symbol = str.concat_all ["@str", to_string (map.size (St.strings s))];
        [symbol, St.set_strings ((St.strings s).[text => symbol]) s]
    },
};

let intern_atom : :string -> St -> [:integer, St];
let intern_atom name s = match map.lookup name (St.atoms s) {
    Option.some(i) => [i, s],
    Option.none => {
        let i = map.size (St.atoms s);
        [i, St.set_atoms ((St.atoms s).[name => i]) s]
    },
};

/// A global function's closure, for where it is used as a value.
let static_closure : :string -> Atom;
let static_closure symbol = Atom.address (str.concat_all ["@c_", str.slice 1 (len symbol - 1) symbol]);

let arithmetic_ops : %{:integer => :string};
let arithmetic_ops = %{21 => "add", 22 => "sub", 23 => "mul", 24 => "div", 25 => "mod"};
let comparison_ops : %{:integer => :string};
let comparison_ops = %{26 => "eq", 27 => "ne", 28 => "lt", 29 => "le", 30 => "gt", 31 => "ge"};

/// `n` evaluated, given to `k` as an atom in weak head normal form.
let value : :any -> :integer -> Env -> St -> :any -> [Expr, St];
let value cx i env s k = {
    let n = image.node cx.[:img] i;
    let op = image.Node.op n;
    let a = image.Node.a n;
    let b = image.Node.b n;
    let forcing = fn atom -> 
        if forced_atom env atom { k atom env s }
        else {
            let [x, s1] = fresh s;
            let var = Atom.var x;
            let [rest, s2] = k var (remember i atom var (mark_forced var env)) s1;
            [seq_of x (Expr.enter atom) rest, s2]
        };
    match op {
        1 => {
            let v = image.integer cx.[:img] a;
            if fits_fixnum v { k (Atom.word (fixnum_word v)) env s }
            else { k (Atom.word unit_word) env (refuse_in cx.[:name] "an integer too large for a fixnum" s) }
        },
        3 => {
            let [symbol, s1] = intern_string (image.string cx.[:img] a) s;
            k (Atom.address symbol) (env) s1
        },
        2 => {
            let [lo, hi] = image.float_bits cx.[:img] a;
            let bits = hi * 4294967296 + lo;
            let key = to_string bits;
            match map.lookup key (St.floats s) {
                Option.some(found) => k (Atom.address found.[0]) env s,
                Option.none => {
                    let symbol = "@flt" + to_string (map.size (St.floats s));
                    k (Atom.address symbol) env (St.set_floats ((St.floats s).[key => [symbol, lo, hi]]) s)
                },
            }
        },
        4 => k (Atom.word (char_word a)) env s,
        5 => k (Atom.word (if a == 1 { true_word } else { false_word })) env s,
        6 => {
            let [index, s1] = intern_atom (image.atom cx.[:img] a) s;
            k (Atom.word (immediate_word 3 index)) env s1
        },
        7 => k (Atom.word unit_word) env s,
        8 => match map.lookup a (Env.slots env) {
            Option.some(atom) => forcing atom,
            Option.none => k (Atom.word unit_word) env (refuse_in cx.[:name] "a slot read before it is bound" s),
        },
        9 => forcing (Env.captures env).[a],
        21 => arithmetic cx op n env s k,
        22 => arithmetic cx op n env s k,
        23 => arithmetic cx op n env s k,
        24 => arithmetic cx op n env s k,
        25 => arithmetic cx op n env s k,
        26 => comparing cx op n env s k,
        27 => comparing cx op n env s k,
        28 => comparing cx op n env s k,
        29 => comparing cx op n env s k,
        30 => comparing cx op n env s k,
        31 => comparing cx op n env s k,
        84 => tested cx (fn atom -> Rhs.has_kind atom 5) a env s k,
        46 => tested cx (fn atom -> Rhs.same atom nil_word) a env s k,
        43 => type_test cx n env s k,
        o if o == 17 || o == 18 => lazily cx i env s k,
        o if o == 36 || o == 37 || o == 44 || o == 81 => lazily cx i env s k,
        _ => {
            let [x, s1] = fresh s;
            let [e, s2] = tail cx i env s1;
            let var = Atom.var x;
            let [rest, s3] = k var (mark_forced var env) s2;
            [seq_of x e rest, s3]
        },
    }
};

/// `try! body catch e handler`.
let trying : :any -> image.Node -> Env -> St -> [Expr, St];
let trying cx n env s = {
    let [x, s1] = fresh s;
    let handler_env = Env.set_slots ((Env.slots env).[image.Node.c n => Atom.var x]) (mark_forced (Atom.var x) env);
    let [handler, s2] = tail cx (image.Node.b n) handler_env s1;
    let [body, s3] = tail cx (image.Node.a n) env s2;
    let live = list.sort (map.keys (map.remove x (free handler)));
    [Expr.catching x live body handler false, s3]
};

/// `body` with `cleanup` after it however it ends. Cleanup appears twice, because its
/// two runs continue differently, and an error in it replaces an answer but not an
/// error already on its way.
let ensuring : :any -> image.Node -> Env -> St -> [Expr, St];
let ensuring cx n env s = {
    let [answer_, s1] = fresh s;
    let [unused, s2] = fresh s1;
    let [cleanup_ok, s3] = tail cx (image.Node.b n) env s2;
    let after_ok = seq_of unused cleanup_ok (Expr.ret (Atom.var answer_));
    let [e, s4] = fresh s3;
    let [e2, s5] = fresh s4;
    let [unused2, s6] = fresh s5;
    let [cleanup_bad, s7] = tail cx (image.Node.b n) env s6;
    let rethrow = Expr.call "@raise!" [Atom.var e];
    let guarded = Expr.catching e2 (list.sort (map.keys (set_of [e]))) cleanup_bad rethrow true;
    let on_error = seq_of unused2 guarded rethrow;
    let [body, s8] = tail cx (image.Node.a n) env s7;
    let live = list.sort (map.keys (map.remove e (free on_error)));
    [seq_of answer_ (Expr.catching e live body on_error true) after_ok, s8]
};

let map_literal : :any -> [:integer] -> Env -> St -> [Expr, St];
let map_literal cx kids env s = {
    let s0 = St.set_natives ((St.natives s).["map_empty!" => true]) s;
    let s1 = St.set_natives ((St.natives s0).["map_put!" => true]) s0;
    let rec pairs rest current env1 st = match rest {
        [] => [Expr.ret current, st],
        [key, v, ..more] => value cx key env1 st (fn k_ env2 st1 ->
            lazily cx v env2 st1 (fn v_ env3 st2 -> {
                let [x, st3] = fresh st2;
                let [after, st4] = pairs more (Atom.var x) env3 st3;
                [Expr.bind x (Rhs.native "map_put!" [current, k_, v_]) after, st4]
            })),
        _ => [Expr.raise_text "a malformed map", st],
    };
    let [m, s2] = fresh s1;
    let [body, s3] = pairs kids (Atom.var m) env s2;
    [Expr.bind m (Rhs.native "map_empty!" []) body, s3]
};

/// `c.[k]` and `c.[k else d]`. A list is walked by the library, since walking one
/// forces it; everything else answers at once, or says there is nothing there.
let getting : :any -> image.Node -> Env -> St -> [Expr, St];
let getting cx n env s = {
    let fallback = image.Node.c n;
    let has_fallback = fallback != image.no_node;
    let s0 = list.fold (fn st name -> St.set_natives ((St.natives st).[name => true]) st) s ["peek!", "index_absent!"];
    value cx (image.Node.a n) env s0 (fn c env1 s1 ->
        value cx (image.Node.b n) env1 s1 (fn key env2 s2 -> {
            let [is_list, s3] = fresh s2;
            let [found, s4] = fresh s3;
            let [absent, s5] = fresh s4;
            let [failed, s6] = fresh s5;
            let [no_answer, s7] = if has_fallback { tail cx fallback env2 s6 }
                else { [Expr.bind failed (Rhs.native "index_absent!" [c, key]) (Expr.ret (Atom.var failed)), s6] };
            let [walk, s8] = if has_fallback {
                lazily cx fallback env2 (St.set_needed_lib ((St.needed_lib s7).["index_of_list_else" => true]) s7)
                    (fn d _ st -> [Expr.call "@lib_index_of_list_else" [c, key, d], st])
            } else {
                [Expr.call "@lib_index_of_list" [c, key], St.set_needed_lib ((St.needed_lib s7).["index_of_list" => true]) s7]
            };
            let other = Expr.bind found (Rhs.peek "peek!" [c, key])
                (Expr.bind absent (Rhs.same (Atom.var found) "0")
                    (Expr.choose (Atom.var absent) no_answer (Expr.enter (Atom.var found))));
            [Expr.bind is_list (Rhs.is_list c) (Expr.choose (Atom.var is_list) walk other), s8]
        }))
};

/// `c.[k => v]`, the value stored as it stands.
let setting : :any -> :integer -> :integer -> :integer -> Env -> St -> [Expr, St];
let setting cx container key v env s =
    value cx container env s (fn c env1 s1 ->
        set_step cx c key v env1 s1 (fn x _ s2 -> [Expr.ret x, s2]));

let set_step : :any -> Atom -> :integer -> :integer -> Env -> St -> :any -> [Expr, St];
let set_step cx c key v env s k = {
    let s0 = St.set_natives ((St.natives s).["index_set!" => true]) s;
    let s1 = St.set_needed_lib ((St.needed_lib s0).["list_set" => true]) s0;
    value cx key env s1 (fn key_atom env1 s2 ->
        lazily cx v env1 s2 (fn v_atom env2 s3 -> {
            let [is_list, s4] = fresh s3;
            let [x, s5] = fresh s4;
            let [o, s6] = fresh s5;
            let [rest, s7] = k (Atom.var x) (mark_forced (Atom.var x) env2) s6;
            let pick = Expr.choose (Atom.var is_list)
                (Expr.call "@lib_list_set" [c, key_atom, v_atom])
                (Expr.bind o (Rhs.native "index_set!" [c, key_atom, v_atom]) (Expr.ret (Atom.var o)));
            [Expr.bind is_list (Rhs.is_list c) (seq_of x pick rest), s7]
        }))
};

/// A chain of `set`s at constant keys, one at a time.
let setting_many : :any -> :integer -> [:integer] -> Env -> St -> [Expr, St];
let setting_many cx container pairs env s = {
    let rec go c rest env1 st = match rest {
        [] => [Expr.ret c, st],
        [key, v, ..more] => set_step cx c key v env1 st (fn x env2 st1 -> go x more env2 st1),
        _ => [Expr.raise_text "a malformed set_many", st],
    };
    value cx container env s (fn c env1 s1 -> go c pairs env1 s1)
};

/// Once a slot's variable is evaluated, the evaluated one is what the slot holds:
/// later reads have nothing to test.
let remember : :integer -> Atom -> Atom -> Env -> Env;
let remember i old new env = {
    let slots = list.fold (fn m [slot, atom] -> if atom == old { m.[slot => new] } else { m })
        (Env.slots env) (map.pairs (Env.slots env));
    Env.set_slots slots env
};

let bound : Rhs -> :any -> Env -> St -> :bool -> [Expr, St];
let bound rhs k env s known = {
    let [x, s1] = fresh s;
    let var = Atom.var x;
    let [rest, s2] = k var (if known { mark_forced var env } else { env }) s1;
    [Expr.bind x rhs rest, s2]
};

/// Whether a node is a literal that is no structure: an operation with one on a side
/// has no slow path the library must finish, so its answer is in hand.
let is_flat_literal : :any -> :integer -> :bool;
let is_flat_literal cx i = list.contains (image.Node.op (image.node cx.[:img] i)) [1, 2, 3, 4, 5, 6, 7];

/// `bound`, for an answer that may be a thunk the runtime made to finish in the library,
/// a list's `+` or a structure's `==`. `value` promises an evaluated atom, so it is
/// evaluated here, where that is known to be needed; only an operation between two
/// unknowns pays for the frame.
let bound_maybe : Rhs -> :any -> Env -> St -> :bool -> [Expr, St];
let bound_maybe rhs_ k env s known =
    if known { bound rhs_ k env s true }
    else {
        let [x, s1] = fresh s;
        let [y, s2] = fresh s1;
        let [rest, s3] = k (Atom.var y) (mark_forced (Atom.var y) env) s2;
        [Expr.bind x rhs_ (seq_of y (Expr.enter (Atom.var x)) rest), s3]
    };

let arithmetic : :any -> :integer -> image.Node -> Env -> St -> :any -> [Expr, St];
let arithmetic cx op n env s k =
    value cx (image.Node.a n) env s (fn a env1 s1 ->
        value cx (image.Node.b n) env1 s1 (fn b env2 s2 ->
            bound_maybe (Rhs.arith arithmetic_ops.[op] a b) k env2 s2
                (op != 21 || is_flat_literal cx (image.Node.a n) || is_flat_literal cx (image.Node.b n))));

let comparing : :any -> :integer -> image.Node -> Env -> St -> :any -> [Expr, St];
let comparing cx op n env s k =
    value cx (image.Node.a n) env s (fn a env1 s1 ->
        value cx (image.Node.b n) env1 s1 (fn b env2 s2 ->
            bound_maybe (Rhs.compare comparison_ops.[op] a b) k env2 s2
                (is_flat_literal cx (image.Node.a n) || is_flat_literal cx (image.Node.b n))));

let tested : :any -> :any -> :integer -> Env -> St -> :any -> [Expr, St];
let tested cx test subject env s k =
    value cx subject env s (fn a env1 s1 -> bound (test a) k env1 s1 true);

/// `type_is`, for the surface kinds that are one test.
let type_test : :any -> image.Node -> Env -> St -> :any -> [Expr, St];
let type_test cx n env s k = {
    let invert = image.Node.c n == 1;
    let test = match image.Node.b n {
        0 => fn a -> Rhs.is_int a,
        3 => fn a -> Rhs.has_tag a 1,
        4 => fn a -> Rhs.same a unit_word,
        1 => fn a -> Rhs.has_kind a 6,
        5 => fn a -> Rhs.has_kind a 7,
        2 => fn a -> Rhs.has_tag a 2,
        6 => fn a -> Rhs.has_tag a 3,
        8 => fn a -> Rhs.has_kind a 8,
        7 => fn a -> Rhs.is_list a,
        _ => fn a -> Rhs.has_kind a 10,
    };
    value cx (image.Node.a n) env s (fn a env1 s1 ->
        if invert {
            let [x, s2] = fresh s1;
            let [y, s3] = fresh s2;
            let [rest, s4] = k (Atom.var y) (mark_forced (Atom.var y) env1) s3;
            [Expr.bind x (test a) (Expr.bind y (Rhs.same (Atom.var x) false_word) rest), s4]
        } else { bound (test a) k env1 s1 true })
};

/// `n` as what the function answers.
let tail : :any -> :integer -> Env -> St -> [Expr, St];
let tail cx i env s = {
    let n = image.node cx.[:img] i;
    let op = image.Node.op n;
    let a = image.Node.a n;
    let b = image.Node.b n;
    let c = image.Node.c n;
    let answer = fn () -> value cx i env s (fn atom _ s1 -> [Expr.ret atom, s1]);
    match op {
        // A read in tail position needs no frame to come back to.
        8 => match map.lookup a (Env.slots env) {
            Option.some(atom) => [if forced_atom env atom { Expr.ret atom } else { Expr.enter atom }, s],
            Option.none => answer (),
        },
        9 => {
            let atom = (Env.captures env).[a];
            [if forced_atom env atom { Expr.ret atom } else { Expr.enter atom }, s]
        },
        10 => global_read cx a env s,
        11 => {
            let [f, s1] = builtin_value cx a s;
            [Expr.ret f, s1]
        },
        12 => {
            let object = image.node cx.[:img] a;
            if image.Node.op object == 10 && image.Global.kind (image.global cx.[:img] (image.Node.a object)) == 1 {
                let [f, s1] = host_value cx n s;
                [Expr.ret f, s1]
            } else { dynamic_member cx n env s }
        },
        13 => applied cx a (image.kids cx.[:img] b c) env s,
        14 => value cx a env s (fn cond env1 s1 -> {
            let [yes, s2] = tail cx b env1 s1;
            let [no, s3] = if c == image.no_node { [Expr.ret (Atom.word unit_word), s2] } else { tail cx c env1 s2 };
            [Expr.choose cond yes no, s3]
        }),
        15 => block cx (image.kids cx.[:img] a b) env s,
        20 => tail cx a env s,
        32 => short_circuit cx true a b env s,
        33 => short_circuit cx false a b env s,
        35 => value cx a env s (fn v env1 s1 ->
            bound (Rhs.same v false_word) (fn x _ s2 -> [Expr.ret x, s2]) env1 s1 true),
        2 => answer (),
        45 => native_exactly "list_tail!" cx [a] env s,
        85 => native_exactly "list_head!" cx [a] env s,
        19 => trying cx n env s,
        83 => ensuring cx n env s,
        34 => native_exactly "neg!" cx [a] env s,
        38 => map_literal cx (image.kids cx.[:img] a (b * 2)) env s,
        39 => getting cx n env s,
        40 => setting cx a b c env s,
        82 => setting_many cx a (image.kids cx.[:img] b (c * 2)) env s,
        75 => native_exactly "bit_and!" cx [a, b] env s,
        76 => native_exactly "bit_or!" cx [a, b] env s,
        77 => native_exactly "bit_xor!" cx [a, b] env s,
        78 => native_exactly "bit_not!" cx [a] env s,
        79 => native_exactly "shift_left!" cx [a, b] env s,
        80 => native_exactly "shift_right!" cx [a, b] env s,
        41 => switching cx n env s,
        42 => switching cx n env s,
        o if o >= 47 && o <= 74 => builtin cx (names_of_builtins.[a]) (image.kids cx.[:img] b c) env s,
        o if o == 1 || o == 3 || o == 4 || o == 5 || o == 6 || o == 7 || o == 17 || o == 18
             || (o >= 21 && o <= 31) || o == 36 || o == 37 || o == 43 || o == 44 || o == 46
             || o == 81 || o == 84 => answer (),
        _ => [Expr.raise_text "not compiled", refuse_in cx.[:name] (str.concat_all ["opcode ", to_string op, " is not compiled yet"]) s],
    }
};

let short_circuit : :any -> :bool -> :integer -> :integer -> Env -> St -> [Expr, St];
let short_circuit cx is_and a b env s =
    value cx a env s (fn l env1 s1 -> {
        let [r, s2] = tail cx b env1 s1;
        let stop = Expr.ret (Atom.word (if is_and { false_word } else { true_word }));
        [if is_and { Expr.choose l r stop } else { Expr.choose l stop r }, s2]
    });

/// A `switch`, written out as the tests its arms stand for. The VM's jump table is
/// the optimization that opcode exists for, and LLVM recovers it from the chain.
let switching : :any -> image.Node -> Env -> St -> [Expr, St];
let switching cx n env s = {
    let kids = image.kids cx.[:img] (image.Node.b n) (image.Node.c n);
    let on_head = image.Node.op n == 41;
    let rec arms env1 subject rest s1 = match rest {
        [fallback] => tail cx fallback env1 s1,
        [key, target, ..more] => {
            let [word, s2] = keyword cx key s1;
            let [x, s3] = fresh s2;
            let [yes, s4] = tail cx target env1 s3;
            let [no, s5] = arms env1 subject more s4;
            [Expr.bind x (Rhs.same subject word) (Expr.choose (Atom.var x) yes no), s5]
        },
        _ => [Expr.raise_text "a malformed switch", s1],
    };
    value cx (image.Node.a n) env (St.set_natives ((St.natives s).["atom_key!" => true]) s) (fn subject env1 s1 ->
        if on_head { head_key cx subject env1 s1 (fn k env2 s2 -> arms env2 k kids s2) }
        else {
            let [key, s2] = fresh s1;
            let [e, s3] = arms env1 (Atom.var key) kids s2;
            [Expr.bind key (Rhs.peek "atom_key!" [subject]) e, s3]
        })
};

let keyword : :any -> :integer -> St -> [:string, St];
let keyword cx key s = {
    let [index, s1] = intern_atom (image.atom cx.[:img] (image.Node.a (image.node cx.[:img] key))) s;
    [immediate_word 3 index, s1]
};

/// What a `switch_head` keys on: a list cell's head evaluated, and anything else
/// takes the default, which a key of unit always does.
let head_key : :any -> Atom -> Env -> St -> :any -> [Expr, St];
let head_key cx subject env s k = {
    let [h, s1] = fresh s;
    let [joined, s2] = fresh s1;
    let [rest, s3] = k (Atom.var joined) (mark_forced (Atom.var joined) env) s2;
    [Expr.bind h (Rhs.peek "head_of!" [subject]) (seq_of joined (Expr.enter (Atom.var h)) rest),
     St.set_natives ((St.natives s3).["head_of!" => true]) s3]
};

/// A global as a value: a function's static closure, a once-computed value's static
/// thunk, or an action, performed by being named.
let global_read : :any -> :integer -> Env -> St -> [Expr, St];
let global_read cx g env s = {
    let rec_ = image.global cx.[:img] g;
    if image.Global.kind rec_ != 0 {
        module_value cx (image.import_path cx.[:img] (image.Global.target rec_)) s
    } else {
        let f = image.Global.target rec_;
        let fr = image.func cx.[:img] f;
        let symbol = symbol_of cx.[:unit] f;
        let s1 = queue cx f s;
        if image.Func.arity fr > 0 { [Expr.ret (static_closure symbol), s1] }
        else if image.Func.flags fr & image.func_impure != 0 { [Expr.call symbol [], s1] }
        else { [Expr.enter (Atom.address (caf_symbol (once_symbol cx f))), queue_once cx f s] }
    }
};

let caf_symbol : :string -> :string;
let caf_symbol symbol = str.concat_all ["@caf_", str.slice 1 (len symbol - 1) symbol];

/// A call: whatever the callee node says it is.
let applied : :any -> :integer -> [:integer] -> Env -> St -> [Expr, St];
let applied cx callee args env s = {
    let n = image.node cx.[:img] callee;
    let unknown = fn () -> value cx callee env s (fn f env1 s1 ->
        lazies cx args env1 s1 (fn atoms _ s2 -> [Expr.apply f atoms, s2]));
    match image.Node.op n {
        11 => builtin cx names_of_builtins.[image.Node.a n] args env s,
        o if o == 8 || o == 9 => match known_callee cx.[:img] cx.[:strict] callee (list.length args) {
            Option.some(f) => value cx callee env (queue cx f s) (fn fa env1 s1 ->
                call_args cx (Demand.masks cx.[:strict]).[f else 0] args env1 s1 (fn atoms _ s2 ->
                    [Expr.call_closure fa (symbol_of cx.[:unit] f) atoms, s2])),
            Option.none => unknown (),
        },
        10 => {
            let g = image.global cx.[:img] (image.Node.a n);
            let f = image.Global.target g;
            if image.Global.kind g == 0 && image.Func.arity (image.func cx.[:img] f) == list.length args {
                call_args cx (Demand.masks cx.[:strict]).[f else 0] args env (queue cx f s) (fn atoms _ s2 -> [Expr.call (symbol_of cx.[:unit] f) atoms, s2])
            } else { unknown () }
        },
        12 => {
            let object = image.node cx.[:img] (image.Node.a n);
            let g = image.global cx.[:img] (image.Node.a object);
            if image.Node.op object == 10 && image.Global.kind g == 1 {
                let module_ = image.import_path cx.[:img] (image.Global.target g);
                let member = image.string cx.[:img] (image.Node.b n);
                if module_ == "std.vm" && member == "host_members" {
                    let [table, s1] = intern_string (host_table cx) s;
                    lazies cx args env (St.set_needed_lib ((St.needed_lib s1).["host_members_in" => true]) s1)
                        (fn atoms _ s2 -> [Expr.call "@lib_host_members_in" (list.cons (Atom.address table) atoms), s2])
                } else { native_call cx module_ member args env s }
            } else { unknown () }
        },
        _ => unknown (),
    }
};

