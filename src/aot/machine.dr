// The core as LLVM IR: every function a `tailcc` function of six words, in registers.
//
//     (p, sp, a, b, c, d)
//
// `p` is the process, `sp` its stack, `a` an object's own address where it matters or
// a return's answer, and the rest the first three arguments. Further arguments stay
// on the stack, first on top. A `seq` pushes a frame holding exactly what comes after
// it needs, and what comes after becomes a function of its own, whose address the
// frame's info holds. So nothing compiled here ever makes a machine call to Dream: a
// process's whole state is `sp`, its stack is a heap-like thing the collector can read
// word by word, and a value's registers need no map because a collection happens only
// where registers have been saved as a frame, at a function's entry.

import std.list;
import std.map;
import std.str;

import dreams.aot.core;
import dreams.aot.dialect;
import dreams.aot.image;

/// What generation has so far. `pending` is what comes after each `seq`, waiting for
/// its own function.
group Gen {
    next : :integer,
    lines : [:string],
    label : :string,
    pending : [[:any]],
    data : [:string],
    code : [:string],
    place : :string,
    rt : %{:string => :string},
    names : %{:string => :string},
    conts : %{:integer => :integer},
    /// The block a `ret` branches to while an inner expression is compiled in line, or "".
    join : :string,
    /// Each such `ret` so far: `[block, word or "", double or ""]`.
    leaves : [[:string]],
    /// The functions with a worker taking doubles, and which of their parameters those are.
    workers : %{:string => [:integer]},
    /// Thunks made where they can be entered at most once, by the variable they are bound to,
    /// and the thunks that have such an entry (`once`).
    once_vars : :map,
    once_syms : :map,
    /// The count a function's own names are made from (`instr`, `label_of`), begun again for
    /// each function: `next` is the program's, and names its symbols.
    local : :integer,
    /// Each function body written so far, by its text, and the symbol it was written under.
    bodies : %{:string => :string},
    /// The pointer made of a word in this block, by the word (`pointer_at`): forgotten at the
    /// next block, where it might not have been made.
    ptrs : %{:string => :string},
    /// Whether functions are written in direct style (`function_d`), and there the block a
    /// failure goes to -- a `catching`'s handler -- or "" to answer 0 out of the function.
    direct : :bool,
    err : :string,
    arch : :integer,
    /// In direct style, whether something called so far in this function may have parked, after
    /// which the process may be running on another worker, and the context is read from the
    /// thread instead of `%p`; and the name it was read under in this block, or "" (`ctx_of`).
    moved : :bool,
    pcur : :string,
    /// In direct style, the `seq`s of the function bound more than once -- the core repeats one
    /// under each branch that reaches it -- each written once as a function of its own, by its
    /// variable, and those not written yet (`out_of_line`).
    dups : :map,
    dconts : :map,
    dpending : [[:any]],
}

let args_text : [:string] -> :string;
let args_text vals = str.join_str ", " (list.map (fn v -> "i64 " + v) vals);

// A line is made when it is emitted, and the counter moved when it is taken. Left to be made
// later, each line was a suspension of its pieces and of everything they were made from, and
// each `next` a suspension of the generator before it: the lines of a whole program, and
// every state the generator had been in, were live at once until the text was joined. dre's
// IR, 27 MB, held 980 MB; the compiler's ran past 12 GB.
let emit : :string -> Gen -> Gen;
let emit !text !g = lines_onto (list.cons text (Gen.lines g)) g;

let lines_onto : [:string] -> Gen -> Gen;
let lines_onto !lines g = Gen.set_lines lines g;

let instr : :string -> Gen -> [:string, Gen];
let instr text !g = named_instr (numbered "%v" (Gen.local g)) text g;

let named_instr : :string -> :string -> Gen -> [:string, Gen];
let named_instr !name text g = made name (emit (str.concat_all ["  ", name, " = ", text]) (moved g));

let label_of : :string -> Gen -> [:string, Gen];
let label_of stem !g = made (numbered stem (Gen.local g)) (moved g);

/// `stem` and `n`.
let numbered : :string -> :integer -> :string;
let numbered !stem !n = stem + to_string n;

/// A name and the generator after it, both made.
let made : :string -> Gen -> [:string, Gen];
let made !name !g = [name, g];

/// `g` with its function's counter moved on, the count made now.
let moved : Gen -> Gen;
let moved !g = local_at (Gen.local g + 1) g;

let local_at : :integer -> Gen -> Gen;
let local_at !n g = Gen.set_local n g;

let start : :string -> Gen -> Gen;
let start name g = Gen.set_label name (emit (name + ":") g) |> Gen.set_ptrs %{} |> Gen.set_pcur "";

/// The context, as a name this block may use: `%p`, until something has been called that may
/// have parked, and then the worker's own as the thread holds it -- the process may have been
/// resumed on another (dreams/docs/aot-direct.md, "Moving").
///
/// The context lives in a slot of the function's own (`%ctxs`, made in `header`): `%p` at entry,
/// and what the thread holds stored there after each call that may have parked
/// (`may_have_moved`). LLVM makes the slot a value of each block, so that where no such call was
/// made on the way -- a force whose slow path was not taken -- it is `%p`, and the heap pointer
/// in it may stay in a register across the join. Read from the thread in every block after a
/// call anywhere before, it was a load of the heap pointer through a pointer LLVM could not
/// tell was the same at each allocation.
let ctx_of : Gen -> [:string, Gen];
let ctx_of g = if not (Gen.moved g) { ["%p", g] } else if Gen.pcur g != "" { [Gen.pcur g, g] } else {
    let [v, g1] = instr "load i64, ptr %ctxs" g;
    [v, Gen.set_pcur v g1]
};

/// After a call that may have parked: the context read again from the thread, and kept in the
/// slot. On aarch64 a process in direct style stays on the worker it first ran on, and `%p`
/// stays good.
///
/// The read says it reads only memory nothing here can see, which is what the thread's slot
/// is: it changes only inside a call, and every call this code makes may write such memory.
/// Written as a side effect it was a write of all memory as far as LLVM knew, and a float
/// boxed and then read back on the other side of it was looked at again -- its info loaded
/// and tested -- where the store was in plain sight.
let may_have_moved : Gen -> Gen;
let may_have_moved g = if Gen.direct g && Gen.arch g != 1 {
    let [v, g1] = instr "call i64 asm \"movq %fs:0x70, $0\", \"=r\"() nounwind memory(inaccessiblemem: read)" g;
    emit (str.concat_all ["  store i64 ", v, ", ptr %ctxs"]) g1 |> Gen.set_moved true |> Gen.set_pcur v
} else { g };

/// The symbol of a function of the runtime.
let rt_symbol : Gen -> :string -> :string;
let rt_symbol g name = (Gen.rt g).[name];

let atom_text : :map -> core.Atom -> :string;
let atom_text env a = match a {
    core.Atom.var(i) => env.[i],
    core.Atom.word(w) => w,
    core.Atom.address(symbol) => str.concat_all ["ptrtoint (ptr ", symbol, " to i64)"],
};

let load_at : :string -> :integer -> Gen -> [:string, Gen];
let load_at base offset g = {
    let [pointer, g1] = pointer_at base offset g;
    instr ("load i64, ptr " + pointer) g1
};

let store_at : :string -> :integer -> :string -> Gen -> Gen;
let store_at base offset v g = {
    let [pointer, g1] = pointer_at base offset g;
    emit (str.concat_all ["  store i64 ", v, ", ptr ", pointer]) g1
};

// Most of what is read and written is a word off one of a function's own registers -- the
// context, the stack, the object in hand -- and each was an add, an `inttoptr` and the access,
// half the text of a program. The three are pointers once, at the entry (`header`), which comes
// before every block, and a word off one is a `getelementptr` and the access, or the access
// alone at offset 0.

/// The pointers a function's header makes of its registers, by the register.
let entry_pointers : %{:string => :string};
let entry_pointers = %{"%p" => "%pp", "%sp0" => "%spp", "%a" => "%ap"};

let ptrs_at : %{:string => :string} -> Gen -> Gen;
let ptrs_at !ptrs g = Gen.set_ptrs ptrs g;

/// `%sp0` moved past `bytes` of arguments, or `%sp0` itself.
let sp_past : :integer -> Gen -> [:string, Gen];
let sp_past bytes g = if bytes == 0 { ["%sp0", g] } else { instr (str.concat_all ["add i64 %sp0, ", to_string bytes]) g };

/// A pointer to the word `offset` bytes past `base`.
let pointer_at : :string -> :integer -> Gen -> [:string, Gen];
let pointer_at base offset g = {
    let [start, g1] = match map.lookup base entry_pointers {
        Option.some(made) => [made, g],
        Option.none => match map.lookup base (Gen.ptrs g) {
            Option.some(made) => [made, g],
            Option.none => {
                let [made, h] = instr (str.concat_all ["inttoptr i64 ", base, " to ptr"]) g;
                [made, ptrs_at ((Gen.ptrs h).[base => made]) h]
            },
        },
    };
    if offset == 0 { [start, g1] }
    else { instr (str.concat_all ["getelementptr i8, ptr ", start, ", i64 ", to_string offset]) g1 }
};

let jump : :string -> [:string] -> Gen -> Gen;
let jump target args g = {
    let [r, g1] = instr (str.concat_all ["musttail call tailcc i64 ", target, "(", args_text args, ")"]) g;
    emit ("  ret i64 " + r) g1
};

/// Answer `v` to the frame on top of the stack.
let answer : :string -> :string -> Gen -> Gen;
let answer sp v g = {
    let [info, g1] = load_at sp 0 g;
    let [code, g2] = load_at info 0 g1;
    let [target, g3] = instr (str.concat_all ["inttoptr i64 ", code, " to ptr"]) g2;
    jump target ["%p", sp, v, "0", "0", "0"] g3
};

/// `count` words of stack, answering where they begin. A stack overflow is the guard
/// below the mapping; a limit with a message is for when processes get their own.
let reserve : :string -> :integer -> Gen -> [:string, Gen];
let reserve sp count g = instr (str.concat_all ["sub i64 ", sp, ", ", to_string (8 * count)]) g;

/// A word's `i1` test as Dream's `true` or `false`.
let as_bool : :string -> Gen -> [:string, Gen];
let as_bool bit g = instr (str.concat_all ["select i1 ", bit, ", i64 ", core.true_word, ", i64 ", core.false_word]) g;

let call_rt : Gen -> :string -> [:string] -> Gen -> [:string, Gen];
let call_rt names name args g = instr (str.concat_all ["call tailcc i64 ", rt_symbol names name, "(", args_text args, ")"]) g;

/// `v == 0` goes to a block that raises; anything else goes on. What it raises is the
/// runtime's to say, since a native has no business knowing where the stack is.
let raise_if_zero : :string -> :string -> Gen -> Gen;
let raise_if_zero sp v g = if Gen.direct g { or_failing v g } else {
    let [bad, g1] = instr (str.concat_all ["icmp eq i64 ", v, ", 0"]) g;
    let [raises, g2] = label_of "raises" g1;
    let [fine, g3] = label_of "fine" g2;
    let g4 = emit (str.concat_all ["  br i1 ", bad, ", label %", raises, ", label %", fine]) g3;
    let g5 = start raises g4;
    let g6 = jump (rt_symbol g5 "native_failed!") ["%p", sp, "0", "0", "0", "0"] g5;
    start fine g6
};

/// Which runtime function takes each operation that is not two fixnums.
let slow_name : :string -> :string;
let slow_name op = op + "_slow!";

/// A checked operation on words, answering its value and the bit that says it fit.
let checked : :string -> :string -> :string -> Gen -> [:string, :string, Gen];
let checked intrinsic a b g = {
    let [pair, g1] = instr (str.concat_all ["call { i64, i1 } @llvm.", intrinsic, ".with.overflow.i64(i64 ", a, ", i64 ", b, ")"]) g;
    let [v, g2] = instr (str.concat_all ["extractvalue { i64, i1 } ", pair, ", 0"]) g1;
    let [over, g3] = instr (str.concat_all ["extractvalue { i64, i1 } ", pair, ", 1"]) g2;
    [v, over, g3]
};

/// `op` on two fixnums, or the slow path for anything else, overflow included. On
/// the tagged words `2a+1` and `2b+1`, so that a sum needs no untagging: taking one
/// tag off leaves the tagged answer.
// What a fast path's rare way out calls. An ordinary call there would make the whole function
// save the callee-saved registers on entry, every time, for the sake of the path not taken; a
// call that preserves them costs only the one who takes it, and a tail-called function that
// saves nothing is what a loop wants to be.
let cold_names : [:string];
let cold_names = ["alloc!", "add_slow!", "sub_slow!", "mul_slow!", "div_slow!", "mod_slow!",
                  "eq_slow!", "ne_slow!", "lt_slow!", "le_slow!", "gt_slow!", "ge_slow!", "to_float!", "remember_value!"];

let cold_symbol : :string -> :string;
let cold_symbol name = str.concat_all ["@cold_", str.replace "!" "" name];

let cold_text : :map -> :string;
let cold_text symbols = str.concat_all (list.map (fn name -> str.concat_all [
    "define internal preserve_mostcc i64 ", cold_symbol name, "(i64 %p, i64 %a, i64 %b) noinline cold {\n",
    if name == "alloc!" || name == "to_float!" {
        str.concat_all ["  %v = call tailcc i64 ", symbols.[name], "(i64 %p, i64 %a)\n"]
    } else {
        str.concat_all ["  %v = call tailcc i64 ", symbols.[name], "(i64 %p, i64 %a, i64 %b)\n"]
    },
    "  ret i64 %v\n}\n"]) cold_names);

/// Allocation, in line: a call for this was a tenth of a run. Only the end of the chunk is the
/// runtime's. 0 and 8 are `ctx_hp` and `ctx_limit` in `rt/main.dr`.
let bump_alloc : :integer -> Gen -> [:string, Gen];
let bump_alloc bytes g0 = {
    let [ctx, g] = ctx_of g0;
    let [hp, g1] = load_at ctx 0 g;
    let [next, g2] = instr (str.concat_all ["add i64 ", hp, ", ", to_string bytes]) g1;
    let [limit, g3] = load_at ctx 8 g2;
    let [over, g4] = instr (str.concat_all ["icmp ugt i64 ", next, ", ", limit]) g3;
    let [fits, g5] = label_of "fits" g4;
    let [more, g6] = label_of "more" g5;
    let [done, g7] = label_of "got" g6;
    let g8 = start fits (emit (str.concat_all ["  br i1 ", over, ", label %", more, ", label %", fits]) g7);
    let g9 = store_at ctx 0 next g8;
    let g10 = start more (emit ("  br label %" + done) g9);
    let [slow, g11] = instr (str.concat_all ["call preserve_mostcc i64 ", cold_symbol "alloc!", "(i64 ", ctx, ", i64 ", to_string bytes, ", i64 0)"]) g10;
    let g12 = start done (emit ("  br label %" + done) g11);
    instr (str.concat_all ["phi i64 [ ", hp, ", %", fits, " ], [ ", slow, ", %", more, " ]"]) g12
};

/// A small result now, or the suspension if either operand is not a small integer or the result
/// would not be one: which of those it was must not be seen, so nothing here raises.
let speculated : :string -> :string -> :string -> :string -> [:string] -> Gen -> [:string, Gen];
let speculated op a b symbol payload g = {
    let [both, g1] = instr (str.concat_all ["and i64 ", a, ", ", b]) g;
    let [tag, g2] = instr (str.concat_all ["and i64 ", both, ", 1"]) g1;
    let [fix, g3] = instr (str.concat_all ["icmp eq i64 ", tag, ", 1"]) g2;
    let [fast, g4] = label_of "now" g3;
    let [slow, g5] = label_of "later" g4;
    let [done, g6] = label_of "spec" g5;
    let g7 = start fast (emit (str.concat_all ["  br i1 ", fix, ", label %", fast, ", label %", slow]) g6);
    let [untagged_b, g8] = instr (str.concat_all ["sub i64 ", b, ", 1"]) g7;
    let [v, g9, from_fast] = match op {
        "add" => spec_checked "sadd" a untagged_b done slow g8,
        "sub" => spec_checked "ssub" a untagged_b done slow g8,
        "mul" => {
            let [half, h1] = instr (str.concat_all ["ashr i64 ", a, ", 1"]) g8;
            let [product, bit, h2] = checked "smul" half untagged_b h1;
            let [tagged, h3] = instr (str.concat_all ["or i64 ", product, ", 1"]) h2;
            let at = Gen.label h3;
            [tagged, emit (str.concat_all ["  br i1 ", bit, ", label %", slow, ", label %", done]) h3, at]
        },
        _ => {
            let condition = %{"eq" => "eq", "ne" => "ne", "lt" => "slt", "le" => "sle", "gt" => "sgt", "ge" => "sge"}.[op];
            let [bit, h1] = instr (str.concat_all ["icmp ", condition, " i64 ", a, ", ", b]) g8;
            let [word, h2] = as_bool bit h1;
            let at = Gen.label h2;
            [word, emit ("  br label %" + done) h2, at]
        },
    };
    let g10 = start slow g9;
    let [o, g11] = bump_alloc (8 * (1 + list.length payload)) g10;
    let g12 = store_at o 0 (str.concat_all ["ptrtoint (ptr ", info_symbol symbol, " to i64)"]) g11;
    let g13 = list.fold (fn st [i, x] -> store_at o (8 * (i + 1)) x st) g12 (list.enumerate payload);
    let from_slow = Gen.label g13;
    let g14 = start done (emit ("  br label %" + done) g13);
    instr (str.concat_all ["phi i64 [ ", v, ", %", from_fast, " ], [ ", o, ", %", from_slow, " ]"]) g14
};

// --- cheap trees, done now -------------------------------------------------------------------
//
// `Rhs.eager` (core.dr): arithmetic on words that may not be numbers yet, done now when they are.
// Each node is a pair, whether it is a double and its 64 bits -- an integer untagged, or the
// double's bits -- so that integers stay exact and a float anywhere below an operation makes it
// one in doubles, as `+` on the two does. Anything that is not a number where one is read, a
// field read off what is not a record, an integer that leaves the fixnums: the suspension is made
// instead, as it would have been.

/// `tree` now, or its suspension `symbol` holding `payload`.
let eagerly : core.Cheap -> :map -> :string -> [:string] -> Gen -> [:string, Gen];
let eagerly tree env symbol payload g = eager_tree tree env symbol payload "" g;

/// The same, evaluated: the suspension made where the tree could not be done now is forced
/// there, on stack `sp`.
let eagerly_then : core.Cheap -> :map -> :string -> [:string] -> :string -> Gen -> [:string, Gen];
let eagerly_then tree env symbol payload sp g = eager_tree tree env symbol payload sp g;

let eager_tree : core.Cheap -> :map -> :string -> [:string] -> :string -> Gen -> [:string, Gen];
let eager_tree tree env symbol payload force_on g = {
    let [later, g0] = label_of "later" g;
    let [done, g00] = label_of "eager" g0;
    // First the case a typed program is made of: every leaf a float, or a field of a record of
    // them, and then nothing but double arithmetic, with no integer twin to choose against.
    // Anything else goes on to the general case below, which is what it always was.
    let [general, gf] = label_of "general" g00;
    let [fast_word, gf1] = if has_integer_literal tree { ["", gf] } else { all_doubles tree env general gf };
    let from_fast = Gen.label gf1;
    let g1 = if fast_word == "" { gf1 } else { start general (emit ("  br label %" + done) gf1) };
    let g2 = g1;
    let [root, g3] = match tree {
        core.Cheap.op(name, l, r) if cheap_comparison name => {
            let [dl, bl, h1] = cheap_pair l env later g2;
            let [dr, br, h2] = cheap_pair r env later h1;
            let [any, h3] = instr (str.concat_all ["or i1 ", dl, ", ", dr]) h2;
            let [fl, h4] = as_double dl bl h3;
            let [fr, h5] = as_double dr br h4;
            let fcond = %{"eq" => "oeq", "ne" => "une", "lt" => "olt", "le" => "ole", "gt" => "ogt", "ge" => "oge"}.[name];
            let icond = %{"eq" => "eq", "ne" => "ne", "lt" => "slt", "le" => "sle", "gt" => "sgt", "ge" => "sge"}.[name];
            let [fbit, h6] = instr (str.concat_all ["fcmp ", fcond, " double ", fl, ", ", fr]) h5;
            let [ibit, h7] = instr (str.concat_all ["icmp ", icond, " i64 ", bl, ", ", br]) h6;
            let [bit, h8] = instr (str.concat_all ["select i1 ", any, ", i1 ", fbit, ", i1 ", ibit]) h7;
            as_bool bit h8
        },
        _ => {
            let [d, bits, h1] = cheap_pair tree env later g2;
            let [boxed, h2] = label_of "boxed" h1;
            let [tagged, h3] = label_of "tagged" h2;
            let [joined, h4] = label_of "number" h3;
            let h5 = start boxed (emit (str.concat_all ["  br i1 ", d, ", label %", boxed, ", label %", tagged]) h4);
            let [o, h6] = bump_alloc 16 h5;
            let h7 = store_at o 8 bits (store_at o 0 "ptrtoint (ptr @i_float to i64)" h6);
            let from_box = Gen.label h7;
            let h8 = start tagged (emit ("  br label %" + joined) h7);
            let [twice, h9] = instr (str.concat_all ["shl i64 ", bits, ", 1"]) h8;
            let [word, h10] = instr (str.concat_all ["or i64 ", twice, ", 1"]) h9;
            let from_tag = Gen.label h10;
            let h11 = start joined (emit ("  br label %" + joined) h10);
            instr (str.concat_all ["phi i64 [ ", o, ", %", from_box, " ], [ ", word, ", %", from_tag, " ]"]) h11
        },
    };
    let from_now = Gen.label g3;
    let g4 = start later (emit ("  br label %" + done) g3);
    let [t, g5] = bump_alloc (8 * (1 + list.length payload)) g4;
    let g6 = store_at t 0 (str.concat_all ["ptrtoint (ptr ", info_symbol symbol, " to i64)"]) g5;
    let g7 = list.fold (fn st [i, x] -> store_at t (8 * (i + 1)) x st) g6 (list.enumerate payload);
    let [later_v, g7b] = if force_on == "" { [t, g7] } else { forced t force_on g7 };
    let from_later = Gen.label g7b;
    let g8 = start done (emit ("  br label %" + done) g7b);
    let fast_in = if fast_word == "" { "" } else { str.concat_all [", [ ", fast_word, ", %", from_fast, " ]"] };
    instr (str.concat_all ["phi i64 [ ", root, ", %", from_now, " ], [ ", later_v, ", %", from_later, " ]", fast_in]) g8
};

/// Whether a leaf of the tree is an integer written in it, which makes the general case the
/// only one: `n * 2` on an integer stays one.
let has_integer_literal : core.Cheap -> :bool;
let has_integer_literal t = match t {
    core.Cheap.leaf(core.Atom.word(_)) => true,
    core.Cheap.leaf(_) => false,
    core.Cheap.field(_, _) => false,
    core.Cheap.op(_, l, r) => has_integer_literal l || has_integer_literal r,
};

/// The tree in doubles, answering its word -- a float boxed, or a boolean -- or going to
/// `general` at the first leaf that is not a double.
let all_doubles : core.Cheap -> :map -> :string -> Gen -> [:string, Gen];
let all_doubles tree env general g = match tree {
    core.Cheap.op(name, l, r) if cheap_comparison name => {
        let [fl, g1] = leaf_double l env general g;
        let [fr, g2] = leaf_double r env general g1;
        let fcond = %{"eq" => "oeq", "ne" => "une", "lt" => "olt", "le" => "ole", "gt" => "ogt", "ge" => "oge"}.[name];
        let [bit, g3] = instr (str.concat_all ["fcmp ", fcond, " double ", fl, ", ", fr]) g2;
        as_bool bit g3
    },
    _ => {
        let [d, g1] = leaf_double tree env general g;
        let [bits, g2] = instr (str.concat_all ["bitcast double ", d, " to i64"]) g1;
        let [o, g3] = bump_alloc 16 g2;
        [o, store_at o 8 bits (store_at o 0 "ptrtoint (ptr @i_float to i64)" g3)]
    },
};

/// A node as a double, or to `general`.
let leaf_double : core.Cheap -> :map -> :string -> Gen -> [:string, Gen];
let leaf_double t env general g = match t {
    core.Cheap.leaf(a) => {
        let [bits, g1] = float_bits_or (atom_text env a) general g;
        instr (str.concat_all ["bitcast i64 ", bits, " to double"]) g1
    },
    core.Cheap.field(a, index) => {
        let v = atom_text env a;
        let [low, g1] = instr (str.concat_all ["and i64 ", v, ", 7"]) g;
        let [object, g2] = instr (str.concat_all ["icmp eq i64 ", low, ", 0"]) g1;
        let [some, g3] = instr (str.concat_all ["icmp ne i64 ", v, ", 0"]) g2;
        let [both, g4] = instr (str.concat_all ["and i1 ", object, ", ", some]) g3;
        let [is_obj, g5] = label_of "dobj" g4;
        let g6 = start is_obj (emit (str.concat_all ["  br i1 ", both, ", label %", is_obj, ", label %", general]) g5);
        let [info, g7] = load_at v 0 g6;
        let [kind, g8] = load_at info 8 g7;
        let [count, g9] = load_at v 8 g8;
        let [inside, g10] = instr (str.concat_all ["icmp sgt i64 ", count, ", ", to_string (2 * index + 1)]) g9;
        let [raw, g11] = instr (str.concat_all ["icmp eq i64 ", kind, ", 18"]) g10;
        let [raw_in, g12] = instr (str.concat_all ["and i1 ", raw, ", ", inside]) g11;
        let [raw_l, g13] = label_of "drawf" g12;
        let [boxed_l, g14] = label_of "dboxf" g13;
        let [joined, g15] = label_of "dfield" g14;
        let g16 = start raw_l (emit (str.concat_all ["  br i1 ", raw_in, ", label %", raw_l, ", label %", boxed_l]) g15);
        let [raw_bits, g17] = load_at v (8 * (3 + index)) g16;
        let from_raw = Gen.label g17;
        let g18 = start boxed_l (emit ("  br label %" + joined) g17);
        let [record, g19] = instr (str.concat_all ["icmp eq i64 ", kind, ", 9"]) g18;
        let [fits, g20] = instr (str.concat_all ["and i1 ", record, ", ", inside]) g19;
        let [read, g21] = label_of "dread" g20;
        let g22 = start read (emit (str.concat_all ["  br i1 ", fits, ", label %", read, ", label %", general]) g21);
        let [field, g23] = load_at v (8 * (3 + index)) g22;
        let [boxed_bits, g24] = float_bits_or field general g23;
        let from_boxed = Gen.label g24;
        let g25 = start joined (emit ("  br label %" + joined) g24);
        let [bits, g26] = instr (str.concat_all ["phi i64 [ ", raw_bits, ", %", from_raw, " ], [ ", boxed_bits, ", %", from_boxed, " ]"]) g25;
        instr (str.concat_all ["bitcast i64 ", bits, " to double"]) g26
    },
    core.Cheap.op(name, l, r) => {
        let [fl, g1] = leaf_double l env general g;
        let [fr, g2] = leaf_double r env general g1;
        instr (str.concat_all [%{"add" => "fadd", "sub" => "fsub", "mul" => "fmul"}.[name], " double ", fl, ", ", fr]) g2
    },
};

/// A float's bits, looking through an indirection, or to `general` for anything else.
let float_bits_or : :string -> :string -> Gen -> [:string, Gen];
let float_bits_or v0 general g0 = {
    let [v, g] = past_indirection v0 g0;
    let [low, g1] = instr (str.concat_all ["and i64 ", v, ", 7"]) g;
    let [aligned, g2] = instr (str.concat_all ["icmp eq i64 ", low, ", 0"]) g1;
    let [some, g3] = instr (str.concat_all ["icmp ne i64 ", v, ", 0"]) g2;
    let [object, g4] = instr (str.concat_all ["and i1 ", aligned, ", ", some]) g3;
    let [look, g5] = label_of "fl" g4;
    let g6 = start look (emit (str.concat_all ["  br i1 ", object, ", label %", look, ", label %", general]) g5);
    let [info, g7] = load_at v 0 g6;
    let [is_float, g8] = instr (str.concat_all ["icmp eq i64 ", info, ", ptrtoint (ptr @i_float to i64)"]) g7;
    let [read, g9] = label_of "fb" g8;
    let g10 = start read (emit (str.concat_all ["  br i1 ", is_float, ", label %", read, ", label %", general]) g9);
    load_at v 8 g10
};

let cheap_comparison : :string -> :bool;
let cheap_comparison name = name == "eq" || name == "ne" || name == "lt" || name == "le" || name == "gt" || name == "ge";

/// A node as `[is a double, bits]`, going to `later` where it cannot be had now.
let cheap_pair : core.Cheap -> :map -> :string -> Gen -> [:string, :string, Gen];
let cheap_pair t env later g = match t {
    core.Cheap.leaf(a) => number_pair (atom_text env a) later g,
    core.Cheap.field(a, index) => {
        let v = atom_text env a;
        let [low, g1] = instr (str.concat_all ["and i64 ", v, ", 7"]) g;
        let [object, g2] = instr (str.concat_all ["icmp eq i64 ", low, ", 0"]) g1;
        let [some, g3] = instr (str.concat_all ["icmp ne i64 ", v, ", 0"]) g2;
        let [both, g4] = instr (str.concat_all ["and i1 ", object, ", ", some]) g3;
        let [is_obj, g5] = label_of "obj" g4;
        let g6 = start is_obj (emit (str.concat_all ["  br i1 ", both, ", label %", is_obj, ", label %", later]) g5);
        let [info, g7] = load_at v 0 g6;
        let [kind, g8] = load_at info 8 g7;
        let [record, g9] = instr (str.concat_all ["icmp eq i64 ", kind, ", 9"]) g8;
        let [count, g10] = load_at v 8 g9;
        // The count is a fixnum: `index` is inside when it is below the count's word.
        let [inside, g11] = instr (str.concat_all ["icmp sgt i64 ", count, ", ", to_string (2 * index + 1)]) g10;
        // A record of floats holds their bits (kind 18, `record_raw!` in rt/main.dr): the field is
        // a double as it lies, with nothing to look through.
        let [raw, g12] = instr (str.concat_all ["icmp eq i64 ", kind, ", 18"]) g11;
        let [raw_in, g13] = instr (str.concat_all ["and i1 ", raw, ", ", inside]) g12;
        let [bits_l, g14] = label_of "rawf" g13;
        let [boxed_l, g15] = label_of "boxf" g14;
        let [joined, g16] = label_of "fieldv" g15;
        let g17 = start bits_l (emit (str.concat_all ["  br i1 ", raw_in, ", label %", bits_l, ", label %", boxed_l]) g16);
        let [bits, g18] = load_at v (8 * (3 + index)) g17;
        let from_bits = Gen.label g18;
        let g19 = start boxed_l (emit ("  br label %" + joined) g18);
        let [fits, g20] = instr (str.concat_all ["and i1 ", record, ", ", inside]) g19;
        let [read, g21] = label_of "field" g20;
        let g22 = start read (emit (str.concat_all ["  br i1 ", fits, ", label %", read, ", label %", later]) g21);
        let [field, g23] = load_at v (8 * (3 + index)) g22;
        let [d, b, g24] = number_pair field later g23;
        let from_boxed = Gen.label g24;
        let g25 = start joined (emit ("  br label %" + joined) g24);
        let [d2, g26] = instr (str.concat_all ["phi i1 [ true, %", from_bits, " ], [ ", d, ", %", from_boxed, " ]"]) g25;
        let [b2, g27] = instr (str.concat_all ["phi i64 [ ", bits, ", %", from_bits, " ], [ ", b, ", %", from_boxed, " ]"]) g26;
        [d2, b2, g27]
    },
    core.Cheap.op(name, l, r) => {
        let [dl, bl, g1] = cheap_pair l env later g;
        let [dr, br, g2] = cheap_pair r env later g1;
        let [any, g3] = instr (str.concat_all ["or i1 ", dl, ", ", dr]) g2;
        // In doubles, as the operation on a float does.
        let [fl, g4] = as_double dl bl g3;
        let [fr, g5] = as_double dr br g4;
        let [fv, g6] = instr (str.concat_all [%{"add" => "fadd", "sub" => "fsub", "mul" => "fmul"}.[name], " double ", fl, ", ", fr]) g5;
        let [fbits, g7] = instr (str.concat_all ["bitcast double ", fv, " to i64"]) g6;
        // In integers, exactly, and only while they stay fixnums.
        let [iv, over, g8] = checked (%{"add" => "sadd", "sub" => "ssub", "mul" => "smul"}.[name]) bl br g7;
        let [twice, g9] = instr (str.concat_all ["shl i64 ", iv, ", 1"]) g8;
        let [back, g10] = instr (str.concat_all ["ashr i64 ", twice, ", 1"]) g9;
        let [lost, g11] = instr (str.concat_all ["icmp ne i64 ", back, ", ", iv]) g10;
        let [bad_int, g12] = instr (str.concat_all ["or i1 ", over, ", ", lost]) g11;
        let [not_any, g13] = instr (str.concat_all ["xor i1 ", any, ", true"]) g12;
        let [fails, g14] = instr (str.concat_all ["and i1 ", not_any, ", ", bad_int]) g13;
        let [ok, g15] = label_of "fit" g14;
        let g16 = start ok (emit (str.concat_all ["  br i1 ", fails, ", label %", later, ", label %", ok]) g15);
        let [bits, g17] = instr (str.concat_all ["select i1 ", any, ", i64 ", fbits, ", i64 ", iv]) g16;
        [any, bits, g17]
    },
};

/// A word as `[is a double, bits]`: a fixnum untagged, a float's bits, and anything else -- a
/// suspension, a big integer, not a number -- to `later`.
let number_pair : :string -> :string -> Gen -> [:string, :string, Gen];
let number_pair v0 later g0 = {
    let [v, g] = past_indirection v0 g0;
    let [low, g1] = instr (str.concat_all ["and i64 ", v, ", 1"]) g;
    let [fix, g2] = instr (str.concat_all ["icmp eq i64 ", low, ", 1"]) g1;
    let [untagged, g3] = instr (str.concat_all ["ashr i64 ", v, ", 1"]) g2;
    let [obj, g4] = label_of "boxed" g3;
    let [done, g5] = label_of "num" g4;
    let from_fix = Gen.label g5;
    let g6 = start obj (emit (str.concat_all ["  br i1 ", fix, ", label %", done, ", label %", obj]) g5);
    let [low3, g7] = instr (str.concat_all ["and i64 ", v, ", 7"]) g6;
    let [aligned, g8] = instr (str.concat_all ["icmp eq i64 ", low3, ", 0"]) g7;
    let [some, g9] = instr (str.concat_all ["icmp ne i64 ", v, ", 0"]) g8;
    let [object, g10] = instr (str.concat_all ["and i1 ", aligned, ", ", some]) g9;
    let [look, g11] = label_of "look" g10;
    let g12 = start look (emit (str.concat_all ["  br i1 ", object, ", label %", look, ", label %", later]) g11);
    let [info, g13] = load_at v 0 g12;
    let [kind, g14] = load_at info 8 g13;
    let [float, g15] = instr (str.concat_all ["icmp eq i64 ", kind, ", 6"]) g14;
    let [read, g16] = label_of "dbl" g15;
    let g17 = start read (emit (str.concat_all ["  br i1 ", float, ", label %", read, ", label %", later]) g16);
    let [bits, g18] = load_at v 8 g17;
    let from_float = Gen.label g18;
    let g19 = start done (emit ("  br label %" + done) g18);
    let [d, g20] = instr (str.concat_all ["phi i1 [ false, %", from_fix, " ], [ true, %", from_float, " ]"]) g19;
    let [b, g21] = instr (str.concat_all ["phi i64 [ ", untagged, ", %", from_fix, " ], [ ", bits, ", %", from_float, " ]"]) g20;
    [d, b, g21]
};

/// `v`, or what it points to if it is an indirection: a suspension evaluated where it was is one,
/// and a field of a record made lazily is one after its first reading.
let past_indirection : :string -> Gen -> [:string, Gen];
let past_indirection v g = {
    let [low3, g1] = instr (str.concat_all ["and i64 ", v, ", 7"]) g;
    let [aligned, g2] = instr (str.concat_all ["icmp eq i64 ", low3, ", 0"]) g1;
    let [some, g3] = instr (str.concat_all ["icmp ne i64 ", v, ", 0"]) g2;
    let [object, g4] = instr (str.concat_all ["and i1 ", aligned, ", ", some]) g3;
    let [look, g5] = label_of "ind" g4;
    let [done, g6] = label_of "past" g5;
    let from_start = Gen.label g6;
    let g7 = start look (emit (str.concat_all ["  br i1 ", object, ", label %", look, ", label %", done]) g6);
    let [info, g8] = load_at v 0 g7;
    let [kind, g9] = load_at info 8 g8;
    let [is_ind, g10] = instr (str.concat_all ["icmp eq i64 ", kind, ", 1"]) g9;
    let [target, g11] = load_at v 8 g10;
    let [w, g12] = instr (str.concat_all ["select i1 ", is_ind, ", i64 ", target, ", i64 ", v]) g11;
    let from_look = Gen.label g12;
    let g13 = start done (emit ("  br label %" + done) g12);
    instr (str.concat_all ["phi i64 [ ", v, ", %", from_start, " ], [ ", w, ", %", from_look, " ]"]) g13
};

/// Bits as a double: a float's own, or an integer's value.
let as_double : :string -> :string -> Gen -> [:string, Gen];
let as_double is_double bits g = {
    let [f, g1] = instr (str.concat_all ["bitcast i64 ", bits, " to double"]) g;
    let [i, g2] = instr (str.concat_all ["sitofp i64 ", bits, " to double"]) g1;
    instr (str.concat_all ["select i1 ", is_double, ", double ", f, ", double ", i]) g2
};

let spec_checked : :string -> :string -> :string -> :string -> :string -> Gen -> [:string, Gen, :string];
let spec_checked name a b done slow g = {
    let [v, bit, g1] = checked name a b g;
    let at = Gen.label g1;
    [v, emit (str.concat_all ["  br i1 ", bit, ", label %", slow, ", label %", done]) g1, at]
};

let tagged_arith : :string -> :string -> :string -> :string -> Gen -> [:string, Gen];
let tagged_arith sp op a b g = {
    let [both, g1] = instr (str.concat_all ["and i64 ", a, ", ", b]) g;
    let [tag, g2] = instr (str.concat_all ["and i64 ", both, ", 1"]) g1;
    let [fix, g3] = instr (str.concat_all ["icmp eq i64 ", tag, ", 1"]) g2;
    let [fast, g4] = label_of "fast" g3;
    let [slow, g5] = label_of "slow" g4;
    let [done, g6] = label_of "done" g5;
    let g7 = start fast (emit (str.concat_all ["  br i1 ", fix, ", label %", fast, ", label %", slow]) g6);
    let [untagged_b, g8] = instr (str.concat_all ["sub i64 ", b, ", 1"]) g7;
    let [v, over, g9] = match op {
        "add" => checked "sadd" a untagged_b g8,
        "sub" => checked "ssub" a untagged_b g8,
        "mul" => {
            let [half, h1] = instr (str.concat_all ["ashr i64 ", a, ", 1"]) g8;
            let [product, bit, h2] = checked "smul" half untagged_b h1;
            let [tagged, h3] = instr (str.concat_all ["or i64 ", product, ", 1"]) h2;
            [tagged, bit, h3]
        },
        _ => {
            // By zero, and the one quotient that does not fit, are the slow path's.
            let [x, h1] = instr (str.concat_all ["ashr i64 ", a, ", 1"]) g8;
            let [y, h2] = instr (str.concat_all ["ashr i64 ", b, ", 1"]) h1;
            let [zero, h3] = instr (str.concat_all ["icmp eq i64 ", y, ", 0"]) h2;
            let [minus, h4] = instr (str.concat_all ["icmp eq i64 ", y, ", -1"]) h3;
            let [unsafe, h5] = instr (str.concat_all ["or i1 ", zero, ", ", minus]) h4;
            let [safe_y, h6] = instr (str.concat_all ["select i1 ", unsafe, ", i64 1, i64 ", y]) h5;
            let [q, h7] = instr (str.concat_all [if op == "div" { "sdiv" } else { "srem" }, " i64 ", x, ", ", safe_y]) h6;
            let [doubled, h8] = instr (str.concat_all ["shl i64 ", q, ", 1"]) h7;
            let [tagged, h9] = instr (str.concat_all ["or i64 ", doubled, ", 1"]) h8;
            [tagged, unsafe, h9]
        },
    };
    let from_fast = Gen.label g9;
    let g10 = emit (str.concat_all ["  br i1 ", over, ", label %", slow, ", label %", done]) g9;
    let g11 = start slow g10;
    // Two floats are the next most likely thing, and need no call. A literal operand is an
    // integer, and then they are not.
    let may_be_floats = op != "mod" && str.starts_with "%" a && str.starts_with "%" b;
    let [cold, g11a] = label_of "cold" g11;
    let [floated, g11b] = if may_be_floats { both_floats op a b cold done g11a } else { [[], emit ("  br label %" + cold) g11a] };
    let g11c = start cold g11b;
    let [ctx, g11d] = ctx_of g11c;
    let [s, g12] = instr (str.concat_all ["call preserve_mostcc i64 ", cold_symbol (slow_name op), "(i64 ", ctx, ", i64 ", a, ", i64 ", b, ")"]) g11d;
    let g13 = raise_if_zero sp s g12;
    let from_slow = Gen.label g13;
    let g14 = start done (emit ("  br label %" + done) g13);
    let from_float = match floated { [word, at] => str.concat_all [" [ ", word, ", %", at, " ],"], _ => "" };
    instr (str.concat_all ["phi i64 [ ", v, ", %", from_fast, " ],", from_float, " [ ", s, ", %", from_slow, " ]"]) g14
};

/// The float path of an operation: answers its boxed result and the block it comes from.
let both_floats : :string -> :string -> :string -> :string -> :string -> Gen -> [[:string], Gen];
let both_floats op a b cold done g = {
    let [either, g1] = instr (str.concat_all ["or i64 ", a, ", ", b]) g;
    let [low, g2] = instr (str.concat_all ["and i64 ", either, ", 7"]) g1;
    let [objects, g3] = instr (str.concat_all ["icmp eq i64 ", low, ", 0"]) g2;
    let [check, g4] = label_of "objects" g3;
    let [flt, g5] = label_of "floats" g4;
    let g6 = start check (emit (str.concat_all ["  br i1 ", objects, ", label %", check, ", label %", cold]) g5);
    let [ia, g7] = load_at a 0 g6;
    let [ib, g8] = load_at b 0 g7;
    let [xa, g9] = instr (str.concat_all ["icmp eq i64 ", ia, ", ptrtoint (ptr @i_float to i64)"]) g8;
    let [xb, g10] = instr (str.concat_all ["icmp eq i64 ", ib, ", ptrtoint (ptr @i_float to i64)"]) g9;
    let [both, g11] = instr (str.concat_all ["and i1 ", xa, ", ", xb]) g10;
    let g12 = start flt (emit (str.concat_all ["  br i1 ", both, ", label %", flt, ", label %", cold]) g11);
    let [ba, g13] = load_at a 8 g12;
    let [bb, g14] = load_at b 8 g13;
    let [da, g15] = instr (str.concat_all ["bitcast i64 ", ba, " to double"]) g14;
    let [db, g16] = instr (str.concat_all ["bitcast i64 ", bb, " to double"]) g15;
    let [d, g17] = instr (str.concat_all [float_op op, " double ", da, ", ", db]) g16;
    let [o, g18] = boxed_float d g17;
    let at = Gen.label g18;
    [[o, at], emit ("  br label %" + done) g18]
};

/// A comparison. Words with no object in them compare as words; anything with one
/// goes to the runtime, which knows strings and floats and answers a word, or a thunk
/// of the library's walk.
let tagged_compare : :string -> :string -> :string -> :string -> Gen -> [:string, Gen];
let tagged_compare sp op a b g = {
    let condition = %{"eq" => "eq", "ne" => "ne", "lt" => "slt", "le" => "sle", "gt" => "sgt", "ge" => "sge"}.[op];
    let is_eq = op == "eq" || op == "ne";
    let [fast, g2] = if is_eq {
        // An object is any word whose low three bits are clear, and only then is
        // comparing the words not the answer.
        let [left, h1] = instr (str.concat_all ["and i64 ", a, ", 7"]) g;
        let [right, h2] = instr (str.concat_all ["and i64 ", b, ", 7"]) h1;
        let [l0, h3] = instr (str.concat_all ["icmp ne i64 ", left, ", 0"]) h2;
        let [r0, h4] = instr (str.concat_all ["icmp ne i64 ", right, ", 0"]) h3;
        instr (str.concat_all ["and i1 ", l0, ", ", r0]) h4
    } else {
        let [both, h1] = instr (str.concat_all ["and i64 ", a, ", ", b]) g;
        let [tag, h2] = instr (str.concat_all ["and i64 ", both, ", 1"]) h1;
        instr (str.concat_all ["icmp eq i64 ", tag, ", 1"]) h2
    };
    let [quick, g3] = label_of "quick" g2;
    let [slow, g4] = label_of "slow" g3;
    let [done, g5] = label_of "done" g4;
    let g6 = start quick (emit (str.concat_all ["  br i1 ", fast, ", label %", quick, ", label %", slow]) g5);
    let [bit, g7] = instr (str.concat_all ["icmp ", condition, " i64 ", a, ", ", b]) g6;
    let [word, g7b] = as_bool bit g7;
    let g8 = start slow (emit ("  br label %" + done) g7b);
    let [ctx, g8x] = ctx_of g8;
    let [slow_word, g9] = instr (str.concat_all ["call preserve_mostcc i64 ", cold_symbol (op + "_slow!"), "(i64 ", ctx, ", i64 ", a, ", i64 ", b, ")"]) g8x;
    let g10 = raise_if_zero sp slow_word g9;
    let from_slow = Gen.label g10;
    let g11 = start done (emit ("  br label %" + done) g10);
    instr (str.concat_all ["phi i64 [ ", word, ", %", quick, " ], [ ", slow_word, ", %", from_slow, " ]"]) g11
};

/// Whether `v` is an object of `kind`: the test that must not read a word as an info
/// before knowing it is an address.
let of_kind : :string -> :integer -> Gen -> [:string, Gen];
let of_kind v kind g = {
    let [low, g1] = instr (str.concat_all ["and i64 ", v, ", 7"]) g;
    let [address, g2] = instr (str.concat_all ["icmp eq i64 ", low, ", 0"]) g1;
    let from = Gen.label g2;
    let [look, g3] = label_of "look" g2;
    let [done, g4] = label_of "done" g3;
    let g5 = start look (emit (str.concat_all ["  br i1 ", address, ", label %", look, ", label %", done]) g4);
    let [info, g6] = load_at v 0 g5;
    let [k, g7] = load_at info 8 g6;
    let [same, g8] = instr (str.concat_all ["icmp eq i64 ", k, ", ", to_string kind]) g7;
    let from_look = Gen.label g8;
    let g9 = start done (emit ("  br label %" + done) g8);
    let [bit, g10] = instr (str.concat_all ["phi i1 [ false, %", from, " ], [ ", same, ", %", from_look, " ]"]) g9;
    as_bool bit g10
};

let info_symbol : :string -> :string;
let info_symbol name =
    if str.starts_with "@" name { "@i_" + str.slice 1 (len name - 1) name } else { "@i_" + name };

let info_text : :string -> :string -> :integer -> :integer -> :integer -> :string;
let info_text name code kind size arity = info_with name code kind size arity "null" "null" 0 "null";

/// An info: nine words, `rt/main.dr` says what each is. The last is the direct-style entry, or
/// null: a thunk's body that answers its value, which a force calls (`force_d!`), and a function's
/// that a known call or an exact application calls (dreams/docs/aot-direct.md).
let info_with : :string -> :string -> :integer -> :integer -> :integer -> :string -> :string -> :integer -> :string -> :string;
let info_with name code kind size arity call shown impure place = info_direct name code kind size arity call shown impure place "null";

let info_direct : :string -> :string -> :integer -> :integer -> :integer -> :string -> :string -> :integer -> :string -> :string -> :string;
let info_direct name code kind size arity call shown impure place direct =
    str.concat_all [name, " = internal constant <{ ptr, i64, i64, i64, ptr, ptr, i64, ptr, ptr }> <{ ptr ", code, ", i64 ", to_string kind,
                    ", i64 ", to_string size, ", i64 ", to_string arity, ", ptr ", call, ", ptr ", shown, ", i64 ", to_string impure,
                    ", ptr ", place, ", ptr ", direct, " }>\n"];

/// A value of the right-hand side of a `bind`.
let rhs : core.Rhs -> :map -> :string -> Gen -> [:string, Gen];
let rhs r env sp g = {
    let text = fn a -> atom_text env a;
    match r {
        core.Rhs.self_closure => ["%a", g],
        core.Rhs.speculate(op, a, b, symbol, payload) => speculated op (text a) (text b) symbol (list.map text payload) g,
        core.Rhs.eager(tree, symbol, payload) => eagerly tree env symbol (list.map text payload) g,
        core.Rhs.arith(op, a, b) => tagged_arith sp op (text a) (text b) g,
        core.Rhs.compare(op, a, b) => tagged_compare sp op (text a) (text b) g,
        core.Rhs.native(name, args) => {
            let [ctx, g0] = ctx_of g;
            let [v, g1] = instr (str.concat_all ["call tailcc i64 ", rt_symbol g0 name, "(",
                                                 args_text (list.cons ctx (list.map text args)), ")"]) g0;
            [v, raise_if_zero sp v g1]
        },
        core.Rhs.peek(name, args) => {
            let [ctx, g0] = ctx_of g;
            instr (str.concat_all ["call tailcc i64 ", rt_symbol g0 name, "(", args_text (list.cons ctx (list.map text args)), ")"]) g0
        },
        core.Rhs.alloc(info, args) => {
            let [o, g1] = bump_alloc (8 * (1 + list.length args)) g;
            let g2 = store_at o 0 (str.concat_all ["ptrtoint (ptr ", info_symbol info, " to i64)"]) g1;
            [o, list.fold (fn st [i, a] -> store_at o (8 * (i + 1)) (text a) st) g2 (list.enumerate args)]
        },
        core.Rhs.patch(object, index, value) => ["0", remembered (text object) (8 * (index + 1)) (text value)
                                                        (store_at (text object) (8 * (index + 1)) (text value) g)],
        core.Rhs.field(object, index) => load_at (text object) (8 * (index + 1)) g,
        core.Rhs.has_kind(a, kind) => of_kind (text a) kind g,
        core.Rhs.same(a, w) => {
            let [bit, g1] = instr (str.concat_all ["icmp eq i64 ", text a, ", ", w]) g;
            as_bool bit g1
        },
        core.Rhs.is_int(a) => {
            let [big, g1] = of_kind (text a) 12 g;
            let [big_bit, g2] = instr (str.concat_all ["icmp eq i64 ", big, ", ", core.true_word]) g1;
            let [low, g3] = instr (str.concat_all ["and i64 ", text a, ", 1"]) g2;
            let [fix_bit, g4] = instr (str.concat_all ["icmp eq i64 ", low, ", 1"]) g3;
            let [bit, g5] = instr (str.concat_all ["or i1 ", big_bit, ", ", fix_bit]) g4;
            as_bool bit g5
        },
        core.Rhs.is_fix(a) => {
            let [low, g1] = instr (str.concat_all ["and i64 ", text a, ", 1"]) g;
            let [bit, g2] = instr (str.concat_all ["icmp eq i64 ", low, ", 1"]) g1;
            as_bool bit g2
        },
        core.Rhs.has_tag(a, kind) => {
            let [low, g1] = instr (str.concat_all ["and i64 ", text a, ", 255"]) g;
            let [bit, g2] = instr (str.concat_all ["icmp eq i64 ", low, ", ", to_string (kind * 8 + 2)]) g1;
            as_bool bit g2
        },
        core.Rhs.raw_floats(a, count) => raw_floats (text a) count g,
        core.Rhs.is_list(a) => {
            let [cell, g1] = of_kind (text a) 5 g;
            let [cell_bit, g2] = instr (str.concat_all ["icmp eq i64 ", cell, ", ", core.true_word]) g1;
            let [nil_bit, g3] = instr (str.concat_all ["icmp eq i64 ", text a, ", ", core.nil_word]) g2;
            let [bit, g4] = instr (str.concat_all ["or i1 ", cell_bit, ", ", nil_bit]) g3;
            as_bool bit g4
        },
    }
};

/// Record `r`, `count` evaluated fields just stored in it, remade as their bits when every one
/// is a float: what `record_raw!` does, written out so that a field that is a float boxed a few
/// instructions before is seen to be one, and its bits are the ones it was given.
let raw_floats : :string -> :integer -> Gen -> [:string, Gen];
let raw_floats r count g = {
    let [done, g1] = label_of "rawdone" g;
    // One block a field, each going on to the next only when its field is a float; the
    // block after the last is reached when they all are, and there the record is remade.
    let checked = list.fold (fn st i -> {
        let [w, st1] = load_at r (8 * (3 + i)) st;
        let [low, st2] = instr (str.concat_all ["and i64 ", w, ", 7"]) st1;
        let [aligned, st3] = instr (str.concat_all ["icmp eq i64 ", low, ", 0"]) st2;
        let [some, st4] = instr (str.concat_all ["icmp ne i64 ", w, ", 0"]) st3;
        let [object, st5] = instr (str.concat_all ["and i1 ", aligned, ", ", some]) st4;
        let [look, st6] = label_of "isf" st5;
        let [next, st7] = label_of "nextf" st6;
        let st8 = start look (emit (str.concat_all ["  br i1 ", object, ", label %", look, ", label %", done]) st7);
        let [info, st9] = load_at w 0 st8;
        let [is_float, st10] = instr (str.concat_all ["icmp eq i64 ", info, ", ptrtoint (ptr @i_float to i64)"]) st9;
        start next (emit (str.concat_all ["  br i1 ", is_float, ", label %", next, ", label %", done]) st10)
    }) g1 (list.range 0 count);
    let converted = list.fold (fn st i -> {
        let [w, st1] = load_at r (8 * (3 + i)) st;
        let [bits, st2] = load_at w 8 st1;
        store_at r (8 * (3 + i)) bits st2
    }) checked (list.range 0 count);
    let g2 = store_at r 0 "ptrtoint (ptr @i_record_f to i64)" converted;
    [r, start done (emit ("  br label %" + done) g2)]
};

/// The symbol a core call names: a function of its own, or one reached by name.
let target_of : Gen -> :string -> :string;
let target_of g symbol = (Gen.names g).[symbol else symbol];

/// `args` beyond the first three, on the stack with the first of them on top.
let pushing : [:string] -> :string -> Gen -> [:string, Gen];
let pushing extra sp g = match extra {
    [] => [sp, g],
    _ => {
        let [below, g1] = reserve sp (list.length extra) g;
        [below, list.fold (fn st [i, v] -> store_at below (8 * i) v st) g1 (list.enumerate extra)]
    },
};

/// Generate `e`, which ends the current block.
let expr : core.Expr -> :map -> :string -> Gen -> Gen;
let expr e env sp g = match e {
    core.Expr.ret(a) if Gen.join g != "" => {
        // In line: the value goes to the join block. A double goes by a block of its own, where
        // it is boxed if the join turns out to need words (`join_point`).
        let d = if float_atom env a { double_text env a } else { "" };
        let w = match a { core.Atom.var(x) => match map.lookup x env { Option.some(t) => t, Option.none => "" }, _ => atom_text env a };
        if d == "" { Gen.set_leaves (list.cons [Gen.label g, w, d] (Gen.leaves g)) g |> emit ("  br label %" + Gen.join g) }
        else {
            let [via, g1] = label_of "leaf" g;
            Gen.set_leaves (list.cons [via, w, d] (Gen.leaves g1)) g1 |> emit ("  br label %" + via)
        }
    },
    core.Expr.ret(a) => answer sp (atom_text env a) g,
    core.Expr.enter(a) => jump (rt_symbol g "enter!") ["%p", sp, atom_text env a] g,
    core.Expr.call(symbol, args) if worker_fits g symbol args env => call_worker symbol "0" args env sp g,
    core.Expr.call_closure(f, symbol, args) if worker_fits g symbol args env => call_worker symbol (atom_text env f) args env sp g,
    core.Expr.call(symbol, args) => {
        let vals = list.map (atom_text env) args;
        let regs = list.take 3 vals;
        let [below, g1] = pushing (list.drop 3 vals) sp g;
        let pad = list.replicate (3 - list.length regs) "0";
        jump (target_of g symbol) (list.concat [["%p", below, "0"], regs, pad]) g1
    },
    core.Expr.call_closure(f, symbol, args) => {
        let vals = list.map (atom_text env) args;
        let regs = list.take 3 vals;
        let [below, g1] = pushing (list.drop 3 vals) sp g;
        let pad = list.replicate (3 - list.length regs) "0";
        jump (target_of g symbol) (list.concat [["%p", below, atom_text env f], regs, pad]) g1
    },
    core.Expr.apply(f, args) => {
        // The usual case, a closure given exactly its arguments, goes straight to its code in
        // registers. Everything else (a partial application, too few, too many, not a function)
        // is what `apply!` is for.
        let vals = list.map (atom_text env) args;
        let fv = atom_text env f;
        let count = list.length vals;
        let [low, g1] = instr (str.concat_all ["and i64 ", fv, ", 7"]) g;
        let [is_object, g2] = instr (str.concat_all ["icmp eq i64 ", low, ", 0"]) g1;
        let [object, g3] = label_of "object" g2;
        let [direct, g4] = label_of "direct" g3;
        let [general, g5] = label_of "general" g4;
        let g6 = start object (emit (str.concat_all ["  br i1 ", is_object, ", label %", object, ", label %", general]) g5);
        let [info, g7] = load_at fv 0 g6;
        let [kind, g8] = load_at info 8 g7;
        let [arity, g9] = load_at info 24 g8;
        let [is_closure, g10] = instr (str.concat_all ["icmp eq i64 ", kind, ", 3"]) g9;
        let [fits, g11] = instr (str.concat_all ["icmp eq i64 ", arity, ", ", to_string count]) g10;
        let [exact, g12] = instr (str.concat_all ["and i1 ", is_closure, ", ", fits]) g11;
        let g13 = start direct (emit (str.concat_all ["  br i1 ", exact, ", label %", direct, ", label %", general]) g12);
        let [code, g14] = load_at info 32 g13;
        let [target, g15] = instr (str.concat_all ["inttoptr i64 ", code, " to ptr"]) g14;
        let regs = list.take 3 vals;
        let [below, g16] = pushing (list.drop 3 vals) sp g15;
        let pad = list.replicate (3 - list.length regs) "0";
        let g17 = start general (jump target (list.concat [["%p", below, fv], regs, pad]) g16);
        let [below2, g18] = pushing vals sp g17;
        jump (rt_symbol g18 "apply!") ["%p", below2, fv, to_string count, "0", "0"] g18
    },
    core.Expr.choose(a, yes, no) => {
        let v = atom_text env a;
        let [is_true, g1] = instr (str.concat_all ["icmp eq i64 ", v, ", ", core.true_word]) g;
        let [then_, g2] = label_of "then" g1;
        let [other, g3] = label_of "other" g2;
        let [else_, g4] = label_of "else" g3;
        let [wrong, g5] = label_of "wrong" g4;
        let g6 = start then_ (emit (str.concat_all ["  br i1 ", is_true, ", label %", then_, ", label %", other]) g5);
        let g7 = start other (expr yes env sp g6);
        let [is_false, g8] = instr (str.concat_all ["icmp eq i64 ", v, ", ", core.false_word]) g7;
        let g9 = start wrong (emit (str.concat_all ["  br i1 ", is_false, ", label %", else_, ", label %", wrong]) g8);
        let g10 = start else_ (jump (rt_symbol g "not_bool!") ["%p", sp, v, "0", "0", "0"] g9);
        expr no env sp g10
    },
    core.Expr.seq(y, _, core.Expr.enter(core.Atom.var(x)), rest) if map.has (float_key x) env => {
        // A float just computed needs no evaluating, and there is no word to enter.
        let env1 = env.[float_key y => env.[float_key x]];
        expr rest (match map.lookup x env { Option.some(w) => env1.[y => w], Option.none => env1 }) sp g
    },
    core.Expr.seq(x, live, inner, rest) if in_line inner && Gen.join g == "" => join_point x inner rest env sp g,
    core.Expr.entry_force(core.Atom.var(v), x, _, _, body) if map.has (float_key v) env => {
        // A double is evaluated: it is what it is called by now.
        let env1 = env.[float_key x => env.[float_key v]];
        expr body (match map.lookup v env { Option.some(w) => env1.[x => w], Option.none => env1 }) sp g
    },
    core.Expr.entry_force(a, x, live, retry, body) => {
        let v = atom_text env a;
        let [low, g1] = instr (str.concat_all ["and i64 ", v, ", 7"]) g;
        let [is_object, g2] = instr (str.concat_all ["icmp eq i64 ", low, ", 0"]) g1;
        let [object, g3] = label_of "object" g2;
        let [ready, g4] = label_of "ready" g3;
        let [waits, g5] = label_of "waits" g4;
        let g6 = start object (emit (str.concat_all ["  br i1 ", is_object, ", label %", object, ", label %", ready]) g5);
        let [info, g7] = load_at v 0 g6;
        let [kind, g8] = load_at info 8 g7;
        let [done, g9] = instr (str.concat_all ["icmp ugt i64 ", kind, ", 2"]) g8;
        let g10 = start ready (emit (str.concat_all ["  br i1 ", done, ", label %", ready, ", label %", waits]) g9);
        let g11 = expr body env.[x => v] sp g10;
        let g12 = start waits g11;
        let [below, _, g13] = frame_for x live retry env sp g12;
        jump (rt_symbol g13 "enter!") ["%p", below, v] g13
    },
    core.Expr.seq(x, live, core.Expr.enter(a), rest) => {
        // Most of what is entered has already been evaluated, and asking costs a load. What
        // then follows runs here, with no frame stored and no jump through a pointer. A long
        // `rest` is not worth a second copy, and takes the frame to go straight to its code.
        let v = atom_text env a;
        let [low, g1] = instr (str.concat_all ["and i64 ", v, ", 7"]) g;
        let [is_object, g2] = instr (str.concat_all ["icmp eq i64 ", low, ", 0"]) g1;
        let [object, g3] = label_of "object" g2;
        let [ready, g4] = label_of "ready" g3;
        let [waits, g5] = label_of "waits" g4;
        let g6 = start object (emit (str.concat_all ["  br i1 ", is_object, ", label %", object, ", label %", ready]) g5);
        let [info, g7] = load_at v 0 g6;
        let [kind, g8] = load_at info 8 g7;
        let [done, g9] = instr (str.concat_all ["icmp ugt i64 ", kind, ", 2"]) g8;
        let g10 = start ready (emit (str.concat_all ["  br i1 ", done, ", label %", ready, ", label %", waits]) g9);
        let small = core_within rest inline_budget >= 0;
        let g11 = if small { expr rest env.[x => v] sp g10 } else {
            let [below, symbol, h1] = frame_for x live rest env sp g10;
            jump symbol ["%p", below, v, "0", "0", "0"] h1
        };
        let g12 = start waits g11;
        let [below, _, g13] = frame_for x live rest env sp g12;
        jump (rt_symbol g13 "enter!") ["%p", below, v] g13
    },
    core.Expr.seq(x, live, inner, rest) => {
        let n = Gen.next g;
        let symbol = "@k" + to_string n;
        let info = "@i_k" + to_string n;
        let size = 1 + list.length live;
        let g1 = Gen.set_next (n + 1) g;
        let g2 = g1 |> datum_onto (info_with info symbol 0 size 0 "null" "null" 0 (Gen.place g1))
                    |> Gen.set_pending (list.cons [symbol, live, x, rest] (Gen.pending g1));
        let [below, g3] = reserve sp size g2;
        let g4 = store_at below 0 (str.concat_all ["ptrtoint (ptr ", info, " to i64)"]) g3;
        let g5 = store_live below live env g4;
        expr inner env below g5
    },
    core.Expr.catching(x, live, body, handler, cleanup) => {
        let n = Gen.next g;
        let symbol = "@k" + to_string n;
        let info = "@i_k" + to_string n;
        let size = 1 + list.length live;
        let g1 = Gen.set_next (n + 1) g;
        let g2 = g1 |> datum_onto (info_with info (rt_symbol g "frame_catch_return!") (if cleanup { 23 } else { 20 }) size 0 symbol "null" 0 (Gen.place g1))
                    |> Gen.set_pending (list.cons [symbol, live, x, handler] (Gen.pending g1));
        let [below, g3] = reserve sp size g2;
        let g4 = store_at below 0 (str.concat_all ["ptrtoint (ptr ", info, " to i64)"]) g3;
        let g5 = store_live below live env g4;
        expr body env below g5
    },
    core.Expr.bind(x, core.Rhs.native("to_float!", [a]), rest) => {
        let [d, g1] = to_double sp (atom_text env a) g;
        float_result x d rest env sp g1
    },
    core.Expr.bind(x, core.Rhs.arith(op, a, b), rest) if op != "mod" && (float_atom env a || float_atom env b) => {
        if float_atom env a && float_atom env b {
            let [da, g1] = double_of env a g;
            let [db, g2] = double_of env b g1;
            let [d, g3] = instr (str.concat_all [float_op op, " double ", da, ", ", db]) g2;
            float_result x d rest env sp g3
        } else {
            let [v, g1] = float_or_slow sp op a b env g;
            expr rest env.[x => v] sp g1
        }
    },
    core.Expr.bind(x, core.Rhs.alloc(info, args), rest) if map.has x (Gen.once_vars g) => {
        // Entered at most once: the entry that does not update it (`once_thunks`).
        let [v, g1] = rhs (core.Rhs.alloc (info + "o") args) env sp g;
        expr rest env.[x => v] sp g1
    },
    core.Expr.bind(x, r, rest) => {
        let [v, g1] = rhs r env sp g;
        expr rest env.[x => v] sp g1
    },
    core.Expr.raised(a) => jump (rt_symbol g "raise!") ["%p", sp, str.concat_all ["ptrtoint (ptr ", Gen.place g, " to i64)"], atom_text env a, "0", "0"] g,
    core.Expr.raise_text(text) => jump (rt_symbol g "native_failed!") ["%p", sp, "0", "0", "0", "0"] g,
};

// --- join points -----------------------------------------------------------------------------
//
// A `seq` pushes a frame and its answer comes back through it, which is right when what it runs
// may call, enter or apply and so leave the function. When it cannot -- only binds, choices,
// raises and answers, as a small inlined function often is -- the frame is a store, a load and an
// indirect jump for nothing, and its answer a box if it is a float. Such an inner expression is
// compiled in line instead, each `ret` a branch to one block where a phi takes the value, a
// double if every branch has one.

let in_line : core.Expr -> :bool;
let in_line e = match e {
    core.Expr.ret(_) => true,
    core.Expr.bind(_, _, rest) => in_line rest,
    core.Expr.choose(_, yes, no) => in_line yes && in_line no,
    core.Expr.raise_text(_) => true,
    core.Expr.raised(_) => true,
    _ => false,
};

let join_point : :integer -> core.Expr -> core.Expr -> :map -> :string -> Gen -> Gen;
let join_point x inner rest env sp g = {
    let [j, g1] = label_of "join" g;
    let outer = Gen.leaves g1;
    let g2 = expr inner env sp (g1 |> Gen.set_join j |> Gen.set_leaves []);
    let leaves = list.reverse (Gen.leaves g2);
    let g3 = g2 |> Gen.set_join "" |> Gen.set_leaves outer;
    if list.is_empty leaves {
        // Every way through raises: nothing joins, and nothing follows.
        g3
    } else if list.all (fn l -> l.[2] != "") leaves {
        let g4 = list.fold (fn st l -> emit ("  br label %" + j) (start l.[0] st)) g3 leaves;
        let [d, g5] = instr ("phi double " + phi_args (list.map (fn l -> [l.[2], l.[0]]) leaves)) (start j g4);
        float_result x d rest env sp g5
    } else {
        // Not all doubles: every branch needs a word, and a double with none is boxed on its way.
        let [ws, g4] = list.fold (fn [acc, st] l ->
            if l.[2] == "" { [list.cons [l.[1], l.[0]] acc, st] }
            else {
                let st1 = start l.[0] st;
                let [w, st2] = if l.[1] != "" { [l.[1], st1] } else { boxed_float l.[2] st1 };
                [list.cons [w, Gen.label st2] acc, emit ("  br label %" + j) st2]
            }) [[], g3] leaves;
        let [v, g5] = instr ("phi i64 " + phi_args (list.reverse ws)) (start j g4);
        expr rest env.[x => v] sp g5
    }
};

let phi_args : [[:string]] -> :string;
let phi_args pairs = str.join_str ", " (list.map (fn pr -> str.concat_all ["[ ", pr.[0], ", %", pr.[1], " ]"]) pairs);

let double_text : :map -> core.Atom -> :string;
let double_text env a = match a {
    core.Atom.var(x) => env.[float_key x else ""],
    _ => "",
};

// --- thunks entered once ------------------------------------------------------------------------
//
// A thunk is made so that its work is done once however often it is forced: entering it marks it
// a hole, pushes a frame that writes the answer back, and leaves an indirection that each later
// reader follows. When it can only be entered once, none of that is wanted. That is so when the
// variable it is bound to is used once on any path, and that use forces it or hands it to a
// parameter that is used so in turn -- `once_params`, a greatest fixed point over the program, as
// a parameter is assumed so until something says otherwise. Such a thunk is made with a second
// entry, `..o`, the same code without the update; a copy of it a message carries is still made
// with that entry, and is still entered at most once, by whoever receives it.

/// Every occurrence of `v` in `e` on its worst path, `[count, all good]`, where good is a force or
/// an argument to a parameter in `once`.
let occurs : :integer -> core.Expr -> :map -> [:integer, :bool];
let occurs v e once = {
    let in_atoms = fn atoms -> list.length (list.filter (fn a -> a == core.Atom.var v) atoms);
    let bad = fn atoms -> { let n = in_atoms atoms; [n, n == 0] };
    let plus = fn a b -> [a.[0] + b.[0], a.[1] && b.[1]];
    let worst = fn a b -> [if a.[0] > b.[0] { a.[0] } else { b.[0] }, a.[1] && b.[1]];
    let args_of = fn symbol args -> list.fold (fn acc [i, a] ->
        if a == core.Atom.var v { [acc.[0] + 1, acc.[1] && map.has (once_key symbol i) once] } else { acc }) [0, true] (list.enumerate args);
    match e {
        core.Expr.enter(a) => [in_atoms [a], true],
        core.Expr.ret(a) => bad [a],
        core.Expr.raised(a) => bad [a],
        core.Expr.raise_text(_) => [0, true],
        core.Expr.call(symbol, args) => args_of symbol args,
        core.Expr.call_closure(f, symbol, args) => plus (bad [f]) (args_of symbol args),
        core.Expr.apply(f, args) => bad (list.cons f args),
        core.Expr.entry_force(a, _, _, retry, body) =>
            plus [in_atoms [a], true] (worst (occurs v body once) (occurs v retry once)),
        core.Expr.choose(a, yes, no) => plus (bad [a]) (worst (occurs v yes once) (occurs v no once)),
        core.Expr.seq(_, _, inner, rest) => plus (occurs v inner once) (occurs v rest once),
        core.Expr.catching(_, _, body, handler, _) => plus (occurs v body once) (occurs v handler once),
        core.Expr.bind(_, r, rest) => {
            let n = list.length (list.filter (fn x -> x == v) (core.rhs_vars r));
            plus [n, n == 0] (occurs v rest once)
        },
    }
};

let once_key : :string -> :integer -> :string;
let once_key symbol i = symbol + "#" + to_string i;

let used_once : :integer -> core.Expr -> :map -> :bool;
let used_once v e once = { let [n, good] = occurs v e once; n <= 1 && good };

/// The parameters used once, as `once_key`s: every parameter, less those found otherwise, until
/// nothing changes. `known` are another set's, found already -- the library's, for a program
/// translated on it -- and stay as they are.
let once_params_on : [core.Function] -> :map -> :map;
let once_params_on fs known = {
    let all = list.fold (fn m f -> list.fold (fn m1 [i, _] -> m1.[once_key (core.Function.symbol f) i => true]) m
        (list.enumerate (core.Function.params f))) known fs;
    once_round fs all
};

let once_round : [core.Function] -> :map -> :map;
let once_round fs once = {
    let next = list.fold (fn m f -> list.fold (fn m1 [i, p] ->
        if map.has (once_key (core.Function.symbol f) i) once && not (used_once p (core.Function.body f) once) {
            map.remove (once_key (core.Function.symbol f) i) m1
        } else { m1 }) m (list.enumerate (core.Function.params f))) once fs;
    if map.size next == map.size once { once } else { once_round fs next }
};

/// `[variables, thunk symbols]`: where a thunk is made that is entered at most once.
let once_thunks_on : [core.Function] -> :map -> [:map, :map];
let once_thunks_on fs known = {
    let thunks = list.fold (fn m f -> if core.Function.how f == :thunk { m.[core.Function.symbol f => true] } else { m }) %{} fs;
    let once = once_params_on fs known;
    list.fold (fn acc f -> once_sites (core.Function.body f) thunks once acc) [%{}, %{}] fs
};

let once_sites : core.Expr -> :map -> :map -> [:map, :map] -> [:map, :map];
let once_sites e thunks once acc = match e {
    core.Expr.bind(x, core.Rhs.alloc(info, _), rest) if map.has info thunks => {
        let acc1 = if used_once x rest once { [acc.[0].[x => true], acc.[1].[info => true]] } else { acc };
        once_sites rest thunks once acc1
    },
    core.Expr.bind(_, _, rest) => once_sites rest thunks once acc,
    core.Expr.choose(_, yes, no) => once_sites no thunks once (once_sites yes thunks once acc),
    core.Expr.seq(_, _, inner, rest) => once_sites rest thunks once (once_sites inner thunks once acc),
    core.Expr.entry_force(_, _, _, retry, body) => once_sites retry thunks once (once_sites body thunks once acc),
    core.Expr.catching(_, _, body, handler, _) => once_sites handler thunks once (once_sites body thunks once acc),
    _ => acc,
};

/// A thunk's entry that does not update it: the same code, with no frame and no hole.
let thunk_once : core.Function -> Gen -> Gen;
let thunk_once f g = {
    let symbol = core.Function.symbol f;
    let osym = symbol + "o";
    let captures = core.Function.captures f;
    let g0 = g |> Gen.set_lines [] |> Gen.set_label "entry";
    let g1 = safepoint osym 0 g0;
    let [env, g2] = list.fold (fn [m, st] [i, v] -> {
        let [loaded, st1] = load_at "%a" (8 * (i + 1)) st;
        [m.[v => loaded], st1]
    }) [%{}, g1] (list.enumerate captures);
    let g3 = expr (core.Function.body f) env "%sp0" g2;
    let size = if list.is_empty captures { 1 } else { list.length captures };
    let g4 = finish osym (emit (str.concat_all ["; ", core.Function.name f, " (entered once)"]) g3);
    drain (datum_onto (info_text (info_symbol osym) osym 0 size 0) g4)
};

// --- workers: floats across calls -------------------------------------------------------------
//
// A function whose parameters among the first three are used as floats -- an operand of float
// arithmetic with another float -- gets a worker beside it, `@..w`, which takes those as doubles,
// their bits in the registers. A call with doubles in hand goes to the worker; everything else
// goes to the function as before, which asks at its entry whether those arguments are floats and,
// if they are, goes on in the worker. So a loop carrying a float stays in the worker, and
// whatever reaches it as a value -- a closure, a retry -- finds its way there too.
//
// The collector must never see a double where a word belongs. Parameters past the third are on
// the stack, which it scans, so only registers are doubles; at the worker's safepoint the doubles
// are boxed and the function proper is what runs again; and a frame takes a double's box
// (`store_live`), made where the frame is.

let float_params : core.Function -> [:integer];
let float_params f = if core.Function.how f != :function { [] } else {
    let params = list.take 3 (core.Function.params f);
    let assumed = float_vars (core.Function.body f) (list.fold (fn m v -> m.[v => true]) %{} params);
    let used = float_operands (core.Function.body f) assumed %{};
    list.map (fn pr -> pr.[0]) (list.filter (fn [i, v] -> map.has v used) (list.enumerate params))
};

let float_known : :map -> core.Atom -> :bool;
let float_known floats a = match a {
    core.Atom.var(x) => map.has x floats,
    core.Atom.address(name) => str.starts_with "@flt" name,
    _ => false,
};

/// The variables `e` makes floats, given those already known.
let float_vars : core.Expr -> :map -> :map;
let float_vars e floats = match e {
    core.Expr.bind(x, core.Rhs.native("to_float!", _), rest) => float_vars rest floats.[x => true],
    core.Expr.bind(x, core.Rhs.arith(op, a, b), rest) =>
        float_vars rest (if op != "mod" && float_known floats a && float_known floats b { floats.[x => true] } else { floats }),
    core.Expr.bind(_, _, rest) => float_vars rest floats,
    core.Expr.choose(_, yes, no) => float_vars no (float_vars yes floats),
    core.Expr.seq(x, _, inner, rest) => {
        let f1 = float_vars inner floats;
        float_vars rest (if answers_float inner f1 { f1.[x => true] } else { f1 })
    },
    core.Expr.entry_force(core.Atom.var(v), x, _, _, body) => float_vars body (if map.has v floats { floats.[x => true] } else { floats }),
    core.Expr.entry_force(_, _, _, _, body) => float_vars body floats,
    core.Expr.catching(_, _, body, handler, _) => float_vars handler (float_vars body floats),
    _ => floats,
};

let answers_float : core.Expr -> :map -> :bool;
let answers_float e floats = match e {
    core.Expr.ret(a) => float_known floats a,
    core.Expr.bind(_, _, rest) => answers_float rest floats,
    core.Expr.choose(_, yes, no) => answers_float yes floats && answers_float no floats,
    _ => false,
};

/// The variables `e` uses as an operand of float arithmetic with a float.
let float_operands : core.Expr -> :map -> :map -> :map;
let float_operands e floats used = match e {
    core.Expr.bind(_, core.Rhs.arith(op, a, b), rest) => {
        let u1 = if op != "mod" && float_known floats a && float_known floats b {
            list.fold (fn m v -> m.[v => true]) used (list.append (core.atom_vars a) (core.atom_vars b))
        } else { used };
        float_operands rest floats u1
    },
    core.Expr.bind(_, _, rest) => float_operands rest floats used,
    core.Expr.choose(_, yes, no) => float_operands no floats (float_operands yes floats used),
    core.Expr.seq(_, _, inner, rest) => float_operands rest floats (float_operands inner floats used),
    core.Expr.entry_force(core.Atom.var(v), x, _, _, body) => {
        let u1 = float_operands body floats used;
        if map.has x u1 { u1.[v => true] } else { u1 }
    },
    core.Expr.entry_force(_, _, _, _, body) => float_operands body floats used,
    core.Expr.catching(_, _, body, handler, _) => float_operands handler floats (float_operands body floats used),
    _ => used,
};

let worker_symbol : :string -> :string;
let worker_symbol symbol = symbol + "w";

/// Whether a call to `symbol` can go to its worker: it has one, and every argument the worker
/// takes as a double is one here.
let worker_fits : Gen -> :string -> [core.Atom] -> :map -> :bool;
let worker_fits g symbol args env = match map.lookup symbol (Gen.workers g) {
    Option.none => false,
    Option.some(mask) => list.all (fn i -> i < list.length args && double_text env args.[i] != "") mask,
};

let call_worker : :string -> :string -> [core.Atom] -> :map -> :string -> Gen -> Gen;
let call_worker symbol closure args env sp g = {
    let mask = (Gen.workers g).[symbol];
    let [vals, g1] = list.fold (fn [acc, st] [i, a] ->
        if list.contains i mask {
            let [bits, st1] = instr (str.concat_all ["bitcast double ", double_text env a, " to i64"]) st;
            [list.cons bits acc, st1]
        } else {
            let [w, st1] = word_of env a st;
            [list.cons w acc, st1]
        }) [[], g] (list.enumerate args);
    let all = list.reverse vals;
    let regs = list.take 3 all;
    let [below, g2] = pushing (list.drop 3 all) sp g1;
    let pad = list.replicate (3 - list.length regs) "0";
    jump (worker_symbol symbol) (list.concat [["%p", below, closure], regs, pad]) g2
};

/// An atom's word, boxing a double that has none.
let word_of : :map -> core.Atom -> Gen -> [:string, Gen];
let word_of env a g = match a {
    // Only a double with no word is boxed; anything else is the word, read as lazily as before.
    core.Atom.var(x) => if map.has (float_key x) env && not (map.has x env) { boxed_float env.[float_key x] g } else { [env.[x], g] },
    _ => [atom_text env a, g],
};

/// A frame's words, each live variable's: a double with no box gets one here.
let store_live : :string -> [:integer] -> :map -> Gen -> Gen;
let store_live below live env g = list.fold (fn st [i, v] -> {
    let [w, st1] = word_of env (core.Atom.var(v)) st;
    store_at below (8 * (i + 1)) w st1
}) g (list.enumerate live);

let registers_of : [:string];
let registers_of = ["%b", "%c", "%d"];

/// At the function's entry: if the worker's arguments are floats, go on there.
let to_worker : :string -> [:integer] -> Gen -> Gen;
let to_worker symbol mask g = {
    let [yes, g1] = label_of "worker" g;
    let [no, g2] = label_of "generic" g1;
    let [checks, g3] = list.fold (fn [acc, st] i -> {
        let r = registers_of.[i];
        let [ok, st1] = is_float_word r st;
        [list.cons ok acc, st1]
    }) [[], g2] mask;
    let [all, g4] = list.fold (fn [acc, st] c -> if acc == "" { [c, st] } else { instr (str.concat_all ["and i1 ", acc, ", ", c]) st }) ["", g3] checks;
    let g5 = start yes (emit (str.concat_all ["  br i1 ", all, ", label %", yes, ", label %", no]) g4);
    let [args, g6] = list.fold (fn [acc, st] i -> {
        let r = registers_of.[i];
        if list.contains i mask {
            let [bits, st1] = load_at r 8 st;
            [list.append acc [bits], st1]
        } else { [list.append acc [r], st] }
    }) [[], g5] [0, 1, 2];
    start no (jump (worker_symbol symbol) (list.concat [["%p", "%sp0", "%a"], args]) g6)
};

/// Whether a word is a boxed float, as an `i1`, computed without a branch and without reading
/// what is not an object.
let is_float_word : :string -> Gen -> [:string, Gen];
let is_float_word r g = {
    let [low, g1] = instr (str.concat_all ["and i64 ", r, ", 7"]) g;
    let [obj, g2] = instr (str.concat_all ["icmp eq i64 ", low, ", 0"]) g1;
    let [nz, g3] = instr (str.concat_all ["icmp ne i64 ", r, ", 0"]) g2;
    let [both, g4] = instr (str.concat_all ["and i1 ", obj, ", ", nz]) g3;
    let [at, g5] = instr (str.concat_all ["select i1 ", both, ", i64 ", r, ", i64 ptrtoint (ptr @flt_zero to i64)"]) g4;
    let [info, g6] = load_at at 0 g5;
    let [same, g7] = instr (str.concat_all ["icmp eq i64 ", info, ", ptrtoint (ptr @i_float to i64)"]) g6;
    instr (str.concat_all ["and i1 ", both, ", ", same]) g7
};

/// The worker of `f`: the same body, with the parameters in `mask` doubles.
let worker : core.Function -> [:integer] -> Gen -> Gen;
let worker f mask g = {
    let symbol = core.Function.symbol f;
    let wsym = worker_symbol symbol;
    let params = core.Function.params f;
    let captures = core.Function.captures f;
    let arity = list.length params;
    let extra = if arity > 3 { arity - 3 } else { 0 };
    let g0 = g |> Gen.set_lines [] |> Gen.set_label "entry";
    let g1 = worker_safepoint symbol mask extra g0;
    let [env0, g2] = list.fold (fn [m, st] [i, v] ->
        if i >= 3 {
            let [loaded, st1] = load_at "%sp0" (8 * (i - 3)) st;
            [m.[v => loaded], st1]
        } else if list.contains i mask {
            let [d, st1] = instr (str.concat_all ["bitcast i64 ", registers_of.[i], " to double"]) st;
            if stays_unboxed v (core.Function.body f) { [m.[float_key v => d], st1] }
            else {
                // Needed as a word too: boxed once, here.
                let [o, st2] = boxed_float d st1;
                [m.[float_key v => d].[v => o], st2]
            }
        } else { [m.[v => registers_of.[i]], st] }) [%{}, g1] (list.enumerate params);
    let [env1, g3] = list.fold (fn [m, st] [i, v] -> {
        let [loaded, st1] = load_at "%a" (8 * (i + 1)) st;
        [m.[v => loaded], st1]
    }) [env0, g2] (list.enumerate captures);
    let [sp, g4] = sp_past (8 * extra) g3;
    let g5 = expr (core.Function.body f) env1 sp g4;
    drain (finish wsym (emit (str.concat_all ["; ", core.Function.name f, " (worker)"]) g5))
};

/// A worker's safepoint: when the guard says stop, its doubles are boxed and the function proper
/// is what runs again after, with words, which comes back here at its entry.
let worker_safepoint : :string -> [:integer] -> :integer -> Gen -> Gen;
let worker_safepoint symbol mask extra g = {
    let [guard_ptr, g0b] = pointer_at "%p" 16 g;
    let [guard, g1] = instr ("load volatile i64, ptr " + guard_ptr) g0b;
    let [asked, g2] = instr (str.concat_all ["icmp ult i64 %sp0, ", guard]) g1;
    let [collect, g3] = label_of "collect" g2;
    let [go_on, g4] = label_of "go" g3;
    let g5 = start collect (emit (str.concat_all ["  br i1 ", asked, ", label %", collect, ", label %", go_on]) g4);
    let [regs, g6] = list.fold (fn [acc, st] i ->
        if list.contains i mask {
            let [d, st1] = instr (str.concat_all ["bitcast i64 ", registers_of.[i], " to double"]) st;
            let [o, st2] = boxed_float d st1;
            [list.append acc [o], st2]
        } else { [list.append acc [registers_of.[i]], st] }) [[], g5] [0, 1, 2];
    let g7 = store_at "%p" 24 (str.concat_all ["ptrtoint (ptr ", symbol, " to i64)"]) g6;
    let g8 = store_at "%p" 32 (to_string extra) g7;
    start go_on (jump (rt_symbol g8 "collect_at_entry!") (list.concat [["%p", "%sp0", "%a"], regs]) g8)
};

// --- floats in registers ------------------------------------------------------------------
//
// A variable known to be a float has its double in `env` under `float_key`, and has a boxed word
// there too only if it needs one. Known is what is built from known floats by arithmetic, since
// a float and a float can only make a float, and nothing else: a float and something unknown
// might be a tensor. What decides whether to box is `stays_unboxed`, an escape analysis over
// what follows: used only as an operand of more arithmetic, it never exists on the heap.

let float_key : :integer -> :string;
let float_key x = "f" + to_string x;

let float_atom : :map -> core.Atom -> :bool;
let float_atom env a = match a {
    core.Atom.var(x) => map.has (float_key x) env,
    core.Atom.address(name) => str.starts_with "@flt" name,
    _ => false,
};

let double_of : :map -> core.Atom -> Gen -> [:string, Gen];
let double_of env a g = match a {
    core.Atom.var(x) => [env.[float_key x], g],
    core.Atom.address(name) => {
        let [bits, g1] = load_at (str.concat_all ["ptrtoint (ptr ", name, " to i64)"]) 8 g;
        instr (str.concat_all ["bitcast i64 ", bits, " to double"]) g1
    },
    _ => ["0.0", g],
};

let float_op : :string -> :string;
let float_op op = %{"add" => "fadd", "sub" => "fsub", "mul" => "fmul", "div" => "fdiv"}.[op];

let boxed_float : :string -> Gen -> [:string, Gen];
let boxed_float d g = {
    let [o, g1] = bump_alloc 16 g;
    let g2 = store_at o 0 "ptrtoint (ptr @i_float to i64)" g1;
    let [bits, g3] = instr (str.concat_all ["bitcast double ", d, " to i64"]) g2;
    [o, store_at o 8 bits g3]
};

/// `x` is the double `d`, and gets a box only if what follows needs one.
let float_result : :integer -> :string -> core.Expr -> :map -> :string -> Gen -> Gen;
let float_result x d rest env sp g = {
    let env1 = env.[float_key x => d];
    // Answered to a join point, a double needs no box either: the join decides.
    if stays_unboxed x rest || (Gen.join g != "" && answers_only x rest) { expr rest env1 sp g }
    else {
        let [o, g1] = boxed_float d g;
        expr rest env1.[x => o] sp g1
    }
};

/// Whether `e` reads `x` only by answering it, after binds that do not read it.
let answers_only : :integer -> core.Expr -> :bool;
let answers_only x e = match e {
    core.Expr.ret(core.Atom.var(y)) => y == x,
    core.Expr.bind(_, r, rest) => not (list.contains x (core.rhs_vars r)) && answers_only x rest,
    _ => false,
};

/// Whether `x` is read in `e` only by arithmetic that takes a double.
let stays_unboxed : :integer -> core.Expr -> :bool;
let stays_unboxed x e = {
    let absent = fn vars -> not (list.contains x vars);
    match e {
        core.Expr.bind(y, core.Rhs.arith(op, a, b), rest) => {
            let reads = list.append (core.atom_vars a) (core.atom_vars b);
            (op != "mod" || absent reads) && stays_unboxed x rest
        },
        core.Expr.bind(_, r, rest) => absent (core.rhs_vars r) && stays_unboxed x rest,
        core.Expr.choose(a, yes, no) => absent (core.atom_vars a) && stays_unboxed x yes && stays_unboxed x no,
        core.Expr.seq(y, _, core.Expr.enter(core.Atom.var(z)), rest) if z == x => stays_unboxed x rest && stays_unboxed y rest,
        core.Expr.seq(_, live, inner, _) => absent live && stays_unboxed x inner,
        // Forcing another parameter: the way that waits keeps `x` in a frame, boxed then
        // (`store_live`), and the way that does not is the one that matters.
        core.Expr.entry_force(core.Atom.var(v), y, _, _, body) =>
            if v == x { stays_unboxed x body && stays_unboxed y body } else { stays_unboxed x body },
        _ => not (map.has x (core.free e)),
    }
};

/// A known float with what may be one: the double in line if it is, and the runtime if not.
let float_or_slow : :string -> :string -> core.Atom -> core.Atom -> :map -> Gen -> [:string, Gen];
let float_or_slow sp op a b env g = {
    let known_first = float_atom env a;
    let other = if known_first { b } else { a };
    let w = atom_text env other;
    let [low, g1] = instr (str.concat_all ["and i64 ", w, ", 7"]) g;
    let [is_object, g2] = instr (str.concat_all ["icmp eq i64 ", low, ", 0"]) g1;
    let [object, g3] = label_of "object" g2;
    let [fast, g4] = label_of "float" g3;
    let [slow, g5] = label_of "other" g4;
    let [done, g6] = label_of "both" g5;
    let g7 = start object (emit (str.concat_all ["  br i1 ", is_object, ", label %", object, ", label %", slow]) g6);
    let [info, g8] = load_at w 0 g7;
    let [same, g9] = instr (str.concat_all ["icmp eq i64 ", info, ", ptrtoint (ptr @i_float to i64)"]) g8;
    let g10 = start fast (emit (str.concat_all ["  br i1 ", same, ", label %", fast, ", label %", slow]) g9);
    let [bits, g11] = load_at w 8 g10;
    let [od, g12] = instr (str.concat_all ["bitcast i64 ", bits, " to double"]) g11;
    let known = if known_first { a } else { b };
    let [kd, g13] = double_of env known g12;
    let [d, g14] = instr (str.concat_all [float_op op, " double ",
        if known_first { kd } else { od }, ", ", if known_first { od } else { kd }]) g13;
    let [boxed, g15] = boxed_float d g14;
    let from_fast = Gen.label g15;
    let g16 = start slow (emit ("  br label %" + done) g15);
    // Whatever the other is, the runtime decides, and it takes words.
    let [kd2, g17] = double_of env known g16;
    let [kw, g18] = boxed_float kd2 g17;
    let [s, g19] = instr (str.concat_all ["call preserve_mostcc i64 ", cold_symbol (slow_name op), "(i64 %p, i64 ",
        if known_first { kw } else { w }, ", i64 ", if known_first { w } else { kw }, ")"]) g18;
    let g20 = raise_if_zero sp s g19;
    let from_slow = Gen.label g20;
    let g21 = start done (emit ("  br label %" + done) g20);
    instr (str.concat_all ["phi i64 [ ", boxed, ", %", from_fast, " ], [ ", s, ", %", from_slow, " ]"]) g21
};

/// `num.to_float`: a small integer in line, and what is not one by the runtime, whose answer
/// is a float or a raise.
let to_double : :string -> :string -> Gen -> [:string, Gen];
let to_double sp w g = {
    let [low, g1] = instr (str.concat_all ["and i64 ", w, ", 1"]) g;
    let [fix, g2] = instr (str.concat_all ["icmp eq i64 ", low, ", 1"]) g1;
    let [fast, g3] = label_of "small" g2;
    let [slow, g4] = label_of "large" g3;
    let [done, g5] = label_of "double" g4;
    let g6 = start fast (emit (str.concat_all ["  br i1 ", fix, ", label %", fast, ", label %", slow]) g5);
    let [raw, g7] = instr (str.concat_all ["ashr i64 ", w, ", 1"]) g6;
    let [d, g8] = instr (str.concat_all ["sitofp i64 ", raw, " to double"]) g7;
    let g9 = start slow (emit ("  br label %" + done) g8);
    let [s, g10] = instr (str.concat_all ["call preserve_mostcc i64 ", cold_symbol "to_float!", "(i64 %p, i64 ", w, ", i64 0)"]) g9;
    let g11 = raise_if_zero sp s g10;
    let [bits, g12] = load_at s 8 g11;
    let [d2, g13] = instr (str.concat_all ["bitcast i64 ", bits, " to double"]) g12;
    let from_slow = Gen.label g13;
    let g14 = start done (emit ("  br label %" + done) g13);
    instr (str.concat_all ["phi double [ ", d, ", %", fast, " ], [ ", d2, ", %", from_slow, " ]"]) g14
};

/// A frame for `rest` to return to, stored: where it is, and `rest`'s code.
let frame_for : :integer -> [:integer] -> core.Expr -> :map -> :string -> Gen -> [:string, :string, Gen];
let frame_for x live rest env sp g = {
    // One function per `seq`, however many copies of the code before it branch there: `x` is
    // fresh for each, and without this a chain of them doubles at every link.
    let size = 1 + list.length live;
    let [n, g2] = match map.lookup x (Gen.conts g) {
        Option.some(known) => [known, g],
        Option.none => {
            let m = Gen.next g;
            let g1 = g |> Gen.set_next (m + 1) |> Gen.set_conts ((Gen.conts g).[x => m]);
            [m, g1 |> Gen.set_data (list.cons (info_with ("@i_k" + to_string m) ("@k" + to_string m) 0 size 0 "null" "null" 0 (Gen.place g1)) (Gen.data g1))
                   |> Gen.set_pending (list.cons [("@k" + to_string m), live, x, rest] (Gen.pending g1))]
        },
    };
    let [below, g3] = reserve sp size g2;
    let g4 = store_at below 0 (str.concat_all ["ptrtoint (ptr @i_k", to_string n, " to i64)"]) g3;
    [below, "@k" + to_string n, store_live below live env g4]
};

let inline_budget = 64;

/// What is left of `budget` after `e`, below zero when it does not fit. It stops counting there,
/// since a function's chain of statements may be long and this is asked at each.
let core_within : core.Expr -> :integer -> :integer;
let core_within e !budget = if budget < 0 { budget } else {
    match e {
        core.Expr.choose(_, yes, no) => core_within no (core_within yes (budget - 1)),
        core.Expr.seq(_, _, inner, rest) => core_within rest (core_within inner (budget - 2)),
        core.Expr.catching(_, _, _, _, _) => 0 - 1,
        core.Expr.bind(_, _, rest) => core_within rest (budget - 1),
        _ => budget - 1,
    }
};

let header : :string -> :string;
let header symbol = str.concat_all ["define internal tailcc i64 ", symbol, "(i64 %p, i64 %sp0, i64 %a, i64 %b, i64 %c, i64 %d) {\nentry:\n",
    "  %pp = inttoptr i64 %p to ptr\n  %spp = inttoptr i64 %sp0 to ptr\n  %ap = inttoptr i64 %a to ptr\n",
    "  %ctxs = alloca i64\n  store i64 %p, ptr %ctxs\n"];

/// Close the function being generated, and start none.
let finish : :string -> Gen -> Gen;
//
// A function's names are its own (`local`), so two functions that do the same thing are the
// same text but for their symbol, and the second is written as an alias of the first. Most
// are continuations, and most of those are a handful of shapes -- a native called on what was
// forced, its answer handed on -- written again at every place one is forced: in `dreams`,
// 458,000 functions were 190,000 bodies.
let finish symbol g = {
    let body = str.concat_all (list.flat_map (fn l -> [l, "\n"]) (list.reverse (Gen.lines g)));
    let written = match map.lookup body (Gen.bodies g) {
        Option.some(first) => code_onto (str.concat_all [symbol, " = internal alias i64 (i64, i64, i64, i64, i64, i64), ptr ", first, "\n"]) g,
        Option.none => bodies_at ((Gen.bodies g).[body => symbol]) (code_onto (str.concat_all [header symbol, body, "}\n"]) g),
    };
    written |> Gen.set_lines [] |> Gen.set_label "entry" |> Gen.set_local 0 |> Gen.set_ptrs %{}
};

let bodies_at : %{:string => :string} -> Gen -> Gen;
let bodies_at !bodies g = Gen.set_bodies bodies g;

/// `g` with a function's text kept, made now: left to be made, it kept the function's lines.
let code_onto : :string -> Gen -> Gen;
let code_onto !text !g = codes_onto (list.cons text (Gen.code g)) g;

let codes_onto : [:string] -> Gen -> Gen;
let codes_onto !code g = Gen.set_code code g;

/// What comes after each `seq`, each a function that takes its frame apart. Doing one
/// may queue more, so this goes until there are none.
let drain : Gen -> Gen;
let drain g = match Gen.pending g {
    [] => g,
    [[symbol, live, x, rest], ..others] => {
        let g1 = Gen.set_pending others g;
        let [env, g2] = list.fold (fn [m, st] [i, v] -> {
            let [loaded, st1] = load_at "%sp0" (8 * (i + 1)) st;
            [m.[v => loaded], st1]
        }) [%{x => "%a"}, g1] (list.enumerate live);
        let [sp, g3] = instr (str.concat_all ["add i64 %sp0, ", to_string (8 * (1 + list.length live))]) g2;
        drain (finish symbol (expr rest env sp g3))
    },
};

/// At a function's entry and nowhere else, a collection may run: every other register
/// is an argument, and the runtime saves those as a frame. `extra` words of arguments
/// are on the stack, and the frame takes them in.
let safepoint : :string -> :integer -> Gen -> Gen;
let safepoint symbol extra g = {
    // Volatile: another thread sets this, and a function that calls itself and allocates nothing
    // becomes a loop, out of which LLVM would otherwise lift the load and never see it change.
    let [guard_ptr, g0b] = pointer_at "%p" 16 g;
    let [guard, g1] = instr ("load volatile i64, ptr " + guard_ptr) g0b;
    let [asked, g2] = instr (str.concat_all ["icmp ult i64 %sp0, ", guard]) g1;
    let [collect, g3] = label_of "collect" g2;
    let [go_on, g4] = label_of "go" g3;
    let g5 = start collect (emit (str.concat_all ["  br i1 ", asked, ", label %", collect, ", label %", go_on]) g4);
    let g6 = store_at "%p" 24 (str.concat_all ["ptrtoint (ptr ", symbol, " to i64)"]) g5;
    let g7 = store_at "%p" 32 (to_string extra) g6;
    start go_on (jump (rt_symbol g7 "collect_at_entry!") ["%p", "%sp0", "%a", "%b", "%c", "%d"] g7)
};

/// A function's place, as static words: what a raise from it or a frame of it reports.
let place_of : core.Function -> :string -> [[:string], :string];
let place_of f plain = match core.Function.place f {
    [name, path, line, col, made] => {
        let symbol = "@pl_" + plain;
        [[string_object ("@pln_" + plain) name, string_object ("@plp_" + plain) path,
          str.concat_all [symbol, " = internal constant <{ ptr, ptr, i64, i64, i64 }> <{ ptr @pln_", plain, ", ptr @plp_", plain,
                          ", i64 ", to_string line, ", i64 ", to_string col, ", i64 ", to_string made, " }>\n"]], symbol]
    },
    _ => [[], "null"],
};

/// One core function, and its infos.
let function : core.Function -> Gen -> Gen;
let function f g = {
    let symbol = core.Function.symbol f;
    let params = core.Function.params f;
    let captures = core.Function.captures f;
    let how = core.Function.how f;
    let plain = str.slice 1 (len symbol - 1) symbol;
    let arity = list.length params;
    let extra = if arity > 3 { arity - 3 } else { 0 };
    let [place_text, place_sym] = place_of f plain;
    let g0 = g |> Gen.set_lines [] |> Gen.set_label "entry" |> Gen.set_place place_sym
              |> (fn x -> data_onto (list.append place_text (Gen.data x)) x);
    let g1 = safepoint symbol extra g0;
    let registers = ["%b", "%c", "%d"];
    let env0 = list.fold (fn m [i, v] -> if i < 3 { m.[v => registers.[i]] } else { m }) %{} (list.enumerate params);
    let [env1, g2] = list.fold (fn [m, st] [i, v] ->
        if i < 3 { [m, st] } else {
            let [loaded, st1] = load_at "%sp0" (8 * (i - 3)) st;
            [m.[v => loaded], st1]
        }) [env0, g1] (list.enumerate params);
    let [env2, g3] = list.fold (fn [m, st] [i, v] -> {
        let [loaded, st1] = load_at "%a" (8 * (i + 1)) st;
        [m.[v => loaded], st1]
    }) [env1, g2] (list.enumerate captures);
    let [sp, g4] = sp_past (8 * extra) g3;
    let [sp1, g5] = if how == :function { [sp, g4] } else {
        // A thunk: its own frame says where the answer goes, and it is marked so that
        // reaching it again is reported rather than run.
        let [below, h1] = reserve sp 2 g4;
        let h2 = store_at below 0 "ptrtoint (ptr @i_update to i64)" h1;
        let h3 = store_at below 8 "%a" h2;
        let h4 = store_at "%a" 0 "ptrtoint (ptr @i_hole to i64)" h3;
        let [owner, h5] = load_at "%p" 120 h4;
        [below, filled "%a" (list.length captures - 1) (store_at "%a" 8 owner h5)]
    };
    let mask = (Gen.workers g).[symbol else []];
    let g5a = if how == :function && not (list.is_empty mask) { to_worker symbol mask g5 } else { g5 };
    let g6 = expr (core.Function.body f) env2 sp1 g5a;
    let g6a = finish symbol (emit (str.concat_all ["; ", core.Function.name f]) g6);
    let g7 = if how == :function && not (list.is_empty mask) { worker f mask g6a }
        else if how == :thunk && map.has symbol (Gen.once_syms g) { thunk_once f g6a }
        else { g6a };
    let infos = match how {
        :thunk => [info_text (info_symbol symbol) symbol 0 (if list.is_empty captures { 1 } else { list.length captures }) 0],
        :caf => [info_text (info_symbol symbol) symbol 0 1 0],
        _ => [
            string_object ("@fn_" + plain) (core.Function.name f),
            info_with ("@i_c" + plain) (rt_symbol g7 "code_value!") 3 (list.length captures) arity symbol ("@fn_" + plain) (if core.Function.impure f { 1 } else { 0 }) "null",
            str.concat_all ["@c_", plain, " = internal constant <{ ptr }> <{ ptr @i_c", plain, " }>, align 8\n"],
        ],
    };
    // A CAF is a shared thunk (`code_shared!` in rt/main.dr): every process may force it, and
    // whoever does evaluates a copy of the suspension beside it, in its own heap.
    let cafs = if how == :caf {
        [str.concat_all ["@caf_", plain, " = internal global <{ ptr, ptr, i64, i64 }> <{ ptr @i_shared, ptr @caft_", plain, ", i64 0, i64 0 }>, align 8\n"],
         str.concat_all ["@caft_", plain, " = internal constant <{ ptr, i64 }> <{ ptr ", info_symbol symbol, ", i64 1 }>, align 8\n"]]
    } else { [] };
    drain (data_onto (list.concat [cafs, infos, Gen.data g7]) g7)
};

// --- direct style ------------------------------------------------------------------------------
//
// The same core, written so that a function returns its answer (dreams/docs/aot-direct.md). A
// force is a test in line and, for what is not yet a value, a call (`force_d!`); a call of a
// known function is a call, and in tail position a `musttail` one, so a loop is still a loop; a
// `seq` is the code after a call, in the same function, its values in registers. What fails
// answers 0, as a native does, with the error in the context: each call is followed by a test
// of that, and a failure goes to the `catching` around it or out of the function.
//
// The runtime's own code still answers through frames on the process's stack, and each function
// here has a shim beside it, under its usual symbol, that the runtime jumps to: it calls the
// function and answers the frame on top, or unwinds. Infos keep pointing at the shims, and say
// where the direct entry is in their last word. Direct code reaches runtime code that answers
// through frames -- a machine native that may park, `raise!`, `apply!` for what is not an exact
// closure -- by a bridge: a frame whose code returns, so that the chain of jumps the call starts
// comes back to its caller with the answer, or with 0 when something unwinds into it.

/// A direct body's symbol: the shim's, with a `d`.
let direct_symbol : :string -> :string;
let direct_symbol symbol = symbol + "d";

/// Whether a call's target is runtime code that answers through frames.
let frame_target : :string -> :bool;
let frame_target symbol = str.starts_with "@m_" symbol || symbol == "@raise!";

/// The block goes where a failure goes: the handler around it, or out with 0.
let failing : Gen -> Gen;
let failing g = if Gen.err g != "" { emit ("  br label %" + Gen.err g) g } else { emit "  ret i64 0" g };

/// `v` of 0 fails; otherwise generation goes on in a block of its own.
let or_failing : :string -> Gen -> Gen;
let or_failing v g = {
    let [bad, g1] = instr (str.concat_all ["icmp eq i64 ", v, ", 0"]) g;
    let [fails, g2] = label_of "fails" g1;
    let [fine, g3] = label_of "fine" g2;
    let g4 = emit (str.concat_all ["  br i1 ", bad, ", label %", fails, ", label %", fine]) g3;
    start fine (failing (start fails g4))
};

/// `v` as the answer: to the block that joins, or out of the function.
let answered : :string -> Gen -> Gen;
let answered v g = if Gen.join g != "" {
    Gen.set_leaves (list.cons [Gen.label g, v, ""] (Gen.leaves g)) g |> emit ("  br label %" + Gen.join g)
} else { emit ("  ret i64 " + v) g };

/// Whether a call here is the last thing the function does, with nothing to catch its failure.
let in_tail : Gen -> :bool;
let in_tail g = Gen.join g == "" && Gen.err g == "";

/// A call of direct code, or a jump to it in tail position; then the answer.
let direct_call : :string -> [:string] -> Gen -> Gen;
let direct_call target args g0 = {
    let [ctx, g] = ctx_of g0;
    let all = list.cons ctx (list.drop 1 args);
    if in_tail g {
        let [r, g1] = instr (str.concat_all ["musttail call tailcc i64 ", target, "(", args_text all, ")"]) g;
        emit ("  ret i64 " + r) g1
    } else {
        let [v, g1] = instr (str.concat_all ["call tailcc i64 ", target, "(", args_text all, ")"]) g;
        answered v (or_failing v (may_have_moved g1))
    }
};

/// A frame whose code returns, on the stack below `sp`: where a bridge's chain comes back.
let bridge_below : :string -> Gen -> [:string, Gen];
let bridge_below sp g = {
    let [at, g1] = reserve sp 1 g;
    [at, store_at at 0 "ptrtoint (ptr @i_bridge to i64)" g1]
};

/// Whether the stack of frames has room below `sp` for a bridge and what the runtime pushes past
/// it: in direct style it cannot grow, and going below its floor would write over another stack.
/// Failing with a recursion too deep when it has not (`frames_full!`).
let frames_room : :string -> Gen -> Gen;
let frames_room sp g0 = {
    let [ctx, g] = ctx_of g0;
    let [floor, g1] = load_at ctx 816 g;
    let [low, g2] = instr (str.concat_all ["icmp ult i64 ", sp, ", ", floor]) g1;
    let [full, g3] = label_of "full" g2;
    let [room, g4] = label_of "room" g3;
    let g5 = start full (emit (str.concat_all ["  br i1 ", low, ", label %", full, ", label %", room]) g4);
    let [_, g6] = instr (str.concat_all ["call tailcc i64 ", rt_symbol g5 "frames_full!", "(", args_text [ctx, sp, "0", "0", "0", "0"], ")"]) g5;
    start room (failing g6)
};

/// Runtime code that answers through frames, called across a bridge: its answer, or 0.
let bridged : :string -> :string -> [:string] -> [:string] -> Gen -> [:string, Gen];
let bridged target sp regs extra g0 = {
    let g = frames_room sp g0;
    let [at, g1] = bridge_below sp g;
    let [below, g2] = pushing extra at g1;
    let pad = list.replicate (4 - list.length regs) "0";
    let [ctx, g3] = ctx_of g2;
    let [v, g4] = instr (str.concat_all ["call tailcc i64 ", target, "(", args_text (list.concat [[ctx, below], regs, pad]), ")"]) g3;
    [v, may_have_moved g4]
};

/// `v` evaluated: itself when it is a value, which is asked in line, and otherwise what
/// `force_d!` answers, or a failure.
let forced : :string -> :string -> Gen -> [:string, Gen];
let forced v sp g = {
    let [low, g1] = instr (str.concat_all ["and i64 ", v, ", 7"]) g;
    let [is_object, g2] = instr (str.concat_all ["icmp eq i64 ", low, ", 0"]) g1;
    let [object, g3] = label_of "object" g2;
    let [slow, g4] = label_of "force" g3;
    let [done, g5] = label_of "forced" g4;
    let from_start = Gen.label g5;
    let g6 = start object (emit (str.concat_all ["  br i1 ", is_object, ", label %", object, ", label %", done]) g5);
    let [info, g7] = load_at v 0 g6;
    let [kind, g8] = load_at info 8 g7;
    let [ready, g9] = instr (str.concat_all ["icmp ugt i64 ", kind, ", 2"]) g8;
    let g10 = start slow (emit (str.concat_all ["  br i1 ", ready, ", label %", done, ", label %", slow]) g9);
    // A thunk with a body of its own is called here; anything else is `force_d!`'s.
    let [is_thunk, g10a] = instr (str.concat_all ["icmp eq i64 ", kind, ", 0"]) g10;
    let [body, g10b] = load_at info 64 g10a;
    let [has_body, g10c] = instr (str.concat_all ["icmp ne i64 ", body, ", 0"]) g10b;
    let [direct, g10d] = instr (str.concat_all ["and i1 ", is_thunk, ", ", has_body]) g10c;
    let [general, g10e] = instr (str.concat_all ["ptrtoint ptr ", rt_symbol g10d "force_d!", " to i64"]) g10d;
    let [code, g10f] = instr (str.concat_all ["select i1 ", direct, ", i64 ", body, ", i64 ", general]) g10e;
    let [target, g10g] = instr (str.concat_all ["inttoptr i64 ", code, " to ptr"]) g10f;
    let [ctx, g10h] = ctx_of g10g;
    let [r, g11] = instr (str.concat_all ["call tailcc i64 ", target, "(", args_text [ctx, sp, v, "0", "0", "0"], ")"]) g10h;
    let g12 = or_failing r (may_have_moved g11);
    let from_slow = Gen.label g12;
    let g13 = start done (emit ("  br label %" + done) g12);
    instr (str.concat_all ["phi i64 [ ", v, ", %", from_start, " ], [ ", v, ", %", object, " ], [ ", r, ", %", from_slow, " ]"]) g13
};

/// Generate `e` in direct style: it ends the current block, answering out of the function, or
/// to `Gen.join` when that is set, or failing.
let dexpr : core.Expr -> :map -> :string -> Gen -> Gen;
let dexpr e env sp g = match e {
    core.Expr.ret(a) => answered (atom_text env a) g,
    core.Expr.enter(a) => {
        let [v, g1] = forced (atom_text env a) sp g;
        answered v g1
    },
    core.Expr.call(symbol, args) => dcall symbol "0" args env sp g,
    core.Expr.call_closure(f, symbol, args) => dcall symbol (atom_text env f) args env sp g,
    core.Expr.apply(f, args) => {
        let vals = list.map (atom_text env) args;
        let fv = atom_text env f;
        let count = list.length vals;
        let [low, g1] = instr (str.concat_all ["and i64 ", fv, ", 7"]) g;
        let [is_object, g2] = instr (str.concat_all ["icmp eq i64 ", low, ", 0"]) g1;
        let [object, g3] = label_of "object" g2;
        let [exact, g4] = label_of "exact" g3;
        let [general, g5] = label_of "general" g4;
        let g6 = start object (emit (str.concat_all ["  br i1 ", is_object, ", label %", object, ", label %", general]) g5);
        let [info, g7] = load_at fv 0 g6;
        let [kind, g8] = load_at info 8 g7;
        let [arity, g9] = load_at info 24 g8;
        let [is_closure, g10] = instr (str.concat_all ["icmp eq i64 ", kind, ", 3"]) g9;
        let [fits, g11] = instr (str.concat_all ["icmp eq i64 ", arity, ", ", to_string count]) g10;
        let [both, g12] = instr (str.concat_all ["and i1 ", is_closure, ", ", fits]) g11;
        let g13 = start exact (emit (str.concat_all ["  br i1 ", both, ", label %", exact, ", label %", general]) g12);
        let [code, g14] = load_at info 64 g13;
        let [target, g15] = instr (str.concat_all ["inttoptr i64 ", code, " to ptr"]) g14;
        let regs = list.take 3 vals;
        let [below, g16] = pushing (list.drop 3 vals) sp g15;
        let pad = list.replicate (3 - list.length regs) "0";
        let g16a = direct_call target (list.concat [["%p", below, fv], regs, pad]) g16;
        // Not an exact closure: a partial application that these fill, its function's arguments
        // all in registers, is called here too (`pap_calls`).
        let [slow, g16b] = label_of "slow" g16a;
        let g17 = start slow (pap_calls fv vals sp slow (start general g16b));
        // Anything else -- too few or too many, not a function -- is `apply!`'s, its arguments
        // on the stack below the bridge.
        let [v, g18] = bridged (rt_symbol g17 "apply!") sp [fv, to_string count] vals g17;
        answered v (or_failing v g18)
    },
    core.Expr.choose(a, yes, no) => {
        let v = atom_text env a;
        let [is_true, g1] = instr (str.concat_all ["icmp eq i64 ", v, ", ", core.true_word]) g;
        let [then_, g2] = label_of "then" g1;
        let [other, g3] = label_of "other" g2;
        let [else_, g4] = label_of "else" g3;
        let [wrong, g5] = label_of "wrong" g4;
        let g6 = start then_ (emit (str.concat_all ["  br i1 ", is_true, ", label %", then_, ", label %", other]) g5);
        let g7 = start other (dexpr yes env sp g6);
        let [is_false, g8] = instr (str.concat_all ["icmp eq i64 ", v, ", ", core.false_word]) g7;
        let g9 = start wrong (emit (str.concat_all ["  br i1 ", is_false, ", label %", else_, ", label %", wrong]) g8);
        let [_, g10] = bridged (rt_symbol g9 "not_bool!") sp [v] [] g9;
        dexpr no env sp (start else_ (failing g10))
    },
    core.Expr.seq(x, live, inner, rest) if map.has x (Gen.dups g) || core_within rest inline_budget < 0 => {
        let [v, g1] = match inner {
            core.Expr.enter(a) => forced (atom_text env a) sp g,
            _ => valued inner env sp g,
        };
        if v == "" { g1 } else { out_of_line x live rest v env sp g1 }
    },
    core.Expr.seq(x, _, core.Expr.enter(a), rest) => {
        let [v, g1] = forced (atom_text env a) sp g;
        dexpr rest env.[x => v] sp g1
    },
    core.Expr.entry_force(a, x, _, _, body) => {
        let [v, g1] = forced (atom_text env a) sp g;
        dexpr body env.[x => v] sp g1
    },
    core.Expr.seq(x, _, inner, rest) => {
        let [v, g1] = valued inner env sp g;
        if v == "" { g1 } else { dexpr rest env.[x => v] sp g1 }
    },
    core.Expr.catching(x, _, body, handler, cleanup) => {
        let [j, g1] = label_of "join" g;
        let [h, g2] = label_of "caught" g1;
        let [outer_join, outer_leaves, outer_err] = [Gen.join g2, Gen.leaves g2, Gen.err g2];
        let g3 = dexpr body env sp (g2 |> Gen.set_join j |> Gen.set_leaves [] |> Gen.set_err h);
        // The error, or 0 when it is not this one's to catch -- a kill, past anything but a cleanup.
        let g4 = start h (Gen.set_err outer_err g3);
        let [ctx, g4a] = ctx_of g4;
        let [caught, g5] = instr (str.concat_all ["call tailcc i64 ", rt_symbol g4a "caught_d!", "(",
            args_text [ctx, sp, if cleanup { "1" } else { "0" }, "0", "0", "0"], ")"]) g4a;
        let g6 = dexpr handler env.[x => caught] sp (or_failing caught g5);
        let leaves = list.reverse (Gen.leaves g6);
        let g7 = g6 |> Gen.set_join outer_join |> Gen.set_leaves outer_leaves;
        if list.is_empty leaves { g7 } else {
            let [v, g8] = instr ("phi i64 " + phi_args (list.map (fn l -> [l.[1], l.[0]]) leaves)) (start j g7);
            answered v g8
        }
    },
    // A cheap tree forced at once (`core.eager_value`): forced only where it could not be done
    // now, so that the number made in line is known to be one where it is used.
    core.Expr.bind(x, core.Rhs.eager(tree, symbol, payload), core.Expr.seq(y, _, core.Expr.enter(core.Atom.var(z)), rest))
        if z == x && not (map.has y (Gen.dups g)) && core_within rest inline_budget >= 0 => {
        let [v, g1] = eagerly_then tree env symbol (list.map (atom_text env) payload) sp g;
        dexpr rest env.[x => v].[y => v] sp g1
    },
    core.Expr.bind(x, r, rest) => {
        let [v, g1] = rhs r env sp g;
        dexpr rest env.[x => v] sp g1
    },
    core.Expr.raised(a) => {
        let [_, g1] = bridged (rt_symbol g "raise!") sp [str.concat_all ["ptrtoint (ptr ", Gen.place g, " to i64)"], atom_text env a] [] g;
        failing g1
    },
    core.Expr.raise_text(_) => {
        let [_, g1] = bridged (rt_symbol g "native_failed!") sp [] [] g;
        failing g1
    },
};

/// `inner`'s answer, in a block that follows it: generated with its answers joined, and their
/// phi. "" when every way through it fails, and nothing follows.
let valued : core.Expr -> :map -> :string -> Gen -> [:string, Gen];
let valued inner env sp g = {
    let [j, g1] = label_of "join" g;
    let [outer_join, outer_leaves] = [Gen.join g1, Gen.leaves g1];
    let g2 = dexpr inner env sp (g1 |> Gen.set_join j |> Gen.set_leaves []);
    let leaves = list.reverse (Gen.leaves g2);
    let g3 = g2 |> Gen.set_join outer_join |> Gen.set_leaves outer_leaves;
    if list.is_empty leaves { ["", g3] } else {
        instr ("phi i64 " + phi_args (list.map (fn l -> [l.[1], l.[0]]) leaves)) (start j g3)
    }
};

/// What follows a `seq` the core repeats, or a long one, called as a function of its own -- the
/// answer in `%a`, what it needs as its arguments -- and written once (`drain_d`). In line, a
/// repeated one was written at every copy, and a `match`'s decision tree was one function, where
/// code that jumps had a continuation for each `seq` and wrote each different one once
/// (`finish`): `show_all`, with `show` inlined into it, was 49 MB of IR and four minutes of LLVM.
let out_of_line : :integer -> [:integer] -> core.Expr -> :string -> :map -> :string -> Gen -> Gen;
let out_of_line x live rest v env sp g = {
    let [symbol, g1] = match map.lookup x (Gen.dconts g) {
        Option.some(known) => [known, g],
        Option.none => {
            let k = "@kd" + to_string (Gen.next g);
            [k, g |> Gen.set_next (Gen.next g + 1) |> Gen.set_dconts ((Gen.dconts g).[x => k])
                  |> Gen.set_dpending (list.cons [k, live, x, rest] (Gen.dpending g))]
        },
    };
    let vals = list.map (fn y -> env.[y]) live;
    let regs = list.take 3 vals;
    let [below, g2] = pushing (list.drop 3 vals) sp g1;
    let pad = list.replicate (3 - list.length regs) "0";
    direct_call symbol (list.concat [["%p", below, v], regs, pad]) g2
};

/// The functions `out_of_line` asked for, each taking its arguments apart as a call's are. Doing
/// one may ask for more.
let drain_d : Gen -> Gen;
let drain_d g = match Gen.dpending g {
    [] => g,
    [[symbol, live, x, rest], ..others] => {
        let g0 = g |> Gen.set_dpending others |> Gen.set_lines [] |> Gen.set_label "entry" |> Gen.set_join "" |> Gen.set_err ""
                   |> Gen.set_leaves [] |> Gen.set_moved false |> Gen.set_pcur "";
        let registers = ["%b", "%c", "%d"];
        let extra = if list.length live > 3 { list.length live - 3 } else { 0 };
        let [env, g1] = list.fold (fn [m, st] [i, y] ->
            if i < 3 { [m.[y => registers.[i]], st] } else {
                let [loaded, st1] = load_at "%sp0" (8 * (i - 3)) st;
                [m.[y => loaded], st1]
            }) [%{x => "%a"}, g0] (list.enumerate live);
        let [sp, g2] = sp_past (8 * extra) g1;
        drain_d (finish symbol (dexpr rest env sp g2))
    },
};

/// The variable of each `seq` in `e`, bound more than once. A repeated one is the same tree each
/// time, and is not walked again.
let seq_dups : core.Expr -> :map -> :map;
let seq_dups e !seen = match e {
    core.Expr.seq(x, _, inner, rest) => if map.has x seen { seen.[x => 2] } else { seq_dups rest (seq_dups inner seen.[x => 1]) },
    core.Expr.entry_force(_, _, _, _, body) => seq_dups body seen,
    core.Expr.catching(_, _, body, handler, _) => seq_dups handler (seq_dups body seen),
    core.Expr.choose(_, yes, no) => seq_dups no (seq_dups yes seen),
    core.Expr.bind(_, _, rest) => seq_dups rest seen,
    _ => seen,
};

/// The `seq`s of `body` that `dexpr` writes out of line.
let dups_of : core.Expr -> :map;
let dups_of body = map.filter (fn _ n -> n > 1) (seq_dups body %{});

/// A partial application `f` of `kind` given `vals`, called directly when the closure it holds
/// takes exactly what it held and these, three at most, so that all of them are registers:
/// `list.map (step 0.01) ps` went through `apply!` for every element. Else to `slow`.
let pap_calls : :string -> [:string] -> :string -> :string -> Gen -> Gen;
let pap_calls f vals sp slow g00 = {
    let count = list.length vals;
    if count >= 3 { emit ("  br label %" + slow) g00 } else {
        // Reached also when `f` is no object at all.
        let [flow, g0a] = instr (str.concat_all ["and i64 ", f, ", 7"]) g00;
        let [fobj, g0b] = instr (str.concat_all ["icmp eq i64 ", flow, ", 0"]) g0a;
        let [look, g0c] = label_of "look" g0b;
        let g0 = start look (emit (str.concat_all ["  br i1 ", fobj, ", label %", look, ", label %", slow]) g0c);
        let [finfo, g0d] = load_at f 0 g0;
        let [kind, g] = load_at finfo 8 g0d;
        let [is_pap, g1] = instr (str.concat_all ["icmp eq i64 ", kind, ", 4"]) g;
        let [pap, g2] = label_of "pap" g1;
        let g3 = start pap (emit (str.concat_all ["  br i1 ", is_pap, ", label %", pap, ", label %", slow]) g2);
        let [count_word, g4] = load_at f 8 g3;
        let [inner, g5] = load_at f 16 g4;
        let [low, g6] = instr (str.concat_all ["and i64 ", inner, ", 7"]) g5;
        let [is_object, g7] = instr (str.concat_all ["icmp eq i64 ", low, ", 0"]) g6;
        let [obj, g8] = label_of "inner" g7;
        let g9 = start obj (emit (str.concat_all ["  br i1 ", is_object, ", label %", obj, ", label %", slow]) g8);
        let [info, g10] = load_at inner 0 g9;
        let [ikind, g11] = load_at info 8 g10;
        let [arity, g12] = load_at info 24 g11;
        let [is_closure, g13] = instr (str.concat_all ["icmp eq i64 ", ikind, ", 3"]) g12;
        // Held, as the count word says it: one more than it, tagged.
        let [held, g14] = instr (str.concat_all ["ashr i64 ", count_word, ", 1"]) g13;
        let [held1, g15] = instr (str.concat_all ["sub i64 ", held, ", 1"]) g14;
        let [total, g16] = instr (str.concat_all ["add i64 ", held1, ", ", to_string count]) g15;
        let [fits, g17] = instr (str.concat_all ["icmp eq i64 ", arity, ", ", total]) g16;
        let [ok, g18] = instr (str.concat_all ["and i1 ", is_closure, ", ", fits]) g17;
        let [code, g19] = load_at info 64 g18;
        let [target, g20] = instr (str.concat_all ["inttoptr i64 ", code, " to ptr"]) g19;
        // One way for each number held that leaves room: 1 or 2 with one given, 1 with two.
        list.fold (fn st h -> {
            let [here, st1] = label_of "held" st;
            let [next, st2] = label_of "next" st1;
            let [is_h, st3] = instr (str.concat_all ["icmp eq i64 ", held1, ", ", to_string h]) st2;
            let [both, st4] = instr (str.concat_all ["and i1 ", ok, ", ", is_h]) st3;
            let st5 = start here (emit (str.concat_all ["  br i1 ", both, ", label %", here, ", label %", next]) st4);
            let [kept, st6] = list.fold (fn [acc, gg] i -> {
                let [w, gg1] = load_at f (24 + 8 * i) gg;
                [list.append acc [w], gg1]
            }) [[], st5] (list.range 0 h);
            let args = list.append kept vals;
            let pad = list.replicate (3 - list.length args) "0";
            start next (direct_call target (list.concat [["%p", sp, inner], args, pad]) st6)
        }) g20 (list.range 1 (4 - count)) |> emit ("  br label %" + slow)
    }
};

/// A known function called: its direct body, or runtime code across a bridge.
let dcall : :string -> :string -> [core.Atom] -> :map -> :string -> Gen -> Gen;
let dcall symbol self args env sp g = {
    let vals = list.map (atom_text env) args;
    let regs = list.take 3 vals;
    let extra = list.drop 3 vals;
    if frame_target symbol {
        let [v, g1] = bridged (target_of g symbol) sp (list.cons self regs) extra g;
        answered v (or_failing v g1)
    } else {
        let [below, g1] = pushing extra sp g;
        let pad = list.replicate (3 - list.length regs) "0";
        direct_call (direct_symbol (target_of g1 symbol)) (list.concat [["%p", below, self], regs, pad]) g1
    }
};

/// At a direct function's entry: the guard against the machine's stack pointer, which is how
/// both a stack run too deep and a collection or a switch asked for are seen (`entry_d!`). It
/// comes after the arguments past the third are read: below `sp` they are words, not a frame,
/// and the collector reads the stack from `sp` as frames, while what is in hand is where it
/// reads conservatively.
///
/// Its stop path, for a function whose arguments are all in registers, is the runtime's (`stop_d!`),
/// which calls the function again from the top once it has done what was asked. A function with
/// more than three keeps the stop path in line and goes on from where it was: called again, it
/// would read its arguments past the third again from below `sp`, where the collector neither
/// reads nor moves them and a yield writes its bridge -- `22_ml` came back with a float that was not.
let dsafepoint : :string -> :string -> :integer -> Gen -> Gen;
let dsafepoint self sp extra g = {
    let asm_ = if Gen.arch g == 1 { "call i64 asm \"mov $0, sp\", \"=r\"()" } else { "call i64 asm \"movq %rsp, $0\", \"=r\"()" };
    let [here, g0] = instr asm_ g;
    let [guard_ptr, g0b] = pointer_at "%p" 16 g0;
    let [guard, g1] = instr ("load volatile i64, ptr " + guard_ptr) g0b;
    let [asked, g2] = instr (str.concat_all ["icmp ult i64 ", here, ", ", guard]) g1;
    let [stop, g3] = label_of "stop" g2;
    let [go_on, g4] = label_of "go" g3;
    let g5 = start stop (emit (str.concat_all ["  br i1 ", asked, ", label %", stop, ", label %", go_on]) g4);
    // What a call again needs that the registers do not say: which function, and where its stack
    // stood (`segment_call!`).
    let g5a = store_at "%p" 24 (str.concat_all ["ptrtoint (ptr ", self, " to i64)"]) g5;
    let g5b = store_at "%p" 32 "%sp0" g5a;
    if extra == 0 {
        // The rest is `stop_d!`'s, and the way on from here knows nothing was called: the context
        // is still `%p`.
        let [r, g6] = instr (str.concat_all ["musttail call tailcc i64 ", rt_symbol g5b "stop_d!", "(", args_text ["%p", sp, "%a", "%b", "%c", "%d"], ")"]) g5b;
        start go_on (emit ("  ret i64 " + r) g6)
    } else {
        let [r, g6] = instr (str.concat_all ["call tailcc i64 ", rt_symbol g5b "entry_d!", "(", args_text ["%p", sp, "%a", "%b", "%c", "%d"], ")"]) g5b;
        let g7 = or_failing r (may_have_moved g6);
        // Run to its end on a segment of its own: that is the answer.
        let [ctx, g8] = ctx_of g7;
        let [ran, g9] = load_at ctx 808 g8;
        let [elsewhere, g10] = instr (str.concat_all ["icmp ne i64 ", ran, ", 0"]) g9;
        let [answer, g11] = label_of "ran" g10;
        let g12 = start answer (emit (str.concat_all ["  br i1 ", elsewhere, ", label %", answer, ", label %", go_on]) g11);
        let g13 = store_at ctx 808 "0" g12;
        start go_on (emit ("  ret i64 " + r) g13)
    }
};

/// The shim under a function's own symbol: the direct body called, and its answer given to the
/// frame on top past `extra` words of arguments, or an unwinding from there.
let shim : :string -> :integer -> Gen -> Gen;
let shim symbol extra g0 = {
    let g = g0 |> Gen.set_moved false |> Gen.set_pcur "";
    let [v, g1a] = instr (str.concat_all ["call tailcc i64 ", direct_symbol symbol, "(i64 %p, i64 %sp0, i64 %a, i64 %b, i64 %c, i64 %d)"]) g;
    let [ctx, g1] = ctx_of (may_have_moved g1a);
    let [sp, g2] = sp_past (8 * extra) g1;
    let [bad, g3] = instr (str.concat_all ["icmp eq i64 ", v, ", 0"]) g2;
    let [fails, g4] = label_of "fails" g3;
    let [fine, g5] = label_of "fine" g4;
    let g6 = start fine (emit (str.concat_all ["  br i1 ", bad, ", label %", fails, ", label %", fine]) g5);
    let g7 = start fails (jump (rt_symbol g6 "return!") [ctx, sp, v, "0", "0", "0"] g6);
    finish symbol (jump (rt_symbol g7 "native_failed!") [ctx, sp, "0", "0", "0", "0"] g7)
};

/// One core function in direct style, its shim and its infos.
let function_d : core.Function -> Gen -> Gen;
let function_d f g = {
    let symbol = core.Function.symbol f;
    let params = core.Function.params f;
    let captures = core.Function.captures f;
    let how = core.Function.how f;
    let plain = str.slice 1 (len symbol - 1) symbol;
    let arity = list.length params;
    let extra = if arity > 3 { arity - 3 } else { 0 };
    let [place_text, place_sym] = place_of f plain;
    let g0 = g |> Gen.set_lines [] |> Gen.set_label "entry" |> Gen.set_place place_sym |> Gen.set_join "" |> Gen.set_err ""
              |> Gen.set_leaves [] |> Gen.set_moved false |> Gen.set_pcur "" |> (fn x -> data_onto (list.append place_text (Gen.data x)) x);
    let g1 = Gen.set_dups (dups_of (core.Function.body f)) g0;
    let registers = ["%b", "%c", "%d"];
    let env0 = list.fold (fn m [i, v] -> if i < 3 { m.[v => registers.[i]] } else { m }) %{} (list.enumerate params);
    let [env1, g2] = list.fold (fn [m, st] [i, v] ->
        if i < 3 { [m, st] } else {
            let [loaded, st1] = load_at "%sp0" (8 * (i - 3)) st;
            [m.[v => loaded], st1]
        }) [env0, g1] (list.enumerate params);
    let [env2, g3] = list.fold (fn [m, st] [i, v] -> {
        let [loaded, st1] = load_at "%a" (8 * (i + 1)) st;
        [m.[v => loaded], st1]
    }) [env1, g2] (list.enumerate captures);
    let [sp, g4a] = sp_past (8 * extra) g3;
    let g4 = dsafepoint (direct_symbol symbol) sp extra g4a;
    let g6 = if how == :function { dexpr (core.Function.body f) env2 sp g4 } else { updating (core.Function.body f) captures env2 sp g4 };
    let g7 = drain_d (finish (direct_symbol symbol) (emit (str.concat_all ["; ", core.Function.name f]) g6));
    let g8 = shim symbol extra (g7 |> Gen.set_lines [] |> Gen.set_label "entry");
    let g9 = if how == :thunk && map.has symbol (Gen.once_syms g) { thunk_once_d f g8 } else { g8 };
    let size = if list.is_empty captures { 1 } else { list.length captures };
    let infos = match how {
        :thunk => [info_direct (info_symbol symbol) symbol 0 size 0 "null" "null" 0 "null" (direct_symbol symbol)],
        :caf => [info_direct (info_symbol symbol) symbol 0 1 0 "null" "null" 0 "null" (direct_symbol symbol)],
        _ => [
            string_object ("@fn_" + plain) (core.Function.name f),
            info_direct ("@i_c" + plain) (rt_symbol g9 "code_value!") 3 (list.length captures) arity symbol ("@fn_" + plain)
                (if core.Function.impure f { 1 } else { 0 }) "null" (direct_symbol symbol),
            str.concat_all ["@c_", plain, " = internal constant <{ ptr }> <{ ptr @i_c", plain, " }>, align 8\n"],
        ],
    };
    let cafs = if how == :caf {
        [str.concat_all ["@caf_", plain, " = internal global <{ ptr, ptr, i64, i64 }> <{ ptr @i_shared, ptr @caft_", plain, ", i64 0, i64 0 }>, align 8\n"],
         str.concat_all ["@caft_", plain, " = internal constant <{ ptr, i64 }> <{ ptr ", info_symbol symbol, ", i64 1 }>, align 8\n"]]
    } else { [] };
    data_onto (list.concat [cafs, infos, Gen.data g9]) g9
};

/// A thunk's body, which marks it a hole, evaluates, and writes the answer over it -- or, if
/// that fails, an indirection to the raise, which is what reaching it again does
/// (`thunk_raised_d!`).
let updating : core.Expr -> [:integer] -> :map -> :string -> Gen -> Gen;
let updating body captures env sp g = {
    let h1 = store_at "%a" 0 "ptrtoint (ptr @i_hole to i64)" g;
    let [owner, h2] = load_at "%p" 120 h1;
    let h3 = filled "%a" (list.length captures - 1) (store_at "%a" 8 owner h2);
    let [j, h4] = label_of "answer" h3;
    let [r, h5] = label_of "raised" h4;
    let h6 = dexpr body env sp (h5 |> Gen.set_join j |> Gen.set_leaves [] |> Gen.set_err r);
    let leaves = list.reverse (Gen.leaves h6);
    let h7 = start r (h6 |> Gen.set_join "" |> Gen.set_leaves [] |> Gen.set_err "");
    let [ctx, h7a] = ctx_of h7;
    let [_, h8] = instr (str.concat_all ["call tailcc i64 ", rt_symbol h7a "thunk_raised_d!", "(", args_text [ctx, sp, "%a", "0", "0", "0"], ")"]) h7a;
    let h9 = emit "  ret i64 0" h8;
    if list.is_empty leaves { h9 } else {
        let [v, h10] = instr ("phi i64 " + phi_args (list.map (fn l -> [l.[1], l.[0]]) leaves)) (start j h9);
        let h11 = store_at "%a" 8 v h10;
        let h12 = store_at "%a" 0 "ptrtoint (ptr @i_ind to i64)" h11;
        emit ("  ret i64 " + v) (remembered "%a" 8 v h12)
    }
};

/// The word at `object + offset` just written with `v`, remembered when `v` is an object and the
/// word is not in the nursery, as the collector's generations need (`remember!` in rt/main.dr):
/// a thunk may be old by the time it is updated, and what it is updated with new. Most are not --
/// a thunk is updated soon after it is made -- and the test of where it is, against the
/// nursery's address space in the world (`w_young_lo`, `w_young_size`), is the whole cost then.
let remembered : :string -> :integer -> :string -> Gen -> Gen;
let remembered object offset v g = {
    // Only where the word is, in line: whether `v` is an object is asked on the way that is
    // rarely taken (`remember_value!`), since the thunk updated is nearly always in the nursery.
    let [at, g1] = instr (str.concat_all ["add i64 ", object, ", ", to_string offset]) g;
    let [lo, g2] = instr "load i64, ptr getelementptr (i8, ptr @i_world, i64 656)" g1;
    let [size, g3] = instr "load i64, ptr getelementptr (i8, ptr @i_world, i64 664)" g2;
    let [off, g4] = instr (str.concat_all ["sub i64 ", at, ", ", lo]) g3;
    let [young, g5] = instr (str.concat_all ["icmp ult i64 ", off, ", ", size]) g4;
    let [note, g6] = label_of "remember" g5;
    let [done, g7] = label_of "remembered" g6;
    let g8 = start note (emit (str.concat_all ["  br i1 ", young, ", label %", done, ", label %", note]) g7);
    let [ctx, g9] = ctx_of g8;
    let [_, g10] = instr (str.concat_all ["call preserve_mostcc i64 ", cold_symbol "remember_value!", "(i64 ", ctx, ", i64 ", at, ", i64 ", v, ")"]) g9;
    start done (emit ("  br label %" + done) g10)
};

/// The entry of a thunk entered at most once: no hole, no update.
let thunk_once_d : core.Function -> Gen -> Gen;
let thunk_once_d f g = {
    let symbol = core.Function.symbol f;
    let osym = symbol + "o";
    let captures = core.Function.captures f;
    let g0 = g |> Gen.set_lines [] |> Gen.set_label "entry" |> Gen.set_join "" |> Gen.set_err "" |> Gen.set_leaves []
              |> Gen.set_moved false |> Gen.set_pcur "" |> Gen.set_dups (dups_of (core.Function.body f));
    let [env, g2a] = list.fold (fn [m, st] [i, v] -> {
        let [loaded, st1] = load_at "%a" (8 * (i + 1)) st;
        [m.[v => loaded], st1]
    }) [%{}, g0] (list.enumerate captures);
    let g2 = dsafepoint (direct_symbol osym) "%sp0" 0 g2a;
    let g3 = dexpr (core.Function.body f) env "%sp0" g2;
    let g4 = drain_d (finish (direct_symbol osym) (emit (str.concat_all ["; ", core.Function.name f, " (entered once)"]) g3));
    let g5 = shim osym 0 (g4 |> Gen.set_lines [] |> Gen.set_label "entry");
    let size = if list.is_empty captures { 1 } else { list.length captures };
    datum_onto (info_direct (info_symbol osym) osym 0 size 0 "null" "null" 0 "null" (direct_symbol osym)) g5
};

/// `g` with its data, made now: left to be made, the data of each function held the
/// generator it was made from, and through it every one before.
let data_onto : [:string] -> Gen -> Gen;
let data_onto !data g = Gen.set_data data g;

/// `g` with one more datum, made now, for the same reason.
let datum_onto : :string -> Gen -> Gen;
let datum_onto !text !g = data_onto (list.cons text (Gen.data g)) g;

/// A string as a static object, laid out as the runtime's `new_string!` makes one.
let string_object : :string -> :string -> :string;
let string_object symbol text = {
    let n = to_string (len text + 1);
    str.concat_all [symbol, " = internal constant <{ ptr, i64, [", n, " x i8] }> <{ ptr @i_string, i64 ",
                    to_string (len text), ", [", n, " x i8] c\"", dialect.escaped text, "\\00\" }>, align 8\n"]
};

/// The words of an object past its first two made a filler, once the object has become a hole
/// of two words: a chunk stays readable object by object from its start, which is how a chunk
/// pinned by a word on the stack is walked (`scan_pinned!` in rt/main.dr). A word is `@i_fill`,
/// two are two of them, and more are a string of what is left over.
let filled : :string -> :integer -> Gen -> Gen;
let filled at words g = match words {
    1 => store_at at 16 "ptrtoint (ptr @i_fill to i64)" g,
    2 => store_at at 24 "ptrtoint (ptr @i_fill to i64)" (store_at at 16 "ptrtoint (ptr @i_fill to i64)" g),
    n => if n < 1 { g } else {
        store_at at 24 (to_string ((n - 3) * 8)) (store_at at 16 "ptrtoint (ptr @i_string to i64)" g)
    },
};

/// What every program has: the infos the runtime names, and its entry to C's `main`.
let fixed_infos : Gen -> [:string];
let fixed_infos g = {
    let rt = fn name -> rt_symbol g name;
    [info_text "@i_ind" (rt "code_ind!") 1 1 0,
     info_text "@i_hole" (rt "code_hole!") 2 1 0,
     info_text "@i_pap" (rt "code_value!") 4 0 0,
     info_text "@i_cons" (rt "code_value!") 5 2 0,
     info_text "@i_float" (rt "code_value!") 6 1 0,
     // What a word that is no object is read as, by a test that must not branch (`is_float_word`).
     "@flt_zero = internal constant <{ i64, i64 }> zeroinitializer, align 8\n",
     info_text "@i_string" (rt "code_value!") 7 0 0,
     // A word of a filler (`filled`): of a kind with no values, and one word long.
     info_text "@i_fill" (rt "code_value!") 6 0 0,
     info_text "@i_array" (rt "code_value!") 8 0 0,
     info_text "@i_record" (rt "code_value!") 9 0 0,
     // A record of floats holding their bits, which the collector copies and does not scan.
     info_text "@i_record_f" (rt "code_value!") 18 0 0,
     info_text "@i_map" (rt "code_value!") 10 0 0,
     info_text "@i_map_leaf" (rt "code_value!") 11 4 0,
     // The same five, for one known to be evaluated all the way down (`all_evaluated!` in
     // rt/main.dr), which a deep force need not walk again.
     info_text "@i_cons_s" (rt "code_value!") 5 2 0,
     info_text "@i_array_s" (rt "code_value!") 8 0 0,
     info_text "@i_record_s" (rt "code_value!") 9 0 0,
     info_text "@i_map_s" (rt "code_value!") 10 0 0,
     info_text "@i_map_leaf_s" (rt "code_value!") 11 4 0,
     // And for one also fit to share: every closure in it has its captures evaluated.
     info_text "@i_cons_x" (rt "code_value!") 5 2 0,
     info_text "@i_array_x" (rt "code_value!") 8 0 0,
     info_text "@i_record_x" (rt "code_value!") 9 0 0,
     info_text "@i_map_x" (rt "code_value!") 10 0 0,
     info_text "@i_big" (rt "code_value!") 12 0 0,
     info_text "@i_error" (rt "code_value!") 13 3 0,
     info_text "@i_raised" (rt "code_raised!") 0 1 0,
     info_text "@i_deferred2" (rt "code_deferred2!") 0 3 0,
     info_text "@i_update" (rt "frame_update!") 21 2 0,
     info_text "@i_shared" (rt "code_shared!") 0 3 0,
     info_text "@i_shared_hole" (rt "code_shared_hole!") 2 3 0,
     info_text "@i_m_enter" (rt "m_enter!") 0 0 0,
     info_text "@i_shared_update" (rt "frame_shared_update!") 24 2 0,
     info_text "@i_halt" (rt "code_halt!") 22 1 0,
     info_text "@i_retry" (rt "frame_resume_entry!") 0 0 0,
     info_text "@i_retry_call" (rt "frame_retry_call!") 0 5 0,
     info_text "@i_enter_again" (rt "frame_enter_again!") 0 2 0,
     info_text "@i_start" (rt "frame_start!") 0 2 0,
     info_text "@i_process" (rt "code_value!") 14 1 0,
     info_text "@i_trunk" (rt "code_value!") 15 3 0,
     // A trunk known to be evaluated all the way down; a trunk is never changed, only remade.
     info_text "@i_trunk_s" (rt "code_value!") 15 3 0,
     info_text "@i_trunk_x" (rt "code_value!") 15 3 0,
     info_text "@i_tensor" (rt "code_value!") 16 0 0,
     info_text "@i_module" (rt "code_value!") 17 2 0,
     info_text "@i_m_join" (rt "join_m!") 0 0 0,
     info_text "@i_m_recv" (rt "recv_m!") 0 0 0,
     info_text "@i_m_await" (rt "await_message_m!") 0 0 0,
     info_text "@i_m_sleep" (rt "sleep_until_m!") 0 0 0,
     info_text "@i_m_child" (rt "child_wait_m!") 0 0 0,
     info_text "@i_m_read" (rt "io_read_m!") 0 0 0,
     info_text "@i_m_write" (rt "io_write_m!") 0 0 0,
     info_text "@i_m_accept" (rt "net_accept_m!") 0 0 0,
     info_text "@i_m_connected" (rt "net_connected_m!") 0 0 0,
     info_text "@i_m_connect" (rt "net_connect_m!") 0 0 0,
     info_text "@i_m_tls_handshake" (rt "tls_handshake_m!") 0 0 0,
     info_with "@i_cb_return" (rt "frame_cb_return!") 20 2 0 (rt "cb_raised!") "null" 0 "null",
     info_text "@i_apply_rest" (rt "frame_apply_rest!") 0 0 0,
     // Where a bridge from direct code comes back: a frame of one word whose code returns.
     info_text "@i_bridge" (rt "frame_bridge!") 25 1 0]
};

/// The functions the machine itself calls or lays out.
let runtime_roots : [:string];
let runtime_roots = ["init!", "run_process!", "alloc!", "enter!", "apply!", "raise!", "collect_at_entry!", "code_value!",
                     "code_ind!", "code_hole!", "frame_update!", "code_shared!", "code_shared_hole!", "frame_shared_update!", "worker_loop!", "pool_loop!", "m_enter!", "code_halt!", "frame_apply_rest!", "code_raised!",
                     "code_deferred2!", "frame_catch_return!", "native_failed!", "not_bool!", "frame_resume_entry!",
                     "frame_retry_call!", "frame_enter_again!", "frame_start!", "join_m!", "recv_m!",
                     "await_message_m!", "sleep_until_m!", "child_wait_m!", "io_read_m!", "io_write_m!", "net_accept_m!", "net_connect_m!", "net_connected_m!", "set_args!", "tls_handshake_m!", "ffi_call_m!", "cb_enter!", "frame_cb_return!", "cb_raised!",
                     "to_float!", "add_slow!", "sub_slow!", "mul_slow!", "div_slow!", "mod_slow!",
                     "eq_slow!", "ne_slow!", "lt_slow!", "le_slow!", "gt_slow!", "ge_slow!",
                     // What direct-style code calls (`dexpr`).
                     "return!", "force_d!", "entry_d!", "caught_d!", "thunk_raised_d!", "frame_bridge!", "run_root!", "frames_full!"];

/// What the runtime reaches in the library by name, as function values.
let library_roots : %{:string => :string};
let library_roots = %{"lib_concat_lists" => "concat_lists", "lib_equal" => "equal", "lib_not_equal" => "not_equal",
                      "lib_uncaught" => "uncaught!", "lib_finish" => "finish!"};

/// The atoms in the order the runtime counts them (`atom_word` in rt/main.dr).
let first_atoms : [:string];
let first_atoms = ["integer", "float", "char", "bool", "unit", "string", "atom", "list", "array", "map",
                   "function", "record", "error", "no_such_key", "out_of_bounds", "type_error", "divide_by_zero",
                   "not_a_function", "loop", "match_error", "pure_fn", "impure_fn", "process", "stack_overflow", "killed", "ok", "timeout", "none", "down",
                   "std.prelude.Result.ok", "std.prelude.Result.error"];

/// A whole program as IR: `user`'s entry, with what it reaches of the library and the
/// runtime, or everything that stopped it.
let to_ir : image.Image -> image.Image -> image.Image -> :integer -> :bool -> Result [:string] [:string];
let to_ir user lib rt arch direct = {
    let entry = image.Image.entry user;
    let [lib_names, native_arity, lib_arity, wanted] = library_setting lib rt;
    let st = core.program %{"u" => user, "l" => lib} [["u", entry, :function]] lib_names native_arity lib_arity wanted;
    finished user st lib_names rt arch direct no_lib_part
};

/// The program on the library already translated and written (`lib_part`): only its own code is
/// translated, numbered on from where the library's ended.
let to_ir_from : image.Image -> image.Image -> image.Image -> :integer -> LibPart -> Result [:string] [:string];
let to_ir_from user lib rt arch part = {
    let entry = image.Image.entry user;
    let [lib_names, native_arity, lib_arity, _] = library_setting lib rt;
    let st = core.program %{"u" => user, "l" => lib} [["u", entry, :function]] lib_names native_arity lib_arity (LibPart.st part);
    finished user st lib_names rt arch true part
};

/// What translating the program and the library work from, for `lib` and `rt`: the library's
/// functions by name, the runtime's natives' arities and the library's, and the state translation
/// starts in, the closures the runtime calls already made.
let library_setting : image.Image -> image.Image -> [:any];
let library_setting lib rt = {
    let atoms = list.fold (fn m [i, name] -> m.[name => i]) %{} (list.enumerate first_atoms);
    let lib_names = dialect.by_name lib;
    let arities = fn img names -> list.fold (fn m [name, f] -> m.[name => image.Func.arity (image.func img f)]) %{} names;
    // A native's arity, not counting the context it takes first.
    let native_arity = list.fold (fn m [name, n] -> m.[name => n - 1]) %{} (map.pairs (arities rt (map.pairs (dialect.by_name rt))));
    let lib_arity = arities lib (map.pairs lib_names);
    let result_type = list.length first_atoms;
    let start = core.empty_st |> core.St.set_atoms atoms.["Result" => result_type]
        |> core.St.set_records %{atoms.["std.prelude.Result.ok"] => [result_type, "Result.ok"],
                                 atoms.["std.prelude.Result.error"] => [result_type, "Result.error"]};
    // The closures the runtime calls are made first, as any function value is.
    let wanted = list.fold (fn st name -> {
        let [_, st1] = core.wrapper_of_library %{:lib_arity => lib_arity} name st;
        st1
    }) start (map.values library_roots);
    [lib_names, native_arity, lib_arity, wanted]
};

// --- the library, by itself -----------------------------------------------------------------
//
// What a program reaches of the library was translated and written with it, numbered by the
// order the program reached it in, so it was different text in every program and compiled
// again for each: in a small program most of the code there was. Translated whole, first and by
// itself, the library is the same text in every program, and its parts are kept as the
// runtime's are (`aot_objects`); and what translating it leaves -- the state the program's
// translation goes on from, the counter its names go on from, its text, the CAFs it made and
// which of its parameters are used once -- is kept between builds too (driver.dr, `lib_part!`),
// since translating all of it was twenty seconds of CPU.

/// The library translated and written: what `to_ir_from` goes on from.
group LibPart { st : core.St, next : :integer, text : :string, cafs : [:string], once : :map, rt : [:any] }

/// No library written apart: the program's translation reaches it as it goes.
let no_lib_part : LibPart;
let no_lib_part = LibPart.make core.empty_st 0 "" [] %{} [];

let lib_part : image.Image -> image.Image -> :integer -> Result LibPart [:string];
let lib_part lib rt arch = {
    let [lib_names, native_arity, lib_arity, wanted] = library_setting lib rt;
    let roots = list.map (fn f -> ["l", f, :function]) (list.sort (map.values lib_names));
    let st = core.program %{"l" => lib} roots lib_names native_arity lib_arity wanted;
    let unit_ = dialect.whole_unit rt (list.append runtime_roots (map.keys (core.St.natives st))) arch;
    let fns = list.reverse (core.St.functions st);
    let names = names_of st lib_names unit_;
    let [once_vars, once_syms] = once_thunks_on fns %{};
    let g0 = Gen.make 0 [] "entry" [] [] [] "null" (dialect.Unit.symbols unit_) names %{} "" [] %{}
        once_vars once_syms 0 %{} %{} true "" arch false "" %{} %{} [];
    let g = list.fold (fn g1 f -> function_d f g1) g0 fns;
    match core.St.refused st {
        [] => Result.ok (LibPart.make (core.St.set_functions [] st) (Gen.next g)
            (str.concat_all (list.append (Gen.data g) (list.reverse (Gen.code g))))
            (cafs_of fns) (once_params_on fns %{})
            // The runtime translated by the dialect, all of it, which is the same for every program too.
            [dialect.Unit.text unit_, dialect.Unit.imports unit_, dialect.Unit.symbols unit_, dialect.Unit.refused unit_, dialect.Unit.atoms unit_]),
        why => Result.error (list.unique (list.reverse why)),
    }
};

/// `part` as plain data, to be kept between builds, and back.
let lib_part_data : LibPart -> [:any];
let lib_part_data part = {
    let st = LibPart.st part;
    [[core.St.next st, core.St.strings st, core.St.floats st, core.St.atoms st, core.St.natives st, core.St.refused st,
      core.St.needed_lib st, core.St.wrapped st, core.St.records st, core.St.done st, core.St.lib_done st],
     LibPart.next part, LibPart.text part, LibPart.cafs part, LibPart.once part, LibPart.rt part]
};

let lib_part_of : [:any] -> LibPart;
let lib_part_of d = {
    let [f, next, text, cafs, once, rt] = d;
    let [n, strings, floats, atoms, natives, refused, needed, wrapped, records, done, lib_done] = f;
    LibPart.make (core.St.make n [] [] strings floats atoms natives refused needed wrapped records done lib_done) next text cafs once rt
};

/// The CAFs among `fns`, as the census table names them.
let cafs_of : [core.Function] -> [:string];
let cafs_of fns = list.map (fn f -> "ptr @caf_" + str.slice 1 (len (core.Function.symbol f) - 1) (core.Function.symbol f))
    (list.filter (fn f -> core.Function.how f == :caf) fns);

/// What a core call by name means: a library function, a machine native, `raise!`.
let names_of : core.St -> :map -> dialect.Unit -> :map;
let names_of st lib_names unit_ = list.fold (fn m name -> m.["@lib_" + name => "@l" + to_string lib_names.[name]])
    (list.fold (fn m name -> m.["@m_" + name => (dialect.Unit.symbols unit_).[name]])
        %{"@raise!" => (dialect.Unit.symbols unit_).["raise!"]} (map.keys core.machine_natives))
    (map.keys (core.St.needed_lib st));

/// The program translated, with the runtime and `part`, written.
let finished : image.Image -> core.St -> :map -> image.Image -> :integer -> :bool -> LibPart -> Result [:string] [:string];
let finished user st lib_names rt arch direct part = {
    let entry = image.Image.entry user;
    let natives = map.keys (core.St.natives st);
    // The whole runtime, in the same order for every program, so that its text is the same and
    // its compiled parts are had again from the cache (`aot_objects` in dream/src/aot_object.cpp)
    // rather than compiled for each, a quarter of a small program's LLVM time. An executable is
    // 170 KB larger for what it does not reach. The library was tried the same way, all of it
    // first: it is most of a small program's code, but translating all of it for every build cost
    // more than compiling what was reached, twenty seconds of CPU where it had been nine.
    let unit_ = match LibPart.rt part {
        [text, imports, symbols, refused, atoms] => dialect.Unit.make text imports symbols refused atoms,
        _ => dialect.whole_unit rt (list.append runtime_roots natives) arch,
    };
    // A native the program asks for that the runtime has not got, which a unit made for this
    // program would have said.
    let missing = list.map (fn r -> "the runtime has no `" + r + "`")
        (list.filter (fn r -> not (map.has r (dialect.Unit.symbols unit_))) (list.append runtime_roots natives));
    match list.concat [list.reverse (core.St.refused st), dialect.Unit.refused unit_, missing] {
        [] => Result.ok (assemble user st unit_ lib_names entry arch direct part),
        why => Result.error (list.unique why),
    }
};

/// The clock that preempts: every worker's guard, from a table `rt/main.dr` fills as it starts
/// them, every `@i_tick_us` microseconds (10 ms, or `DREAM_TICK_US`). A store from another thread, with no synchronization because a late or a lost one costs
/// only a later switch.
let tick_text : :string;
let tick_text = str.concat_all [
    "@i_tick_targets = internal global [256 x i64] zeroinitializer, align 8\n",
    "@i_tick_count = internal global i64 0\n",
    "@i_tick_us = internal global i64 10000\n",
    "declare i32 @usleep(i32)\n",
    "declare i32 @pthread_create(ptr, ptr, ptr, ptr)\n",
    "@dream_tick_handle = internal global i64 0\n",
    "define internal ptr @dream_tick(ptr %u) {\nentry:\n  br label %again\nagain:\n",
    "  %us = load i64, ptr @i_tick_us\n  %us32 = trunc i64 %us to i32\n  call i32 @usleep(i32 %us32)\n",
    "  %n = load atomic i64, ptr @i_tick_count monotonic, align 8\n  br label %each\n",
    "each:\n  %i = phi i64 [ 0, %again ], [ %i1, %one ]\n  %more = icmp ult i64 %i, %n\n  br i1 %more, label %one, label %again\n",
    "one:\n  %at = getelementptr i64, ptr @i_tick_targets, i64 %i\n  %t = load atomic i64, ptr %at monotonic, align 8\n",
    "  %q = inttoptr i64 %t to ptr\n  store atomic i64 -1, ptr %q monotonic, align 8\n  %i1 = add i64 %i, 1\n  br label %each\n}\n",
    "define internal i64 @dream_start_tick() {\n  %r = call i32 @pthread_create(ptr @dream_tick_handle, ptr null, ptr @dream_tick, ptr null)\n  ret i64 0\n}\n"];

/// A worker's thread: C's calling convention on the way in, then the scheduler, which never
/// comes back. The context is the thread's argument.
let worker_text : :string -> :string -> :string;
let worker_text loop_ pool = str.concat_all [
    "define internal ptr @dream_pool(ptr %c) {\nentry:\n  %v = ptrtoint ptr %c to i64\n",
    "  %r = call tailcc i64 ", pool, "(i64 %v, i64 0, i64 0, i64 0, i64 0, i64 0)\n  ret ptr null\n}\n",
    "define internal i64 @dream_start_pool(i64 %c) {\nentry:\n  %h = alloca i64\n  %cp = inttoptr i64 %c to ptr\n",
    "  %r = call i32 @pthread_create(ptr %h, ptr null, ptr @dream_pool, ptr %cp)\n  %w = sext i32 %r to i64\n  ret i64 %w\n}\n",
    "define internal ptr @dream_worker(ptr %c) {\nentry:\n  %v = ptrtoint ptr %c to i64\n",
    "  %r = call tailcc i64 ", loop_, "(i64 %v, i64 0, i64 0, i64 0, i64 0, i64 0)\n  ret ptr null\n}\n",
    "define internal i64 @dream_start_worker(i64 %c) {\nentry:\n  %h = alloca i64\n  %cp = inttoptr i64 %c to ptr\n",
    "  %r = call i32 @pthread_create(ptr %h, ptr null, ptr @dream_worker, ptr %cp)\n  %w = sext i32 %r to i64\n  ret i64 %w\n}\n"];

/// A process's own stack (`dispatch!` in rt/main.dr): `dream_run_on` saves the callee-saved
/// registers and the stack pointer where it is told, moves to the process's stack and runs it
/// there, through `dream_process_entry`; `dream_return_to` comes back, and that call of
/// `dream_run_on` returns. The process side never returns: it gives the worker back.
let stacks_text : :string -> :integer -> :string;
let stacks_text run arch = str.concat_all [
    str.concat_all (list.map (fn l -> str.concat_all ["module asm \"", l, "\"\n"]) (if arch == 1 { [
        ".text", ".globl dream_run_on", "dream_run_on:",
        "  stp x29, x30, [sp, #-16]!", "  stp x19, x20, [sp, #-16]!", "  stp x21, x22, [sp, #-16]!",
        "  stp x23, x24, [sp, #-16]!", "  stp x25, x26, [sp, #-16]!", "  stp x27, x28, [sp, #-16]!",
        "  stp d8, d9, [sp, #-16]!", "  stp d10, d11, [sp, #-16]!", "  stp d12, d13, [sp, #-16]!",
        "  stp d14, d15, [sp, #-16]!", "  mov x9, sp", "  str x9, [x3]", "  mov sp, x0",
        "  mov x0, x1", "  mov x1, x2", "  bl dream_process_entry", "  brk #0",
        ".globl dream_return_to", "dream_return_to:", "  mov sp, x0",
        "  ldp d14, d15, [sp], #16", "  ldp d12, d13, [sp], #16", "  ldp d10, d11, [sp], #16",
        "  ldp d8, d9, [sp], #16", "  ldp x27, x28, [sp], #16", "  ldp x25, x26, [sp], #16",
        "  ldp x23, x24, [sp], #16", "  ldp x21, x22, [sp], #16", "  ldp x19, x20, [sp], #16",
        "  ldp x29, x30, [sp], #16", "  ret",
        ".globl dream_call_on", "dream_call_on:",
        "  stp x29, x30, [sp, #-16]!", "  mov x29, sp", "  mov sp, x0", "  sub sp, sp, #16", "  str x29, [sp]",
        "  mov x0, x1", "  bl dream_segment_entry", "  ldr x29, [sp]", "  mov sp, x29", "  ldp x29, x30, [sp], #16", "  ret",
        ".globl dream_switch", "dream_switch:",
        "  stp x29, x30, [sp, #-16]!", "  stp x19, x20, [sp, #-16]!", "  stp x21, x22, [sp, #-16]!",
        "  stp x23, x24, [sp, #-16]!", "  stp x25, x26, [sp, #-16]!", "  stp x27, x28, [sp, #-16]!",
        "  stp d8, d9, [sp, #-16]!", "  stp d10, d11, [sp, #-16]!", "  stp d12, d13, [sp, #-16]!",
        "  stp d14, d15, [sp, #-16]!", "  mov x9, sp", "  str x9, [x0]", "  mov sp, x1",
        "  ldp d14, d15, [sp], #16", "  ldp d12, d13, [sp], #16", "  ldp d10, d11, [sp], #16",
        "  ldp d8, d9, [sp], #16", "  ldp x27, x28, [sp], #16", "  ldp x25, x26, [sp], #16",
        "  ldp x23, x24, [sp], #16", "  ldp x21, x22, [sp], #16", "  ldp x19, x20, [sp], #16",
        "  ldp x29, x30, [sp], #16", "  ret"] } else { [
        ".text", ".globl dream_run_on", "dream_run_on:",
        "  pushq %rbp", "  pushq %rbx", "  pushq %r12", "  pushq %r13", "  pushq %r14", "  pushq %r15",
        "  movq %rsp, (%rcx)", "  movq %rdi, %rsp", "  movq %rsi, %rdi", "  movq %rdx, %rsi",
        "  call dream_process_entry", "  ud2",
        ".globl dream_return_to", "dream_return_to:", "  movq %rdi, %rsp",
        "  popq %r15", "  popq %r14", "  popq %r13", "  popq %r12", "  popq %rbx", "  popq %rbp", "  ret",
        // A call on another stack: the old stack pointer kept on the new one, the call made from
        // there, and the old one back before returning its answer (`segment_call!`).
        ".globl dream_call_on", "dream_call_on:",
        "  pushq %rbp", "  movq %rsp, %rbp", "  movq %rdi, %rsp", "  pushq %rbp", "  subq $8, %rsp",
        "  movq %rsi, %rdi", "  call dream_segment_entry", "  addq $8, %rsp", "  popq %rsp", "  popq %rbp", "  ret",
        // Saved as `dream_run_on` saves, so that either side may be the one switched back to.
        ".globl dream_switch", "dream_switch:",
        "  pushq %rbp", "  pushq %rbx", "  pushq %r12", "  pushq %r13", "  pushq %r14", "  pushq %r15",
        "  movq %rsp, (%rdi)", "  movq %rsi, %rsp",
        "  popq %r15", "  popq %r14", "  popq %r13", "  popq %r12", "  popq %rbx", "  popq %rbp", "  ret"] })),
    "declare void @dream_run_on(i64, i64, i64, i64)\n",
    "declare void @dream_switch(i64, i64)\n",
    "declare i64 @dream_call_on(i64, i64)\n",
    // The call `dream_call_on` makes, from a record of the function and its six words.
    "define dso_local i64 @dream_segment_entry(i64 %r) {\n  %rp = inttoptr i64 %r to ptr\n",
    "  %f = load i64, ptr %rp\n  %fp = inttoptr i64 %f to ptr\n",
    str.concat_all (list.map (fn i -> str.concat_all ["  %q", to_string i, " = getelementptr i64, ptr %rp, i64 ", to_string (i + 1),
        "\n  %w", to_string i, " = load i64, ptr %q", to_string i, "\n"]) (list.range 0 6)),
    "  %v = call tailcc i64 %fp(i64 %w0, i64 %w1, i64 %w2, i64 %w3, i64 %w4, i64 %w5)\n  ret i64 %v\n}\n",
    "declare void @dream_return_to(i64)\n",
    "define dso_local void @dream_process_entry(i64 %p, i64 %pcb) {\n  %r = call tailcc i64 ", run,
    "(i64 %p, i64 %pcb, i64 0, i64 0, i64 0, i64 0)\n  unreachable\n}\n"];

/// The C callbacks OpenSSL wants, which the dialect has no way to write. Each is reached
/// through addresses `rt/main.dr` stores once it has opened the library. A certificate
/// revocation list that cannot be found is no reason to refuse a certificate, and a server's
/// protocol choice is OpenSSL's own function over the list the context was given.
let tls_text : :string;
let tls_text = str.concat_all [
    "@i_cb_context = internal global i64 0\n",
    "@i_tls_get_error = internal global i64 0\n@i_tls_set_error = internal global i64 0\n@i_tls_next_proto = internal global i64 0\n",
    "define internal i32 @i_verify_stub(i32 %ok, ptr %store) {\nentry:\n  %good = icmp ne i32 %ok, 0\n  br i1 %good, label %yes, label %look\n",
    "yes:\n  ret i32 1\nlook:\n  %g = load i64, ptr @i_tls_get_error\n  %gp = inttoptr i64 %g to ptr\n  %e = call i32 %gp(ptr %store)\n",
    "  switch i32 %e, label %no [ i32 3, label %forgive i32 11, label %forgive i32 12, label %forgive i32 33, label %forgive ]\n",
    "forgive:\n  %s = load i64, ptr @i_tls_set_error\n  %sp = inttoptr i64 %s to ptr\n  call void %sp(ptr %store, i32 0)\n  ret i32 1\nno:\n  ret i32 0\n}\n",
    "define internal i32 @i_alpn_stub(ptr %ssl, ptr %out, ptr %outlen, ptr %in, i32 %inlen, ptr %arg) {\n",
    "  %n = load i64, ptr %arg\n  %ours = getelementptr i8, ptr %arg, i64 8\n  %t = trunc i64 %n to i32\n",
    "  %f = load i64, ptr @i_tls_next_proto\n  %fp = inttoptr i64 %f to ptr\n",
    "  %r = call i32 %fp(ptr %out, ptr %outlen, ptr %ours, i32 %t, ptr %in, i32 %inlen)\n",
    "  %ok = icmp eq i32 %r, 1\n  %v = select i1 %ok, i32 0, i32 3\n  ret i32 %v\n}\n"];

/// Where a callback from C lands, by a stub `rt/main.dr` writes: save what C passed where the
/// runtime can read it, and hand back the answer in both registers an answer may be looked for.
/// On aarch64 the stub leaves the record in x16, eight integer registers are saved and then the
/// eight doubles, and `dream_flush_code` makes code just written visible to the instruction stream,
/// which x86-64 does by itself and so has as a function that returns.
let callback_text : :string -> :integer -> :string;
let callback_text enter arch = str.concat_all [
    str.concat_all (list.map (fn l -> str.concat_all ["module asm \"", l, "\"\n"]) (if arch == 1 { [
        ".text", ".globl i_cb_common", "i_cb_common:", "  stp x29, x30, [sp, #-16]!", "  mov x29, sp",
        "  sub sp, sp, #128", "  stp x0, x1, [sp, #0]", "  stp x2, x3, [sp, #16]", "  stp x4, x5, [sp, #32]",
        "  stp x6, x7, [sp, #48]", "  stp d0, d1, [sp, #64]", "  stp d2, d3, [sp, #80]", "  stp d4, d5, [sp, #96]",
        "  stp d6, d7, [sp, #112]", "  mov x0, x16", "  mov x1, sp", "  bl dream_cb_entry", "  fmov d0, x0",
        "  add sp, sp, #128", "  ldp x29, x30, [sp], #16", "  ret",
        ".globl dream_flush_code", "dream_flush_code:", "  dc cvau, x0", "  dsb ish", "  ic ivau, x0",
        "  dsb ish", "  isb", "  mov x0, #0", "  ret"] } else { [
        ".text", ".globl i_cb_common", "i_cb_common:", "  subq $120, %rsp",
        "  movq %rdi, 0(%rsp)", "  movq %rsi, 8(%rsp)", "  movq %rdx, 16(%rsp)", "  movq %rcx, 24(%rsp)",
        "  movq %r8, 32(%rsp)", "  movq %r9, 40(%rsp)", "  movsd %xmm0, 48(%rsp)", "  movsd %xmm1, 56(%rsp)",
        "  movsd %xmm2, 64(%rsp)", "  movsd %xmm3, 72(%rsp)", "  movsd %xmm4, 80(%rsp)", "  movsd %xmm5, 88(%rsp)",
        "  movsd %xmm6, 96(%rsp)", "  movsd %xmm7, 104(%rsp)", "  movq %r10, %rdi", "  movq %rsp, %rsi",
        "  call dream_cb_entry", "  movq %rax, %xmm0", "  addq $120, %rsp", "  ret",
        ".globl dream_flush_code", "dream_flush_code:", "  xorl %eax, %eax", "  ret"] })),
    "declare void @i_cb_common()\n",
    "define dso_local i64 @dream_cb_entry(i64 %r, i64 %regs) {\n  %v = call tailcc i64 ", enter,
    "(i64 %r, i64 %regs)\n  ret i64 %v\n}\n"];

/// How much address space each process's native stack is reserved with (`@i_native_stack`, read
/// by `native_stack_top!` in rt/main.dr), decided here from what the program can reach. Code that
/// jumps keeps nothing of its own on that stack: only the runtime's calls run there, and the
/// deepest any program in the suite went was under four kilobytes. What can go deeper is C the
/// runtime calls for the program -- a foreign function and its callbacks, OpenSSL, OpenCL, the
/// resolver -- and a program reaching any of it keeps a thread's eight megabytes. The rest get
/// sixty-four kilobytes, so that eighty thousand processes reserve five gigabytes, not six
/// hundred. Once Dream code runs on the stack in direct style, this is where a bound computed
/// from each function's frame over what a process can call takes over
/// (dreams/docs/aot-direct.md, "Risks").
let native_stack_of : [:string] -> :integer;
let native_stack_of natives = if list.any deep_c natives { 8388608 } else { 65536 };

/// A segment of a process's machine stack in direct style, where its recursion is: a process
/// starts on one, a quarter of it the stack of frames the runtime's code uses (`carved!` in
/// rt/main.dr), and goes on in another when it runs low (`segment_call!`). A program that can
/// reach C that goes deeper has segments of a thread's size, as C cannot be moved off one.
let direct_stack_of : [:string] -> :integer;
let direct_stack_of natives = if list.any deep_c natives { 8388608 } else { 262144 };

/// Whether a native of the runtime calls C that may use a thread's stack.
let deep_c : :string -> :bool;
let deep_c name = list.any (fn prefix -> str.starts_with prefix name) ["ffi_", "tls_", "t_gpu", "net_connect"];

/// The module's text, in the pieces it is written as, each one or more whole top-level items: the
/// cutter takes them as they are (`parts.tops_of_pieces`), and nothing joins them all.
let assemble : image.Image -> core.St -> dialect.Unit -> :map -> :integer -> :integer -> :bool -> LibPart -> [:string];
let assemble user st unit_ lib_names entry arch direct part = {
    // The atoms the dialect asked for by name are numbered with the rest.
    let st_with = list.fold (fn s1 name -> list.nth 1 (core.intern_atom name s1)) st (dialect.Unit.atoms unit_);
    let atom_words = list.map (fn name ->
        str.concat_all ["@aw_", name, " = internal constant i64 ",
                        core.immediate_word 3 (core.St.atoms st_with).[name], "\n"]) (dialect.Unit.atoms unit_);
    let names = names_of st lib_names unit_;
    let workers = list.fold (fn m f -> match float_params f { [] => m, mask => m.[core.Function.symbol f => mask] })
        %{} (core.St.functions st);
    let [once_vars, once_syms] = once_thunks_on (core.St.functions st) (LibPart.once part);
    let g0 = Gen.make (LibPart.next part) [] "entry" [] [] [] "null" (dialect.Unit.symbols unit_) names %{} "" [] (if direct { %{} } else { workers })
        once_vars once_syms 0 %{} %{} direct "" arch false "" %{} %{} [];
    let g = list.fold (fn g1 f -> if direct { function_d f g1 } else { function f g1 }) g0 (core.St.functions st);
    let strings = list.map (fn [text, symbol] -> string_object symbol text) (map.pairs (core.St.strings st));
    let atom_list = list.sort_on (fn p -> p.[1]) (map.pairs (core.St.atoms st_with));
    let atom_objects = list.map (fn [name, i] -> string_object ("@atom" + to_string i) name) atom_list;
    let atom_count = str.concat_all ["@i_atom_count = internal constant i64 ", to_string (list.length atom_list), "\n"];
    let atom_table = str.concat_all ["@i_atoms = internal constant [", to_string (list.length atom_list), " x ptr] [",
        str.join_str ", " (list.map (fn [_, i] -> "ptr @atom" + to_string i) atom_list), "]\n"];
    let table = image.data_table user;
    let payload_labels = list.flat_map (fn [i, row] -> match row.[2] {
        () => [],
        name => [string_object ("@paylabel" + to_string i) name],
    }) (list.enumerate table);
    let payload_rows = list.map (fn [i, row] -> str.concat_all [
        ", i64 ", to_string row.[0], ", i64 ", to_string row.[1], ", i64 ",
        match row.[2] { () => "0", _ => str.concat_all ["ptrtoint (ptr @paylabel", to_string i, " to i64)"] }]) (list.enumerate table);
    let payload_types = str.join_str "" (list.map (fn _ -> ", i64, i64, i64") table);
    let payload_table = str.concat_all ["@i_payload = external constant i8\n@i_payload_table = internal constant <{ i64",
        payload_types, " }> <{ i64 ", to_string (list.length table), str.concat_all payload_rows, " }>\n"];
    let closures = list.map (fn [name, target] ->
        str.concat_all ["@i_", name, " = internal constant <{ ptr }> <{ ptr @i_cwl", core.mangled target, " }>, align 8\n"])
        (map.pairs library_roots);
    let floats = list.map (fn [_, f] ->
        str.concat_all [f.[0], " = internal constant <{ ptr, i64 }> <{ ptr @i_float, i64 ",
                        to_string (f.[2] * 4294967296 + f.[1]), " }>, align 8\n"]) (map.pairs (core.St.floats st));
    let records = core.St.records st;
    let displays = list.filter_map (fn [i, r] -> string_object ("@shown" + to_string i) r.[1]) (map.pairs records);
    let types_table = str.concat_all ["@i_atom_types = internal constant [", to_string (list.length atom_list), " x i64] [",
        str.join_str ", " (list.map (fn [_, i] -> "i64 " + to_string (match map.lookup i records { Option.some(r) => r.[0], _ => i })) atom_list), "]\n"];
    let display_table = str.concat_all ["@i_atom_display = internal constant [", to_string (list.length atom_list), " x ptr] [",
        str.join_str ", " (list.map (fn [_, i] -> if map.has i records { "ptr @shown" + to_string i } else { "ptr @atom" + to_string i }) atom_list), "]\n"];
    // What no one process owns (the shared region's ends, in rt/main.dr).
    let world = str.concat_all ["@i_world = internal global [96 x i64] zeroinitializer, align 8\n",
        "@i_native_stack = internal constant i64 ", to_string (if direct { direct_stack_of (map.keys (core.St.natives st)) } else { native_stack_of (map.keys (core.St.natives st)) }), "\n",
        // 1 when the code keeps values of its own on the native stack, which the collector then
        // reads for pins (`pin_native!`). Code that jumps keeps none there: reading the stack
        // anyway found the runtime's own stale words, which pinned whole allocation chunks and
        // cost a native compile 8%.
        "@i_native_frames = internal constant i64 ", if direct { "1" } else { "0" }, "\n"];
    // Every CAF, for the census of the shared region to start from.
    let cafs = list.append (LibPart.cafs part) (cafs_of (core.St.functions st));
    let cafs_table = str.concat_all ["@i_cafs = internal constant <{ i64", str.concat_all (list.map (fn _ -> ", ptr") cafs),
        " }> <{ i64 ", to_string (list.length cafs), str.concat_all (list.map (fn c -> ", " + c) cafs), " }>\n"];
    let arity = image.Func.arity (image.func user entry);
    let args = list.take 3 (list.replicate arity core.unit_word);
    let pad = list.replicate (3 - list.length args) "0";
    let main_ = str.concat_all [
        "define dso_local i32 @main(i32 %argc, ptr %argv) {\n  %p = call tailcc i64 ", (dialect.Unit.symbols unit_).["init!"],
        "()\n  %ac = sext i32 %argc to i64\n  %av = ptrtoint ptr %argv to i64\n  %au = call tailcc i64 ", (dialect.Unit.symbols unit_).["set_args!"],
        "(i64 %p, i64 %ac, i64 %av)\n  %tp = add i64 %p, 40\n  %tq = inttoptr i64 %tp to ptr\n  %top = load i64, ptr %tq\n",
        "  %sp = sub i64 %top, 8\n",
        // In direct style the first process runs on a stack of its own, as every process does,
        // from the scheduler (`run_root!`): run here, on the thread's, what it left on the stack
        // was lost the first time it parked.
        if direct {
            str.concat_all ["  %r = call tailcc i64 ", (dialect.Unit.symbols unit_).["run_root!"], "(",
                args_text (list.concat [["%p", "%sp", str.concat_all ["ptrtoint (ptr @u", to_string entry, " to i64)"]], args, pad]), ")\n"]
        } else {
            str.concat_all ["  %r = call tailcc i64 @u", to_string entry, "(", args_text (list.concat [["%p", "%sp", "0"], args, pad]), ")\n"]
        },
        "  ret i32 0\n}\n"];
    list.concat [
        [str.concat_all ["target triple = \"", dialect.triple_of arch, "\"\n"], dialect.start_text arch, "declare void @__libc_start_main()\n",
         "declare { i64, i1 } @llvm.sadd.with.overflow.i64(i64, i64)\n",
         "declare { i64, i1 } @llvm.ssub.with.overflow.i64(i64, i64)\n",
         "declare { i64, i1 } @llvm.smul.with.overflow.i64(i64, i64)\n"],
        dialect.declarations (dialect.Unit.imports unit_) arch,
        atom_words,
        fixed_infos g,
        strings,
        atom_objects,
        displays,
        payload_labels,
        [payload_table],
        floats,
        closures,
        [atom_count, atom_table, types_table, display_table, world, cafs_table, tick_text, worker_text (dialect.Unit.symbols unit_).["worker_loop!"] (dialect.Unit.symbols unit_).["pool_loop!"], tls_text, stacks_text (dialect.Unit.symbols unit_).["run_process!"] arch, cold_text (dialect.Unit.symbols unit_), callback_text (dialect.Unit.symbols unit_).["cb_enter!"] arch],
        Gen.data g,
        // Between these, the runtime: the same text for every program, which the splitter puts in
        // parts of its own and compiles once (`aot_objects`, "Parts kept").
        ["; dream: cached\n", dialect.Unit.text unit_, LibPart.text part, "; dream: end cached\n"],
        list.reverse (Gen.code g),
        [main_],
    ]
};
