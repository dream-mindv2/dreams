// `dreams --aot`: an image in, an executable on disk.
//
// The stages in order, and the one thing none of them can answer for themselves:
// which dynamic loader the executable should name. That is read from the VM
// running this, whose own header holds a loader that exists on this machine, and
// a build for another machine will have to say otherwise.
//
// A program it cannot compile yet is refused by name, function by function, rather
// than built into something that fails later.

import std.console;
import std.file;
import std.io;
import std.llvm;
import std.proc;
import std.list;
import std.num;
import std.os;
import std.str;
import std.vm;
import std.wire;

import dreams.aot.dialect;
import dreams.aot.image;
import dreams.aot.link;
import dreams.aot.machine;
import dreams.aot.parts;
import dreams.aot.target;

/// The host module a dialect program imports; a build has to be told it exists.
let primitives = "rt.prim";

/// What the runtime's Dream half reaches its dialect half through.
let natives = "rt.native";

/// What a `-O2` is worth keeping out of a debugging session is a later question;
/// this is the level everything is built at.
let opt_level = 2;

let default_loader = "/lib64/ld-linux-x86-64.so.2";

/// The `PT_INTERP` of an ELF executable, or `()` if it has none.
let interpreter_of : :string -> :any;
let interpreter_of exe = {
    let table = link.u64_at exe 32;
    let count = link.u16_at exe 56;
    let size = link.u16_at exe 54;
    match list.find (fn i -> link.u32_at exe (table + i * size) == 3) (list.range 0 count) {
        Option.none => (),
        Option.some(i) => link.cstr_at exe (link.u64_at exe (table + i * size + 8)),
    }
};

let loader! : :unit -> :string;
let loader! () = match file.read! "/proc/self/exe" {
    Option.none => default_loader,
    Option.some(exe) => match interpreter_of exe {
        () => default_loader,
        path => path,
    },
};

/// `ir` made an executable at `out`: its size, or what stopped it.
let written! : :string -> :string -> :string -> :string -> Result :integer [:string];
let written! ir out payload interp = {
    // The IR, for a debugger: built with clang it has the symbols this writer omits.
    match os.env! "DREAMS_AOT_KEEP_IR" { () => (), path => file.write! path ir };
    object_and_link! ir out payload interp
};

/// How many parts LLVM is to compile `ir` in, at once: one for each half megabyte, up to 32. A
/// compiler's 700 MB was one part, on one core, for twenty minutes; and at one for each 16 MB,
/// every program the suites build -- four megabytes, most of it the runtime and the library --
/// was still one, nine seconds of LLVM on one core where eight parts take two.
let parts_for : :string -> :integer;
let parts_for ir = num.min 32 (1 + len ir / 524288);

/// `objects`, each written to `DREAMS_AOT_KEEP_OBJECTS/part-N.o` first when that is set, for the
/// linker to be timed by itself.
let after_keeping! : [:string] -> [:string];
let after_keeping! objects = {
    match os.env! "DREAMS_AOT_KEEP_OBJECTS" {
        () => (),
        dir => list.each! (fn! [i, o] -> file.write! (dir + "/part-" + to_string i + ".o") o) (list.enumerate objects),
    };
    objects
};

/// `parts_for`, or as many as `DREAMS_AOT_PARTS` says: a small program in several parts is how
/// splitting and linking them again is tested.
let parts_asked! : :string -> :integer;
let parts_asked! ir = match os.env! "DREAMS_AOT_PARTS" {
    () => parts_for ir,
    n => match num.parse_int n { Option.some(k) if k >= 1 => k, _ => parts_for ir },
};

let object_and_link! : :string -> :string -> :string -> :string -> Result :integer [:string];
let object_and_link! ir out payload interp = match objects! ir opt_level (parts_asked! ir) {
    Result.error(why) => Result.error ["LLVM refused what was generated: " + why],
    Result.ok([objects, kept]) => match linked! (link.Options.make interp ["libm.so.6", "libc.so.6"] payload (os.env! "DREAMS_AOT_SYMBOLS" != ()))
                                        (after_keeping! objects) kept {
        Result.error(why) => Result.error [why],
        Result.ok(exe) => {
            file.write! out exe;
            io.chmod! out 493;
            Result.ok (len exe)
        },
    },
};

/// `objects` linked: the last `kept` -- the runtime's and the library's, the same bytes in every
/// build -- merged once and kept in the AOT cache under their digests (`link.merged_part`), and
/// the program's own read and merged after them.
let linked! : link.Options -> [:string] -> :integer -> Result :string :string;
let linked! o objects kept = match list.find (fn obj -> str.slice 0 4 obj != str.of_bytes [127, 69, 76, 70]) objects {
    Option.some(_) => Result.error "not an ELF object",
    Option.none => {
        let own = list.take (list.length objects - kept) objects;
        let theirs = list.drop (list.length objects - kept) objects;
        let part = if kept == 0 { link.no_part } else { kept_part! theirs };
        link.link_parsed o part (list.map link.parse own)
    },
};

let kept_part! : [:string] -> link.MergedPart;
let kept_part! objects = {
    let make = fn () -> link.merged_part (str.byte 18 (list.head objects) + 256 * str.byte 19 (list.head objects)) 0 0 (list.map link.parse objects);
    match aot_cache! () {
        () => make (),
        dir => {
            // The format's version is in the key: what a link reads of a kept part changes with the linker.
            let at = str.concat_all [dir, "/merged-", io.digest (str.concat_all (list.cons "merged-2" (list.map io.digest objects))), ".wire"];
            let made = fn! () -> {
                let part = make ();
                file.mkdir_all! dir;
                file.replace! at (wire.pack part);
                part
            };
            match file.read! at {
                Option.some(bytes) => match wire.decode bytes { Result.ok(part) => part, _ => made () },
                Option.none => made (),
            }
        },
    }
};

/// Whether an image was written in the runtime's dialect and stands alone: it says so
/// by importing the primitives, which nothing else can.
let is_dialect : image.Image -> :bool;
let is_dialect img = list.any (fn i -> image.import_path img i == primitives) (list.range 0 (image.count img "IMPT"));

/// The machine to build for: the one `--target` names, or this one. For this one the loader is
/// the one this VM was started by, which is known to exist here; for another, its usual path.
let chosen! : :any -> Result [target.Target, :string] [:string];
let chosen! name = match name {
    () => Result.ok [target.host (), loader! ()],
    n => match target.named n {
        Option.none => Result.error [str.concat_all ["no target `", n, "`: x86_64-linux or aarch64-linux"]],
        Option.some(t) => Result.ok [t, if target.Target.arch t == target.Target.arch (target.host ()) { loader! () } else { target.Target.loader t }],
    },
};

/// Where native builds keep what they made once: `DREAMS_AOT_CACHE`, none when it is empty or `0`,
/// or `$XDG_CACHE_HOME/dream/aot`, or `~/.cache/dream/aot` -- where `vm.llvm_objects!` keeps
/// compiled parts too (dream/src/aot_object.cpp).
/// The objects of `ir` in up to `units` parts, and how many of them, at the end, are kept parts
/// (`parts.parts_of`). Built native, through LLVM as a library (`std.llvm`); on the VM, through the
/// VM's own, which is linked into it for the JIT, unless `DREAMS_AOT_FFI` asks for the library.
let objects! : :string -> :integer -> :integer -> Result [[:string], :integer] :string;
let objects! ir level units = if native_build || os.env! "DREAMS_AOT_FFI" != () { library_objects! ir level units }
    else { vm.llvm_objects! ir level units };

/// Whether this compiler was itself built native.
let native_build : :bool;
when native { let native_build = true; }
when not native { let native_build = false; }

/// `objects!` through `std.llvm`: the parts compiled twelve at a time, a process each, and a kept
/// part read from the cache when this text was compiled before by this LLVM at this level.
let library_objects! : :string -> :integer -> :integer -> Result [[:string], :integer] :string;
let library_objects! ir level units = {
    let trace = os.env! "DREAMS_AOT_TRACE" != ();
    let started = vm.now_ns! ();
    let cut = list.forced (parts.parts_of ir units);
    let kept = list.length (list.filter parts.Part.cached cut);
    if trace { console.error! (str.concat_all ["aot: cut into ", to_string (list.length cut), " parts, ", to_string kept, " kept, in ",
        to_string ((vm.now_ns! () - started) / 1000000), " ms"]); };
    // `DREAMS_AOT_KEEP_PARTS=DIR`: each part's text as `DIR/part-N.ll`.
    match os.env! "DREAMS_AOT_KEEP_PARTS" {
        () => (),
        dir => strict! (list.map (fn! [i, part] -> file.write! (str.concat_all [dir, "/part-", to_string i, ".ll"]) (parts.Part.text part)) (list.enumerate cut)),
    }
    let version = llvm.version! ();
    let dir = aot_cache! ();
    let compiling = vm.now_ns! ();
    let made = proc.map_limit! 12 (fn! part -> part_object! dir version level part) cut;
    if trace { console.error! (str.concat_all ["aot: compiled in ", to_string ((vm.now_ns! () - compiling) / 1000000), " ms"]); };
    match list.filter (fn r -> not (Result.is_ok r)) made {
        [Result.error(why), ..] => Result.error why,
        _ => Result.ok [list.map (fn r -> Result.unwrap_or "" r) made, kept],
    }
};

/// One part's object: read back from the cache for a kept part compiled before, compiled and kept
/// there when not.
let part_object! : :string | :unit -> :string -> :integer -> parts.Part -> Result :string :string;
let part_object! dir version level part = {
    let text = parts.Part.text part;
    match dir {
        () => llvm.object! text level,
        d => if not (parts.Part.cached part) { llvm.object! text level } else {
            let at = str.concat_all [d, "/", io.digest (str.concat_all ["dream-aot-part-ffi-1:", version, ":", to_string level, ":", text]), ".o"];
            match file.read! at {
                Option.some(object) => Result.ok object,
                Option.none => {
                    let compiled = llvm.object! text level;
                    match compiled {
                        Result.ok(object) => {
                            file.mkdir_all! d
                            file.replace! at object
                        },
                        _ => (),
                    }
                    compiled
                },
            }
        },
    }
};

let aot_cache! : () -> :string | :unit;
let aot_cache! () = match os.env! "DREAMS_AOT_CACHE" {
    () => match os.env! "XDG_CACHE_HOME" {
        () => match os.env! "HOME" { () => (), home => home + "/.cache/dream/aot" },
        "" => match os.env! "HOME" { () => (), home => home + "/.cache/dream/aot" },
        xdg => xdg + "/dream/aot",
    },
    "" => (),
    "0" => (),
    dir => dir,
};

/// The library translated and written for `arch` (`machine.lib_part`), read from the cache when a
/// build with this compiler, library and runtime made it before, and kept there when not: making
/// it is translating all of the library, twenty seconds of CPU, where reading it is a moment.
let lib_part! : image.Image -> image.Image -> :string -> :string -> :integer -> Result machine.LibPart [:string];
let lib_part! lib rt lib_bytes rt_bytes arch = match aot_cache! () {
    () => machine.lib_part lib rt arch,
    dir => {
        let key = io.digest (str.concat_all [vm.image_digest (), ":", io.digest lib_bytes, ":", io.digest rt_bytes, ":", to_string arch, ":lib-part-1"]);
        let at = str.concat_all [dir, "/lib-", key, ".wire"];
        let made = fn! () -> match machine.lib_part lib rt arch {
            Result.ok(part) => {
                file.mkdir_all! dir;
                file.replace! at (wire.pack (machine.lib_part_data part));
                Result.ok part
            },
            failed => failed,
        };
        match file.read! at {
            Option.some(bytes) => match wire.decode bytes {
                Result.ok(d) => Result.ok (machine.lib_part_of d),
                _ => made (),
            },
            Option.none => made (),
        }
    },
};

/// Write `bytes`, an image, to `out` as an executable, given the two images that are
/// the runtime: how to get those is the caller's, since it means building a program.
let build! : :string -> :string -> :any -> :any -> :any -> Result :integer [:string];
let build! bytes out lib_bytes rt_bytes target_name = match chosen! target_name {
    Result.error(why) => Result.error why,
    Result.ok([t, interp]) => {
        let arch = target.arch_number t;
        match image.read bytes {
            Result.error(why) => Result.error [why],
            Result.ok(img) => if is_dialect img {
                match dialect.to_ir img arch {
                    Result.error(why) => Result.error why,
                    Result.ok(ir) => written! ir out "" interp,
                }
            } else {
                match [image.read lib_bytes, image.read rt_bytes] {
                    // Direct style (dreams/docs/aot-direct.md, stage 4), on the library written once
                    // and kept (`lib_part!`); `DREAMS_AOT_CPS=1` is the code that jumps, kept to
                    // measure against while the two both exist.
                    [Result.ok(lib), Result.ok(rt)] => match (if os.env! "DREAMS_AOT_CPS" != () { machine.to_ir img lib rt arch false } else {
                        match lib_part! lib rt lib_bytes rt_bytes arch {
                            Result.ok(part) => machine.to_ir_from img lib rt arch part,
                            Result.error(why) => Result.error why,
                        }
                    }) {
                        Result.error(why) => Result.error why,
                        Result.ok(ir) => written! ir out (image.payload_bytes img) interp,
                    },
                    _ => Result.error ["the runtime's images are not images"],
                }
            },
        }
    },
};
