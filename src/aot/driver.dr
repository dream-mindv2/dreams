// `dreams --aot`: an image in, an executable on disk.
//
// The stages in order, and the one thing none of them can answer for themselves:
// which dynamic loader the executable should name. That is read from the VM
// running this, whose own header holds a loader that exists on this machine, and
// a build for another machine will have to say otherwise.
//
// A program it cannot compile yet is refused by name, function by function, rather
// than built into something that fails later.

import std.file;
import std.io;
import std.list;
import std.num;
import std.os;
import std.str;
import std.vm;

import dreams.aot.dialect;
import dreams.aot.image;
import dreams.aot.link;
import dreams.aot.machine;
import dreams.aot.target;

/// The host module a dialect program imports; a build has to be told it exists.
let primitives = "rt.prim";

/// What the runtime's Dream half reaches its dialect half through.
let natives = "rt.native";

/// What a `-O2` is worth keeping out of a debugging session is a later question;
/// this is the level everything is built at.
let opt_level = 2;

let default_loader = "/lib64/ld-linux-x86-64.so.2";

/// The `PT_INTERP` of an ELF executable, or `()` if it has none.
let interpreter_of : :string -> :any;
let interpreter_of exe = {
    let table = link.u64_at exe 32;
    let count = link.u16_at exe 56;
    let size = link.u16_at exe 54;
    match list.find (fn i -> link.u32_at exe (table + i * size) == 3) (list.range 0 count) {
        Option.none => (),
        Option.some(i) => link.cstr_at exe (link.u64_at exe (table + i * size + 8)),
    }
};

let loader! : :unit -> :string;
let loader! () = match file.read! "/proc/self/exe" {
    Option.none => default_loader,
    Option.some(exe) => match interpreter_of exe {
        () => default_loader,
        path => path,
    },
};

/// `ir` made an executable at `out`: its size, or what stopped it.
let written! : :string -> :string -> :string -> :string -> Result :integer [:string];
let written! ir out payload interp = {
    // The IR, for a debugger: built with clang it has the symbols this writer omits.
    match os.env! "DREAMS_AOT_KEEP_IR" { () => (), path => file.write! path ir };
    object_and_link! ir out payload interp
};

/// How many parts LLVM is to compile `ir` in, at once: one for each half megabyte, up to 32. A
/// compiler's 700 MB was one part, on one core, for twenty minutes; and at one for each 16 MB,
/// every program the suites build -- four megabytes, most of it the runtime and the library --
/// was still one, nine seconds of LLVM on one core where eight parts take two.
let parts_for : :string -> :integer;
let parts_for ir = num.min 32 (1 + len ir / 524288);

/// `objects`, each written to `DREAMS_AOT_KEEP_OBJECTS/part-N.o` first when that is set, for the
/// linker to be timed by itself.
let after_keeping! : [:string] -> [:string];
let after_keeping! objects = {
    match os.env! "DREAMS_AOT_KEEP_OBJECTS" {
        () => (),
        dir => list.each! (fn! [i, o] -> file.write! (dir + "/part-" + to_string i + ".o") o) (list.enumerate objects),
    };
    objects
};

/// `parts_for`, or as many as `DREAMS_AOT_PARTS` says: a small program in several parts is how
/// splitting and linking them again is tested.
let parts_asked! : :string -> :integer;
let parts_asked! ir = match os.env! "DREAMS_AOT_PARTS" {
    () => parts_for ir,
    n => match num.parse_int n { Option.some(k) if k >= 1 => k, _ => parts_for ir },
};

let object_and_link! : :string -> :string -> :string -> :string -> Result :integer [:string];
let object_and_link! ir out payload interp = match vm.llvm_objects! ir opt_level (parts_asked! ir) {
    Result.error(why) => Result.error ["LLVM refused what was generated: " + why],
    Result.ok(objects) => match link.link_all (link.Options.make interp ["libm.so.6", "libc.so.6"] payload (os.env! "DREAMS_AOT_SYMBOLS" != ())) (after_keeping! objects) {
        Result.error(why) => Result.error [why],
        Result.ok(exe) => {
            file.write! out exe;
            io.chmod! out 493;
            Result.ok (len exe)
        },
    },
};

/// Whether an image was written in the runtime's dialect and stands alone: it says so
/// by importing the primitives, which nothing else can.
let is_dialect : image.Image -> :bool;
let is_dialect img = list.any (fn i -> image.import_path img i == primitives) (list.range 0 (image.count img "IMPT"));

/// The machine to build for: the one `--target` names, or this one. For this one the loader is
/// the one this VM was started by, which is known to exist here; for another, its usual path.
let chosen! : :any -> Result [target.Target, :string] [:string];
let chosen! name = match name {
    () => Result.ok [target.host (), loader! ()],
    n => match target.named n {
        Option.none => Result.error [str.concat_all ["no target `", n, "`: x86_64-linux or aarch64-linux"]],
        Option.some(t) => Result.ok [t, if target.Target.arch t == target.Target.arch (target.host ()) { loader! () } else { target.Target.loader t }],
    },
};

/// Write `bytes`, an image, to `out` as an executable, given the two images that are
/// the runtime: how to get those is the caller's, since it means building a program.
let build! : :string -> :string -> :any -> :any -> :any -> Result :integer [:string];
let build! bytes out lib_bytes rt_bytes target_name = match chosen! target_name {
    Result.error(why) => Result.error why,
    Result.ok([t, interp]) => {
        let arch = target.arch_number t;
        match image.read bytes {
            Result.error(why) => Result.error [why],
            Result.ok(img) => if is_dialect img {
                match dialect.to_ir img arch {
                    Result.error(why) => Result.error why,
                    Result.ok(ir) => written! ir out "" interp,
                }
            } else {
                match [image.read lib_bytes, image.read rt_bytes] {
                    // Direct style (dreams/docs/aot-direct.md, stage 4); `DREAMS_AOT_CPS=1` is the code
                    // that jumps, kept to measure against while the two both exist.
                    [Result.ok(lib), Result.ok(rt)] => match machine.to_ir img lib rt arch (os.env! "DREAMS_AOT_CPS" == ()) {
                        Result.error(why) => Result.error why,
                        Result.ok(ir) => written! ir out (image.payload_bytes img) interp,
                    },
                    _ => Result.error ["the runtime's images are not images"],
                }
            },
        }
    },
};
