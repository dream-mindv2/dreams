// The executable writer: one relocatable object in, one executable out.
//
// A native build needs no linker installed, which is the whole reason this
// exists. It is far smaller than a linker because it is asked for far less: the
// compiler hands over one object and nothing else, so there is no symbol
// resolution between objects, no archives and no section merging. What is left is
// to lay the object's sections out at fixed addresses, make what the dynamic
// loader needs to find the C library, and apply the relocations.
//
// The address space is fixed and the file is laid out congruent with it, an offset
// being the address less `base`, so one number describes both. Three segments, in
// the order the loader wants them:
//
//     read only   the headers, the loader's tables, the object's read-only data
//     executable  the object's code, then one jump stub per imported function
//     writable    the dynamic section, the imported addresses, data, then zeros
//
// The C library stays shared because `std.ffi` needs `dlopen` and macOS allows
// nothing else, so an import is the one thing not known here: each gets a stub
// that jumps through a slot the loader fills at start-up. Binding is immediate,
// since a lazy binding would need the resolver stub and buys nothing for a
// program that uses a few dozen functions.
//
// x86-64 and aarch64 ELF; another machine is refused by name, not misread. The object says which
// it is, and the two differ in their relocations, in what an import's stub is, and in the page
// size a kernel may have, which on aarch64 can be 64 KB.

import std.array;
import std.list;
import std.map;
import std.str;

let base = 4194304;
let page = 4096;
let ehdr_size = 64;
let phdr_size = 56;
let phdr_count = 6;
let dynsym_size = 24;
let rela_size = 24;
let stub_size = 16;
/// `ff 25 rel32`, `jmp *slot(%rip)`, is six bytes of each stub.
let stub_jump_size = 6;

let sht_symtab = 2;
let sht_rela = 4;
let sht_nobits = 8;
let shf_write = 1;
let shf_alloc = 2;
let shf_exec = 4;
let shn_abs = 65521;

/// The address of the program's large data, in the object.
let payload_symbol = "i_payload";

let em_x86_64 = 62;
let em_aarch64 = 183;

// aarch64's relocations: most patch a field of an instruction, so are written into the word that is
// there rather than over it.
let ra_abs64 = 257;
let ra_prel64 = 260;
let ra_prel32 = 261;
let ra_adr_prel_lo21 = 274;
let ra_adr_prel_pg_hi21 = 275;
let ra_adr_prel_pg_hi21_nc = 276;
let ra_add_abs_lo12_nc = 277;
let ra_ldst8_abs_lo12_nc = 278;
let ra_tstbr14 = 279;
let ra_condbr19 = 280;
let ra_jump26 = 282;
let ra_call26 = 283;
let ra_ldst16_abs_lo12_nc = 284;
let ra_ldst32_abs_lo12_nc = 285;
let ra_ldst64_abs_lo12_nc = 286;
let ra_ldst128_abs_lo12_nc = 299;
let ra_adr_got_page = 311;
let ra_ld64_got_lo12_nc = 312;
let ra_glob_dat = 1025;
let r_64 = 1;
let r_pc32 = 2;
let r_gotpcrel = 9;
let r_plt32 = 4;
let r_32 = 10;
let r_32s = 11;
let r_gotpcrelx = 41;
let r_rex_gotpcrelx = 42;
let r_glob_dat = 6;

/// What the program needs of the machine it will run on, and the object's own
/// bytes say the rest. `interp` is the dynamic loader's path, which is the one
/// thing about a Linux that cannot be read from anywhere but the machine.
/// `symbols`: write the functions' names after everything else, for `perf` and a debugger.
group Options { interp : :string, needed : [:string], payload : :string, symbols : :bool }

group Section {
    index : :integer,
    name : :string,
    kind : :integer,
    flags : :integer,
    align : :integer,
    size : :integer,
    link : :integer,
    info : :integer,
    bytes : :string,
}

/// `global`: bound outside its object, so another object's undefined use of the name is it.
group Symbol { name : :string, shndx : :integer, value : :integer, global : :bool }

group Reloc { offset : :integer, kind : :integer, symbol : :integer, addend : :integer }

// --- reading ---------------------------------------------------------------------

let u8_at : :string -> :integer -> :integer;
let u8_at s i = str.byte i s;
let u16_at : :string -> :integer -> :integer;
let u16_at s i = u8_at s i + 256 * u8_at s (i + 1);
let u32_at : :string -> :integer -> :integer;
let u32_at s i = u16_at s i + 65536 * u16_at s (i + 2);
let u64_at : :string -> :integer -> :integer;
let u64_at s i = u32_at s i + 4294967296 * u32_at s (i + 4);

/// An addend is signed; everything else read here is a size or an address.
let i64_at : :string -> :integer -> :integer;
let i64_at s i = {
    let v = u64_at s i;
    if v >= 9223372036854775808 { v - 18446744073709551616 } else { v }
};

let cstr_at : :string -> :integer -> :string;
let cstr_at s from = str.slice from (str.find_from from "\0" s - from) s;

let sections : :string -> [Section];
let sections obj = {
    let table = u64_at obj 40;
    let entry = u16_at obj 58;
    let count = u16_at obj 60;
    let names = u64_at obj (table + u16_at obj 62 * entry + 24);
    list.map (fn i -> {
        let h = table + i * entry;
        let kind = u32_at obj (h + 4);
        let size = u64_at obj (h + 32);
        Section.make i (cstr_at obj (names + u32_at obj h)) kind (u64_at obj (h + 8))
            (u64_at obj (h + 48)) size (u32_at obj (h + 40)) (u32_at obj (h + 44))
            (if kind == sht_nobits { "" } else { str.slice (u64_at obj (h + 24)) size obj })
    }) (list.range 0 count)
};

let symbols : [Section] -> [Symbol];
let symbols ss = match list.filter (fn s -> Section.kind s == sht_symtab) ss {
    [] => [],
    [table, .._] => {
        let names = Section.bytes ss.[Section.link table];
        let b = Section.bytes table;
        list.map (fn i -> {
            let o = i * 24;
            Symbol.make (cstr_at names (u32_at b o)) (u16_at b (o + 6)) (u64_at b (o + 8)) (u8_at b (o + 4) / 16 != 0)
        }) (list.range 0 (Section.size table / 24))
    },
};

let relocs_of : Section -> [Reloc];
let relocs_of s = {
    let b = Section.bytes s;
    list.map (fn i -> {
        let o = i * 24;
        Reloc.make (u64_at b o) (u32_at b (o + 8)) (u32_at b (o + 12)) (i64_at b (o + 16))
    }) (list.range 0 (Section.size s / 24))
};

// --- writing ---------------------------------------------------------------------

let le : :integer -> :integer -> :string;
let le width v = {
    // The two's complement of a negative field, reached without a 64-bit literal
    // in the arithmetic: a field's low bytes do not depend on the rest.
    let rec go !i !n !acc =
        if i >= width { str.concat_all (list.reverse acc) }
        else { go (i + 1) (n / 256) (list.cons (str.of_int_le 1 (n % 256)) acc) };
    if v >= 0 { go 0 v [] }
    else {
        let limit = list.fold (fn a _ -> a * 256) 1 (list.range 0 width);
        go 0 (limit + v) []
    }
};

let align_up : :integer -> :integer -> :integer;
let align_up alignment n =
    if alignment <= 1 { n } else { (n + alignment - 1) / alignment * alignment };

let zeros : :integer -> :string;
let zeros n = str.repeat n "\0";

// --- layout ----------------------------------------------------------------------

/// Sections placed one after another from `from`: the address of each, by section
/// index, and where they end.
let place : [Section] -> :integer -> :map -> [:map, :integer];
let place ss from known = list.fold (fn [m, at] s -> {
    let a = align_up (Section.align s) at;
    [m.[Section.index s => a], a + Section.size s]
}) [known, from] ss;

let allocated : Section -> :bool;
let allocated s = Section.flags s & shf_alloc != 0;
let writable : Section -> :bool;
let writable s = Section.flags s & shf_write != 0;
let executable : Section -> :bool;
let executable s = Section.flags s & shf_exec != 0;

/// A section's bytes with its relocations written in. `patches` is
/// `[offset, width, value]`, and sorted here because nothing promises the order.
let patched : :string -> [[:integer]] -> :string;
let patched bytes patches = {
    let rec go ps !at acc = match ps {
        [] => str.concat_all (list.reverse (list.cons (str.slice at (len bytes - at) bytes) acc)),
        [[offset, width, value], ..rest] =>
            go rest (offset + width) (list.cons (le width value) (list.cons (str.slice at (offset - at) bytes) acc)),
    };
    go (list.sort_on (fn p -> p.[0]) patches) 0 []
};

/// Write `obj` as an executable, or say why it cannot be one.
let link : Options -> :string -> Result :string :string;
let link o obj = link_all o [obj];

/// The objects as one executable: what LLVM wrote for each part of a program it compiled at
/// once (`vm.llvm_objects!`), each naming what the others define.
let link_all : Options -> [:string] -> Result :string :string;
let link_all o objs = match list.find (fn obj -> str.slice 0 4 obj != str.of_bytes [127, 69, 76, 70]) objs {
    Option.some(_) => Result.error "not an ELF object",
    Option.none => {
        let machine = u16_at (list.head objs) 18;
        if machine != em_x86_64 && machine != em_aarch64 { Result.error "only x86-64 and aarch64 can be linked" }
        else if list.any (fn obj -> u16_at obj 18 != machine) objs { Result.error "the objects are for different machines" }
        else { laid_out o (merged machine objs) }
    },
};

// --- several objects as one ---------------------------------------------------------------
//
// The objects are read as one: each's sections numbered after the ones before, its symbols after
// theirs, and its relocations moved with both. A relocation naming a symbol its object does not
// define, which another defines as global, names that one; what none defines is an import, as
// it was. The layout below then never knows there was more than one.

/// The objects read as one: their sections, numbered from 0 across them all, their symbols, and
/// each relocation section's relocations by its number.
group Merged { machine : :integer, sections : [Section], symbols : :array, relocs : :map }

let shn_loreserve = 65280;

let merged : :integer -> [:string] -> Merged;
let merged machine objs = {
    let read = list.map (fn obj -> { let ss = sections obj; [ss, symbols ss] }) objs;
    let offsets = fn sizes -> list.reverse (list.head (list.fold (fn [acc, at] n -> [list.cons at acc, at + n]) [[], 0] sizes));
    let section_base = offsets (list.map (fn r -> list.length r.[0]) read);
    let symbol_base = offsets (list.map (fn r -> list.length r.[1]) read);
    let moved = fn base n -> if n == 0 || n >= shn_loreserve { n } else { base + n };
    let all_symbols = array.of_list (list.concat (list.map (fn [r, sb] ->
        list.map (fn sym -> Symbol.set_shndx (moved sb (Symbol.shndx sym)) sym) r.[1]) (list.zip read section_base)));
    // Each defined global's number, by its name.
    let defined = list.fold (fn m i -> {
        let sym = all_symbols.[i];
        if Symbol.global sym && Symbol.shndx sym != 0 && Symbol.name sym != "" { m.[Symbol.name sym => i] } else { m }
    }) %{} (list.range 0 (len all_symbols));
    let resolved = fn i -> {
        let sym = all_symbols.[i];
        if Symbol.shndx sym == 0 { defined.[Symbol.name sym else i] } else { i }
    };
    let parts = list.map (fn [[r, sb], yb] -> {
        let ss = list.map (fn sec -> sec
            |> Section.set_index (sb + Section.index sec)
            |> Section.set_link (if Section.kind sec == sht_rela || Section.kind sec == sht_symtab { sb + Section.link sec } else { Section.link sec })
            |> Section.set_info (if Section.kind sec == sht_rela { sb + Section.info sec } else { Section.info sec })) r.[0];
        let relocs = list.fold (fn m sec -> if Section.kind sec != sht_rela { m } else {
            m.[sb + Section.index sec => list.map (fn rel -> Reloc.set_symbol (resolved (yb + Reloc.symbol rel)) rel) (relocs_of sec)]
        }) %{} r.[0];
        [ss, relocs]
    }) (list.zip (list.zip read section_base) symbol_base);
    Merged.make machine (list.concat (list.map list.head parts))
        all_symbols (list.fold (fn m part -> list.fold (fn mm kv -> mm.[kv.[0] => kv.[1]]) m (map.pairs part.[1])) %{} parts)
};

/// A 4 KB page's start, for `adrp`.
let page_of : :integer -> :integer;
let page_of a = a - a % 4096;

/// `word` with `value`'s low `bits` bits put at bit `at`, as an instruction's field.
let with_field : :integer -> :integer -> :integer -> :integer -> :integer;
let with_field word value at bits = {
    let span = list.fold (fn a _ -> a * 2) 1 (list.range 0 bits);
    let shift = list.fold (fn a _ -> a * 2) 1 (list.range 0 at);
    let v = ((value % span) + span) % span;
    let cleared = word - ((word / shift) % span) * shift;
    cleared + v * shift
};

/// `adrp`'s two fields, for a distance in pages.
let with_adrp : :integer -> :integer -> :integer;
let with_adrp word pages = {
    let imm = ((pages % 2097152) + 2097152) % 2097152;
    with_field (with_field word (imm % 4) 29 2) (imm / 4) 5 19
};

/// An import's stub on aarch64: `adrp x16, slot; ldr x17, [x16, slot's low bits]; br x17; nop`.
let aarch64_stub : :integer -> :integer -> :string;
let aarch64_stub at slot = {
    let adrp = with_adrp 2415919120 ((page_of slot - page_of at) / 4096);
    let ldr = with_field 4181721617 ((slot % 4096) / 8) 10 12;
    le 4 adrp + le 4 ldr + le 4 3592356384 + le 4 3573751839
};

priv let laid_out : Options -> Merged -> Result :string :string;
priv let laid_out o m = {
    let ss = Merged.sections m;
    let machine = Merged.machine m;
    let relocs_of = fn s -> (Merged.relocs m).[Section.index s else []];
    // A segment starts on a page of the largest size its kernel may have.
    let seg_page = if machine == em_aarch64 { 65536 } else { page };
    let syms = Merged.symbols m;
    let kept = list.filter allocated ss;
    let ro = list.filter (fn s -> not (writable s) && not (executable s)) kept;
    let rx = list.filter executable kept;
    let rw = list.filter (fn s -> writable s && Section.kind s != sht_nobits) kept;
    let bss = list.filter (fn s -> writable s && Section.kind s == sht_nobits) kept;
    let relas = list.filter (fn s -> Section.kind s == sht_rela
                                      && allocated ss.[Section.info s]) ss;

    // Imports: every symbol a relocation names and the object does not define.
    let used = list.unique (list.flat_map (fn s ->
        list.map (fn r -> Reloc.symbol r) (relocs_of s)) relas);
    // The program's large data is not code and goes nowhere near LLVM: it is laid out here,
    // and the one symbol naming it is resolved here.
    let is_payload = fn i -> Symbol.name syms.[i] == payload_symbol;
    let undefined = list.filter (fn i -> Symbol.shndx syms.[i] == 0 && not (is_payload i)) used;
    let imports = list.sort (list.unique (list.map (fn i -> Symbol.name syms.[i]) undefined));
    let count = list.length imports;
    let import_index = list.fold (fn m [i, n] -> m.[n => i]) %{} (list.enumerate imports);

    // A slot for each symbol the object defines but reaches through one: LLVM asks
    // for that for any symbol not marked as staying in this file. The address is
    // known here, so the slot is written rather than left to the loader.
    let via_slot = fn r -> list.contains (Reloc.kind r) (if machine == em_aarch64 { [ra_adr_got_page, ra_ld64_got_lo12_nc] }
        else { [r_gotpcrel, r_gotpcrelx, r_rex_gotpcrelx] });
    let held = list.unique (list.filter (fn i -> Symbol.shndx syms.[i] != 0 || is_payload i)
        (list.flat_map (fn s -> list.map (fn r -> Reloc.symbol r) (list.filter via_slot (relocs_of s))) relas));
    let slots = count + list.length held;
    let held_index = list.fold (fn m [i, n] -> m.[n => count + i]) %{} (list.enumerate held);

    // The dynamic string table: a NUL, the libraries, the imports.
    let [strtab, name_at] = list.fold (fn [text, m] n ->
        [str.concat_all [text, n, "\0"], m.[n => len text]]) ["\0", %{}] (list.append (Options.needed o) imports);

    let interp : :string = str.concat_all [Options.interp o, "\0"];
    let at_interp = ehdr_size + phdr_size * phdr_count;
    let at_hash = align_up 8 (at_interp + len interp);
    let hash_size = 4 * (2 + 1 + count + 1);
    let at_dynsym = align_up 8 (at_hash + hash_size);
    let at_dynstr = at_dynsym + dynsym_size * (count + 1);
    let at_rela = align_up 8 (at_dynstr + len strtab);
    let ro_from = at_rela + rela_size * count;
    let [addr0, ro_sections_end] = place ro (base + ro_from) %{};
    let payload_at = align_up 16 ro_sections_end;
    let ro_end = payload_at + len (Options.payload o);

    let rx_start = align_up seg_page ro_end;
    let [addr1, rx_end] = place rx rx_start addr0;
    let at_stubs = align_up stub_size rx_end;
    let rx_stop = at_stubs + stub_size * count;

    let rw_start = align_up seg_page rx_stop;
    let dynamic_entries = list.length (Options.needed o) + 9;
    let dynamic_size = 16 * dynamic_entries;
    let at_slots = rw_start + dynamic_size;
    let [addr2, data_end] = place rw (at_slots + 8 * slots) addr1;
    let [addresses, bss_end] = place bss data_end addr2;

    let stub_of = fn name -> at_stubs + stub_size * import_index.[name];
    let slot_of = fn name -> at_slots + 8 * import_index.[name];
    let slot_for = fn i -> match Symbol.shndx syms.[i] {
        0 if not (is_payload i) => slot_of (Symbol.name syms.[i]),
        _ => at_slots + 8 * held_index.[i],
    };
    let symbol_address = fn i -> {
        let s = syms.[i];
        match Symbol.shndx s {
            0 => if Symbol.name s == payload_symbol { payload_at } else { stub_of (Symbol.name s) },
            n if n == shn_abs => Symbol.value s,
            n => addresses.[n] + Symbol.value s,
        }
    };

    // Each relocation as a patch to its section, or the name of the one that
    // this does not know how to write. An unknown kind must stop the link: a word
    // left unrelocated is a crash at a distance.
    let arm = machine == em_aarch64;
    // In two halves, words and branches and then the fields of an address's low bits, as one
    // match of that many guarded arms was more than the compiler before 0.2.9 could lower
    // (`always_matches` in lower.dr).
    let arm_low12 = fn r o insn s p -> {
        let lo12 = s % 4096;
        let slot = fn u -> slot_for (Reloc.symbol r) + Reloc.addend r;
        match Reloc.kind r {
            k if k == ra_add_abs_lo12_nc || k == ra_ldst8_abs_lo12_nc => [o, 4, with_field insn lo12 10 12],
            k if k == ra_ldst16_abs_lo12_nc => [o, 4, with_field insn (lo12 / 2) 10 12],
            k if k == ra_ldst32_abs_lo12_nc => [o, 4, with_field insn (lo12 / 4) 10 12],
            k if k == ra_ldst64_abs_lo12_nc => [o, 4, with_field insn (lo12 / 8) 10 12],
            k if k == ra_ldst128_abs_lo12_nc => [o, 4, with_field insn (lo12 / 16) 10 12],
            k if k == ra_adr_got_page => [o, 4, with_adrp insn ((page_of (slot ()) - page_of p) / 4096)],
            k if k == ra_ld64_got_lo12_nc => [o, 4, with_field insn ((slot () % 4096) / 8) 10 12],
            k => [:unknown, k],
        }
    };
    let arm_patch = fn target r -> {
        let o = Reloc.offset r;
        let p = addresses.[target] + o;
        let s = symbol_address (Reloc.symbol r) + Reloc.addend r;
        let insn = u32_at (Section.bytes ss.[target]) o;
        match Reloc.kind r {
            k if k == ra_abs64 => [o, 8, s],
            k if k == ra_prel64 => [o, 8, s - p],
            k if k == ra_prel32 => [o, 4, s - p],
            k if k == ra_adr_prel_pg_hi21 || k == ra_adr_prel_pg_hi21_nc => [o, 4, with_adrp insn ((page_of s - page_of p) / 4096)],
            k if k == ra_adr_prel_lo21 => {
                let d = s - p;
                [o, 4, with_field (with_field insn (d % 4) 29 2) (d / 4) 5 19]
            },
            k if k == ra_call26 || k == ra_jump26 => [o, 4, with_field insn ((s - p) / 4) 0 26],
            k if k == ra_condbr19 => [o, 4, with_field insn ((s - p) / 4) 5 19],
            k if k == ra_tstbr14 => [o, 4, with_field insn ((s - p) / 4) 5 14],
            _ => arm_low12 r o insn s p,
        }
    };
    let patch_of = fn target r -> if arm { arm_patch target r } else {
        let p = addresses.[target] + Reloc.offset r;
        let s = symbol_address (Reloc.symbol r) + Reloc.addend r;
        match Reloc.kind r {
            k if k == r_64 => [Reloc.offset r, 8, s],
            k if k == r_pc32 || k == r_plt32 => [Reloc.offset r, 4, s - p],
            k if k == r_32 || k == r_32s => [Reloc.offset r, 4, s],
            k if k == r_gotpcrel || k == r_gotpcrelx || k == r_rex_gotpcrelx =>
                [Reloc.offset r, 4, slot_for (Reloc.symbol r) + Reloc.addend r - p],
            k => [:unknown, k],
        }
    };
    let patches = list.fold (fn m s -> {
        let target = Section.info s;
        m.[target => list.append m.[target else []] (list.map (patch_of target) (relocs_of s))]
    }) %{} relas;
    let bad = list.filter (fn p -> p.[0] == :unknown) (list.concat (map.values patches));

    match bad {
        [[_, kind], .._] => Result.error ("a relocation of kind " + to_string kind + " cannot be written"),
        _ => {
            let body = fn s -> patched (Section.bytes s) patches.[Section.index s else []];
            let lay = fn ss from -> list.fold (fn [pieces, at] s -> {
                let a = align_up (Section.align s) at;
                [list.cons (body s) (list.cons (zeros (a - at)) pieces), a + Section.size s]
            }) [[], from] ss;
            let [ro_pieces, _] = lay ro (base + ro_from);
            let [rx_pieces, _] = lay rx rx_start;
            let [rw_pieces, _] = lay rw (at_slots + 8 * slots);

            let stubs = list.map (fn n -> {
                let at = stub_of n;
                if arm { aarch64_stub at (slot_of n) }
                else { str.of_bytes [255, 37] + le 4 (slot_of n - (at + stub_jump_size)) + zeros (stub_size - stub_jump_size) }
            }) imports;
            let dynsym = zeros dynsym_size + str.concat_all (list.map (fn n ->
                le 4 name_at.[n] + le 1 16 + le 1 0 + le 2 0 + le 8 0 + le 8 0) imports);
            // One empty bucket: nothing is exported, so no lookup can find anything
            // here, and every library's own search should not stop to look.
            let hash = le 4 1 + le 4 (count + 1) + le 4 0 + zeros (4 * (count + 1));
            let rela = str.concat_all (list.map_indexed (fn i n ->
                le 8 (slot_of n) + le 4 (if arm { ra_glob_dat } else { r_glob_dat }) + le 4 (i + 1) + le 8 0) imports);
            let tag = fn t v -> le 8 t + le 8 v;
            let dynamic = str.concat_all (list.append
                (list.map (fn n -> tag 1 name_at.[n]) (Options.needed o))
                [tag 4 (base + at_hash), tag 5 (base + at_dynstr), tag 6 (base + at_dynsym),
                 tag 10 (len strtab), tag 11 dynsym_size, tag 7 (base + at_rela),
                 tag 8 (rela_size * count), tag 9 rela_size, tag 0 0]);

            let phdr = fn kind flags from filesz memsz alignment ->
                le 4 kind + le 4 flags + le 8 (from - base) + le 8 from + le 8 from
                + le 8 filesz + le 8 memsz + le 8 alignment;
            let phdrs = str.concat_all [
                phdr 3 4 (base + at_interp) (len interp) (len interp) 1,
                phdr 1 4 base (ro_end - base) (ro_end - base) seg_page,
                phdr 1 5 rx_start (rx_stop - rx_start) (rx_stop - rx_start) seg_page,
                phdr 1 6 rw_start (data_end - rw_start) (bss_end - rw_start) seg_page,
                phdr 2 6 rw_start dynamic_size dynamic_size 8,
                // No executable stack: an object with no note would otherwise ask for one.
                le 4 1685382481 + le 4 6 + zeros 48,
            ];
            match list.find (fn s -> Symbol.name s == "_start" && Symbol.shndx s != 0) (array.to_list syms) {
                Option.none => Result.error "the object defines no _start",
                Option.some(start) => {
                    let entry = addresses.[Symbol.shndx start] + Symbol.value start;
                    let seq = fn at pieces -> list.fold (fn [out, here] [where, text] ->
                        [list.cons text (list.cons (zeros (where - here)) out), where + len text]) [[], at] pieces;
                    // Everything after the header, which says where the symbols are, so is made last.
                    let front_rest = list.reverse (list.head (seq ehdr_size [
                        [ehdr_size, phdrs], [at_interp, interp], [at_hash, hash],
                        [at_dynsym, dynsym], [at_dynstr, strtab], [at_rela, rela]]));
                    let loaded = list.concat [
                        front_rest,
                        list.reverse ro_pieces,
                        [zeros (payload_at - ro_sections_end), Options.payload o],
                        [zeros (rx_start - ro_end)],
                        list.reverse rx_pieces,
                        [zeros (at_stubs - rx_end)],
                        stubs,
                        [zeros (rw_start - rx_stop), dynamic, zeros (8 * count)],
                        list.map (fn i -> le 8 (symbol_address i)) held,
                        list.reverse rw_pieces,
                    ];
                    let loaded_end = ehdr_size + list.fold (fn n t -> n + len t) 0 loaded;
                    let functions = if Options.symbols o {
                        Option.values (list.map (fn i -> {
                            let sym = syms.[i];
                            let n = Symbol.shndx sym;
                            if Symbol.name sym != "" && n > 0 && n < list.length ss && executable ss.[n] {
                                Option.some [Symbol.name sym, symbol_address i]
                            } else { Option.none }
                        }) (list.range 0 (len syms)))
                    } else { [] };
                    let [names_table, tail_, shoff, shnum] = symbol_table functions loaded_end rx_start (rx_stop - rx_start);
                    let ehdr = str.of_bytes [127, 69, 76, 70, 2, 1, 1, 0] + zeros 8 + le 2 2 + le 2 machine + le 4 1
                        + le 8 entry + le 8 ehdr_size + le 8 shoff + le 4 0 + le 2 ehdr_size
                        + le 2 phdr_size + le 2 phdr_count + le 2 64 + le 2 shnum + le 2 (if shnum == 0 { 0 } else { shnum - 1 });
                    Result.ok (str.concat_all (list.concat [[ehdr], loaded, [names_table, tail_]]))
                },
            }
        },
    }
};

/// The functions' names, after what is loaded: `.text` over the code, `.symtab` and `.strtab`
/// naming each function at its address, and `.shstrtab` -- nothing a loader reads, and what
/// `perf` and `gdb` read to say where a program spends its time or stopped. `[padding and
/// tables, section headers, where the headers start, how many]`, or nothing, when there are no
/// names to write.
let symbol_table : [[:any]] -> :integer -> :integer -> :integer -> [:any];
let symbol_table functions at code_at code_size = if list.is_empty functions { ["", "", 0, 0] } else {
    let [strtab, name_at] = list.fold (fn [text, m] [name, _] -> [list.cons "\0" (list.cons name text), m.[name => list.fold (fn n t -> n + len t) 0 text]])
        [["\0"], %{}] functions;
    let strtab_text = str.concat_all (list.reverse strtab);
    // Local functions, in `.text`, at their addresses: what LLVM made them, internal all.
    let symtab = zeros 24 + str.concat_all (list.map (fn [name, address] ->
        le 4 name_at.[name] + le 1 2 + le 1 0 + le 2 1 + le 8 address + le 8 0) functions);
    let shstrtab = "\0.text\0.symtab\0.strtab\0.shstrtab\0";
    let at_symtab = align_up 8 at;
    let at_strtab = at_symtab + len symtab;
    let at_shstrtab = at_strtab + len strtab_text;
    let shoff = align_up 8 (at_shstrtab + len shstrtab);
    let header = fn name kind flags address offset size link info alignment entsize ->
        le 4 name + le 4 kind + le 8 flags + le 8 address + le 8 offset + le 8 size
        + le 4 link + le 4 info + le 8 alignment + le 8 entsize;
    let headers = str.concat_all [
        zeros 64,
        header 1 1 (shf_alloc + shf_exec) code_at (code_at - base) code_size 0 0 16 0,
        header 7 sht_symtab 0 0 at_symtab (len symtab) 3 (list.length functions + 1) 8 24,
        header 15 3 0 0 at_strtab (len strtab_text) 0 0 1 0,
        header 23 3 0 0 at_shstrtab (len shstrtab) 0 0 1 0,
    ];
    [str.concat_all [zeros (at_symtab - at), symtab, strtab_text, shstrtab, zeros (shoff - at_shstrtab - len shstrtab)], headers, shoff, 5]
};
