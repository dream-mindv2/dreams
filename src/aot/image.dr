// An image, read: what the AOT compiler takes as its input.
//
// Nothing is unpacked. A section is a position in the file and a record a fixed
// size, so each accessor reads the bytes it was asked for and a large image costs
// what is looked at. The format is dream/docs/bytecode-format.md; only what the
// format says is relied on, and nothing about how the VM runs it.

import std.array;
import std.list;
import std.map;
import std.str;

group Image { bytes : :string, table : :map, entry : :integer }

group Node { op : :integer, flags : :integer, a : :integer, b : :integer, c : :integer }

group Func {
    name : :integer,
    body : :integer,
    arity : :integer,
    flags : :integer,
    slots : :integer,
    captures : :integer,
}

group Global { name : :integer, kind : :integer, target : :integer }

/// The sentinel for an absent edge, the entry included.
let no_node : :integer;
let no_node = 4294967295;

let func_impure : :integer;
let func_impure = 1;
let func_global_value : :integer;
let func_global_value = 8;

let u32_at : :string -> :integer -> :integer;
let u32_at s i = str.byte i s + 256 * str.byte (i + 1) s + 65536 * str.byte (i + 2) s
    + 16777216 * str.byte (i + 3) s;
let u16_at : :string -> :integer -> :integer;
let u16_at s i = str.byte i s + 256 * str.byte (i + 1) s;
/// A `KINT` constant, which is signed. Built from halves because a 64-bit field's
/// top half is what says so.
let i64_at : :string -> :integer -> :integer;
let i64_at s i = {
    let low = u32_at s i;
    let high = u32_at s (i + 4);
    (if high >= 2147483648 { high - 4294967296 } else { high }) * 4294967296 + low
};

/// `bytes` as an image, or why it is not one.
let read : :string -> Result Image :string;
let read bytes =
    if len bytes < 32 || str.slice 0 8 bytes != "DAGNCAAF" { Result.error "not a Dream image" }
    else if u16_at bytes 8 != 0 { Result.error "an image of a format this compiler does not read" }
    else {
        let table = list.fold (fn m i -> {
            let at = 32 + 16 * i;
            m.[str.slice at 4 bytes => [u32_at bytes (at + 4), u32_at bytes (at + 12)]]
        }) %{} (list.range 0 (u32_at bytes 28));
        Result.ok (Image.make bytes table (u32_at bytes 24))
    };

priv let at : Image -> :string -> :integer;
priv let at img kind = (Image.table img).[kind else [0, 0]].[0];

let count : Image -> :string -> :integer;
let count img kind = (Image.table img).[kind else [0, 0]].[1];

let node : Image -> :integer -> Node;
let node img i = {
    let b = Image.bytes img;
    let o = at img "NODE" + 16 * i;
    Node.make (str.byte o b) (str.byte (o + 1) b) (u32_at b (o + 4)) (u32_at b (o + 8)) (u32_at b (o + 12))
};

let kid : Image -> :integer -> :integer;
let kid img i = u32_at (Image.bytes img) (at img "KIDS" + 4 * i);

let kids : Image -> :integer -> :integer -> [:integer];
let kids img offset n = list.map (fn i -> kid img (offset + i)) (list.range 0 n);

let func : Image -> :integer -> Func;
let func img i = {
    let b = Image.bytes img;
    let o = at img "FUNC" + 32 * i;
    Func.make (u32_at b o) (u32_at b (o + 4)) (u16_at b (o + 8)) (u16_at b (o + 10))
              (u16_at b (o + 12)) (u16_at b (o + 14))
};

let global : Image -> :integer -> Global;
let global img i = {
    let b = Image.bytes img;
    let o = at img "GLBL" + 16 * i;
    Global.make (u32_at b o) (u32_at b (o + 4)) (u32_at b (o + 8))
};

/// The function `module.name` is, by the module's table of its globals (`MODS`), as the VM
/// finds one for `vm.call_image!`: `Option.none` if the image has no such function.
let function_in_module : Image -> :string -> :string -> Option :integer;
let function_in_module img module_name name = {
    let b = Image.bytes img;
    let found = list.find_map (fn mi -> {
        let o = at img "MODS" + 24 * mi;
        if string img (u32_at b o) != module_name { Option.none } else {
            let start = u32_at b (o + 8);
            list.find_map (fn gi -> {
                let g = global img gi;
                if Global.kind g == 0 && string img (Global.name g) == name { Option.some (Global.target g) } else { Option.none }
            }) (list.range start (start + u32_at b (o + 12)))
        }
    }) (list.range 0 (count img "MODS"));
    found
};

let string : Image -> :integer -> :string;
let string img i = {
    let b = Image.bytes img;
    let o = at img "KSTR" + 8 * i;
    str.slice (at img "SBLB" + u32_at b o) (u32_at b (o + 4)) b
};

let integer : Image -> :integer -> :integer;
let integer img i = i64_at (Image.bytes img) (at img "KINT" + 8 * i);

/// The path of import `i`: what a module global's target names.
let import_path : Image -> :integer -> :string;
let import_path img i = string img (u32_at (Image.bytes img) (at img "IMPT" + 8 * i));

/// Where function `i`'s capture descriptors are, in `KIDS`.
let func_captures_at : Image -> :integer -> :integer;
let func_captures_at img i = u32_at (Image.bytes img) (at img "FUNC" + 32 * i + 16);

/// An atom's name: `KATM` is a table of `KSTR` indices.
let atom : Image -> :integer -> :string;
let atom img i = string img (u32_at (Image.bytes img) (at img "KATM" + 4 * i));

/// A float constant's bits, as two 32-bit halves, low first: a Dream integer holds
/// them exactly, and a bit pattern is all the machine wants.
let float_bits : Image -> :integer -> [:integer];
let float_bits img i = {
    let o = at img "KFLT" + 8 * i;
    [u32_at (Image.bytes img) o, u32_at (Image.bytes img) (o + 4)]
};

/// Where function `i` was written: its source, line and column, as the format has them
/// for what an error reports. The source is one more than a string index; 0 is not known.
let func_source : Image -> :integer -> :string;
let func_source img i = {
    let n = u32_at (Image.bytes img) (at img "FUNC" + 32 * i + 28);
    if n == 0 { "" } else { string img (n - 1) }
};
let func_line : Image -> :integer -> :integer;
let func_line img i = u32_at (Image.bytes img) (at img "FUNC" + 32 * i + 20);
let func_col : Image -> :integer -> :integer;
let func_col img i = u32_at (Image.bytes img) (at img "FUNC" + 32 * i + 24);

let u64_at : :string -> :integer -> :integer;
let u64_at s i = u32_at s i + 4294967296 * u32_at s (i + 4);

/// The large data: each datum's `[offset, length, name]`, the name `()` if it has none.
let data_table : Image -> [[:any]];
let data_table img = {
    let b = Image.bytes img;
    let n = count img "LDAT";
    let names_at = at img "LNAM";
    let rec named i pos = if i >= n { [] } else {
        let o = at img "LDAT" + 16 * i;
        let name_len = if names_at == 0 { 0 } else { u32_at b pos };
        let name = if names_at == 0 { () } else { str.slice (pos + 4) name_len b };
        [u64_at b o, u64_at b (o + 8), name] :: named (i + 1) (pos + 4 + name_len)
    };
    named 0 names_at
};

/// The bytes the table's offsets are into: what follows the payload's length word.
let payload_bytes : Image -> :string;
let payload_bytes img = {
    let b = Image.bytes img;
    let o = at img "PAYL";
    if o == 0 { "" } else { str.slice (o + 8) (u64_at b o) b }
};
