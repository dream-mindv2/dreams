// Accumulators written the slow way, written again the fast way: the second
// pass `--supercompile` runs before the driver, after `hoist`. See "Milestone
// 2, step 4" in docs/notes/supercompilation.md.
//
// The point is that code written the obvious way is not slow. Three shapes
// are the obvious way and are quadratic, because each step copies everything
// before it:
//
// - **An accumulator grown at the end**, `go (acc + [x])` or `go (acc +
//   piece)`: each `+` copies `acc`. Kept instead newest first, a cons per
//   step, the accumulator is put in order once, where it is read
//   (`_append_rev`, `_str_append_rev`). Its reads must all be where the loop
//   ends -- a branch that does not call itself -- or keeping it backwards
//   would put it in order once per read.
// - **A result grown at the end**, `f rest + [x]`, naive reverse's shape: each
//   level copies what the levels below made. An accumulator is introduced --
//   `f' args k` is `f args + k` -- so each level puts its piece in front of
//   what follows instead, and the recursion becomes a tail call.
// - **A membership scan of a list grown by cons**, `list.contains x seen` with
//   `seen` handed on as `x :: seen`, or unchanged: a scan per step. A set is
//   carried beside the list (`_set_add`), and a lookup answers from it when it
//   can say what the scan would (`_set_lookup`), forcing what the scan would
//   force, and says it cannot otherwise -- and then the scan, as written,
//   runs. The list is still built, so anything else that reads it reads what
//   it always did.
//
// - **A count of a list that does not change**, `count x xs` for each `x`
//   of a loop over something else, `xs` handed on as it was: a scan each.
//   The list is counted once, every value at a time, into a map (`_tally`),
//   and each count is a lookup (`tallied`).
// - **A search of a list that does not change by a key**, `list.find (fn
//   c -> c.[0] == o) customers` for each `o`: a scan each. An index of the
//   list by that key is filled as the scans would have read it, and each
//   search is a lookup (`indexed`).
// - **The oldest of a list grown at the front**, `list.head (list.reverse
//   acc)` with `acc` handed on as `x :: acc`: a copy each step for one
//   element that does not change. It is carried beside the list
//   (`consed_last`).
// - **An aggregate of a growing prefix**, `maximum (take (i + 1) xs)` for
//   each `i`: each folds the prefix again. The fold of the prefix one longer
//   is the fold of the prefix carried on by one more element, which is the
//   aggregate's own loop run on that one element (`prefix_folded`).
// - **Several demanded folds of the same list**: one loop carries each
//   fold's own accumulator and keeps its steps as lazy as written (`tupled`).
// - **A priority queue sorted again on every step**, `go (list.tail (list.sort
//   q) + [x])` with the smallest taken off: a sort each step. The queue is
//   a heap instead, whose smallest is the sort's head and whose pop is its
//   tail (`heaped`).
// - **A queue grown at the end**, `go (rest + [x, y])` with the head taken
//   off each step: each `+` copies the queue. What is added is kept newest
//   first beside it and turned around once when the front runs out, the
//   queue of two lists (`queue`).
//
// - **An association list kept by a function that updates it**, `go ..
//   (bump w acc)` where `bump` finds `w`'s pair and replaces it, or adds one
//   at the end: a scan each step. The list is a trunk instead, and each
//   update is a lookup through its index (`upserted`).
//
// And one that is worse than quadratic: **tree recursion**, `fib (n - 1) +
// fib (n - 2)`, the same smaller calls made again under each call. Its
// values are kept in a lazy table, one cell for each, so each is made once
// (`memo_table`, "Milestone 2, step 5").
//
// Each is a wrapper and a worker, as in `hoist`: the function keeps its name
// and its callers, and calls a worker that carries what is kept the new way.

import std.array;
import std.list;
import std.map;
import std.str;

import dreams.builtins;
import dreams.drive;
import dreams.hoist;
import dreams.ir;
import dreams.sc;
import dreams.sc.{Term, Stmt, Fun};

/// What the pass reads of the program.
mapping Program {
    // Tupling runs after the driver has specialised each fold on its step.
    tupling : :bool
    reading
    funcs
    globals
    global_of
    // The builtins it writes, by name, and `std.list.contains`'s global.
    ids
    contains
    // `std.list.append`'s global, which is `+` by another name, and
    // `std.list.last`'s, and `reverse_from`'s, which `reverse` is, and
    // `take`'s, and `sort`'s.
    append
    last
    reverse_from
    take
    sort
    // Where the small integers are in the image's pool: a count written as a
    // constant names its pool entry, not its value.
    small_ints
    // Each function that is `list.contains` by another name -- the scan
    // `std`'s fusion writes for one -- as `[list parameter, value parameter]`,
    // by global.
    scans
    // The image's integer pool, to read a constant a term names.
    ints
    // Each function that counts the occurrences of a value in a list -- the
    // scan `std`'s fusion writes for `length (filter (== x) xs)`, or a
    // function that starts one at nothing -- as `[list, value, count]`, its
    // parameters' positions, the count `-1` when it starts at nothing.
    tallies
    // Each function of one list that folds it, as `[form, loop's global,
    // the loop's arguments, list position, accumulator position]`: `:whole`
    // when it hands the loop the list, `:headed` when it hands it the head
    // as the accumulator and the tail as the list (`maximum`). And the
    // folds themselves, as `[list, accumulator]`, by global: one called on a
    // prefix directly is an aggregate of it too.
    aggregates
    folds
    // Each function that finds the first element of a list whose key is a
    // value -- the scan `std`'s fusion writes for `list.find (fn e -> e.[0]
    // == x) xs` -- as `[list, value, key path, value first, found, none]`:
    // the path as the constant keys the key is read by, `found` and `none`
    // the terms it answers (`found` reading the element as `l.[0]`). And
    // each function, not itself a loop, that searches one of its parameters
    // so: `[parameter, path, value first]` (`searcher_shape`).
    keyed
    searchers
    // Each function that updates an association list (`upsert_shape`), by
    // global.
    upserts
    // Each function that looks up or replaces in an association list
    // (`assoc_op`), and each small function that hands one to them
    // (`composite`), by global: what a loop that keeps one is rewritten
    // through (`designed`).
    assocs
    composites
}

/// The image with its slow accumulators written again.
let accum : ir.Image -> Result;
let accum img0 = accumulated false img0;

/// The last accumulator pass can also tuple the driver's specialised folds.
/// Its workers stay as loops: driving the result continuation afterwards
/// would inline its branch locals into the loop's frame again.
let finishing : ir.Image -> Result;
let finishing img = accumulated true img;

let accumulated : :bool -> ir.Image -> Result;
let accumulated tupling img0 = {
    let [img, small] = with_small_ints img0;
    let rd = sc.read img;
    let globals = array.of_list (ir.Image.globals img);
    let strs = array.of_list (ir.Image.strs img);
    let global_of = list.fold (fn m [gi, g] ->
        if g.[:kind else -1] == ir.global_function && not (map.has (g.[:target]) m) { m.[g.[:target] => gi] } else { m })
        %{} (list.enumerate (ir.Image.globals img));
    let id name = match builtins.id name { () => -1, i => i };
    let ids = list.fold (fn m n -> m.[n => id n]) %{}
                        ["_append_rev", "_rev_onto", "_str_append_rev", "_set_of", "_set_add", "_set_lookup", "_set_refresh", "to_string", "len",
                         "_memo_cells", "_match_is_cons", "_match_head", "_match_tail", "_match_fail", "_tally", "_tally_lookup", "_list_drop", "_index_new", "_index_find",
                         "_heap_of", "_heap_push", "_heap_empty", "_heap_min", "_heap_pop",
                         "_trunk_of", "_trunk_to_list", "_trunk_lookup", "_trunk_at", "_trunk_push", "_trunk_set", "_trunk_recall"];
    let p = Program.make tupling rd (array.of_list (ir.Image.funcs img)) globals global_of ids
                         (global_named img strs "std.list" "contains") (global_named img strs "std.list" "append")
                         (global_named img strs "std.list" "last") (global_named img strs "std.list" "reverse_from")
                         (global_named img strs "std.list" "take") (global_named img strs "std.list" "sort") small %{}
                         (array.of_list (ir.Image.ints img)) %{} %{} %{} %{} %{} %{} %{} %{};
    let ints = Program.ints p;
    let scans = list.fold (fn m [gi, g] -> match scan_shape p ints g.[:target else -1] gi {
        () => m,
        shape => m.[gi => shape],
    }) %{} (list.filter (fn [_, g] -> g.[:kind else -1] == ir.global_function) (list.enumerate (ir.Image.globals img)));
    let p = Program.set_scans scans p;
    let functions = list.filter (fn [_, g] -> g.[:kind else -1] == ir.global_function) (list.enumerate (ir.Image.globals img));
    let counting = list.fold (fn m [gi, g] -> match tally_shape p ints g.[:target else -1] gi {
        () => m,
        shape => m.[gi => shape],
    }) %{} functions;
    let counting = list.fold (fn m [gi, g] -> match tally_start p ints counting g.[:target else -1] {
        () => m,
        shape => m.[gi => shape],
    }) counting functions;
    let p = Program.set_tallies counting p;
    let folds = list.fold (fn m [gi, g] -> match fold_shape p (g.[:target else -1]) gi {
        () => m,
        shape => m.[gi => shape],
    }) %{} functions;
    let p = Program.set_folds folds p;
    let p = Program.set_keyed (list.fold (fn m [gi, g] -> match keyed_shape p (g.[:target else -1]) gi {
        () => m,
        shape => m.[gi => shape],
    }) %{} functions) p;
    let p = Program.set_searchers (list.fold (fn m [gi, g] -> match searcher_shape p (g.[:target else -1]) {
        () => m,
        shape => m.[gi => shape],
    }) %{} functions) p;
    let p = Program.set_aggregates (list.fold (fn m [gi, g] -> match aggregate_shape p folds (g.[:target else -1]) {
        () => m,
        shape => m.[gi => shape],
    }) %{} functions) p;
    let p = Program.set_upserts (list.fold (fn m [gi, g] -> match upsert_shape p (g.[:target else -1]) gi {
        () => m,
        shape => m.[gi => shape],
    }) %{} functions) p;
    let p = Program.set_assocs (list.fold (fn m [gi, g] -> match assoc_op p (g.[:target else -1]) gi {
        () => m,
        shape => m.[gi => shape],
    }) %{} functions) p;
    // A composite hands its list to an operation or to another composite, so
    // they are found outward from the operations, a few rings deep.
    let p = list.fold (fn q _ -> Program.set_composites (list.fold (fn m [gi, g] -> match composite_of q (g.[:target else -1]) gi {
        () => m,
        shape => m.[gi => shape],
    }) (Program.composites q) functions) q) p [1, 2, 3];
    let n_funcs = array.length (Program.funcs p);
    let [changed, added_rev, globals_rev] = list.fold (fn [m, added, gs] fi ->
        match rewritten p fi (n_funcs + list.length added) (array.length globals + list.length gs) {
            // Workers made as closures have no globals of their own, and
            // there may be more than one, numbered in order from `wfi`.
            [wrapper, workers, ()] => [m.[fi => wrapper], list.fold (fn a w -> list.cons w a) added (workers_of workers), gs],
            [wrapper, worker, global] => [m.[fi => wrapper], list.fold (fn a w -> list.cons w a) added (workers_of worker), list.cons global gs],
            _ => [m, added, gs],
        }) [%{}, [], []] (list.range 0 n_funcs);
    if map.size changed == 0 { Result.ok img0 }
    else { sc.patch img rd changed (list.reverse added_rev) (list.reverse globals_rev) }
};

/// A shape's workers: one, or a list of them.
let workers_of : :any -> [Fun];
let workers_of w = if type_of w == :list { w } else { [w] };

/// The image with 0 to 16 in its integer pool, and `memo_cap`, and where each is.
let with_small_ints : ir.Image -> [ir.Image, %{:integer => :integer}];
let with_small_ints img = {
    let have = list.fold (fn m [i, v] -> if map.has v m { m } else { m.[v => i] }) %{} (list.enumerate (ir.Image.ints img));
    let missing = list.filter (fn v -> not (map.has v have)) (list.append (list.range 0 17) [memo_cap]);
    let n = list.length (ir.Image.ints img);
    let placed = list.fold (fn m [i, v] -> m.[v => n + i]) have (list.enumerate missing);
    [ir.Image.set_ints (list.append (ir.Image.ints img) missing) img, placed]
};

/// Whether function `fi`, called through global `gi`, is a membership scan:
/// `if empty xs { false } else if xs.[0] == x { true } else { self (tail xs) .. x .. }`
/// with every other parameter handed on as it was. `[list, value]`, its
/// parameters' positions, or `()`.
let scan_shape : Program -> #[:integer] -> :integer -> :integer -> [:integer, :integer] | :unit;
let scan_shape p ints fi gi =
    if fi < 0 || fi >= array.length (Program.funcs p) { () }
    else {
        let f = (Program.funcs p).[fi];
        let k = f.[:arity else 0];
        let head_of l t = match t {
            Term.prim(:get, _, _, _, _, [Term.var(n, _), Term.prim(:const_int, _, i, _, _, _), Term.absent]) => n == l && ints.[i] == 0,
            _ => false,
        };
        match unwrap (sc.body_of (Program.reading p) f) {
            Term.prim(:if, _, _, _, _, [Term.prim(:list_is_empty, _, _, _, _, [Term.var(l, _)]),
                                        Term.prim(:const_bool, _, 0, _, _, _),
                                        rest]) => match unwrap rest {
                Term.prim(:if, _, _, _, _, [Term.prim(:eq, _, _, _, _, [a, b]), Term.prim(:const_bool, _, 1, _, _, _), again]) => {
                    let x = match [a, b] {
                        [y, Term.var(n, _)] if head_of l y => n,
                        [Term.var(n, _), y] if head_of l y => n,
                        _ => (),
                    };
                    let li = list.find_index (fn j -> sc.slot_name j == l) (list.range 0 k);
                    let xi = list.find_index (fn j -> sc.slot_name j == x) (list.range 0 k);
                    match unwrap again {
                        Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args])
                            if g == gi && x != () && li >= 0 && xi >= 0 && list.length args == k
                               && list.all (fn [j, arg] -> if j == li { match arg {
                                      Term.prim(:list_tail, _, _, _, _, [Term.var(n, _)]) => n == l,
                                      _ => false,
                                  } } else { is_var (sc.slot_name j) arg }) (list.enumerate args) => [li, xi],
                        _ => (),
                    }
                },
                _ => (),
            },
            _ => (),
        }
    };

/// A term with the blocks of one statement around it taken off.
let unwrap : Term -> Term;
let rec unwrap t = match t {
    Term.block(_, [Stmt.expr(e)]) => unwrap e,
    _ => t,
};

/// The global through which `module.name` is called, or `-1` -- also when
/// the program never reaches it: then the global is the stub every
/// unreached declaration shares (`<unreached>`, scope.dr), and a rewrite
/// that called it would call that.
let global_named : ir.Image -> #[:string] -> :string -> :string -> :integer;
let global_named img strs module name = match list.find (fn m -> strs.[m.[:name else 0]] == module) (ir.Image.modules img) {
    () => -1,
    m => {
        let from = m.[:globals_start else 0];
        let gs = array.of_list (ir.Image.globals img);
        let funcs = array.of_list (ir.Image.funcs img);
        let reached gi = match (gs.[gi]).[:target else -1] {
            t if t >= 0 && t < array.length funcs => strs.[(funcs.[t]).[:name else 0]] != "<unreached>",
            _ => false,
        };
        match list.find (fn gi -> strs.[(gs.[gi]).[:name else 0]] == name) (list.range from (from + m.[:globals_count else 0])) {
            () => -1,
            gi => if reached gi { gi } else { -1 },
        }
    },
};

/// Function `fi` with the first shape that fits it written again: the
/// wrapper, the worker (function `wfi`, global `wgi`) and its global, or `()`.
let rewritten : Program -> :integer -> :integer -> :integer -> [Fun, Fun | [Fun], :map | :unit] | :unit;
let rewritten p fi wfi wgi = {
    let f = (Program.funcs p).[fi];
    let fl = f.[:flags else 0];
    let k = f.[:arity else 0];
    let gi = (Program.global_of p).[fi else -1];
    if gi < 0 || k == 0 || ir.has_flag fl ir.fn_impure
       || ir.has_flag fl ir.fn_thunk || f.[:n_captures else 0] > 0
       || rewritten_before p (sc.body_of (Program.reading p) f) { () }
    else {
        let body = sc.renamed (sc.body_of (Program.reading p) f);
        let site = Site.make p fi wfi wgi gi k body;
        let [terms, _] = hoist.parts body;
        let can_tuple = Program.tupling p && list.length terms <= 400
            && not (list.any (fn t -> match t { Term.trying(_, _, _, _) => true, _ => false }) terms);
        match if can_tuple { tupled site } else { () } {
            () if ir.has_flag fl ir.fn_rec => first_of [fn () -> grown_accumulator site, fn () -> appended_result site, fn () -> member_set site,
                  fn () -> tallied site, fn () -> indexed site, fn () -> consed_last site, fn () -> prefix_folded site, fn () -> heaped site, fn () -> queue site, fn () -> upserted site, fn () -> designed site,
                  fn () -> memo_table site],
            result => result,
        }
    }
};

/// Whether a body is one this pass wrote, in a round before the driver: it
/// calls a builtin only this pass writes. Each shape keeps what it rewrote as
/// written where it cannot answer -- the scan behind a set's lookup, the read
/// behind a carried value -- so the same shape finds it again in its own
/// worker, and a second rewrite of a rewrite went wrong three times (a
/// carried value carried twice, a set kept twice). A worker is not rewritten
/// again.
let rewritten_before : Program -> Term -> :bool;
let rewritten_before p body = {
    let ids = Program.ids p;
    let written = list.filter (fn b -> b >= 0) (list.map (fn n -> ids.[n else -1])
        ["_append_rev", "_rev_onto", "_str_append_rev", "_set_of", "_set_add", "_set_lookup", "_set_refresh",
         "_memo_cells", "_tally", "_tally_lookup", "_list_drop", "_index_new", "_index_find",
         "_heap_of", "_heap_push", "_heap_empty", "_heap_min", "_heap_pop",
         "_trunk_of", "_trunk_lookup", "_trunk_push", "_trunk_set", "_trunk_recall"]);
    list.any (fn t -> match t {
        Term.prim(:apply, _, _, _, _, [Term.prim(:builtin, _, b, _, _, _), .._]) => list.contains b written,
        _ => false,
    }) (list.head (hoist.parts body))
};

/// What every shape is asked about: the function, its worker's indices, its
/// own global, its arity and its body.
group Site { program, fi : :integer, wfi : :integer, wgi : :integer, gi : :integer, k : :integer, body }

let first_of : [(:unit -> :any)] -> :any;
let rec first_of tries = match tries {
    [] => (),
    [t, ..rest] => match t () { () => first_of rest, r => r },
};

// --- where a body ends ----------------------------------------------------------

/// The terms a body can finish as -- its tail positions -- through blocks to
/// their last statement, both branches of an `if`, each target of a switch.
let leaves : Term -> [Term];
let rec leaves t = match t {
    Term.block(_, ss) => match list.reverse ss { [Stmt.expr(l), .._] => leaves l, _ => [t] },
    Term.prim(:if, _, _, _, _, [_, y, z]) => list.append (leaves y) (leaves z),
    Term.prim(op, _, _, _, _, [_, ..kids]) if op == :switch_atom || op == :switch_head =>
        list.concat (list.map leaves (targets kids)),
    _ => [t],
};

let targets : [Term] -> [Term];
let rec targets kids = match kids {
    [default] => [default],
    [_, target, ..rest] => list.cons target (targets rest),
    [] => [],
};

/// Everything a body evaluates that is not one of its leaves: conditions,
/// switch subjects and keys, and each statement but a block's last. A strict
/// read of a parameter as a statement is left out: it forces the parameter
/// and decides nothing.
let around : Term -> [Term];
let rec around t = match t {
    Term.block(_, ss) => match list.reverse ss {
        [Stmt.expr(l), ..before] => list.append (list.concat (list.map (fn s -> match s {
            Stmt.bind(_, _, x) => [x],
            Stmt.expr(Term.var(_, fl)) if ir.has_flag fl ir.f_strict => [],
            // `force acc` as a statement is the same: what the fused loops
            // of `std.list` write for a strict accumulator.
            Stmt.expr(Term.prim(:force, fl, _, _, _, [Term.var(_, _)])) if ir.has_flag fl ir.f_strict => [],
            Stmt.expr(e) => [e],
        }) before)) (around l),
        _ => [],
    },
    Term.prim(:if, _, _, _, _, [x, y, z]) => list.cons x (list.append (around y) (around z)),
    Term.prim(op, _, _, _, _, [subject, ..kids]) if op == :switch_atom || op == :switch_head =>
        list.cons subject (list.append (keys kids) (list.concat (list.map around (targets kids)))),
    _ => [],
};

let keys : [Term] -> [Term];
let rec keys kids = match kids {
    [_] => [],
    [key, _, ..rest] => list.cons key (keys rest),
    [] => [],
};

/// `t` with each leaf replaced by what `f` makes of it.
let map_leaves : (Term -> Term) -> Term -> Term;
let rec map_leaves f t = match t {
    Term.block(fl, ss) => match list.reverse ss {
        [Stmt.expr(l), ..before] => Term.block fl (list.reverse (list.cons (Stmt.expr (map_leaves f l)) before)),
        _ => f t,
    },
    Term.prim(:if, fl, a, b, c, [x, y, z]) => Term.prim :if fl a b c [x, map_leaves f y, map_leaves f z],
    Term.prim(op, fl, a, b, c, [subject, ..kids]) if op == :switch_atom || op == :switch_head =>
        Term.prim op fl a b c (list.cons subject (map_targets f kids)),
    _ => f t,
};

let map_targets : (Term -> Term) -> [Term] -> [Term];
let rec map_targets f kids = match kids {
    [default] => [map_leaves f default],
    [key, target, ..rest] => list.cons key (list.cons (map_leaves f target) (map_targets f rest)),
    [] => [],
};

// --- reading terms ----------------------------------------------------------------

/// Whether `t` reads the name `n` anywhere, a closure's capture included.
let reads : :string -> Term -> :bool;
let reads n t = list.any (fn x -> match x {
    Term.var(m, _) => m == n,
    Term.lam(_, _, _, caps) => list.contains n caps,
    _ => false,
}) (list.head (hoist.parts t));

/// Whether `t` calls or names global `gi` anywhere.
let names : :integer -> Term -> :bool;
let names gi t = list.any (fn x -> hoist.names_global gi x) (list.head (hoist.parts t));

let is_var : :string -> Term -> :bool;
let is_var n t = match t { Term.var(m, _) => m == n, _ => false };

/// `[base, pieces]` of a left-nested `+`: `((base + p1) + p2) + ..`, the
/// pieces in order. A term that is not an addition is its own base.
let addends : Program -> Term -> [Term, [Term]];
let rec addends p t = match t {
    Term.prim(:add, _, _, _, _, [x, y]) => {
        let [base, pieces] = addends p x;
        [base, list.append pieces [y]]
    },
    // `list.append x y` is `x + y`.
    Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), x, y]) if g == Program.append p && g >= 0 => {
        let [base, pieces] = addends p x;
        [base, list.append pieces [y]]
    },
    _ => [t, []],
};

/// What kind of thing a piece added to an accumulator shows it is: `:list`
/// for a list literal or a cell, `:string` for a string a program can only
/// have made as one, `()` when the piece does not say.
let kind_of : Program -> Term -> :atom | :unit;
let kind_of p t = match t {
    Term.prim(op, _, _, _, _, _) if op == :make_list || op == :cons => :list,
    Term.prim(:const_str, _, _, _, _, _) => :string,
    Term.prim(:str_interp, _, _, _, _, _) => :string,
    Term.prim(:apply, _, _, _, _, [Term.prim(:builtin, _, b, _, _, _), _]) if b == (Program.ids p).["to_string"] => :string,
    _ => (),
};

/// The one kind every growth shows, the last piece of each deciding it (`a +
/// b + ","` is a string whatever `b` is), or `()`.
let agreed : Program -> [:any] -> :atom | :unit;
let agreed p growths = match list.map (fn pieces -> kind_of p (list.last pieces)) growths {
    [] => (),
    [first, ..rest] => if first != () && list.all (fn x -> x == first) rest { first } else { () },
};

let builtin : Program -> :string -> [Term] -> Term;
let builtin p name args = hoist.call_builtin ((Program.ids p).[name]) args;

let call : :integer -> [Term] -> Term;
let call gi args = Term.prim :apply 0 ir.no_node ir.no_node ir.no_node
                             (list.cons (Term.prim :global 0 gi ir.no_node ir.no_node []) args);

let self_args : Term -> [Term];
let self_args t = match t { Term.prim(:apply, _, _, _, _, [_, ..args]) => args, _ => [] };

let op_and : Term -> Term -> Term;
let op_and x y = Term.prim :and 0 ir.no_node ir.no_node ir.no_node [x, y];

let nil : Term;
let nil = Term.prim :make_list 0 ir.no_node 0 ir.no_node [];

let is_nil : Term -> :bool;
let is_nil t = match t { Term.prim(:make_list, _, _, _, _, []) => true, _ => false };

// --- the worker -------------------------------------------------------------------

/// The wrapper and the worker: the worker is `body` (already rewritten, with
/// the new parameter read as `new_name`, strict when `strict`) under its own
/// names; the wrapper the function's strict reads and a call of the worker
/// passing `start` for the new parameter.
let built : Site -> :string -> :bool -> Term -> Term -> [Fun, Fun, :map];
let built site new_name strict body start = built_with site [[new_name, strict, start]] [] body;

/// The same with several new parameters, `[name, strict, start]` each, and
/// `lets` bound lazily in the wrapper first, for the starts to read.
let built_with : Site -> [[:string, :bool, Term]] -> [Stmt] -> Term -> [Fun, Fun, :map];
let built_with site news lets body = {
    let p = Site.program site;
    let k = Site.k site;
    let m = list.length news;
    let f = (Program.funcs p).[Site.fi site];
    let param i = sc.slot_name (k + i);
    let index = list.fold (fn mp [i, [n, _, _]] -> mp.[n => param i]) %{} (list.enumerate news);
    let reads_new = list.concat (list.map (fn [i, [_, strict, _]] -> if strict { [Stmt.expr (Term.var (param i) ir.f_strict)] } else { [] })
                                          (list.enumerate news));
    // The body's own slots past its parameters move up to make room for the
    // new ones (`hoist.shift_slots`), which take the first of them.
    let named = list.head (hoist.rewrite (fn x -> match x {
        Term.var(n, fl) => match index.[n else ()] { () => (), to => Term.var to fl },
        _ => (),
    }) %{} (hoist.shift_slots k m body));
    let worker_body = Term.block 0 (list.append reads_new [Stmt.expr named]);
    let worker = sc.fun_of (f.[:arity => k + m].[:n_captures => 0].[:captures_off => 0]
                             .[:slots => f.[:slots else 0] + m]) worker_body;
    let params = list.map (fn j -> Term.var (sc.slot_name j) 0) (list.range 0 k);
    let starts = list.map (fn [_, _, start] -> start) news;
    let wrapper = sc.fun_of f (Term.block 0 (list.concat [hoist.strict_reads (Site.body site), lets,
                                                          [Stmt.expr (call (Site.wgi site) (list.append params starts))]]));
    [wrapper, worker, ((Program.globals p).[Site.gi site]).[:target => Site.wfi site]]
};

// --- an accumulator grown at the end ------------------------------------------------

/// `go .. (acc + [x])`, for the first parameter that is grown so.
let grown_accumulator : Site -> [Fun, Fun, :map] | :unit;
let grown_accumulator site = first_of (list.map (fn j -> fn () -> grown_at site j) (list.range 0 (Site.k site)));

let grown_at : Site -> :integer -> [Fun, Fun, :map] | :unit;
let grown_at site j = {
    let p = Site.program site;
    let gi = Site.gi site;
    let acc = sc.slot_name j;
    // `len acc` anywhere reads a count carried beside it, so a loop that
    // measures what it has made -- its test, say -- does not walk it.
    let len_id = (Program.ids p).["len"];
    let measured = list.head (hoist.rewrite (fn x -> match x {
        Term.prim(:apply, _, _, _, _, [Term.prim(:builtin, _, b, _, _, _), Term.var(n, _)]) if b == len_id && n == acc =>
            Term.var "acc_count" 0,
        _ => (),
    }) %{} (Site.body site));
    let counted = reads "acc_count" measured;
    let body = if counted { measured } else { Site.body site };
    // `list.last acc` the same way, as the last element carried beside it --
    // which a piece says only when it is written out, `acc + [x]`.
    let lasted = list.head (hoist.rewrite (fn x -> match x {
        Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), Term.var(n, _)]) if g == Program.last p && g >= 0 && n == acc =>
            Term.var "acc_last" 0,
        _ => (),
    }) %{} body);
    let last_read = reads "acc_last" lasted;
    let body = if last_read { lasted } else { body };
    let ls = leaves body;
    let self_calls = list.filter (fn l -> hoist.self_call gi l) ls;
    // Each call of itself passes `acc` on, or `acc` with pieces added.
    let growth arg = match addends p arg {
        [base, pieces] if is_var acc base && not (list.is_empty pieces) && not (list.any (fn x -> reads acc x) pieces) => pieces,
        _ => (),
    };
    let fits = list.all (fn l -> {
        let args = self_args l;
        let arg = list.nth j args;
        (is_var acc arg || growth arg != ())
            && list.all (fn [i, x] -> i == j || not (reads acc x)) (list.enumerate args)
            && list.all (fn [i, x] -> not (names gi x)) (list.enumerate args)
    }) self_calls
    // Anywhere else the loop does not read `acc` but where it ends, and does
    // not call itself but in a leaf.
    && list.all (fn x -> not (reads acc x) && not (names gi x)) (around body)
    && list.all (fn l -> hoist.self_call gi l || not (names gi l)) ls;
    let growths = list.filter (fn g -> g != ()) (list.map (fn l -> growth (list.nth j (self_args l))) self_calls);
    if not fits || list.is_empty growths || (last_read && list.any (fn g -> last_of g == ()) growths) { () }
    else {
        match agreed p growths {
            () => (),
            kind => {
                let r = "acc_kept";
                // Newest first: `acc + [a, b]` is `b :: a :: kept`.
                let onto pieces = list.fold (fn rest piece -> match [kind, piece] {
                    [:list, Term.prim(:make_list, _, _, _, _, xs)] => list.fold (fn rr x -> Term.prim :cons 0 ir.no_node ir.no_node ir.no_node [x, rr]) rest xs,
                    [:list, _] => builtin p "_rev_onto" [piece, rest],
                    _ => Term.prim :cons 0 ir.no_node ir.no_node ir.no_node [piece, rest],
                }) (Term.var r 0) pieces;
                let in_order = builtin p (if kind == :list { "_append_rev" } else { "_str_append_rev" }) [Term.var acc 0, Term.var r 0];
                let leaf l = if hoist.self_call gi l {
                    let args = self_args l;
                    let arg = list.nth j args;
                    let kept = match growth arg { () => Term.var r 0, pieces => onto pieces };
                    // `acc` itself is handed on as it came: what was added is kept.
                    let passed = list.map (fn [i, x] -> if i == j { Term.var acc 0 } else { x }) (list.enumerate args);
                    let count = match growth arg {
                        () => [Term.var "acc_count" 0],
                        pieces => [list.fold (fn n piece -> Term.prim :add 0 ir.no_node ir.no_node ir.no_node [n, piece_length p piece])
                                             (Term.var "acc_count" 0) pieces],
                    };
                    let last = match growth arg {
                        () => [Term.var "acc_last" 0],
                        pieces => [match last_of pieces { () => Term.var "acc_last" 0, [] => Term.var "acc_last" 0, [x] => x }],
                    };
                    call (Site.wgi site) (list.concat [passed, [kept], if counted { count } else { [] }, if last_read { last } else { [] }])
                } else if reads acc l {
                    // Where the loop ends, `acc` is what it was: put in order once.
                    Term.block 0 [Stmt.bind "acc_whole" 0 in_order,
                                  Stmt.expr (list.head (hoist.rewrite (fn x -> if is_var acc x { Term.var "acc_whole" 0 } else { () }) %{} l))]
                } else { l };
                let news = list.concat [[[r, true, nil]],
                                        if counted { [["acc_count", false, builtin p "len" [Term.var acc 0]]] } else { [] },
                                        if last_read { [["acc_last", false, call (Program.last p) [Term.var acc 0]]] } else { [] }];
                built_with site news [] (map_leaves leaf body)
            },
        }
    }
};

/// The last element pieces added in order end with, when each is written
/// out: `[x]` when one of them is not empty, `[]` when none adds anything,
/// `()` when a piece that is not written out leaves it unknown.
let last_of : [Term] | :unit -> [Term] | :unit;
let last_of pieces = if pieces == () { () } else { list.fold (fn known piece -> match piece {
    Term.prim(:make_list, _, _, _, _, []) => known,
    Term.prim(:make_list, _, _, _, _, xs) if known != () => [list.last xs],
    _ => (),
}) [] pieces };

/// How many elements a piece adds: a literal's own count, else its length.
let piece_length : Program -> Term -> Term;
let piece_length p piece = match piece {
    Term.prim(:make_list, _, _, _, _, xs) if list.length xs <= 16 =>
        Term.prim :const_int 0 ((Program.small_ints p).[list.length xs]) ir.no_node ir.no_node [],
    _ => builtin p "len" [piece],
};

// --- a result grown at the end -------------------------------------------------------

/// `f rest + [x]`: an accumulator `k` for what follows, `f' args k = f args +
/// k`, so each level conses its piece in front of the rest and calls itself
/// last.
let appended_result : Site -> [Fun, Fun, :map] | :unit;
let appended_result site = {
    let p = Site.program site;
    let gi = Site.gi site;
    let body = Site.body site;
    let ls = leaves body;
    let appended l = match addends p l {
        [base, pieces] if hoist.self_call gi base && not (list.is_empty pieces) && not (list.any (fn x -> names gi x) pieces)
                          && list.all (fn x -> not (names gi x)) (self_args base) => pieces,
        _ => (),
    };
    let shapes = list.map (fn l -> if appended l != () { :appended }
                                   else if hoist.self_call gi l && list.all (fn x -> not (names gi x)) (self_args l) { :tail }
                                   else if not (names gi l) { :base }
                                   else { () }) ls;
    let growths = list.filter (fn g -> g != ()) (list.map appended ls);
    if list.any (fn s -> s == ()) shapes || list.is_empty growths
       || list.any (fn x -> names gi x) (around body) || agreed p growths != :list { () }
    else {
        let k = "rest_kept";
        // Strict only when each step's piece is a literal, so forcing it at
        // the step forces nothing the program would not.
        let literal = list.all literal_pieces growths;
        let onto pieces = list.fold (fn rest piece -> match piece {
            Term.prim(:make_list, _, _, _, _, xs) => list.fold (fn rr x -> Term.prim :cons 0 ir.no_node ir.no_node ir.no_node [x, rr]) rest (list.reverse xs),
            _ => Term.prim :add 0 ir.no_node ir.no_node ir.no_node [piece, rest],
        }) (Term.var k 0) (list.reverse pieces);
        let leaf l = match appended l {
            () => if hoist.self_call gi l { call (Site.wgi site) (list.append (self_args l) [Term.var k 0]) }
                  else if is_nil l { Term.var k 0 }
                  else { Term.prim :add 0 ir.no_node ir.no_node ir.no_node [l, Term.var k 0] },
            pieces => {
                let [base, _] = addends p l;
                call (Site.wgi site) (list.append (self_args base) [onto pieces])
            },
        };
        built site k literal (map_leaves leaf body) nil
    }
};

/// Whether every piece is a list literal.
let literal_pieces : :any -> :bool;
let literal_pieces pieces = list.all (fn x -> match x { Term.prim(:make_list, _, _, _, _, _) => true, _ => false }) pieces;

// --- a membership scan of a list grown by cons -------------------------------------

/// `list.contains x seen`, `seen` handed on as `x :: seen` or as it was: a
/// set carried beside it.
let member_set : Site -> [Fun, Fun, :map] | :unit;
let member_set site =
    if Program.contains (Site.program site) < 0 && map.size (Program.scans (Site.program site)) == 0 { () }
    else { first_of (list.map (fn j -> fn () -> member_at site j) (list.range 0 (Site.k site))) };

/// The value `t` asks to find in `seen`, if `t` is a membership scan of it:
/// `list.contains x seen`, or a call of a function that is one by another
/// name (`Program.scans`).
let scanned : Program -> :string -> Term -> Term | :unit;
let scanned p seen t = match t {
    Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), x, xs]) if g == Program.contains p && is_var seen xs => x,
    Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) => match (Program.scans p).[g else ()] {
        [li, xi] if is_var seen (list.nth li args) => list.nth xi args,
        _ => (),
    },
    _ => (),
};

/// The scan `t` looking for `x` in `xs`.
let with_value : Program -> Term -> Term -> Term -> Term;
let with_value p t x xs = match t {
    Term.prim(:apply, fl, a, b, c, [callee, ..args]) => {
        let [xi, li] = match callee {
            Term.prim(:global, _, g, _, _, _) =>
                if g == Program.contains p { [0, 1] } else { match (Program.scans p).[g else ()] { [l, v] => [v, l], _ => [-1, -1] } },
            _ => [-1, -1],
        };
        Term.prim :apply fl a b c (list.cons callee (list.map (fn [i, arg] -> if i == xi { x } else if i == li { xs } else { arg })
                                                              (list.enumerate args)))
    },
    _ => t,
};

let member_at : Site -> :integer -> [Fun, Fun, :map] | :unit;
let member_at site j = {
    let p = Site.program site;
    let gi = Site.gi site;
    let seen = sc.slot_name j;
    let body = Site.body site;
    let [terms, _] = hoist.parts body;
    let scans = list.filter (fn t -> scanned p seen t != ()) terms;
    let self_calls = list.filter (fn t -> hoist.self_call gi t) terms;
    let grown arg = match arg {
        Term.prim(:cons, _, _, _, _, [e, rest]) if is_var seen rest && hoist.trivial_term e => e,
        _ => (),
    };
    let fits = list.all (fn c -> {
        let arg = list.nth j (self_args c);
        is_var seen arg || grown arg != ()
    }) self_calls && not (list.is_empty self_calls);
    if list.is_empty scans || not fits { () }
    else {
        let s = "seen_set";
        let rewritten_body = list.head (hoist.rewrite (fn t ->
            if hoist.self_call gi t {
                let args = self_args t;
                // Handed on refreshed: once a scan has evaluated the list, a
                // set that could not say can be built again, and say.
                let fresh = builtin p "_set_refresh" [Term.var s 0, Term.var seen 0];
                let kept = match grown (list.nth j args) { () => fresh, e => builtin p "_set_add" [fresh, e] };
                call (Site.wgi site) (list.append args [kept])
            } else {
                match scanned p seen t {
                    () => (),
                    x => {
                        // The set's answer when it has one; the scan as
                        // written when it has not.
                        Term.block (drive.flags_of t) [Stmt.bind "seen_x" 0 x,
                                       Stmt.bind "seen_says" ir.f_strict (builtin p "_set_lookup" [Term.var s 0, Term.var "seen_x" 0]),
                                       // `()`: the set cannot say, and the
                                       // scan runs as written. A list: the
                                       // rest the set has not seen, which is
                                       // where the scan would go on.
                                       Stmt.expr (Term.prim :if 0 ir.no_node ir.no_node ir.no_node
                                           [Term.prim :eq 0 ir.no_node ir.no_node ir.no_node
                                                      [Term.var "seen_says" 0, Term.prim :unit 0 ir.no_node ir.no_node ir.no_node []],
                                            with_value p t (Term.var "seen_x" 0) (Term.var seen 0),
                                            Term.prim :if 0 ir.no_node ir.no_node ir.no_node
                                                [Term.prim :type_is 0 ir.no_node 7 0 [Term.var "seen_says" 0],
                                                 with_value p t (Term.var "seen_x" 0) (Term.var "seen_says" 0),
                                                 Term.var "seen_says" 0]])]
                    },
                }
            }) %{} body);
        built site s false rewritten_body (builtin p "_set_of" [Term.var seen 0])
    }
};

// --- a tree of calls on smaller numbers ---------------------------------------------

/// The most cells a table is made with. Past it the function runs as written:
/// the table is made whole, and a call that reaches few of its cells should
/// not pay for the rest of them.
let memo_cap : :integer;
let memo_cap = 1048576;

/// `fib (n - 1) + fib (n - 2)`: calls of itself on numbers a constant smaller,
/// more than one of them on a path, which as written is exponential -- the
/// same smaller calls are made again under each. The values are kept in a
/// table instead, a lazy cell for each, so each is made once.
///
/// Each cell is the function's body again, as a closure of the cell's place
/// (the worker): a cell for each of `0..n` along each number that changes,
/// row by row when there are several, the body at those numbers with every
/// call of itself read from the table -- or made by the function as written,
/// when its numbers fall outside it. The cells are lazy, so a cell
/// no call reaches is never made, and each forces only what the call it
/// stands for would.
///
/// The wrapper runs the body as written down to where it calls itself -- the
/// branch past its base cases -- so that what it forces before asking for the
/// table is what the program forces. There every number must be forced
/// already, and must be a small integer that is not negative, or the body
/// runs on as written.
let memo_table : Site -> [Fun, [Fun], :unit] | :unit;
let memo_table site = {
    let p = Site.program site;
    let gi = Site.gi site;
    let k = Site.k site;
    let body = Site.body site;
    let graph = hoist.parts body;
    let [terms, _] = graph;
    let self_calls = list.filter (fn t -> hoist.self_call gi t) terms;
    // A table made already: this function is a wrapper, from a round before.
    let made = list.any (fn t -> match t {
        Term.prim(:apply, _, _, _, _, [Term.prim(:builtin, _, b, _, _, _), .._]) => b == (Program.ids p).["_memo_cells"],
        _ => false,
    }) terms;
    match hoist.statics p gi k graph {
        () => (),
        _ if made || list.length terms > 400 => (),
        statics => {
            let dims = list.filter (fn j -> not (list.contains j statics)) (list.range 0 k);
            let stepping = list.all (fn c -> {
                let steps = list.map (fn j -> step p j (list.nth j (self_args c))) dims;
                list.all (fn x -> x != ()) steps && list.any (fn x -> x != 0) steps
            }) self_calls;
            if list.is_empty dims || not stepping { () }
            else {
                let [m, forced, place] = memo_point gi body [];
                if calls gi m < 2 || not (list.all (fn j -> list.contains (sc.slot_name j) forced) dims) { () }
                else { memo_built site dims m place }
            }
        },
    }
};

/// How far a call steps back along parameter `j`: `0` for the parameter as
/// it was, `c` for `n - c` with `c` a positive constant, `()` for anything else.
let step : Program -> :integer -> Term -> :integer | :unit;
let step p j arg = match arg {
    Term.var(n, _) if n == sc.slot_name j => 0,
    Term.prim(:sub, _, _, _, _, [Term.var(n, _), Term.prim(:const_int, _, i, _, _, _)])
        if n == sc.slot_name j && (Program.ints p).[i] > 0 => (Program.ints p).[i],
    _ => (),
};

/// Where the body first calls itself: down through blocks, and down the one
/// branch of an `if` that calls it when the other does not. `[term, names
/// forced on the way there, a function putting a term in its place]`.
let memo_point : :integer -> Term -> [:string] -> [Term, [:string], (Term -> Term)];
let rec memo_point gi t forced = match t {
    Term.block(fl, ss) => match list.reverse ss {
        [Stmt.expr(l), ..before] if not (list.any (fn s -> match s { Stmt.bind(_, _, x) => names gi x, Stmt.expr(e) => names gi e }) before) => {
            let more = list.concat (list.map (fn s -> match s {
                Stmt.expr(Term.var(n, sf)) if ir.has_flag sf ir.f_strict => [n],
                Stmt.bind(_, bf, x) if ir.has_flag bf ir.f_strict => forced_by x,
                _ => [],
            }) before);
            let [m, fs, place] = memo_point gi l (list.append forced more);
            [m, fs, fn x -> Term.block fl (list.reverse (list.cons (Stmt.expr (place x)) before))]
        },
        _ => [t, forced, fn x -> x],
    },
    Term.prim(:if, fl, a, b, c, [cond, y, z]) if not (names gi cond) => match [names gi y, names gi z] {
        [false, true] => {
            let [m, fs, place] = memo_point gi z (list.append forced (forced_when cond false));
            [m, fs, fn x -> Term.prim :if fl a b c [cond, y, place x]]
        },
        [true, false] => {
            let [m, fs, place] = memo_point gi y (list.append forced (forced_when cond true));
            [m, fs, fn x -> Term.prim :if fl a b c [cond, place x, z]]
        },
        _ => [t, forced, fn x -> x],
    },
    _ => [t, forced, fn x -> x],
};

/// The names a condition has forced once it is known to be `v`: both sides
/// of a comparison, and of `a || b` when it is false.
let forced_when : Term -> :bool -> [:string];
let rec forced_when t v = match t {
    Term.prim(:or, _, _, _, _, [x, y]) => if v { forced_by x } else { list.append (forced_when x false) (forced_when y false) },
    Term.prim(:and, _, _, _, _, [x, y]) => if v { list.append (forced_when x true) (forced_when y true) } else { forced_by x },
    Term.prim(:not, _, _, _, _, [x]) => forced_when x (not v),
    _ => forced_by t,
};

/// The names evaluating `t` always forces.
let forced_by : Term -> [:string];
let rec forced_by t = match t {
    Term.var(n, _) => [n],
    Term.prim(op, _, _, _, _, [x, y]) if list.contains op hoist.strict_binaries => list.append (forced_by x) (forced_by y),
    Term.prim(op, _, _, _, _, [x, _]) if op == :and || op == :or => forced_by x,
    Term.prim(op, _, _, _, _, [x]) if op == :not || op == :neg || op == :type_is => forced_by x,
    _ => [],
};

/// The most calls of itself one evaluation of `t` can make: the larger
/// branch of each `if` and each switch, everything else added up.
let calls : :integer -> Term -> :integer;
let rec calls gi t = match t {
    Term.prim(:if, _, _, _, _, [x, y, z]) => calls gi x + larger (calls gi y) (calls gi z),
    Term.prim(op, _, _, _, _, [subject, ..kids]) if op == :switch_atom || op == :switch_head =>
        calls gi subject + list.fold (fn n x -> larger n (calls gi x)) 0 (targets kids),
    Term.prim(_, _, _, _, _, cs) => (if hoist.self_call gi t { 1 } else { 0 }) + list.fold (fn n x -> n + calls gi x) 0 cs,
    Term.block(_, ss) => list.fold (fn n s -> n + match s { Stmt.bind(_, _, x) => calls gi x, Stmt.expr(e) => calls gi e }) 0 ss,
    Term.trying(_, x, _, h) => calls gi x + calls gi h,
    _ => 0,
};

let larger : :integer -> :integer -> :integer;
let larger a b = if a > b { a } else { b };

/// The wrapper and the cell: a function of a cell's place in the table,
/// capturing what every cell shares -- the parameters handed on as they
/// were, the top of each number, and the table -- that reads its numbers
/// back out of its place and runs the body on them. `_memo_cells` makes the
/// table of them, each a frame and a thunk of the cell's body; as a Dream
/// recursion building a list it was 350 bytes a cell, the list and the
/// builder's frames made only to be thrown away.
/// A function's flags without `rec`: a cell and its caller call nothing of
/// their own.
let untagged : :integer -> :integer;
let untagged fl = if ir.has_flag fl ir.fn_rec { fl - ir.fn_rec } else { fl };

let memo_built : Site -> [:integer] -> Term -> (Term -> Term) -> [Fun, [Fun], :unit];
let memo_built site dims m place = {
    let p = Site.program site;
    let gi = Site.gi site;
    let k = Site.k site;
    let d = list.length dims;
    let f = (Program.funcs p).[Site.fi site];
    let statics = list.filter (fn j -> not (list.contains j dims)) (list.range 0 k);
    let ns = list.length statics;
    let int v = Term.prim :const_int 0 ((Program.small_ints p).[v]) ir.no_node ir.no_node [];
    let op o x y = Term.prim o 0 ir.no_node ir.no_node ir.no_node [x, y];
    let cap i = Term.var (sc.capture_name i) 0;
    // Row by row: a cell's place is its numbers read in the tops' radix.
    let flat at ts = list.fold (fn acc [x, t] -> op :add (op :mul acc (op :add t (int 1))) x)
                               (list.head at) (list.zip (list.tail at) (list.tail ts));
    let read from at ts = Term.prim :get 0 ir.no_node ir.no_node ir.no_node [from, flat at ts, Term.absent];
    // In the cell: its place is slot 0, and the function's slots each one on.
    let tops = list.map (fn i -> cap (ns + i)) (list.range 0 d);
    let table = cap (ns + d);
    let index = Term.var (sc.slot_name 0) 0;
    // A call of itself in a cell: the table's cell when its numbers are in
    // it -- below the cell's own, so above zero is all there is to ask --
    // and the function as written when they are not.
    let lookup t = {
        let at = list.map (fn j -> list.nth j (self_args t)) dims;
        let stepped = list.filter (fn x -> match x { Term.var(_, _) => false, _ => true }) at;
        match stepped {
            [] => read table at tops,
            [x, ..xs] => Term.prim :if 0 ir.no_node ir.no_node ir.no_node
                [list.fold (fn c y -> op :and c (op :ge y (int 0))) (op :ge x (int 0)) xs, read table at tops, t],
        }
    };
    let body = list.head (hoist.rewrite (fn t -> if hoist.self_call gi t { lookup t } else { () }) %{}
                                        (hoist.shift_slots 0 1 (Site.body site)));
    // Each number out of the place: the last the place modulo its width,
    // each before it the place over the widths after it, modulo its own.
    let width i = op :add (list.nth i tops) (int 1);
    let number i = {
        let over = list.fold (fn x l -> op :div x (width l)) index (list.reverse (list.range (i + 1) d));
        if i == 0 { over } else { op :mod over (width i) }
    };
    let unpacked = list.append
        (list.map (fn [c, j] -> Stmt.bind (sc.slot_name (j + 1)) 0 (cap c)) (list.enumerate statics))
        (list.map (fn [i, j] -> Stmt.bind (sc.slot_name (j + 1)) ir.f_strict (number i)) (list.enumerate dims));
    let cell = Fun.make [sc.slot_name 0] (list.map sc.capture_name (list.range 0 (ns + d + 1)))
                        (Term.block 0 (list.append unpacked [Stmt.expr body]))
                        (f.[:arity => 1].[:n_captures => ns + d + 1].[:captures_off => 0]
                          .[:slots => f.[:slots else 0] + 1].[:flags => untagged (f.[:flags else 0])]);
    // The wrapper: where the body calls itself, the table when the numbers
    // are small integers, the body as written when they are not.
    let slot j = Term.var (sc.slot_name j) 0;
    let limit = Term.prim :const_int 0 ((Program.small_ints p).[memo_cap]) ir.no_node ir.no_node [];
    let fits = list.fold (fn c j -> op :and c (op :and (Term.prim :type_is 0 ir.no_node 0 0 [slot j])
                                                       (op :and (op :ge (slot j) (int 0)) (op :le (slot j) limit))))
                         (Term.prim :const_bool 0 1 ir.no_node ir.no_node []) dims;
    let cells = list.fold (fn n j -> op :mul n (op :add (slot j) (int 1))) (int 1) dims;
    let at = list.map slot dims;
    let made = Term.lam :make_closure 0 (Site.wfi site)
                        (list.concat [list.map sc.slot_name statics, list.map sc.slot_name dims, ["memo_table"]]);
    // A cell is a thunk of `fn i -> cell i` -- the cell called, rather than
    // its body run in the cell's own frame -- because a call is what the JIT
    // takes: a thunk of a body only the interpreter runs. The frame each cell
    // keeps is this one's, the place and the cell, and the cell's own is made
    // only while it runs.
    let calling = Fun.make [sc.slot_name 0] [sc.capture_name 0]
                           (Term.prim :apply 0 ir.no_node ir.no_node ir.no_node [cap 0, index])
                           (f.[:arity => 1].[:n_captures => 1].[:captures_off => 0].[:slots => 1]
                             .[:flags => untagged (f.[:flags else 0])]);
    let tabled = Term.block 0 [Stmt.bind "memo_cell" 0 made,
                               Stmt.bind "memo_table" 0 (builtin p "_memo_cells"
                                   [cells, Term.lam :make_closure 0 (Site.wfi site + 1) ["memo_cell"]]),
                               Stmt.expr (read (Term.var "memo_table" 0) at at)];
    let wrapper = sc.fun_of f (place (Term.prim :if 0 ir.no_node ir.no_node ir.no_node [op :and fits (op :le cells limit), tabled, m]));
    [wrapper, [cell, calling], ()]
};

// --- a queue grown at the end ---------------------------------------------------------

/// `go (rest + [x, y])`, where `rest` is what is left of parameter `j` with
/// its head taken off: a queue, as breadth-first code writes one. What each
/// step adds is kept beside it newest first (`queue_back`), and the queue is
/// what was left followed by that, turned around. The worker turns it around
/// when what was left runs out -- each element is turned around once -- and
/// otherwise takes the head off what was left, as written.
///
/// It is exact only while the queue is read as nothing but a queue: tested
/// for a cell, its head and its rest taken, and handed on as it was, as its
/// rest, or as its rest with pieces written out added; or not handed on, and
/// something new handed on instead. The pieces must be written out so that
/// turning them around forces no more than reading the queue would.
let queue : Site -> [Fun, Fun, :map] | :unit;
let queue site = first_of (list.map (fn j -> fn () -> queue_at site j) (list.range 0 (Site.k site)));

/// Whether the body forces `q` before it does anything else, past the reads
/// of strict parameters, which force nothing but themselves.
let queue_first : :string -> Term -> :bool;
let rec queue_first q t = match t {
    Term.block(_, ss) => match list.drop_while (fn st -> match st {
        Stmt.expr(Term.var(m, fl)) => m != q && ir.has_flag fl ir.f_strict,
        _ => false,
    }) ss {
        [Stmt.bind(_, fl, Term.var(m, _)), .._] => m == q && ir.has_flag fl ir.f_strict,
        [Stmt.expr(Term.var(m, fl)), .._] => m == q && ir.has_flag fl ir.f_strict,
        [Stmt.expr(inner)] => queue_first q inner,
        _ => false,
    },
    _ => false,
};

let queue_at : Site -> :integer -> [Fun, Fun, :map] | :unit;
let queue_at site j = {
    let p = Site.program site;
    let gi = Site.gi site;
    let q = sc.slot_name j;
    let body = Site.body site;
    let [terms, stmts] = hoist.parts body;
    let ids = Program.ids p;
    // The names the queue is read by: the parameter and what is bound to it,
    // and the names its rest is bound to.
    let aliases = list.cons q (list.concat (list.map (fn s -> match s {
        Stmt.bind(n, _, Term.var(m, _)) if m == q => [n],
        _ => [],
    }) stmts));
    let is_alias t = match t { Term.var(n, _) => list.contains n aliases, _ => false };
    let rests = list.concat (list.map (fn s -> match s {
        Stmt.bind(n, _, Term.prim(:apply, _, _, _, _, [Term.prim(:builtin, _, b, _, _, _), x])) if b == ids.["_match_tail"] && is_alias x => [n],
        Stmt.bind(n, _, Term.prim(:list_tail, _, _, _, _, [x])) if is_alias x => [n],
        _ => [],
    }) stmts);
    let is_rest t = match t { Term.var(n, _) => list.contains n rests, _ => false };
    let queued t = is_alias t || is_rest t;
    // How a call of itself hands the queue on: `[rest, pieces]`, `[rest]`,
    // `[:same]`, `[:new]`, or `()` when the queue is read some other way.
    let handed arg = match addends p arg {
        [base, []] if is_rest base => [base],
        [base, []] if is_alias base => [:same],
        [base, pieces] if is_rest base && literal_pieces pieces => [base, pieces],
        _ => if list.any (fn n -> reads n arg) (list.append aliases rests) { () } else { [:new] },
    };
    let self_calls = list.filter (fn t -> hoist.self_call gi t) terms;
    let hands = list.map (fn c -> handed (list.nth j (self_args c))) self_calls;
    // Every other read of the queue is as a queue.
    let read_as_queue = list.all (fn t -> match t {
        Term.lam(_, _, _, caps) => not (list.any (fn n -> list.contains n caps) (list.append aliases rests)),
        Term.prim(:apply, _, _, _, _, [Term.prim(:builtin, _, b, _, _, _), x])
            if is_alias x && (b == ids.["_match_is_cons"] || b == ids.["_match_head"] || b == ids.["_match_tail"]) => true,
        Term.prim(op, _, _, _, _, [x]) if is_alias x && (op == :type_is || op == :list_is_empty || op == :list_tail
                                                         || op == :list_is_cons || op == :list_head) => true,
        Term.prim(:get, _, _, _, _, [x, Term.prim(:const_int, _, i, _, _, _), Term.absent]) if is_alias x && (Program.ints p).[i] == 0 => true,
        // A `match` that fails names what it was handed. It fails only on
        // what is not a list, which the queue never is while anything is
        // kept beside it, and otherwise the front is the queue.
        Term.prim(:apply, _, _, _, _, [Term.prim(:builtin, _, b, _, _, _), x, ..rest])
            if b == ids.["_match_fail"] && is_alias x => not (list.any queued rest),
        _ if hoist.self_call gi t => list.all (fn [i, x] -> i == j || not (queued x)) (list.enumerate (self_args t)),
        // `rest + pieces` handed on is read by the call it is handed to.
        Term.prim(:add, _, _, _, _, [x, _]) if is_rest x => true,
        Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), x, _]) if g == Program.append p && is_rest x => true,
        Term.prim(_, _, _, _, _, cs) => not (list.any queued cs),
        Term.trying(_, x, _, h) => not (queued x || queued h),
        _ => true,
    }) terms && list.all (fn s -> match s {
        Stmt.bind(n, _, x) if queued x => list.contains n aliases,
        Stmt.expr(Term.var(_, fl)) if ir.has_flag fl ir.f_strict => true,
        Stmt.expr(x) => not (queued x) || is_alias x,
        _ => true,
    }) stmts;
    // The queue is forced before anything else is done, as `match` does.
    let forced_first = queue_first q body;
    let grows = list.any (fn h -> match h { [_, _] => true, _ => false }) hands;
    if not forced_first || not read_as_queue || not grows || list.any (fn h -> h == ()) hands { () }
    else {
        // What is kept beside the queue past the turn: nothing, once it has
        // become the front.
        let back = Term.var "queue_kept" 0;
        let front = Term.var "queue_front" 0;
        let onto pieces = list.fold (fn rest piece -> match piece {
            Term.prim(:make_list, _, _, _, _, xs) => list.fold (fn rr x -> Term.prim :cons 0 ir.no_node ir.no_node ir.no_node [x, rr]) rest xs,
            _ => rest,
        }) back pieces;
        let passed c = {
            let args = self_args c;
            let [arg_q, arg_back] = match handed (list.nth j args) {
                [:same] => [front, back],
                [:new] => [list.nth j args, nil],
                [r] => [r, back],
                [r, pieces] => [r, onto pieces],
            };
            call (Site.wgi site) (list.append (list.map (fn [i, x] -> if i == j { arg_q } else { x }) (list.enumerate args)) [arg_back])
        };
        let renamed = list.head (hoist.rewrite (fn t -> match t {
            Term.var(n, fl) if n == q => Term.var "queue_front" fl,
            _ if hoist.self_call gi t => passed t,
            _ => (),
        }) %{} body);
        let empty x = Term.prim :list_is_empty 0 ir.no_node ir.no_node ir.no_node [x];
        let cond c y z = Term.prim :if 0 ir.no_node ir.no_node ir.no_node [c, y, z];
        // What was left, unless it ran out and something was added: then
        // what was added, turned around.
        let came = Term.var "queue_back" 0;
        let turns = op_and (Term.prim :not 0 ir.no_node ir.no_node ir.no_node [empty came]) (empty (Term.var q 0));
        built site "queue_back" true
              (Term.block 0 [Stmt.bind "queue_turns" ir.f_strict turns,
                             Stmt.bind "queue_front" ir.f_strict
                                 (cond (Term.var "queue_turns" 0) (builtin p "_append_rev" [nil, came]) (Term.var q 0)),
                             Stmt.bind "queue_kept" ir.f_strict (cond (Term.var "queue_turns" 0) nil came),
                             Stmt.expr renamed]) nil
    }
};

// --- counting a list that does not change -----------------------------------------------

/// Whether function `fi`, called through global `gi`, counts a value in a
/// list: `if empty xs { n } else if xs.[0] == x { self (tail xs) .. (n + 1) .. x }
/// else { self (tail xs) .. n .. x }`, everything else handed on as it was.
/// `[list, value, count]`, its parameters' positions, or `()`.
let tally_shape : Program -> #[:integer] -> :integer -> :integer -> [:integer, :integer, :integer] | :unit;
let tally_shape p ints fi gi =
    if fi < 0 || fi >= array.length (Program.funcs p) { () }
    else {
        let f = (Program.funcs p).[fi];
        let k = f.[:arity else 0];
        let position n = list.find_index (fn j -> sc.slot_name j == n) (list.range 0 k);
        let head_of l t = match t {
            Term.prim(:get, _, _, _, _, [Term.var(n, _), Term.prim(:const_int, _, i, _, _, _), Term.absent]) => n == l && ints.[i] == 0,
            _ => false,
        };
        // Past a strict read of the count, which is how a strict count is kept.
        let past_force t = match unwrap t {
            Term.block(_, [Stmt.expr(Term.prim(:force, _, _, _, _, [Term.var(_, _)])), Stmt.expr(e)]) => unwrap e,
            Term.block(_, [Stmt.expr(Term.var(_, fl)), Stmt.expr(e)]) if ir.has_flag fl ir.f_strict => unwrap e,
            u => u,
        };
        match unwrap (sc.body_of (Program.reading p) f) {
            Term.prim(:if, _, _, _, _, [Term.prim(:list_is_empty, _, _, _, _, [Term.var(l, _)]), Term.var(n, _), rest]) => match past_force rest {
                Term.prim(:if, _, _, _, _, [Term.prim(:eq, _, _, _, _, [a, b]), found, missed]) => {
                    let x = match [a, b] {
                        [y, Term.var(m, _)] if head_of l y => m,
                        [Term.var(m, _), y] if head_of l y => m,
                        _ => (),
                    };
                    let [li, xi, ni] = [position l, position x, position n];
                    // The step: the rest of the list, the count one more or
                    // the same, everything else as it was.
                    let step t more = match unwrap t {
                        Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) if g == gi && list.length args == k =>
                            list.all (fn [j, arg] -> if j == li { match arg {
                                Term.prim(:list_tail, _, _, _, _, [Term.var(m, _)]) => m == l,
                                _ => false,
                            } } else if j == ni { if more { match arg {
                                Term.prim(:add, _, _, _, _, [Term.var(m, _), Term.prim(:const_int, _, i, _, _, _)]) => m == n && ints.[i] == 1,
                                _ => false,
                            } } else { is_var n arg } } else { is_var (sc.slot_name j) arg }) (list.enumerate args),
                        _ => false,
                    };
                    if x != () && li >= 0 && xi >= 0 && ni >= 0 && step found true && step missed false { [li, xi, ni] } else { () }
                },
                _ => (),
            },
            _ => (),
        }
    };

/// Whether function `fi` starts a count at nothing: its body a call of a
/// counting function, handing it two of its parameters as the list and the
/// value, zero as the count, and constants for the rest.
let tally_start : Program -> #[:integer] -> :map -> :integer -> [:integer, :integer, :integer] | :unit;
let tally_start p ints counting fi =
    if fi < 0 || fi >= array.length (Program.funcs p) { () }
    else {
        let f = (Program.funcs p).[fi];
        let k = f.[:arity else 0];
        let position t = match t {
            Term.var(n, _) => list.find_index (fn j -> sc.slot_name j == n) (list.range 0 k),
            _ => -1,
        };
        match unwrap (sc.body_of (Program.reading p) f) {
            Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) => match counting.[g else ()] {
                [li, xi, ni] => {
                    let [l, x] = [position (list.nth li args), position (list.nth xi args)];
                    let zero = match list.nth ni args { Term.prim(:const_int, _, i, _, _, _) => ints.[i] == 0, _ => false };
                    let rest_constant = list.all (fn [j, arg] -> j == li || j == xi || j == ni || match arg {
                        Term.prim(_, _, _, _, _, []) => true,
                        _ => false,
                    }) (list.enumerate args);
                    if l >= 0 && x >= 0 && zero && rest_constant && f.[:n_captures else 0] == 0 { [l, x, -1] } else { () }
                },
                _ => (),
            },
            _ => (),
        }
    };

/// A loop that counts values in parameter `j`, a list it hands on as it
/// was: the list's tally carried beside it, made the first time a count
/// needs it, and each count a lookup in it -- or the count as written, when
/// the tally cannot say.
let tallied : Site -> [Fun, Fun, :map] | :unit;
let tallied site =
    if map.size (Program.tallies (Site.program site)) == 0 { () }
    else {
        let p = Site.program site;
        match hoist.statics p (Site.gi site) (Site.k site) (hoist.parts (Site.body site)) {
            () => (),
            statics => first_of (list.map (fn j -> fn () -> tallied_at site j) statics),
        }
    };

let tallied_at : Site -> :integer -> [Fun, Fun, :map] | :unit;
let tallied_at site j = {
    let p = Site.program site;
    let xs = sc.slot_name j;
    let counted t = match t {
        Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) => match (Program.tallies p).[g else ()] {
            [li, xi, ni] if is_var xs (list.nth li args) => [list.nth xi args, if ni < 0 { () } else { list.nth ni args }],
            _ => (),
        },
        _ => (),
    };
    let [terms, _] = hoist.parts (Site.body site);
    if not (list.any (fn t -> counted t != ()) terms) { () }
    else {
        let tally = Term.var "tally_of" 0;
        let counts_read = list.head (hoist.rewrite (fn t ->
            if hoist.self_call (Site.gi site) t { () }
            else {
                match counted t {
                    () => (),
                    [x, from] => {
                        let says = Term.var "tally_says" 0;
                        let found = match from { () => says, n => Term.prim :add 0 ir.no_node ir.no_node ir.no_node [n, says] };
                        Term.block (drive.flags_of t) [
                            Stmt.bind "tally_says" ir.f_strict (builtin p "_tally_lookup" [tally, Term.var xs 0, x]),
                            Stmt.expr (Term.prim :if 0 ir.no_node ir.no_node ir.no_node
                                [Term.prim :eq 0 ir.no_node ir.no_node ir.no_node [says, Term.prim :unit 0 ir.no_node ir.no_node ir.no_node []],
                                 t, found])]
                    },
                }
            }) %{} (Site.body site));
        // The calls of itself after the counts, so that a count in a call's
        // own arguments is read from the tally too.
        let rewritten_body = list.head (hoist.rewrite (fn t ->
            if hoist.self_call (Site.gi site) t { call (Site.wgi site) (list.append (self_args t) [tally]) }
            else { () }) %{} counts_read);
        built site "tally_of" false rewritten_body (builtin p "_tally" [Term.var xs 0])
    }
};

// --- the oldest of a list grown at the front ---------------------------------------------

/// `list.head (list.reverse acc)` -- `reverse_from [] acc` read at 0 -- for
/// parameter `j`, handed on as `x :: acc` or as it was: the last element is
/// carried beside it, since a cons changes it only on an empty list. Where
/// `acc` is empty the read is left as written, which fails as `head` does.
let consed_last : Site -> [Fun, Fun, :map] | :unit;
let consed_last site =
    if Program.reverse_from (Site.program site) < 0 { () }
    else { first_of (list.map (fn j -> fn () -> consed_last_at site j) (list.range 0 (Site.k site))) };

let consed_last_at : Site -> :integer -> [Fun, Fun, :map] | :unit;
let consed_last_at site j = {
    let p = Site.program site;
    let gi = Site.gi site;
    let acc = sc.slot_name j;
    let body = Site.body site;
    let [terms, _] = hoist.parts body;
    let oldest t = match t {
        Term.prim(:get, _, _, _, _, [Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), start, Term.var(n, _)]),
                                     Term.prim(:const_int, _, i, _, _, _), Term.absent]) =>
            g == Program.reverse_from p && n == acc && is_nil start && (Program.ints p).[i] == 0,
        _ => false,
    };
    let consed arg = match arg {
        Term.prim(:cons, _, _, _, _, [e, rest]) if is_var acc rest => e,
        _ => (),
    };
    let self_calls = list.filter (fn t -> hoist.self_call gi t) terms;
    let grows = list.any (fn c -> consed (list.nth j (self_args c)) != ()) self_calls;
    // Carried already, by a round before: the read left as written is the
    // one on an empty list.
    let carried_already = list.any (fn t -> match t {
        Term.prim(:if, _, _, _, _, [Term.prim(:list_is_empty, _, _, _, _, [Term.var(n, _)]), y, _]) => n == acc && oldest y,
        _ => false,
    }) terms;
    if not (list.any oldest terms) || not grows || carried_already { () }
    else {
        let carried = Term.var "acc_oldest" 0;
        // The oldest of a list as the program reads it, `reverse_from` being
        // reached: read only where the list is not empty.
        let oldest_of x = Term.prim :get 0 ir.no_node ir.no_node ir.no_node
            [call (Program.reverse_from p) [nil, x], Term.prim :const_int 0 ((Program.small_ints p).[0]) ir.no_node ir.no_node [], Term.absent];
        let empty x = Term.prim :list_is_empty 0 ir.no_node ir.no_node ir.no_node [x];
        let cond c y z = Term.prim :if 0 ir.no_node ir.no_node ir.no_node [c, y, z];
        // The reads first, the calls of itself after, so that a read in a
        // call's own arguments is replaced too.
        let read = list.head (hoist.rewrite (fn t ->
            if oldest t { cond (empty (Term.var acc 0)) t carried } else { () }) %{} body);
        let rewritten_body = list.head (hoist.rewrite (fn t ->
            if hoist.self_call gi t {
                let arg = list.nth j (self_args t);
                let next = match consed arg {
                    () => if is_var acc arg { carried } else { oldest_of arg },
                    e => cond (empty (Term.var acc 0)) e carried,
                };
                call (Site.wgi site) (list.append (self_args t) [next])
            } else { () }) %{} read);
        built site "acc_oldest" false rewritten_body (oldest_of (Term.var acc 0))
    }
};

// --- an aggregate of a growing prefix --------------------------------------------------

/// A body past the reads of strict parameters it starts with.
let past_strict : Term -> Term;
let rec past_strict t = match t {
    Term.block(_, ss) => match list.drop_while (fn st -> match st {
        Stmt.expr(Term.var(_, fl)) => ir.has_flag fl ir.f_strict,
        _ => false,
    }) ss {
        [Stmt.expr(inner)] => past_strict inner,
        _ => t,
    },
    _ => t,
};

/// Whether function `fi`, called through global `gi`, is a left fold of a
/// list: on an empty list it answers its accumulator, and otherwise it calls
/// itself on the list's tail with every parameter but the accumulator as it
/// was. Then running it on `[x]` from an accumulator is one step of the fold.
/// `[list, accumulator]`, their positions, or `()`.
let fold_shape : Program -> :integer -> :integer -> [:integer, :integer] | :unit;
let fold_shape p fi gi =
    if fi < 0 || fi >= array.length (Program.funcs p) { () }
    else {
        let f = (Program.funcs p).[fi];
        let k = f.[:arity else 0];
        let position n = list.find_index (fn j -> sc.slot_name j == n) (list.range 0 k);
        if not (ir.has_flag (f.[:flags else 0]) ir.fn_rec) || ir.has_flag (f.[:flags else 0]) ir.fn_impure || f.[:n_captures else 0] > 0 { () }
        else {
            match past_strict (sc.body_of (Program.reading p) f) {
                Term.prim(:if, _, _, _, _, [Term.prim(:list_is_empty, _, _, _, _, [Term.var(l, _)]), answer, rest]) => {
                    let a = match unwrap answer { Term.var(n, _) => n, _ => "" };
                    let [li, ai] = [position l, position a];
                    let [terms, _] = hoist.parts rest;
                    let calls = list.filter (fn t -> hoist.self_call gi t) terms;
                    let stepping = list.all (fn c -> {
                        let args = self_args c;
                        list.length args == k && list.all (fn [j, arg] ->
                            if j == li { match arg { Term.prim(:list_tail, _, _, _, _, [Term.var(m, _)]) => m == l, _ => false } }
                            else { j == ai || is_var (sc.slot_name j) arg }) (list.enumerate args)
                    }) calls;
                    // It ends only where it answers the accumulator: every
                    // other leaf is a call of itself.
                    let ends = list.all (fn t -> hoist.self_call gi t) (leaves rest);
                    if li >= 0 && ai >= 0 && li != ai && not (list.is_empty calls) && stepping && ends { [li, ai] } else { () }
                },
                _ => (),
            }
        }
    };

/// Whether function `fi` is an aggregate of one list made by a fold: it
/// hands the fold its list whole, or its head as the accumulator and its
/// tail as the list, and everything else it hands the fold reads nothing of
/// its own -- so the same call can be written anywhere.
let aggregate_shape : Program -> :map -> :integer -> [:atom, :integer, [Term], :integer, :integer] | :unit;
let aggregate_shape p folds fi =
    if fi < 0 || fi >= array.length (Program.funcs p) { () }
    else {
        let f = (Program.funcs p).[fi];
        let own = sc.slot_name 0;
        let closed t = list.all (fn x -> match x {
            Term.var(_, _) => false,
            Term.lam(_, _, _, caps) => list.is_empty caps,
            _ => true,
        }) (list.head (hoist.parts t));
        let others args li ai = list.all (fn [j, arg] -> j == li || j == ai || closed arg) (list.enumerate args);
        if f.[:arity else 0] != 1 || f.[:n_captures else 0] > 0 || ir.has_flag (f.[:flags else 0]) ir.fn_impure { () }
        else {
            match unwrap (past_strict (sc.body_of (Program.reading p) f)) {
                Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) => match folds.[g else ()] {
                    [li, ai] if is_var own (list.nth li args) && closed (list.nth ai args) && others args li ai => [:whole, g, args, li, ai],
                    _ => (),
                },
                Term.prim(:if, _, _, _, _, [Term.prim(:list_is_empty, _, _, _, _, [Term.var(n, _)]), _, rest]) if n == own =>
                    match unwrap rest {
                        Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) => match folds.[g else ()] {
                            [li, ai] => {
                                let tail_ok = match list.nth li args { Term.prim(:list_tail, _, _, _, _, [Term.var(m, _)]) => m == own, _ => false };
                                let head_ok = match list.nth ai args {
                                    Term.prim(:get, _, _, _, _, [Term.var(m, _), Term.prim(:const_int, _, i, _, _, _), Term.absent]) =>
                                        m == own && (Program.ints p).[i] == 0,
                                    _ => false,
                                };
                                if tail_ok && head_ok && others args li ai { [:headed, g, args, li, ai] } else { () }
                            },
                            _ => (),
                        },
                        _ => (),
                    },
                _ => (),
            }
        }
    };

/// A loop over `i`, stepping by one, that asks an aggregate of `take (i + c)
/// xs` with `xs` handed on as it was: the aggregate carried from one step to
/// the next, as the length it stands for, its value, and the rest of `xs`
/// past it. Where the length carried is not this step's -- the first step,
/// or a prefix too short to step from -- the aggregate is asked as written.
let prefix_folded : Site -> [Fun, Fun, :map] | :unit;
let prefix_folded site = {
    let p = Site.program site;
    if Program.take p < 0 || map.size (Program.aggregates p) == 0 { () }
    else {
        let gi = Site.gi site;
        let k = Site.k site;
        let [terms, _] = hoist.parts (Site.body site);
        let self_calls = list.filter (fn t -> hoist.self_call gi t) terms;
        let stepped j = not (list.is_empty self_calls) && list.all (fn c -> match list.nth j (self_args c) {
            Term.prim(:add, _, _, _, _, [Term.var(n, _), Term.prim(:const_int, _, i, _, _, _)]) => n == sc.slot_name j && (Program.ints p).[i] == 1,
            _ => false,
        }) self_calls;
        let kept j = list.all (fn c -> is_var (sc.slot_name j) (list.nth j (self_args c))) self_calls;
        let prefix i xs arg = match arg {
            Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, tk, _, _, _), n, Term.var(l, _)])
                if tk == Program.take p && l == sc.slot_name xs && match n {
                    Term.var(m, _) => m == sc.slot_name i,
                    Term.prim(:add, _, _, _, _, [Term.var(m, _), Term.prim(:const_int, _, _, _, _, _)]) => m == sc.slot_name i,
                    _ => false,
                } => n,
            _ => (),
        };
        let closed x = list.all (fn y -> match y {
            Term.var(_, _) => false,
            Term.lam(_, _, _, caps) => list.is_empty caps,
            _ => true,
        }) (list.head (hoist.parts x));
        // `[term, the aggregate, n]` for each read of one: an aggregate of a
        // prefix, or a fold called on one directly.
        let asked i xs t = match t {
            Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) if map.has g (Program.folds p) => {
                let [li, ai] = (Program.folds p).[g];
                match prefix i xs (list.nth li args) {
                    () => (),
                    n if list.all (fn [j, a] -> j == li || closed a) (list.enumerate args) =>
                        [t, [:whole, g, args, li, ai], n, Term.var (sc.slot_name xs) 0],
                    _ => (),
                }
            },
            Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _),
                                           Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, tk, _, _, _), n, Term.var(l, _)])]) =>
                match (Program.aggregates p).[g else ()] {
                    () => (),
                    shape if tk == Program.take p && l == sc.slot_name xs && match n {
                        Term.var(m, _) => m == sc.slot_name i,
                        Term.prim(:add, _, _, _, _, [Term.var(m, _), Term.prim(:const_int, _, _, _, _, _)]) => m == sc.slot_name i,
                        _ => false,
                    } => [t, shape, n, Term.var (sc.slot_name xs) 0],
                    _ => (),
                },
            _ => (),
        };
        let found = list.concat (list.map (fn i -> list.concat (list.map (fn xs ->
            match list.find (fn t -> asked i xs t != ()) terms { () => [], t => [asked i xs t] })
            (list.filter (fn xs -> xs != i && kept xs) (list.range 0 k))))
            (list.filter stepped (list.range 0 k)));
        // Carried already, by a round before.
        let done = list.any (fn t -> match t {
            Term.prim(:apply, _, _, _, _, [Term.prim(:builtin, _, b, _, _, _), .._]) => b == (Program.ids p).["_list_drop"],
            _ => false,
        }) terms;
        match if done { [] } else { found } {
            [] => (),
            [[t, [form, loop, args, li, ai], n, xs], .._] => {
                let int v = Term.prim :const_int 0 ((Program.small_ints p).[v]) ir.no_node ir.no_node [];
                let op o x y = Term.prim o 0 ir.no_node ir.no_node ir.no_node [x, y];
                let cond c y z = Term.prim :if 0 ir.no_node ir.no_node ir.no_node [c, y, z];
                let [carried_n, carried, rest] = [Term.var "pfx_n" 0, Term.var "pfx_state" 0, Term.var "pfx_rest" 0];
                let [hit, here, after] = [Term.var "pfx_hit" 0, Term.var "pfx_here" 0, Term.var "pfx_after" 0];
                let unknown = op :sub (int 0) (int 1);
                let empty x = Term.prim :list_is_empty 0 ir.no_node ir.no_node ir.no_node [x];
                // One more step of the fold: its loop on the next element
                // alone, from the aggregate so far.
                let next_element = Term.prim :get 0 ir.no_node ir.no_node ir.no_node [after, int 0, Term.absent];
                let stepped_once = call loop (list.map (fn [j, arg] -> if j == li { Term.prim :make_list 0 ir.no_node 1 ir.no_node [next_element] }
                                                                   else if j == ai { here } else { arg }) (list.enumerate args));
                // A prefix the fold can step from: any for a fold handed the
                // whole list, one with a head for one handed the head.
                let from = if form == :headed { int 1 } else { int 0 };
                let steps = op :ge n from;
                let lets = [Stmt.bind "pfx_hit" 0 (op :eq carried_n n),
                            Stmt.bind "pfx_here" 0 (cond hit carried t),
                            Stmt.bind "pfx_after" 0 (cond hit rest (builtin p "_list_drop" [n, xs]))];
                // The reads first, the calls of itself after, so that a read
                // in a call's own arguments is replaced too.
                let read = list.head (hoist.rewrite (fn x -> if x == t { here } else { () }) %{} (Site.body site));
                let body = list.head (hoist.rewrite (fn x ->
                    if hoist.self_call gi x {
                        call (Site.wgi site) (list.append (self_args x) [
                            cond steps (op :add n (int 1)) unknown,
                            cond (op :and steps (Term.prim :not 0 ir.no_node ir.no_node ir.no_node [empty after])) stepped_once here,
                            cond (empty after) after (Term.prim :list_tail 0 ir.no_node ir.no_node ir.no_node [after])])
                    } else { () }) %{} read);
                built_with site [["pfx_n", false, unknown], ["pfx_state", false, Term.prim :unit 0 ir.no_node ir.no_node ir.no_node []],
                                 ["pfx_rest", false, nil]] []
                           (Term.block 0 (list.append lets [Stmt.expr body]))
            },
        }
    }
};

// --- several demanded folds of the same list -------------------------------------

/// A call that may share a traversal: the call as written, its list's name,
/// and the fold and initial arguments read by `fold_shape`/`aggregate_shape`.
group TupleFold { term : Term, xs : :string, form : :atom, loop : :integer, args : [Term], li : :integer, ai : :integer }

let tuple_call : Program -> Term -> TupleFold | :unit;
let tuple_call p t = match unwrap t {
    Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) => match (Program.folds p).[g else ()] {
        [li, ai] => match list.nth li args {
            Term.var(n, _) => TupleFold.make t n :whole g args li ai,
            _ => (),
        },
        _ => match [args, (Program.aggregates p).[g else ()]] {
            [[Term.var(n, _)], [form, loop, starts, li, ai]] => TupleFold.make t n form loop starts li ai,
            _ => (),
        },
    },
    // The driver may already have unfolded an aggregate's small wrapper.
    // Read the same headed shape directly at its call site in that case.
    Term.prim(:if, _, _, _, _, [Term.prim(:list_is_empty, _, _, _, _, [Term.var(n, _)]), _, rest]) => match unwrap rest {
        Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) => match (Program.folds p).[g else ()] {
            [li, ai] if match list.nth li args {
                Term.prim(:list_tail, _, _, _, _, [Term.var(m, _)]) => m == n,
                _ => false,
            } && match list.nth ai args {
                Term.prim(:get, _, _, _, _, [Term.var(m, _), Term.prim(:const_int, _, i, _, _, _), Term.absent]) => m == n && (Program.ints p).[i] == 0,
                _ => false,
            } => TupleFold.make t n :headed g args li ai,
            _ => (),
        },
        _ => (),
    },
    _ => (),
};

/// The children whose outer values evaluating this primitive always demands.
/// A call contributes only its callee's explicit strict parameters. Unknown
/// calls, constructors, branch arms and handlers give no such guarantee.
let tuple_strict : Program -> Term -> [:integer];
let tuple_strict p t = match t {
    Term.prim(op, _, _, _, _, cs) if list.contains op hoist.strict_binaries => list.range 0 (list.length cs),
    Term.prim(op, _, _, _, _, [_]) if list.contains op [:force, :neg, :not, :bnot, :type_is] => [0],
    Term.prim(op, _, _, _, _, _) if list.contains op [:if, :and, :or, :switch_head, :switch_atom] => [0],
    Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) => {
        let global = (Program.globals p).[g];
        match global.[:target else -1] {
            fi if global.[:kind else -1] == ir.global_function && fi >= 0 && fi < array.length (Program.funcs p) => {
                let f = (Program.funcs p).[fi];
                if list.length args != f.[:arity else 0] { [] }
                else { list.concat (list.map (fn st -> match st {
                    Stmt.expr(Term.var(n, _)) => match sc.fixed_slot n {
                        j if j != () && j < list.length args => [j + 1],
                        _ => [],
                    },
                    _ => [],
                }) (hoist.strict_reads (sc.body_of (Program.reading p) f))) }
            },
            _ => [],
        }
    },
    _ => [],
};

/// Calls demanded on this path, following lazy bindings only when their
/// names are demanded too. The names are kept so rewriting follows exactly
/// these edges, even when an arena node is also shared by an unchosen arm.
let tuple_demands : Program -> Term -> [[Term], [:string]];
let tuple_demands p body = {
    let [_, stmts] = hoist.parts body;
    let bindings = list.fold (fn m st -> match st { Stmt.bind(n, _, x) => m.[n => x], _ => m }) %{} stmts;
    tuple_demanding p bindings [body] %{} [] []
};

/// Names are unique after `sc.renamed`, so a binding has one meaning on
/// every demanded edge that reaches it. Visit each arena term only once:
/// following a shared binding separately at each use made this analysis
/// multiply the self-compiler's work.
let tuple_demanding : Program -> :map -> [Term] -> :map -> [Term] -> [:string] -> [[Term], [:string]];
let rec tuple_demanding p bindings todo !seen !calls !wanted = match todo {
    [] => [calls, wanted],
    [t, ..rest] if map.has t seen => tuple_demanding p bindings rest seen calls wanted,
    [t, ..rest] => {
        let seen = seen.[t => true];
        match tuple_call p t {
            shape if shape != () => tuple_demanding p bindings rest seen (list.cons t calls) wanted,
            _ => match t {
                Term.var(n, _) => match bindings.[n else ()] {
                    () => tuple_demanding p bindings rest seen calls wanted,
                    x => tuple_demanding p bindings (list.cons x rest) seen calls (list.cons n wanted),
                },
                Term.block(_, ss) => {
                    let last = list.length ss - 1;
                    let edges = list.concat (list.map (fn [i, st] -> match st {
                        Stmt.bind(_, fl, x) if ir.has_flag fl ir.f_strict => [x],
                        Stmt.expr(x) if i == last || ir.has_flag (drive.flags_of x) ir.f_strict => [x],
                        _ => [],
                    }) (list.enumerate ss));
                    tuple_demanding p bindings (list.append edges rest) seen calls wanted
                },
                Term.prim(_, _, _, _, _, cs) => tuple_demanding p bindings
                    (list.append (list.map (fn i -> list.nth i cs) (tuple_strict p t)) rest) seen calls wanted,
                _ => tuple_demanding p bindings rest seen calls wanted,
            },
        }
    },
};

/// Replace only demanded edges; a call with the same syntax in a branch
/// that might not run must keep the traversal it had.
let tuple_reads : Program -> :map -> [:string] -> Term -> Term;
let rec tuple_reads p replacements wanted t = match replacements.[t else ()] {
    x if x != () => drive.inherit t x,
    _ => match t {
        Term.block(fl, ss) => {
            let last = list.length ss - 1;
            Term.block fl (list.map (fn [i, st] -> match st {
                Stmt.bind(n, bf, x) if list.contains n wanted || ir.has_flag bf ir.f_strict => Stmt.bind n bf (tuple_reads p replacements wanted x),
                Stmt.expr(x) if i == last || ir.has_flag (drive.flags_of x) ir.f_strict => Stmt.expr (tuple_reads p replacements wanted x),
                _ => st,
            }) (list.enumerate ss))
        },
        Term.prim(op, fl, a, b, c, cs) => {
            let strict = tuple_strict p t;
            Term.prim op fl a b c (list.map (fn [i, x] -> if list.contains i strict { tuple_reads p replacements wanted x } else { x }) (list.enumerate cs))
        },
        _ => t,
    },
};

/// A fold's body must really be a local step. `fold_shape` alone also
/// admits folds that inspect the remaining list or call themselves inside
/// an argument. Those are left as written. Parameters other than the list
/// are handed on, and each step may read just the head of the current cell.
let tuple_step : Program -> TupleFold -> :bool;
let tuple_step p shape = {
    let g = TupleFold.loop shape;
    let f = (Program.funcs p).[((Program.globals p).[g]).[:target]];
    let body = sc.renamed (sc.body_of (Program.reading p) f);
    let l = sc.slot_name (TupleFold.li shape);
    let local t = list.head (hoist.rewrite (fn x -> match x {
        Term.prim(:get, _, _, _, _, [Term.var(n, _), Term.prim(:const_int, _, i, _, _, _), Term.absent])
            if n == l && (Program.ints p).[i] == 0 => nil,
        Term.prim(:list_head, _, _, _, _, [Term.var(n, _)]) if n == l => nil,
        _ => (),
    }) %{} t);
    match past_strict body {
        Term.prim(:if, _, _, _, _, [_, _, rest]) =>
            list.length (TupleFold.args shape) == f.[:arity else 0]
            && not (list.any (fn x -> match x { Term.trying(_, _, _, _) => true, _ => false }) (list.head (hoist.parts rest)))
            && not (list.any (fn x -> names g x) (around rest))
            && list.all (fn leaf -> hoist.self_call g leaf && list.all (fn [i, x] ->
                i == TupleFold.li shape || (not (reads l (local x)) && not (names g x))) (list.enumerate (self_args leaf))) (leaves rest)
            && not (reads l (local (map_leaves (fn _ -> nil) rest))),
        _ => false,
    }
};

/// Rename a copied fold's parameters, bindings and captures together. The
/// prefix is private to this component of the tuple, including branch slots
/// already given distinct names by `sc.renamed`.
let tuple_named : :map -> Term -> Term;
let tuple_named renaming t = rename_binds renaming (list.head (hoist.rewrite (fn x -> match x {
    Term.var(n, fl) => Term.var (renaming.[n else n]) fl,
    Term.lam(op, fl, fi, caps) => Term.lam op fl fi (list.map (fn n -> renaming.[n else n]) caps),
    _ => (),
}) %{} t));

/// Several independent folds of one list, all demanded on the same path,
/// become one loop with one accumulator per fold. Demand follows strict
/// operations and explicit strict parameters through lazy bindings, stopping
/// at branches, unknown calls, constructors and exception boundaries. Only
/// starts over the caller's parameters are moved, so no start can depend on
/// another fold's result or read a local before it has been bound.
///
/// The worker runs each original step's control and keeps its accumulator
/// argument lazy, with exactly the original strict parameter reads on entry
/// to the next iteration. It neither reassociates arithmetic nor forces an
/// element that its step left lazy. Headed folds start with the first head
/// and keep their original empty-list answer. Thus the walk forces the union
/// of the demanded walks, changing only which independent failure is met
/// first. If any of these facts cannot be proved, the code stays as written.
let tupled : Site -> [Fun, Fun | [Fun], :map] | :unit;
let tupled site = {
    let p = Site.program site;
    let f = (Program.funcs p).[Site.fi site];
    let body = Site.body site;
    let params = list.map sc.slot_name (list.range 0 (Site.k site));
    let [terms, wanted] = tuple_demands p body;
    let found = list.map (fn t -> tuple_call p t) (list.unique terms);
    let safe shape = list.contains (TupleFold.xs shape) params && tuple_step p shape
        && list.all (fn [i, x] -> i == TupleFold.li shape || (TupleFold.form shape == :headed && i == TupleFold.ai shape)
            || list.all (fn y -> match y {
                Term.var(n, _) => list.contains n params,
                Term.lam(_, _, _, caps) => list.all (fn n -> list.contains n params) caps,
                _ => true,
            }) (list.head (hoist.parts x))) (list.enumerate (TupleFold.args shape));
    let candidates = list.filter safe found;
    let group = first_of (list.map (fn n -> fn () -> {
        let same = list.filter (fn s -> TupleFold.xs s == n) candidates;
        if list.length same >= 2 && list.length same <= 8 { same } else { () }
    }) params);
    match group {
        () => (),
        shapes => tuple_built site shapes wanted,
    }
};

let tuple_built : Site -> [TupleFold] -> [:string] -> [Fun, Fun | [Fun], :map];
let tuple_built site shapes wanted = {
    let p = Site.program site;
    let xs = Term.var "tuple_xs" 0;
    let int i = Term.prim :const_int 0 ((Program.small_ints p).[i]) ir.no_node ir.no_node [];
    let empty = Term.prim :list_is_empty 0 ir.no_node ir.no_node ir.no_node [xs];
    let head_value = Term.prim :get 0 ir.no_node ir.no_node ir.no_node [xs, int 0, Term.absent];
    let head = Term.var "tuple_head" 0;
    let tail = Term.prim :list_tail 0 ir.no_node ir.no_node ir.no_node [xs];
    let name i j = "tuple_" + to_string i + "_" + sc.slot_name j;
    let acc i = name i (TupleFold.ai (list.nth i shapes));
    let next i = "tuple_next_" + to_string i;
    let components = list.enumerate shapes;
    let entries = list.concat (list.map (fn [i, s] -> list.concat (list.map (fn [j, a] ->
        if j == TupleFold.li s { [] }
        else { [[name i j, if TupleFold.form s == :headed && j == TupleFold.ai s { head } else { a }]] })
        (list.enumerate (TupleFold.args s)))) components);
    let caller_names = list.filter (fn n -> n != TupleFold.xs (list.head shapes))
                                  (list.map sc.slot_name (list.range 0 (Site.k site)));
    let caller_name n = "tuple_caller_" + n;
    let caller_args = list.map (fn n -> Term.var (caller_name n) 0) caller_names;
    let worker_params = list.concat [["tuple_xs"], list.map list.head entries, list.map caller_name caller_names];
    let again = call (Site.wgi site) (list.concat [[tail],
        list.concat (list.map (fn [i, s] -> list.concat (list.map (fn [j, _] ->
            if j == TupleFold.li s { [] } else { [Term.var (if j == TupleFold.ai s { next i } else { name i j }) 0] })
            (list.enumerate (TupleFold.args s)))) components), caller_args]);
    let moved i s = {
        let f = (Program.funcs p).[((Program.globals p).[TupleFold.loop s]).[:target]];
        let body = sc.renamed (sc.body_of (Program.reading p) f);
        let [_, stmts] = hoist.parts body;
        let locals = list.concat (list.map (fn st -> match st { Stmt.bind(n, _, _) => [n], _ => [] }) stmts);
        let renaming = list.fold (fn m n -> m.[n => "tuple_local_" + to_string i + "_" + n]) %{} locals;
        let renaming = list.fold (fn m j -> m.[sc.slot_name j => if j == TupleFold.li s { "tuple_xs" } else { name i j }])
                                  renaming (list.range 0 (list.length (TupleFold.args s)));
        let named = tuple_named renaming body;
        list.head (hoist.rewrite (fn t -> match t {
            Term.prim(:get, _, _, _, _, [Term.var(n, _), Term.prim(:const_int, _, z, _, _, _), Term.absent])
                if n == "tuple_xs" && (Program.ints p).[z] == 0 => head,
            Term.prim(:list_head, _, _, _, _, [Term.var(n, _)]) if n == "tuple_xs" => head,
            _ => (),
        }) %{} named)
    };
    let bodies = list.map (fn [i, s] -> moved i s) components;
    let advance i s continuation = {
        let rest = match past_strict (list.nth i bodies) { Term.prim(:if, _, _, _, _, [_, _, r]) => r, _ => nil };
        map_leaves (fn leaf -> Term.block 0 [
            Stmt.bind (next i) 0 (list.nth (TupleFold.ai s) (self_args leaf)), Stmt.expr continuation]) rest
    };
    let forces = list.concat (list.map hoist.strict_reads bodies);
    let steps = list.fold (fn continuation [i, s] -> advance i s continuation) again (list.reverse components);
    let steps = Term.block 0 [Stmt.bind "tuple_head" 0 head_value, Stmt.expr steps];
    let answer = Term.prim :make_list 0 ir.no_node (list.length shapes) ir.no_node
                           (list.map (fn [i, _] -> Term.var (acc i) 0) components);
    // Every selected result is demanded by the caller. Force the finished
    // accumulators here, after the spine ends, so a lazy numeric fold keeps
    // its original order and the JIT can still see its demanded result.
    let direct_replacements = list.fold (fn m [i, s] -> m.[TupleFold.term s => Term.var (acc i) 0]) %{} components;
    let returned = tuple_reads p direct_replacements wanted (Site.body site);
    let returns_directly = not (reads (TupleFold.xs (list.head shapes)) returned);
    let [_, return_stmts] = hoist.parts returned;
    let return_names = list.concat (list.map (fn st -> match st { Stmt.bind(n, _, _) => [n], _ => [] }) return_stmts);
    let return_renaming = list.fold (fn m n -> m.[n => "tuple_return_" + n]) %{} return_names;
    let return_renaming = list.fold (fn m n -> m.[n => caller_name n]) return_renaming caller_names;
    let result_params = list.concat [list.map (fn [i, _] -> acc i) components, list.map caller_name caller_names];
    let result_args = list.map (fn n -> Term.var n 0) result_params;
    let result_call = Term.prim :apply 0 ir.no_node ir.no_node ir.no_node
        (list.cons (Term.lam :make_closure 0 (Site.wfi site + 1) []) result_args);
    let finished = Term.block 0 (list.append (list.map (fn [i, _] -> Stmt.expr (Term.var (acc i) ir.f_strict)) components)
        [Stmt.expr (if returns_directly { result_call } else { answer })]);
    let worker_body = Term.block 0 (list.append forces [Stmt.expr (if_term empty finished steps)]);
    let f = (Program.funcs p).[Site.fi site];
    let template = f.[:arity => list.length worker_params].[:n_captures => 0].[:captures_off => 0]
                    .[:slots => list.length worker_params].[:flags => ir.fn_rec];
    let worker = Fun.make worker_params [] worker_body template;
    let result = Fun.make result_params [] (tuple_named return_renaming returned)
        (f.[:arity => list.length result_params].[:n_captures => 0].[:captures_off => 0]
          .[:slots => list.length result_params].[:flags => 0]);
    // The first cell is handled outside the loop. Headed folds seed from
    // its head; whole folds execute their original first step. In particular
    // its control runs even when a later lazy step discards that accumulator.
    let initial = list.fold (fn continuation [i, s] ->
        if TupleFold.form s == :headed { Term.block 0 [Stmt.bind (next i) 0 head, Stmt.expr continuation] }
        else { Term.block 0 (list.append (hoist.strict_reads (list.nth i bodies)) [Stmt.expr (advance i s continuation)]) })
        again (list.reverse components);
    let initial = Term.block 0 (list.concat [[Stmt.bind "tuple_head" 0 head_value], list.map (fn [n, a] -> Stmt.bind n 0 a) entries,
        list.map (fn n -> Stmt.bind (caller_name n) 0 (Term.var n 0)) caller_names, [Stmt.expr initial]]);
    let original = Term.prim :make_list 0 ir.no_node (list.length shapes) ir.no_node (list.map TupleFold.term shapes);
    let start = Term.block 0 [Stmt.bind "tuple_xs" 0 (Term.var (TupleFold.xs (list.head shapes)) 0),
                              Stmt.expr (if_term empty (if returns_directly { Site.body site } else { original }) initial)];
    let replacements = list.fold (fn m [i, s] -> m.[TupleFold.term s =>
        Term.prim :get 0 ir.no_node ir.no_node ir.no_node [Term.var "tuple_results" 0, int i, Term.absent]]) %{} components;
    let body = tuple_reads p replacements wanted (Site.body site);
    // If the caller never reads the list except through these folds, its
    // remaining body can consume the finished accumulators in the worker.
    // The wrapper then tail-calls it, so no waiting frame pins the input.
    let wrapper = sc.fun_of f (if returns_directly {
        Term.block 0 (list.append (hoist.strict_reads (Site.body site)) [Stmt.expr start])
    } else { Term.block 0 [Stmt.bind "tuple_results" 0 start, Stmt.expr body] });
    [wrapper, if returns_directly { [worker, result] } else { [worker] }, ((Program.globals p).[Site.gi site]).[:target => Site.wfi site]]
};

// --- searching a list that does not change by a key ----------------------------------------

/// Whether function `fi`, called through global `gi`, finds the first
/// element of a list whose key is a value: `if empty l { none } else if
/// key (l.[0]) == x { found } else { self (tail l) .. x .. }`, the key read
/// by constant `.[k]`s, `found` reading the element and nothing else of the
/// list, `none` reading nothing, every other parameter handed on as it was.
let keyed_shape : Program -> :integer -> :integer -> [:integer, :integer, :any, :bool, Term, Term] | :unit;
let keyed_shape p fi gi =
    if fi < 0 || fi >= array.length (Program.funcs p) { () }
    else {
        let f = (Program.funcs p).[fi];
        let k = f.[:arity else 0];
        let position n = list.find_index (fn j -> sc.slot_name j == n) (list.range 0 k);
        let int_is t v = match t { Term.prim(:const_int, _, i, _, _, _) => (Program.ints p).[i] == v, _ => false };
        let element l t = match t {
            Term.prim(:get, _, _, _, _, [Term.var(n, _), i, Term.absent]) => n == l && int_is i 0,
            _ => false,
        };
        // The path a key is read by, outermost last, or `()`.
        let path_of l t = {
            let rec walk t = if element l t { [] } else { match t {
                Term.prim(:get, _, _, _, _, [inner, key, Term.absent]) => match key {
                    Term.prim(op, _, _, _, _, []) if op == :const_int || op == :const_atom || op == :const_str =>
                        match walk inner { () => (), path => list.append path [key] },
                    _ => (),
                },
                _ => (),
            } };
            walk t
        };
        if f.[:n_captures else 0] > 0 || ir.has_flag (f.[:flags else 0]) ir.fn_impure { () }
        else {
            match past_strict (sc.body_of (Program.reading p) f) {
                Term.prim(:if, _, _, _, _, [Term.prim(:list_is_empty, _, _, _, _, [Term.var(l, _)]), none, rest]) => match unwrap rest {
                    Term.prim(:if, _, _, _, _, [Term.prim(:eq, _, _, _, _, [a, b]), found, again]) => {
                        let [x, path, x_first] = match [a, b] {
                            [Term.var(n, _), y] if path_of l y != () => [n, path_of l y, true],
                            [y, Term.var(n, _)] if path_of l y != () => [n, path_of l y, false],
                            _ => ["", [], false],
                        };
                        let [li, xi] = [position l, position x];
                        let reads_only_element t = list.all (fn y -> match y {
                            Term.var(n, _) => n != l && position n >= 0,
                            Term.lam(_, _, _, caps) => list.is_empty caps,
                            Term.block(_, _) => false,
                            _ => true,
                        }) (list.head (hoist.parts (list.head (hoist.rewrite (fn y -> if element l y { Term.prim :unit 0 ir.no_node ir.no_node ir.no_node [] } else { () }) %{} t))));
                        let closed t = list.all (fn y -> match y {
                            Term.var(_, _) => false,
                            Term.lam(_, _, _, caps) => list.is_empty caps,
                            Term.block(_, _) => false,
                            _ => true,
                        }) (list.head (hoist.parts t));
                        let stepping = match unwrap again {
                            Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) =>
                                g == gi && list.length args == k && list.all (fn [j, arg] ->
                                    if j == li { match arg { Term.prim(:list_tail, _, _, _, _, [Term.var(m, _)]) => m == l, _ => false } }
                                    else { is_var (sc.slot_name j) arg }) (list.enumerate args),
                            _ => false,
                        };
                        if li >= 0 && xi >= 0 && stepping && reads_only_element (unwrap found) && closed (unwrap none) {
                            [li, xi, path, x_first, unwrap found, unwrap none]
                        } else { () }
                    },
                    _ => (),
                },
                _ => (),
            }
        }
    };

/// A loop that searches parameter `j`, a list it hands on as it was, by a
/// key: an index of it carried beside it, made the first time a search needs
/// it, and each search a lookup in it -- or the search as written, when the
/// index cannot say.
let indexed : Site -> [Fun, Fun | [Fun], :map] | :unit;
let indexed site =
    if map.size (Program.keyed (Site.program site)) == 0 { () }
    else {
        match hoist.statics (Site.program site) (Site.gi site) (Site.k site) (hoist.parts (Site.body site)) {
            () => (),
            statics => first_of (list.map (fn j -> fn () -> indexed_at site j) statics),
        }
    };

let indexed_at : Site -> :integer -> [Fun, Fun | [Fun], :map] | :unit;
let indexed_at site j = {
    let p = Site.program site;
    let gi = Site.gi site;
    let xs = sc.slot_name j;
    let [terms, _] = hoist.parts (Site.body site);
    // Searches of `xs` in the loop's own body, and calls handing `xs` to a
    // function that searches it.
    // Read through an index already, by a round before: the search left as
    // written is the one the index could not answer.
    let done = list.any (fn t -> match t {
        Term.prim(:apply, _, _, _, _, [Term.prim(:builtin, _, b, _, _, _), .._]) => b == (Program.ids p).["_index_find"],
        _ => false,
    }) terms;
    let own = if done { [] } else { list.filter (fn t -> searched_in p xs t != ()) terms };
    let handed = if done { [] } else { list.filter (fn t -> match t {
        Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) => match (Program.searchers p).[g else ()] {
            [at, _, _] => is_var xs (list.nth at args),
            _ => false,
        },
        _ => false,
    }) terms };
    let keys = list.append (list.map (fn t -> match searched_in p xs t { [_, _, _, q, xf, _, _] => [q, xf], _ => [] }) own)
                           (list.map (fn t -> match t {
                               Term.prim(_, _, _, _, _, [Term.prim(_, _, g, _, _, _), .._]) => match (Program.searchers p).[g else ()] {
                                   [_, q, xf] => [q, xf], _ => [],
                               },
                               _ => [],
                           }) handed);
    // One index, so every search must read the same key.
    match keys {
        [] => (),
        [first, ..rest] if list.all (fn k -> k == first) rest => {
            let [path, x_first] = first;
            let index = Term.var "key_index" 0;
            // A searching function handed `xs` is called as a copy of itself
            // taking the index too: a closure of no captures, numbered after
            // the loop's worker, so it needs no global of its own.
            let called = list.unique (list.map (fn t -> match t { Term.prim(_, _, _, _, _, [Term.prim(_, _, g, _, _, _), .._]) => g, _ => -1 }) handed);
            let copies = list.map (fn [n, g] -> [g, Site.wfi site + 1 + n]) (list.enumerate called);
            let clone_of g = {
                let fi = ((Program.globals p).[g]).[:target];
                let f = (Program.funcs p).[fi];
                let k = f.[:arity else 0];
                let [at, _, _] = (Program.searchers p).[g];
                let shifted = hoist.shift_slots k 1 (sc.body_of (Program.reading p) f);
                let body = index_reads p (sc.slot_name at) (Term.var (sc.slot_name k) 0) shifted;
                sc.fun_of (f.[:arity => k + 1].[:slots => f.[:slots else 0] + 1]
                             .[:flags => untagged (f.[:flags else 0])]) body
            };
            // The searches and the calls handing `xs` on first, the calls of
            // itself after, so that one inside a call's own arguments is
            // rewritten too.
            let reads = list.head (hoist.rewrite (fn t -> match t {
                Term.prim(:apply, fl, a, b, c, [Term.prim(:global, _, g, _, _, _), ..args]) if g != gi => match list.find (fn [h, _] -> h == g) copies {
                    [_, cfi] if is_var xs (list.nth (list.head ((Program.searchers p).[g])) args) =>
                        Term.prim :apply fl a b c (list.cons (Term.lam :make_closure 0 cfi []) (list.append args [index])),
                    _ => (),
                },
                _ => (),
            }) %{} (index_reads p xs index (Site.body site)));
            let body = list.head (hoist.rewrite (fn t ->
                if hoist.self_call gi t { call (Site.wgi site) (list.append (self_args t) [index]) } else { () }) %{} reads);
            let path_list = Term.prim :make_list 0 ir.no_node (list.length path) ir.no_node path;
            let [wrapper, worker, global] = built site "key_index" false body
                  (builtin p "_index_new" [Term.var xs 0, path_list, Term.prim :const_bool 0 (if x_first { 1 } else { 0 }) ir.no_node ir.no_node []]);
            [wrapper, list.cons worker (list.map (fn [g, _] -> clone_of g) copies), global]
        },
        _ => (),
    }
};

/// A search of `xs` that `t` is, as `[args, list, value, path, value first,
/// found, none]`, or `()`.
let searched_in : Program -> :string -> Term -> :any;
let searched_in p xs t = match t {
    Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) => match (Program.keyed p).[g else ()] {
        [li, xi, path, x_first, found, none] if is_var xs (list.nth li args) => [args, li, xi, path, x_first, found, none],
        _ => (),
    },
    _ => (),
};

/// `body` with each search of `xs` a lookup in `index` -- or the search as
/// written, when the index cannot say.
let index_reads : Program -> :string -> Term -> Term -> Term;
let index_reads p xs index body = list.head (hoist.rewrite (fn t ->
    match searched_in p xs t {
        () => (),
        [args, li, xi, _, _, found, none] => {
            let says = Term.var "key_says" 0;
            // What it answers, in this frame: the element found where it read
            // `l.[0]`, its parameters as this call hands them.
            let l = sc.slot_name li;
            let here = list.head (hoist.rewrite (fn y -> match y {
                Term.prim(:get, _, _, _, _, [Term.var(n, _), _, Term.absent]) if n == l =>
                    Term.prim :get 0 ir.no_node ir.no_node ir.no_node
                        [says, Term.prim :const_int 0 ((Program.small_ints p).[0]) ir.no_node ir.no_node [], Term.absent],
                Term.var(n, _) => match list.find_index (fn m -> sc.slot_name m == n) (list.range 0 (list.length args)) {
                    -1 => (),
                    m => list.nth m args,
                },
                _ => (),
            }) %{} found);
            Term.block (drive.flags_of t) [
                Stmt.bind "key_says" ir.f_strict (builtin p "_index_find" [index, list.nth xi args]),
                Stmt.expr (Term.prim :if 0 ir.no_node ir.no_node ir.no_node
                    [Term.prim :eq 0 ir.no_node ir.no_node ir.no_node [says, Term.prim :unit 0 ir.no_node ir.no_node ir.no_node []],
                     t,
                     Term.prim :if 0 ir.no_node ir.no_node ir.no_node
                         [Term.prim :list_is_empty 0 ir.no_node ir.no_node ir.no_node [says], none, here]])]
        },
    }) %{} body);

/// Whether function `fi` searches one of its parameters by a key -- a pure
/// function of its own, not recursive, every search in it of that parameter
/// and by one key: `[parameter, path, value first]`, or `()`.
let searcher_shape : Program -> :integer -> [:integer, :any, :bool] | :unit;
let searcher_shape p fi =
    if fi < 0 || fi >= array.length (Program.funcs p) { () }
    else {
        let f = (Program.funcs p).[fi];
        let fl = f.[:flags else 0];
        let k = f.[:arity else 0];
        if k == 0 || ir.has_flag fl ir.fn_rec || ir.has_flag fl ir.fn_impure || ir.has_flag fl ir.fn_thunk
           || ir.has_flag fl ir.fn_global_value || f.[:n_captures else 0] > 0 { () }
        else {
            let [terms, _] = hoist.parts (sc.body_of (Program.reading p) f);
            let found = list.concat (list.map (fn j -> list.concat (list.map (fn t -> match searched_in p (sc.slot_name j) t {
                [_, _, _, q, xf, _, _] => [[j, q, xf]],
                _ => [],
            }) terms)) (list.range 0 k));
            match found {
                [first, ..rest] if list.all (fn x -> x == first) rest => first,
                _ => (),
            }
        }
    };

// --- a priority queue sorted on every step --------------------------------------------------

/// Parameter `j`, a list read only by being sorted -- tested for emptiness,
/// sorted, the sort's head read and its tail handed on, perhaps with pieces
/// added -- carried as a heap (`_heap_of`) instead. Its smallest is the head
/// `list.sort` would answer and its pop the tail, in the order a stable sort
/// gives; each step is a pop and a push rather than a sort.
let heaped : Site -> [Fun, Fun, :map] | :unit;
let heaped site =
    if Program.sort (Site.program site) < 0 { () }
    else { first_of (list.map (fn j -> fn () -> heaped_at site j) (list.range 0 (Site.k site))) };

let heaped_at : Site -> :integer -> [Fun, Fun, :map] | :unit;
let heaped_at site j = {
    let p = Site.program site;
    let gi = Site.gi site;
    let q = sc.slot_name j;
    let body = Site.body site;
    let [terms, stmts] = hoist.parts body;
    let sort_of t = match t {
        Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), Term.var(n, _)]) => g == Program.sort p && n == q,
        _ => false,
    };
    // The names the sort is bound to, lazily.
    let sorts = list.concat (list.map (fn s -> match s {
        Stmt.bind(n, fl, x) if sort_of x && not (ir.has_flag fl ir.f_strict) => [n],
        _ => [],
    }) stmts);
    let sorted t = sort_of t || match t { Term.var(n, _) => list.contains n sorts, _ => false };
    let is_q t = is_var q t;
    let mentions t = reads q t || list.any (fn n -> reads n t) sorts;
    let tail_of t = match t { Term.prim(:list_tail, _, _, _, _, [x]) => sorted x, _ => false };
    // How a call of itself hands the queue on: `[:pop, pieces]`, `[:keep,
    // pieces]`, `[:new]`, or `()` when it reads the queue some other way.
    let handed arg = match addends p arg {
        [base, pieces] if tail_of base && not (list.any mentions pieces) => [:pop, pieces],
        [base, pieces] if is_q base && not (list.any mentions pieces) => [:keep, pieces],
        _ => if mentions arg { () } else { [:new] },
    };
    let self_calls = list.filter (fn t -> hoist.self_call gi t) terms;
    let hands = list.map (fn c -> handed (list.nth j (self_args c))) self_calls;
    let read_as_queue = list.all (fn t -> match t {
        Term.lam(_, _, _, caps) => not (list.contains q caps) && not (list.any (fn n -> list.contains n caps) sorts),
        Term.prim(:list_is_empty, _, _, _, _, [x]) if is_q x => true,
        Term.prim(:get, _, _, _, _, [x, i, Term.absent]) if sorted x =>
            match i { Term.prim(:const_int, _, k, _, _, _) => (Program.ints p).[k] == 0, _ => false },
        _ if sort_of t => true,
        _ if hoist.self_call gi t => list.all (fn [i, x] -> i == j || not (mentions x)) (list.enumerate (self_args t)),
        // A tail of the sort, or the queue, handed on with pieces added is
        // read by the call it is handed to.
        Term.prim(:list_tail, _, _, _, _, [x]) if sorted x => true,
        Term.prim(:add, _, _, _, _, [x, _]) if tail_of x || is_q x => true,
        Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), x, _]) if g == Program.append p && (tail_of x || is_q x) => true,
        Term.prim(_, _, _, _, _, cs) => not (list.any (fn x -> is_q x || match x { Term.var(n, _) => list.contains n sorts, _ => false }) cs),
        Term.trying(_, x, _, h) => not (mentions x || mentions h),
        _ => true,
    }) terms && list.all (fn s -> match s {
        Stmt.bind(n, _, x) => sort_of x && list.contains n sorts || not (is_q x || match x { Term.var(m, _) => list.contains m sorts, _ => false }),
        Stmt.expr(Term.var(_, fl)) if ir.has_flag fl ir.f_strict => true,
        Stmt.expr(x) => not (is_q x || match x { Term.var(m, _) => list.contains m sorts, _ => false }),
    }) stmts;
    let pops = list.any (fn h -> match h { [:pop, _] => true, _ => false }) hands;
    if not pops || not read_as_queue || list.any (fn h -> h == ()) hands { () }
    else {
        let h = Term.var q 0;
        let cond c y z = Term.prim :if 0 ir.no_node ir.no_node ir.no_node [c, y, z];
        let empty = builtin p "_heap_empty" [h];
        let zero = Term.prim :const_int 0 ((Program.small_ints p).[0]) ir.no_node ir.no_node [];
        let pushed base pieces = list.fold (fn acc piece -> builtin p "_heap_push" [acc, piece]) base pieces;
        let reads = list.head (hoist.rewrite (fn t -> match t {
            Term.prim(:list_is_empty, _, _, _, _, [x]) if is_q x => empty,
            // On an empty queue, the read as written, which fails as it did.
            Term.prim(:get, fl, a, b, c, [x, _, Term.absent]) if sorted x =>
                cond empty (Term.prim :get fl a b c [nil, zero, Term.absent]) (builtin p "_heap_min" [h]),
            _ => (),
        }) %{} body);
        let worker_body = list.head (hoist.rewrite (fn t ->
            if hoist.self_call gi t {
                let args = self_args t;
                let next = match handed (list.nth j args) {
                    [:pop, pieces] => pushed (cond empty (builtin p "_heap_of" [Term.prim :list_tail 0 ir.no_node ir.no_node ir.no_node [nil]])
                                                         (builtin p "_heap_pop" [h])) pieces,
                    [:keep, pieces] => pushed h pieces,
                    [:new] => builtin p "_heap_of" [list.nth j args],
                };
                call (Site.wgi site) (list.map (fn [i, x] -> if i == j { next } else { x }) (list.enumerate args))
            } else { () }) %{} reads);
        let f = (Program.funcs p).[Site.fi site];
        let k = Site.k site;
        let worker = sc.fun_of f worker_body;
        let params = list.map (fn i -> if i == j { builtin p "_heap_of" [Term.var q 0] } else { Term.var (sc.slot_name i) 0 }) (list.range 0 k);
        let wrapper = sc.fun_of f (Term.block 0 (list.append (hoist.strict_reads body) [Stmt.expr (call (Site.wgi site) params)]));
        [wrapper, worker, ((Program.globals p).[gi]).[:target => Site.wfi site]]
    }
};

// --- an association list kept by a function that updates it ------------------------

/// What `upsert_shape` reads of a function that updates an association list:
/// its list and key parameters' positions, the value a new pair starts with,
/// and the key and value of the pair that replaces one found -- each a term
/// over `k`, `v` and `w`, the names the found pair's key and value and the
/// key asked for have in its body.
group Upsert { li : :integer, wi : :integer, init, key, value, k : :string, v : :string, w : :string }

/// Whether function `fi`, called through global `gi`, is the update of an
/// association list a first draft writes:
///
///     let rec bump w xs = match xs {
///         [] => [[w, 1]],
///         [[k, n], ..rest] => if k == w { [k, n + 1] :: rest } else { [k, n] :: bump w rest },
///     }
///
/// Read off the `match` as it is lowered: the list bound strictly, a test
/// that holds of `[]` and not of a pair's cell, a test that holds of a cell
/// whose head is a pair (each made of type and cell tests along heads and
/// tails, and evaluated on both to say so, rather than matched as written),
/// the pair taken apart, and the comparison. What a new pair starts with and
/// what a found one becomes may read only the key and the found pair, and
/// bind nothing, since they are moved into another function's frame.
let upsert_shape : Program -> :integer -> :integer -> Upsert | :unit;
let upsert_shape p fi gi =
    if fi < 0 || fi >= array.length (Program.funcs p) { () }
    else {
        let f = (Program.funcs p).[fi];
        if f.[:arity else 0] != 2 || f.[:n_captures else 0] > 0 || ir.has_flag (f.[:flags else 0]) ir.fn_impure { () }
        else {
            let ids = Program.ids p;
            let [hd, tl, is_cons] = [ids.["_match_head"], ids.["_match_tail"], ids.["_match_is_cons"]];
            // The steps from the list to a term -- `:h` a head, `:t` a tail --
            // or `()` for a term that is not one.
            let rec path s t = match t {
                Term.var(n, _) => if n == s { [] } else { () },
                Term.prim(:apply, _, _, _, _, [Term.prim(:builtin, _, b, _, _, _), x]) if b == hd || b == tl =>
                    match path s x { () => (), steps => list.append steps [if b == hd { :h } else { :t }] },
                Term.prim(op, _, _, _, _, [x]) if op == :list_head || op == :list_tail =>
                    match path s x { () => (), steps => list.append steps [if op == :list_head { :h } else { :t }] },
                _ => (),
            };
            // What the list's part at those steps is, in a model: `:empty`, the
            // list `[]`, or `:pair`, a cell whose head is `[k, v]`. `:cons`,
            // `:nil`, or `()` for a part whose shape the model does not fix.
            let shape model steps = match [model, steps] {
                [:empty, []] => :nil,
                [:pair, []] => :cons,
                [:pair, [:h]] => :cons,
                [:pair, [:h, :t]] => :cons,
                [:pair, [:h, :t, :t]] => :nil,
                _ => (),
            };
            let rec holds s model t = match t {
                Term.prim(:and, _, _, _, _, [x, y]) => match [holds s model x, holds s model y] {
                    [true, true] => true,
                    [false, _] => false,
                    [_, false] => false,
                    _ => (),
                },
                Term.prim(:not, _, _, _, _, [x]) => match holds s model x { () => (), b => not b },
                Term.prim(:const_bool, _, b, _, _, _) => b == 1,
                Term.prim(:type_is, _, _, 7, 0, [x]) => match path s x {
                    () => (),
                    steps => match shape model steps { () => (), _ => true },
                },
                Term.prim(:list_is_empty, _, _, _, _, [x]) => match path s x {
                    () => (),
                    steps => match shape model steps { () => (), sh => sh == :nil },
                },
                Term.prim(:apply, _, _, _, _, [Term.prim(:builtin, _, b, _, _, _), x]) if b == is_cons => match path s x {
                    () => (),
                    steps => match shape model steps { () => (), sh => sh == :cons },
                },
                Term.prim(:list_is_cons, _, _, _, _, [x]) => match path s x {
                    () => (),
                    steps => match shape model steps { () => (), sh => sh == :cons },
                },
                _ => (),
            };
            let [l, w] = [sc.slot_name 0, sc.slot_name 1];
            // The list is either parameter; the key is the other.
            let entry = match unwrap (sc.body_of (Program.reading p) f) {
                Term.block(_, [Stmt.bind(s, _, Term.var(n, _)), Stmt.expr(e)]) => [s, n, unwrap e],
                _ => (),
            };
            match entry {
                () => (),
                [s, ln, e] => {
                    let li = if ln == l { 0 } else if ln == w { 1 } else { -1 };
                    let wn = if li == 0 { w } else { l };
                    let bindless t = {
                        let [terms, stmts] = hoist.parts t;
                        list.is_empty stmts && list.all (fn x -> match x {
                            Term.lam(_, _, _, _) => false,
                            Term.trying(_, _, _, _) => false,
                            Term.block(_, _) => false,
                            _ => true,
                        }) terms
                    };
                    let only allowed t = bindless t && list.all (fn x -> match x {
                        Term.var(n, _) => list.contains n allowed,
                        _ => true,
                    }) (list.head (hoist.parts t)) && not (names gi t);
                    match e {
                        Term.prim(:if, _, _, _, _, [empty_test, empty_branch, rest]) if li >= 0
                            && holds s :empty empty_test == true && holds s :pair empty_test == false => {
                            let init = match unwrap empty_branch {
                                Term.prim(:make_list, _, _, _, _, [Term.prim(:make_list, _, _, _, _, [Term.var(n, _), x])]) if n == wn && only [wn] x => x,
                                _ => (),
                            };
                            match unwrap rest {
                                Term.prim(:if, _, _, _, _, [pair_test, Term.block(_, stmts), _]) if init != () && holds s :pair pair_test == true => {
                                    let binds = list.take_while (fn st -> match st { Stmt.bind(_, _, _) => true, _ => false }) stmts;
                                    let named = list.fold (fn m st -> match st {
                                        Stmt.bind(n, _, x) => match path s x {
                                            [:h, :h] => m.[:k => n],
                                            [:h, :t, :h] => m.[:v => n],
                                            [:t] => m.[:r => n],
                                            _ => m.[:other => n],
                                        },
                                        _ => m,
                                    }) %{} binds;
                                    let [k, v, r] = [named.[:k else ()], named.[:v else ()], named.[:r else ()]];
                                    let compared x y = (is_var k x && is_var wn y) || (is_var wn x && is_var k y);
                                    match list.drop (list.length binds) stmts {
                                        [Stmt.expr(Term.prim(:if, _, _, _, _, [Term.prim(:eq, _, _, _, _, [a, b]), found, missed]))]
                                            if k != () && v != () && r != () && not (map.has :other named) && compared a b => {
                                            let replaced = match unwrap found {
                                                Term.prim(:cons, _, _, _, _, [Term.prim(:make_list, _, _, _, _, [kt, vt]), Term.var(rn, _)])
                                                    if rn == r && (is_var k kt || is_var wn kt) && only [k, v, wn] vt => [kt, vt],
                                                _ => (),
                                            };
                                            let passed = match unwrap missed {
                                                Term.prim(:cons, _, _, _, _, [Term.prim(:make_list, _, _, _, _, [kx, vx]),
                                                                              Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), a0, a1])]) =>
                                                    g == gi && is_var k kx && is_var v vx
                                                        && is_var r (if li == 0 { a0 } else { a1 }) && is_var wn (if li == 0 { a1 } else { a0 }),
                                                _ => false,
                                            };
                                            match replaced {
                                                [kt, vt] if passed => Upsert.make li (1 - li) init kt vt k v wn,
                                                _ => (),
                                            }
                                        },
                                        _ => (),
                                    }
                                },
                                _ => (),
                            }
                        },
                        _ => (),
                    }
                },
            }
        }
    };

/// A loop that hands parameter `j` on as it was or through an update of an
/// association list (`upsert_shape`), reading it nowhere but where it ends:
/// the list is a trunk instead, and each update finds its key through the
/// trunk's index rather than by a scan of the list.
///
/// Exact, where it applies. It applies when the loop starts from `[]` --
/// anything else runs as written, so every element is a pair the loop made
/// -- and either forces the list at every step (`!acc`) or answers the list
/// itself wherever it ends. The update as written forces each key it is
/// given when its own answer is forced, comparing the key with the first
/// pair's: at the next step, when the list is strict, and all of them in
/// order when the answer is wanted, when it is lazy -- `std`'s `fold` -- since
/// each update takes apart the one before. So looking each key up at once
/// forces nothing the loop would not, but for the very first, which is filed
/// unevaluated, as `[[w, 1]]` files it (the lookup of an empty trunk forces
/// nothing). A loop as lazy as that runs only once its answer is wanted. What
/// moves is when two failures are met against each other: a key that raises
/// is met before a list being walked that raises later, where as written
/// the walk raised first. A found pair is replaced by the pair as written, its key and
/// value read out of the pair found; a new one is pushed at the end, where
/// the list as written adds it. Where the loop ends, the list is the trunk's
/// elements.
let upserted : Site -> [Fun, Fun, :map] | :unit;
let upserted site =
    if map.size (Program.upserts (Site.program site)) == 0 { () }
    else { first_of (list.map (fn j -> fn () -> upserted_at site j) (list.range 0 (Site.k site))) };

let upserted_at : Site -> :integer -> [Fun, Fun, :map] | :unit;
let upserted_at site j = {
    let p = Site.program site;
    let gi = Site.gi site;
    let acc = sc.slot_name j;
    let body = Site.body site;
    let ups = Program.upserts p;
    let strict = list.any (fn st -> match st {
        Stmt.expr(Term.var(n, fl)) => n == acc && ir.has_flag fl ir.f_strict,
        Stmt.expr(Term.prim(:force, _, _, _, _, [Term.var(n, _)])) => n == acc,
        _ => false,
    }) (hoist.strict_reads body);
    let update arg = match arg {
        Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), a0, a1]) => match ups.[g else ()] {
            () => (),
            u => {
                let args = [a0, a1];
                let key = list.nth (Upsert.wi u) args;
                if is_var acc (list.nth (Upsert.li u) args) && not (reads acc key) && not (names gi key) { [u, key] } else { () }
            },
        },
        _ => (),
    };
    let ls = leaves body;
    let self_calls = list.filter (fn l -> hoist.self_call gi l) ls;
    // Or the loop answers the list itself wherever it ends, so whatever
    // forces its answer forces every update made, and with them every key.
    let answered = list.all (fn l -> hoist.self_call gi l || is_var acc l) ls;
    let fits = (strict || answered) && not (list.is_empty self_calls) && list.all (fn l -> {
        let args = self_args l;
        let arg = list.nth j args;
        (is_var acc arg || update arg != ())
            && list.all (fn [i, x] -> i == j || not (reads acc x)) (list.enumerate args)
            && list.all (fn [i, x] -> i == j || not (names gi x)) (list.enumerate args)
    }) self_calls
        && list.all (fn x -> not (reads acc x) && not (names gi x)) (around body)
        && list.all (fn l -> hoist.self_call gi l || not (names gi l)) ls;
    let updates = list.filter (fn u -> u != ()) (list.map (fn l -> update (list.nth j (self_args l))) self_calls);
    if not fits || list.is_empty updates { () }
    else {
        let t = "acc_trunk";
        let zero = Term.prim :const_int 0 ((Program.small_ints p).[0]) ir.no_node ir.no_node [];
        let one = Term.prim :const_int 0 ((Program.small_ints p).[1]) ir.no_node ir.no_node [];
        let pair_part i = Term.prim :get 0 ir.no_node ir.no_node ir.no_node [Term.var "up_pair" 0, i, Term.absent];
        let pair2 x y = Term.prim :make_list 0 ir.no_node 2 ir.no_node [x, y];
        // A term of the update's, read in the loop: its names as the found
        // pair's parts and the key looked up.
        let moved u x = list.head (hoist.rewrite (fn y -> match y {
            Term.var(n, _) => if n == Upsert.k u { pair_part zero } else if n == Upsert.v u { pair_part one }
                              else if n == Upsert.w u { Term.var "up_w" 0 } else { () },
            _ => (),
        }) %{} x);
        let updated [u, key] = Term.block 0 [
            Stmt.bind "up_w" 0 key,
            Stmt.bind "up_i" ir.f_strict (builtin p "_trunk_lookup" [Term.var "up_w" 0, Term.var t 0]),
            Stmt.expr (Term.prim :if 0 ir.no_node ir.no_node ir.no_node [
                Term.prim :lt 0 ir.no_node ir.no_node ir.no_node [Term.var "up_i" 0, zero],
                builtin p "_trunk_push" [pair2 (Term.var "up_w" 0) (moved u (Upsert.init u)), Term.var t 0],
                Term.block 0 [Stmt.bind "up_pair" 0 (builtin p "_trunk_at" [Term.var "up_i" 0, Term.var t 0]),
                              Stmt.expr (builtin p "_trunk_set" [Term.var "up_i" 0,
                                                                pair2 (moved u (Upsert.key u)) (moved u (Upsert.value u)),
                                                                Term.var t 0])],
            ]),
        ];
        let leaf l = if hoist.self_call gi l {
            let args = self_args l;
            let kept = match update (list.nth j args) { () => Term.var t 0, u => updated u };
            call (Site.wgi site) (list.append args [kept])
        } else if reads acc l {
            Term.block 0 [Stmt.bind "acc_whole" 0 (builtin p "_trunk_to_list" [Term.var t 0]),
                          Stmt.expr (list.head (hoist.rewrite (fn x -> if is_var acc x { Term.var "acc_whole" 0 } else { () }) %{} l))]
        } else { l };
        let [wrapper, worker, global] = built site t true (map_leaves leaf body) (builtin p "_trunk_of" [nil]);
        // The worker only from `[]`: a list the loop did not start empty may
        // hold what is not a pair, which the update as written raises on and
        // a lookup passes over.
        let f = (Program.funcs p).[Site.fi site];
        let params = list.map (fn i -> Term.var (sc.slot_name i) 0) (list.range 0 (Site.k site));
        let guarded = sc.fun_of f (Term.block 0 (list.append (hoist.strict_reads body) [
            Stmt.expr (Term.prim :if 0 ir.no_node ir.no_node ir.no_node [
                Term.prim :list_is_cons 0 ir.no_node ir.no_node ir.no_node [Term.var acc 0],
                body,
                call (Site.wgi site) (list.append params [builtin p "_trunk_of" [nil]]),
            ])]));
        [guarded, worker, global]
    }
};

// --- a design: an association list, whatever functions it passes through -----------
//
// A first design keeps its table as a list of `[key, value]` pairs: one
// function adds to it, another searches it, a third replaces a pair, and a
// loop threads it through all of them -- every step a scan, the program
// quadratic, and no one loop of it the shape of anything. What is rewritten
// here is the *list*, wherever it goes: a loop that hands one on through such
// functions keeps it as a trunk instead, the functions that take it apart are
// read as the operations they are (`assoc_op`) and run on the trunk, and the
// small functions between them (`composite_of`) are taken in where they are
// called, so that what they do to the list is done to the trunk. See "A
// design, rewritten" in docs/notes/supercompilation.md.
//
// Exactly, an operation at a time rather than for the program as a whole,
// which is what lets it apply to code that cannot be seen whole:
//
// - Every operation stands where it was written, with its arguments as lazy
//   as they were, so it runs when the call it replaces would have. The list
//   is "a trunk, or the list as written", and each operation looks at which
//   it was handed: a list it does not know runs the code as written.
// - A trunk is made only from `[]`, and grows only by the pairs the code
//   writes, so every element is a pair and a lookup that passes over what is
//   not one never meets one.
// - A lookup forces what the scan forces, in its order: the trunk's search
//   is that (`search` in dream/src/trunk.cpp).
// - A replace finds its pair only through the lookup made just before it of
//   the same key in the same version (`_trunk_recall`), which forced all its
//   scan would; without one it takes the list as written, and the loop goes
//   on with the list.
// - Wherever else the list is read it is the list: the trunk's elements.

/// What a function that takes an association list apart is: `:lookup`,
/// answering `found` -- over the pair's key `k` and value `v`, the key asked
/// for and the other parameters -- for the first pair with that key and
/// `empty` when there is none; or `:replace`, the list with that pair
/// replaced by `[key, value]`, unchanged when there is none, or with `[w,
/// missing]` added when `missing` is not `()`. `li` and `wi` are the list's
/// and the key's positions among `params`.
group AssocOp { kind : :atom, li : :integer, wi : :integer, params, empty, found, key, value, missing, k, v }

/// The steps from the subject `s` of a list pattern to a part of it, `:h` a
/// head and `:t` a tail, or `()`.
let pair_path : :string -> Term -> [:atom] | :unit;
let rec pair_path s t = match t {
    Term.var(n, _) => if n == s { [] } else { () },
    Term.prim(op, _, _, _, _, [x]) if op == :list_head || op == :list_tail =>
        match pair_path s x { () => (), steps => list.append steps [if op == :list_head { :h } else { :t }] },
    _ => (),
};

/// A part's shape in a model of the subject: `:empty` is `[]`, `:pair` a cell
/// whose head is `[k, v]`; `:cons`, `:nil`, or `()` for what it does not fix.
let pair_shape : :atom -> [:atom] -> :atom | :unit;
let pair_shape model steps = match [model, steps] {
    [:empty, []] => :nil,
    [:pair, []] => :cons,
    [:pair, [:h]] => :cons,
    [:pair, [:h, :t]] => :cons,
    [:pair, [:h, :t, :t]] => :nil,
    _ => (),
};

/// Whether a pattern's test holds in a model, when the model says.
let pair_holds : :string -> :atom -> Term -> :bool | :unit;
let rec pair_holds s model t = match t {
    Term.prim(:and, _, _, _, _, [x, y]) => match [pair_holds s model x, pair_holds s model y] {
        [true, true] => true,
        [false, _] => false,
        [_, false] => false,
        _ => (),
    },
    Term.prim(:not, _, _, _, _, [x]) => match pair_holds s model x { () => (), b => not b },
    Term.prim(:const_bool, _, b, _, _, _) => b == 1,
    Term.prim(:type_is, _, _, 7, 0, [x]) => match pair_path s x {
        () => (),
        steps => match pair_shape model steps { () => (), _ => true },
    },
    Term.prim(op, _, _, _, _, [x]) if op == :list_is_cons || op == :list_is_empty => match pair_path s x {
        () => (),
        steps => match pair_shape model steps { () => (), sh => (sh == :cons) == (op == :list_is_cons) },
    },
    _ => (),
};

/// Whether `t` reads no name but `allowed`, binds nothing, makes no closure
/// and names no global `gi` -- a term that can be moved into another frame.
let movable : [:string] -> :integer -> Term -> :bool;
let movable allowed gi t = {
    let [terms, stmts] = hoist.parts t;
    list.is_empty stmts && not (names gi t) && list.all (fn x -> match x {
        Term.var(n, _) => list.contains n allowed,
        Term.lam(_, _, _, _) => false,
        Term.trying(_, _, _, _) => false,
        Term.block(_, _) => false,
        _ => true,
    }) terms
};

/// Function `fi`, called through `gi`, read as an operation on an association
/// list, or `()`. The `match` as it is lowered, as `upsert_shape` reads it,
/// with any number of parameters that are handed on as they were.
let assoc_op : Program -> :integer -> :integer -> AssocOp | :unit;
let assoc_op p fi gi =
    if fi < 0 || fi >= array.length (Program.funcs p) { () }
    else {
        let f = (Program.funcs p).[fi];
        let arity = f.[:arity else 0];
        if arity < 2 || f.[:n_captures else 0] > 0 || ir.has_flag (f.[:flags else 0]) ir.fn_impure { () }
        else {
            let params = list.map sc.slot_name (list.range 0 arity);
            match unwrap (sc.body_of (Program.reading p) f) {
                Term.block(_, [Stmt.bind(s, _, Term.var(ln, _)), Stmt.expr(e)]) if list.contains ln params =>
                    assoc_read p gi params (list.find_index (fn n -> n == ln) params) s (unwrap e),
                _ => (),
            }
        }
    };

let assoc_read : Program -> :integer -> [:string] -> :integer -> :string -> Term -> AssocOp | :unit;
let assoc_read p gi params li s e = match e {
    Term.prim(:if, _, _, _, _, [empty_test, empty_branch, rest])
        if pair_holds s :empty empty_test == true && pair_holds s :pair empty_test == false => match unwrap rest {
        Term.prim(:if, _, _, _, _, [pair_test, Term.block(_, stmts), _]) if pair_holds s :pair pair_test == true => {
            let binds = list.take_while (fn st -> match st { Stmt.bind(_, _, _) => true, _ => false }) stmts;
            let named = list.fold (fn m st -> match st {
                Stmt.bind(n, _, x) => match pair_path s x {
                    [:h, :h] => m.[:k => n],
                    [:h, :t, :h] => m.[:v => n],
                    [:t] => m.[:r => n],
                    _ => m.[:other => n],
                },
                _ => m,
            }) %{} binds;
            let [k, v, r] = [named.[:k else ()], named.[:v else ()], named.[:r else ()]];
            let ln = list.nth li params;
            let others = list.filter (fn n -> n != ln) params;
            match list.drop (list.length binds) stmts {
                // A pattern that names no value, `[[n, _], ..rest]`, binds none.
                [Stmt.expr(Term.prim(:if, _, _, _, _, [Term.prim(:eq, _, _, _, _, [a, b]), found, missed]))]
                    if k != () && r != () && not (map.has :other named) => {
                    let w = match [a, b] {
                        [Term.var(x, _), Term.var(y, _)] if x == k && list.contains y others => y,
                        [Term.var(x, _), Term.var(y, _)] if y == k && list.contains x others => x,
                        _ => (),
                    };
                    let wi = list.find_index (fn n -> n == w) params;
                    // A call of itself on the rest, every other parameter as it was.
                    let again t = match unwrap t {
                        Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) =>
                            g == gi && list.length args == list.length params
                                && list.all (fn [i, x] -> if i == li { is_var r x } else { is_var (list.nth i params) x }) (list.enumerate args),
                        _ => false,
                    };
                    let kept t = match unwrap t {
                        Term.prim(:cons, _, _, _, _, [Term.prim(:make_list, _, _, _, _, [kx, vx]), rest_call]) =>
                            is_var k kx && is_var v vx && again rest_call,
                        _ => false,
                    };
                    if w == () { () }
                    else if again missed && movable (list.concat [[k, if v == () { k } else { v }], others]) gi (unwrap found) && movable others gi (unwrap empty_branch) {
                        AssocOp.make :lookup li wi params (unwrap empty_branch) (unwrap found) () () () k v
                    }
                    else if kept missed {
                        let replaced = match unwrap found {
                            Term.prim(:cons, _, _, _, _, [Term.prim(:make_list, _, _, _, _, [kt, vt]), Term.var(rn, _)])
                                if rn == r && (is_var k kt || is_var w kt) && movable (list.concat [[k, v], others]) gi vt => [kt, vt],
                            _ => (),
                        };
                        let missing = match unwrap empty_branch {
                            Term.prim(:make_list, _, _, _, _, []) => [()],
                            Term.prim(:make_list, _, _, _, _, [Term.prim(:make_list, _, _, _, _, [Term.var(n, _), x])])
                                if n == w && movable others gi x => [x],
                            _ => (),
                        };
                        match [replaced, missing] {
                            [[kt, vt], [m]] => AssocOp.make :replace li wi params () () kt vt m k v,
                            _ => (),
                        }
                    }
                    else { () }
                },
                _ => (),
            }
        },
        _ => (),
    },
    _ => (),
};

/// The largest body a composite may have: it is copied into each place it is
/// called from.
let composite_size : :integer;
let composite_size = 400;

/// Function `fi`, called through `gi`, as a composite: a small function, not
/// recursive, that hands one of its parameters to an operation or to another
/// composite. `[fi, its list parameter's position]`, or `()`.
let composite_of : Program -> :integer -> :integer -> [:integer, :integer] | :unit;
let composite_of p fi gi =
    if fi < 0 || fi >= array.length (Program.funcs p) || map.has gi (Program.assocs p) { () }
    else {
        let f = (Program.funcs p).[fi];
        let fl = f.[:flags else 0];
        let arity = f.[:arity else 0];
        if arity == 0 || ir.has_flag fl ir.fn_rec || ir.has_flag fl ir.fn_impure || ir.has_flag fl ir.fn_thunk
           || f.[:n_captures else 0] > 0 { () }
        else {
            let body = sc.body_of (Program.reading p) f;
            if drive.size body > composite_size { () }
            else {
                let handed = list.concat (list.map (fn t -> match t {
                    Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) => match assoc_list_at p g {
                        i if i >= 0 && i < list.length args => match list.nth i args { Term.var(n, _) => [n], _ => [] },
                        _ => [],
                    },
                    _ => [],
                }) (list.head (hoist.parts body)));
                match list.find_index (fn j -> list.contains (sc.slot_name j) handed) (list.range 0 arity) {
                    j if j >= 0 => [fi, j],
                    _ => (),
                }
            }
        }
    };

/// Where global `g` takes its association list: an operation's list
/// parameter, a composite's, or -1.
let assoc_list_at : Program -> :integer -> :integer;
let assoc_list_at p g = match (Program.assocs p).[g else ()] {
    () => match (Program.composites p).[g else ()] { [_, j] => j, _ => -1 },
    op => AssocOp.li op,
};

/// A translation's context: the program, the loop's own global, the names
/// that hold the list as a trunk or as written, the prefix this term's new
/// names start with, and how deep composites have been taken in.
group Tx { program, gi : :integer, vars : :map, at : :string, depth : :integer }

let tx_at : Tx -> :string -> Tx;
let tx_at x suffix = Tx.make (Tx.program x) (Tx.gi x) (Tx.vars x) (Tx.at x + suffix) (Tx.depth x);

let tx_with : Tx -> :string -> Tx;
let tx_with x n = Tx.make (Tx.program x) (Tx.gi x) ((Tx.vars x).[n => true]) (Tx.at x) (Tx.depth x);

let trunk_code : :integer;
let trunk_code = 19;

let is_trunk_term : Term -> Term;
let is_trunk_term x = Term.prim :type_is 0 ir.no_node trunk_code 0 [x];

let if_term : Term -> Term -> Term -> Term;
let if_term c y n = Term.prim :if 0 ir.no_node ir.no_node ir.no_node [c, y, n];

/// A name that holds the list read where a list is wanted: the trunk's
/// elements, or the list as it is.
let as_list : Program -> Term -> Term;
let as_list p x = if_term (is_trunk_term x) (builtin p "_trunk_to_list" [x]) x;

/// Whether `t` makes the list an operation or a composite answers, or hands
/// on one the context holds -- the value of a binding that should hold it
/// too.
let produces : Tx -> Term -> :bool;
let rec produces x t = match t {
    Term.var(n, _) => map.has n (Tx.vars x),
    Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) => match (Program.assocs (Tx.program x)).[g else ()] {
        () => match (Program.composites (Tx.program x)).[g else ()] {
            [_, j] => j < list.length args && produces x (list.nth j args),
            _ => appended x t != (),
        },
        op => AssocOp.kind op == :replace && produces x (list.nth (AssocOp.li op) args),
    },
    Term.prim(:add, _, _, _, _, _) => appended x t != (),
    Term.prim(:if, _, _, _, _, [_, y, z]) => produces x y || produces x z,
    Term.block(_, ss) => match list.reverse ss { [Stmt.expr(l), .._] => produces x l, _ => false },
    _ => false,
};

/// `l + [pair]` or `list.append l [pair]`, with `l` a list the context
/// holds: `[l, pair]`, or `()`.
let appended : Tx -> Term -> [Term, Term] | :unit;
let appended x t = match t {
    Term.prim(:add, _, _, _, _, [l, Term.prim(:make_list, _, _, _, _, [pair])]) if pair_literal pair && produces x l => [l, pair],
    Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), l, Term.prim(:make_list, _, _, _, _, [pair])])
        if g == Program.append (Tx.program x) && g >= 0 && pair_literal pair && produces x l => [l, pair],
    _ => (),
};

let pair_literal : Term -> :bool;
let pair_literal t = match t { Term.prim(:make_list, _, _, _, _, [_, _]) => true, _ => false };

/// `t` translated where the list is wanted as it is: a name holding it read
/// as a list (`as_list`), an operation on it run on the trunk when it is one.
let tr : Tx -> Term -> Term;
let rec tr x t = match t {
    Term.var(n, _) => if map.has n (Tx.vars x) { as_list (Tx.program x) t } else { t },
    Term.prim(:apply, fl, a, b, c, [Term.prim(:global, gfl, g, ga, gb, gc), ..args]) => {
        let p = Tx.program x;
        match (Program.assocs p).[g else ()] {
            op if op != () && AssocOp.kind op == :lookup => lookup_term (tx_at x "l") g op args,
            op if op != () => as_list p (replace_term (tx_at x "r") g op args),
            _ => match (Program.composites p).[g else ()] {
                [fi, j] if Tx.depth x < 3 => as_list p (inlined (tx_at x "c") fi j args false),
                _ => match appended x t {
                    [l, pair] => as_list p (push_term (tx_at x "a") l pair),
                    _ if g == Tx.gi x => Term.prim :apply fl a b c (list.cons (Term.prim :global gfl g ga gb gc)
                        (list.map (fn [i, arg] -> tp (tx_at x ("_" + to_string i)) arg) (list.enumerate args))),
                    _ => Term.prim :apply fl a b c (list.cons (Term.prim :global gfl g ga gb gc)
                        (list.map (fn [i, arg] -> tr (tx_at x ("_" + to_string i)) arg) (list.enumerate args))),
                },
            },
        }
    },
    Term.prim(:add, fl, a, b, c, cs) => match appended x t {
        [l, pair] => as_list (Tx.program x) (push_term (tx_at x "a") l pair),
        _ => Term.prim :add fl a b c (list.map (fn [i, k] -> tr (tx_at x ("_" + to_string i)) k) (list.enumerate cs)),
    },
    Term.prim(op, fl, a, b, c, cs) => Term.prim op fl a b c (list.map (fn [i, k] -> tr (tx_at x ("_" + to_string i)) k) (list.enumerate cs)),
    Term.block(fl, ss) => tr_block x fl ss false,
    Term.lam(op, fl, fi, caps) => {
        // A closure capturing the list captures it as a list.
        let held = list.filter (fn n -> map.has n (Tx.vars x)) caps;
        if list.is_empty held { t }
        else {
            let renamed = list.map (fn n -> if map.has n (Tx.vars x) { Tx.at x + "_cap_" + n } else { n }) caps;
            Term.block 0 (list.append (list.map (fn n -> Stmt.bind (Tx.at x + "_cap_" + n) 0 (as_list (Tx.program x) (Term.var n 0))) held)
                                      [Stmt.expr (Term.lam op fl fi renamed)])
        }
    },
    Term.trying(fl, body, e, h) => Term.trying fl (tr (tx_at x "t") body) e (tr (tx_at x "h") h),
    _ => t,
};

/// `t` translated where the list may stay a trunk: what a binding that holds
/// it is, or a loop's next list.
let tp : Tx -> Term -> Term;
let rec tp x t = match t {
    Term.var(n, _) if map.has n (Tx.vars x) => t,
    Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) => {
        let p = Tx.program x;
        match (Program.assocs p).[g else ()] {
            op if op != () && AssocOp.kind op == :replace => replace_term (tx_at x "r") g op args,
            _ => match (Program.composites p).[g else ()] {
                [fi, j] if Tx.depth x < 3 => inlined (tx_at x "c") fi j args true,
                _ => match appended x t {
                    [l, pair] => push_term (tx_at x "a") l pair,
                    _ => tr x t,
                },
            },
        }
    },
    Term.prim(:add, _, _, _, _, _) => match appended x t {
        [l, pair] => push_term (tx_at x "a") l pair,
        _ => tr x t,
    },
    Term.prim(:if, fl, a, b, c, [cond, y, z]) =>
        Term.prim :if fl a b c [tr (tx_at x "_c") cond, tp (tx_at x "_y") y, tp (tx_at x "_z") z],
    Term.block(fl, ss) => tr_block x fl ss true,
    _ => tr x t,
};

/// A block, each binding of a list the context holds held so too, the last
/// statement `tp`'s when `keep`.
let tr_block : Tx -> :integer -> [Stmt] -> :bool -> Term;
let tr_block x fl ss keep = {
    let n = list.length ss;
    let [out, _] = list.fold (fn [acc, cx] [i, st] -> {
        let here = tx_at cx ("b" + to_string i);
        match st {
            Stmt.bind(name, bf, v) => if produces cx v {
                [list.cons (Stmt.bind name bf (tp here v)) acc, tx_with cx name]
            } else {
                [list.cons (Stmt.bind name bf (tr here v)) acc, cx]
            },
            // A strict read of the list forces it, which a trunk is already.
            Stmt.expr(Term.var(m, _)) if map.has m (Tx.vars cx) && i + 1 < n => [list.cons st acc, cx],
            Stmt.expr(e) => [list.cons (Stmt.expr (if keep && i + 1 == n { tp here e } else { tr here e })) acc, cx],
        }
    }) [[], x] (list.enumerate ss);
    Term.block fl (list.reverse out)
};

/// The arguments of an operation's call bound to names of its own, lazily, as
/// the call would have bound them: `[stmts, the list's name, the key's name,
/// what each parameter is now named]`.
let bound_args : Tx -> AssocOp -> [Term] -> [[Stmt], :string, :string, :map];
let bound_args x op args = {
    let params = AssocOp.params op;
    let names = list.fold (fn m [i, n] -> m.[n => Tx.at x + "_p" + to_string i]) %{} (list.enumerate params);
    let stmts = list.map (fn [i, arg] -> {
        let here = tx_at x ("_a" + to_string i);
        Stmt.bind (Tx.at x + "_p" + to_string i) 0 (if i == AssocOp.li op { tp here arg } else { tr here arg })
    }) (list.enumerate args);
    [stmts, Tx.at x + "_p" + to_string (AssocOp.li op), Tx.at x + "_p" + to_string (AssocOp.wi op), names]
};

/// A term of the operation's own, read in the loop: its parameters by the
/// names they are bound to, the found pair's key and value read out of
/// `pair`.
let moved_in : :map -> AssocOp -> :string -> Term -> Term;
let moved_in names op pair t = {
    list.head (hoist.rewrite (fn y -> match y {
        Term.var(n, _) => if n == AssocOp.k op && AssocOp.k op != () { pair_get pair 0 }
                          else if n == AssocOp.v op && AssocOp.v op != () { pair_get pair 1 }
                          else { match names.[n else ()] { () => (), to => Term.var to 0 } },
        _ => (),
    }) %{} t)
};

/// `pair.[i]`, for `i` 0 or 1, as a list pattern reads the parts of a pair:
/// its head, and the head of its tail.
let pair_get : :string -> :integer -> Term;
let pair_get pair i = {
    let cell = Term.var pair 0;
    if i == 0 { Term.prim :list_head 0 ir.no_node ir.no_node ir.no_node [cell] }
    else { Term.prim :list_head 0 ir.no_node ir.no_node ir.no_node [Term.prim :list_tail 0 ir.no_node ir.no_node ir.no_node [cell]] }
};

/// The call `g args`, by the names its arguments are bound to.
let call_as : :integer -> AssocOp -> :string -> [Term] -> Term;
let call_as g op at args = call g (list.map (fn i -> Term.var (at + "_p" + to_string i) 0) (list.range 0 (list.length args)));

/// Whether a list the context holds is one the trunk can stand for: a trunk,
/// or `[]`, which a trunk is made of.
let trunkable : Term -> Term;
let trunkable l = Term.prim :or 0 ir.no_node ir.no_node ir.no_node [is_trunk_term l, Term.prim :list_is_empty 0 ir.no_node ir.no_node ir.no_node [l]];

/// The trunk a list the context holds stands for, once it is `trunkable`.
let the_trunk : Program -> Term -> Term;
let the_trunk p l = if_term (is_trunk_term l) l (builtin p "_trunk_of" [nil]);

let lookup_term : Tx -> :integer -> AssocOp -> [Term] -> Term;
let lookup_term x g op args = {
    let p = Tx.program x;
    let [stmts, l, w, names] = bound_args x op args;
    let t = Tx.at x + "_t";
    let i = Tx.at x + "_i";
    let pair = Tx.at x + "_pair";
    let zero = Term.prim :const_int 0 ((Program.small_ints p).[0]) ir.no_node ir.no_node [];
    let on_trunk = Term.block 0 [
        Stmt.bind t 0 (the_trunk p (Term.var l 0)),
        Stmt.bind i ir.f_strict (builtin p "_trunk_lookup" [Term.var w 0, Term.var t 0]),
        Stmt.expr (if_term (Term.prim :lt 0 ir.no_node ir.no_node ir.no_node [Term.var i 0, zero])
            (moved_in names op pair (AssocOp.empty op))
            (Term.block 0 [Stmt.bind pair 0 (builtin p "_trunk_at" [Term.var i 0, Term.var t 0]),
                           Stmt.expr (moved_in names op pair (AssocOp.found op))])),
    ];
    Term.block 0 (list.append stmts [Stmt.expr (if_term (trunkable (Term.var l 0)) on_trunk (call_as g op (Tx.at x) args))])
};

let replace_term : Tx -> :integer -> AssocOp -> [Term] -> Term;
let replace_term x g op args = {
    let p = Tx.program x;
    let [stmts, l, w, names] = bound_args x op args;
    let t = Tx.at x + "_t";
    let i = Tx.at x + "_i";
    let pair = Tx.at x + "_pair";
    let zero = Term.prim :const_int 0 ((Program.small_ints p).[0]) ir.no_node ir.no_node [];
    let pair2 a b = Term.prim :make_list 0 ir.no_node 2 ir.no_node [a, b];
    // The pair a trunk is handed is a cell already made, its key evaluated
    // where that is already true: what is filed in its index must be
    // evaluated, and a suspension written in the middle of it would drop the
    // index and make the next lookup a scan. Making a list of two forces
    // nothing; a replace's key is the found pair's or the key looked up, both
    // forced by the lookup that found it. A pair added is the one exception:
    // the trunk may have been empty, when nothing forced the key, so it goes
    // in as written and is filed once a lookup has forced it.
    let new_pair = Tx.at x + "_new";
    let new_key = Tx.at x + "_key";
    let absent = match AssocOp.missing op {
        () => Term.var t 0,
        m => Term.block 0 [Stmt.bind new_pair ir.f_strict (pair2 (Term.var w 0) (moved_in names op pair m)),
                           Stmt.expr (builtin p "_trunk_push" [Term.var new_pair 0, Term.var t 0])],
    };
    // Without the lookup before it to say where the pair is, the list as
    // written: the trunk's elements, and the call.
    let as_written = Term.block 0 [Stmt.bind l 0 (builtin p "_trunk_to_list" [Term.var t 0]), Stmt.expr (call_as g op (Tx.at x) args)];
    let on_trunk = Term.block 0 [
        Stmt.bind t 0 (the_trunk p (Term.var l 0)),
        Stmt.bind i ir.f_strict (builtin p "_trunk_recall" [Term.var w 0, Term.var t 0]),
        Stmt.expr (if_term (Term.prim :type_is 0 ir.no_node 0 0 [Term.var i 0])
            (if_term (Term.prim :lt 0 ir.no_node ir.no_node ir.no_node [Term.var i 0, zero])
                absent
                (Term.block 0 [Stmt.bind pair ir.f_strict (builtin p "_trunk_at" [Term.var i 0, Term.var t 0]),
                               Stmt.bind new_key ir.f_strict (moved_in names op pair (AssocOp.key op)),
                               Stmt.bind new_pair ir.f_strict (pair2 (Term.var new_key 0) (moved_in names op pair (AssocOp.value op))),
                               Stmt.expr (builtin p "_trunk_set" [Term.var i 0, Term.var new_pair 0, Term.var t 0])]))
            as_written),
    ];
    Term.block 0 (list.append stmts [Stmt.expr (if_term (trunkable (Term.var l 0)) on_trunk (call_as g op (Tx.at x) args))])
};

let push_term : Tx -> Term -> Term -> Term;
let push_term x l pair = {
    let p = Tx.program x;
    let lname = Tx.at x + "_l";
    let pname = Tx.at x + "_pair";
    Term.block 0 [
        Stmt.bind lname 0 (tp (tx_at x "_l") l),
        // A cell already made, as `replace_term` hands the trunk one.
        Stmt.bind pname ir.f_strict (tr (tx_at x "_v") pair),
        Stmt.expr (if_term (trunkable (Term.var lname 0))
            (builtin p "_trunk_push" [Term.var pname 0, the_trunk p (Term.var lname 0)])
            (call (Program.append p) [Term.var lname 0, Term.prim :make_list 0 ir.no_node 1 ir.no_node [Term.var pname 0]])),
    ]
};

/// Composite `fi`'s body where it is called, its arguments bound lazily to
/// names of their own and its own names prefixed so they meet none of the
/// loop's: a call of a pure function, by need.
let inlined : Tx -> :integer -> :integer -> [Term] -> :bool -> Term;
let inlined x fi j args keep = {
    let p = Tx.program x;
    let f = (Program.funcs p).[fi];
    let body = sc.renamed (sc.body_of (Program.reading p) f);
    let pre = Tx.at x + "_";
    let [terms, stmts] = hoist.parts body;
    let own = list.concat [list.map sc.slot_name (list.range 0 (list.length args)),
                           list.concat (list.map (fn st -> match st { Stmt.bind(n, _, _) => [n], _ => [] }) stmts)];
    let renaming = list.fold (fn m n -> m.[n => pre + n]) %{} own;
    let named = list.head (hoist.rewrite (fn y -> match y {
        Term.var(n, fl) => match renaming.[n else ()] { () => (), to => Term.var to fl },
        Term.block(fl, ss) => (),
        _ => (),
    }) %{} body);
    let renamed = rename_binds renaming named;
    let binds = list.map (fn [i, arg] -> {
        let here = tx_at x ("_a" + to_string i);
        Stmt.bind (pre + sc.slot_name i) 0 (if i == j { tp here arg } else { tr here arg })
    }) (list.enumerate args);
    let inner = Tx.make p (Tx.gi x) ((Tx.vars x).[pre + sc.slot_name j => true]) (Tx.at x + "i") (Tx.depth x + 1);
    Term.block 0 (list.append binds [Stmt.expr (if keep { tp inner renamed } else { tr inner renamed })])
};

/// `t` with every binding's name renamed as `renaming` says.
let rename_binds : :map -> Term -> Term;
let rename_binds renaming t = list.head (hoist.rewrite (fn y -> match y {
    Term.block(fl, ss) => Term.block fl (list.map (fn st -> match st {
        Stmt.bind(n, bf, v) => Stmt.bind (renaming.[n else n]) bf (rename_binds renaming v),
        Stmt.expr(e) => Stmt.expr (rename_binds renaming e),
    }) ss),
    _ => (),
}) %{} t);

/// A loop that hands parameter `j` on through what `assoc_op` and
/// `composite_of` read, rewritten so the list it hands on can be a trunk. The
/// function itself, its callers and its arity unchanged: what it answers is a
/// list, wherever it ends.
let designed : Site -> [Fun, [Fun], :unit] | :unit;
let designed site =
    if map.size (Program.assocs (Site.program site)) == 0 { () }
    else { first_of (list.map (fn j -> fn () -> designed_at site j) (list.range 0 (Site.k site))) };

let designed_at : Site -> :integer -> [Fun, [Fun], :unit] | :unit;
let designed_at site j = {
    let p = Site.program site;
    let gi = Site.gi site;
    let acc = sc.slot_name j;
    let body = Site.body site;
    let x = Tx.make p gi (%{ acc => true }) "dz" 0;
    // Each call of itself hands on, as `j`, what an operation or a composite
    // makes of the list -- through bindings, as a loop that chooses between
    // them writes it.
    let rec through cx t = match t {
        Term.block(_, ss) => {
            let [cx2, found] = list.fold (fn [c, f] st -> match st {
                Stmt.bind(n, _, v) => if produces c v { [tx_with c n, f || doing c v] } else { [c, f] },
                Stmt.expr(e) => [c, f || through c e],
            }) [cx, false] ss;
            found
        },
        Term.prim(:if, _, _, _, _, [_, y, z]) => through cx y || through cx z,
        Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) if g == gi && list.length args > j =>
            doing cx (list.nth j args),
        _ => false,
    };
    if not (through x body) { () }
    else {
        let f = (Program.funcs p).[Site.fi site];
        [sc.fun_of f (tr x body), [], ()]
    }
};

let is_var_any : Term -> :bool;
let is_var_any t = match t { Term.var(_, _) => true, _ => false };

/// Whether `t` does something to the list on the way to its answer: an
/// operation, a composite, an append.
let doing : Tx -> Term -> :bool;
let rec doing x t = match t {
    Term.var(n, _) => false,
    Term.prim(:apply, _, _, _, _, [Term.prim(:global, _, g, _, _, _), ..args]) => produces x t && not (is_var_any t),
    Term.prim(:add, _, _, _, _, _) => appended x t != (),
    Term.prim(:if, _, _, _, _, [_, y, z]) => doing x y || doing x z,
    Term.block(_, ss) => match list.reverse ss { [Stmt.expr(l), .._] => doing x l, _ => false },
    _ => false,
};
