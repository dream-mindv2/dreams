// Supercompilation: see docs/notes/supercompilation.md.
//
// This file is the core the supercompiler works on and the two translations
// between it and the IR. A program's IR is a frame of numbered slots per
// function, and a transformation that moves code between functions cannot
// keep a slot's number; so here a slot is a name, and a binding says which
// name it binds. Every operation that does not bind is one form, `prim`, that
// keeps its operands as they were and its children as terms, so the
// translation is faithful to the eighty-odd operations without modelling
// each: what the supercompiler needs to understand it will match on by
// operation, and everything else passes through.
//
// Milestone 1 is the round trip, IR to core and back with nothing between,
// run over every program the suites compile (`--sc-roundtrip`).

import std.array;
import std.lazy;
import std.list;
import std.map;
import std.num;
import std.str;

import dreams.ir;

/// A term of the core.
union Term {
    /// A slot of the frame, or a capture of the closure, by name. Its flags
    /// are the node's: a strict parameter is a read of it marked strict, at
    /// the head of the body (`lower_body`), and that read is what forces it.
    var(name : :string, flags : :integer)
    /// Any operation that binds nothing: its opcode, flags and operand fields
    /// as the IR had them, and the terms its child fields held, in the order
    /// `layout` reads them.
    prim(op : :atom, flags : :integer, a, b, c, children : [Term])
    /// A block: its statements, the last its value.
    block(flags : :integer, stmts : [Stmt])
    /// `make_closure` or `make_thunk` of function `fi`, with the names of the
    /// making frame its captures are taken from, in descriptor order.
    lam(op : :atom, flags : :integer, fi : :integer, captures : [:string])
    /// `try`: the body, the name the caught error is bound to, the handler.
    trying(flags : :integer, body : Term, error : :string, handler : Term)
    /// A child that is not there: an `if` with no `else`, a `get` with no
    /// fallback.
    absent
}

/// A block's statement.
union Stmt {
    bind(name : :string, flags : :integer, value : Term)
    expr(term : Term)
}

/// A function of the core: the names of its parameters and captures, its
/// body, and the record it came from, for every field the core does not touch.
struct Fun {
    params : [:string]
    captures : [:string]
    body : Term
    record
}

// --- what an operation's fields are -------------------------------------------

/// The opcodes whose children are a kids section at `b` of length `c`, with
/// `a` an operand: the primitives (`DREAM_PRIMITIVES` in the VM).
let primitives : [:atom];
let primitives = [:str_chars, :error_new, :error_kind, :error_payload, :str_slice, :str_find, :str_byte,
                  :str_le, :str_span, :str_upto, :char_code, :char_of_code, :to_float, :float_bytes,
                  :float_of_bytes, :to_int, :parse_int, :parse_float, :to_existing_atom, :array_new,
                  :array_to_list, :map_has, :map_remove, :map_pairs, :data_count, :data_at, :compare,
                  :str_interp];

/// The opcodes with two child fields, `a` and `b`.
let binaries : [:atom];
let binaries = [:add, :sub, :mul, :div, :mod, :eq, :ne, :lt, :le, :gt, :ge, :and, :or, :cons,
                :band, :bor, :bxor, :shl, :shr, :ensure];

/// Which of an operation's fields are children, as the VM's `node_children`
/// says: `:leaf`, `:a`, `:ab`, `:abc` (the last optional), `:a_kids` (`a`,
/// then `c` kids at `b`), `:kids_ab` (`b` kids at `a`), `:kids_ab2` (`2b`
/// kids at `a`), `:a_kids2` (`a`, then `2c` kids at `b`), or `:kids_bc`.
let layout : :atom -> :atom;
let layout op = match op {
    :field => :a, :force => :a, :neg => :a, :not => :a, :bnot => :a, :type_is => :a,
    :list_tail => :a, :list_is_empty => :a,
    :apply => :a_kids, :switch_head => :a_kids, :switch_atom => :a_kids,
    :if => :abc, :get => :abc, :set => :abc,
    :make_list => :kids_ab, :make_array => :kids_ab, :record_make => :kids_ab,
    :set_many => :a_kids2,
    :make_map => :kids_ab2,
    o if list.contains o binaries => :ab,
    o if list.contains o primitives => :kids_bc,
    _ => :leaf,
};

// --- from the IR -------------------------------------------------------------

/// The IR a translation reads: the arena as arrays.
mapping Arena {
    nodes
    kids
}

/// The name of slot `k`, and of capture `i`.
let slot_name : :integer -> :string;
let slot_name k = "s" + to_string k;
let capture_name : :integer -> :string;
let capture_name i = "c" + to_string i;

let node_of : Arena -> :integer -> ir.Node;
let node_of ar i = (Arena.nodes ar).[i];
let kids_of : Arena -> :integer -> :integer -> [:integer];
let kids_of ar off n = list.map (fn k -> (Arena.kids ar).[off + k]) (list.range 0 n);

/// A closure's or a thunk's captures, as names of the frame that makes it:
/// what its function's capture descriptors name there.
let capture_terms : Arena -> :map -> [:string];
let capture_terms ar f =
    list.map (fn d -> if d >= ir.cap_from_capture { capture_name (d - ir.cap_from_capture) }
                      else { slot_name d })
             (kids_of ar (f.[:captures_off else 0]) (f.[:n_captures else 0]));

// --- to the IR ---------------------------------------------------------------

/// Where emitting is: the program being built; what each of the function's
/// names stands for (`[:slot, k]` or `[:capture, i]`) and its next free slot;
/// the capture descriptors of every function made so far, by index; and
/// what went wrong, which is a fault of the core handed in and fails the
/// translation (`to_image`).
mapping Emit {
    prog
    names = %{}
    next = 0
    descriptors = %{}
    problems = []
    // When patching (`patch`): each function's descriptors as the image has
    // them, the clones made of a function captured some other way, keyed by
    // the function and the descriptors, and the next function index.
    original = ()
    clones = %{}
    next_fi = 0
    // When patching: which terms and statements were read from the arena,
    // and from which node, so that one the driver handed back unchanged is
    // that node again rather than a copy of it (`Reading`). Patching keeps
    // every slot where it was -- `s4` is slot 4 -- so a node read from a
    // function means the same thing written back into it.
    origins = ()
    stmt_origins = ()
    // What has been written in this function, and in which position:
    // `[tail, node]`, kept when `share` is set, so that a term two parents
    // share is written once (`emit_at`).
    emitted = %{}
    share = false
}

let problem : :string -> Emit -> Emit;
let problem p !e = settle (Emit.set_problems (list.cons p (Emit.problems e)) e);

/// The state with every field forced as far as its outermost constructor.
///
/// It is threaded through every node of the program, and a setter stores its
/// value unforced: unforced, the arena after the last node is a suspension
/// of the push before it, and so on back to the first, and forcing it at the
/// end overflowed the stack on a self-compile. Each function that takes the
/// state takes it strictly, so each forces the step before it.
let settle : Emit -> Emit;
let settle e =
    if lazy.forced (Emit.prog e) && lazy.forced (Emit.names e) && lazy.forced (Emit.next e)
       && lazy.forced (Emit.descriptors e) && lazy.forced (Emit.problems e)
       && lazy.forced (Emit.clones e) && lazy.forced (Emit.next_fi e) && lazy.forced (Emit.emitted e) { e }
    else { e };

/// What `name` stands for, giving it the next slot if it has none: a binding
/// is the first a name is seen.
let place : Emit -> :string -> [Emit, [:any]];
let place !e name = match (Emit.names e).[name else ()] {
    () if Emit.origins e != () && fixed_slot name != () => [e, [:slot, fixed_slot name]],
    () => {
        let k = Emit.next e;
        [settle (e |> Emit.set_names ((Emit.names e).[name => [:slot, k]]) |> Emit.set_next (k + 1)), [:slot, k]]
    },
    at => [e, at],
};

/// The slot a name read from the arena is: `s4` is 4. A name the driver
/// made has none, and is given the next slot after the frame's own.
let fixed_slot : :string -> :integer | :unit;
let fixed_slot name =
    if str.starts_with "s" name { num.parse_int (str.slice 1 (str.byte_length name - 1) name) } else { () };

/// The slot `name` is, giving it one if it has none. A name a binding binds
/// is never a capture: a closure's captures are read, not rebound.
let slot : Emit -> :string -> [Emit, :integer];
let slot !e name = {
    let [e2, at] = place e name;
    match at {
        [:slot, k] => [e2, k],
        _ => [problem ("a binding rebinds the capture " + name) e2, 0],
    }
};

let push : Emit -> ir.Node -> [Emit, :integer];
let push !e n = {
    let [p, i] = ir.push_node n (Emit.prog e);
    [settle (Emit.set_prog p e), i]
};

let push_kids : Emit -> [:any] -> [Emit, :integer];
let push_kids !e xs = {
    let [p, off] = ir.push_kids xs (Emit.prog e);
    [settle (Emit.set_prog p e), off]
};

/// Several terms as nodes, in order, none in tail position.
let emit_all : Emit -> [Term] -> [Emit, [:integer | :atom]];
let emit_all !e ts = {
    let [e2, rev] = list.fold (fn [ex, is] t -> {
        let [ex2, i] = emit ex t;
        [ex2, list.cons i is]
    }) [e, []] ts;
    [e2, list.reverse rev]
};

/// The capture descriptor a name of the making frame is.
let descriptor : Emit -> :string -> [Emit, :integer];
let descriptor !e name = {
    let [e2, at] = place e name;
    match at {
        [:slot, k] => [e2, ir.encode_capture false k],
        [:capture, i] => [e2, ir.encode_capture true i],
    }
};

/// A term as nodes, not in tail position: the index of the node it is.
let emit : Emit -> Term -> [Emit, :integer | :atom];
let emit !e t = emit_at e false t;

/// A term as nodes, in tail position or not.
///
/// Patching, a term read from the arena is the node it was read from, and a
/// term the driver made is written once however many parents share it --
/// the driver hands a shared node's result to each of them as one term, and
/// writing it per parent would undo the arena's sharing (`emitted`). A call
/// the driver made is marked a tail call exactly when it is in tail position
/// as `lower.mark_tail` decides it: the body, a branch of an `if` there, a
/// switch's target, a forced tail, a block's last statement. A call read
/// from the arena keeps its mark -- the driver only puts one where it stood,
/// or where it ends the function exactly when it did -- and taking a
/// function's tail calls into another is why the marks are made again.
let emit_at : Emit -> :bool -> Term -> [Emit, :integer | :atom];
let emit_at !e tail t =
    if Emit.origins e != () && map.has t (Emit.origins e) { [e, (Emit.origins e).[t]] }
    else {
        match (Emit.emitted e).[t else ()] {
            () => {
                let [e2, i] = emit_new e tail t;
                if not (Emit.share e2) { [e2, i] }
                else { [settle (Emit.set_emitted ((Emit.emitted e2).[t => [tail, i]]) e2), i] }
            },
            [was, i] if was == tail => [e, i],
            _ => emit_new e tail t,
        }
    };

let emit_new : Emit -> :bool -> Term -> [Emit, :integer | :atom];
let emit_new !e tail t = match t {
    Term.absent => [e, ir.no_node],
    Term.var(name, fl) => {
        let [e2, at] = place e name;
        match at {
            [:slot, k] => push e2 (ir.with_flags fl (ir.node :local k ir.no_node ir.no_node)),
            [:capture, i] => push e2 (ir.with_flags fl (ir.node :capture i ir.no_node ir.no_node)),
        }
    },
    Term.block(fl, ss) => {
        let last = list.length ss - 1;
        let [e2, rev] = list.fold (fn [ex, is] [k, s] -> match s {
            Stmt.bind(_, _, _) if Emit.stmt_origins ex != () && map.has s (Emit.stmt_origins ex) =>
                [ex, list.cons ((Emit.stmt_origins ex).[s]) is],
            // The name is given its slot before its value is emitted, which
            // is the order `lower` numbers them in.
            Stmt.bind(name, f2, v) => {
                let [ex2, slot_k] = slot ex name;
                let [ex3, vi] = emit ex2 v;
                let [ex4, bi] = push ex3 (ir.with_flags f2 (ir.node :bind slot_k vi ir.no_node));
                [ex4, list.cons bi is]
            },
            Stmt.expr(x) => {
                let [ex2, xi] = emit_at ex (tail && k == last) x;
                [ex2, list.cons xi is]
            },
        }) [e, []] (list.enumerate ss);
        let [e3, off] = push_kids e2 (list.reverse rev);
        push e3 (ir.with_flags fl (ir.node :block off (list.length ss) ir.no_node))
    },
    Term.lam(op, fl, fi, cs) => {
        // The descriptors belong to the function, not to the place it is made;
        // a function made in two places must capture the same slots in both.
        let [e2, rev] = list.fold (fn [ex, ds] c -> {
            let [ex2, d] = descriptor ex c;
            [ex2, list.cons d ds]
        }) [e, []] cs;
        let ds = list.reverse rev;
        match Emit.original e2 {
            () => {
                let known = (Emit.descriptors e2).[fi else ds];
                let e3 = if known != ds { problem ("function " + to_string fi + " is made capturing different slots") e2 }
                         else { settle (Emit.set_descriptors ((Emit.descriptors e2).[fi => ds]) e2) };
                push e3 (ir.with_flags fl (ir.node op fi ir.no_node ir.no_node))
            },
            // Patching, a function made where it always was captures what
            // it always did. One made in a frame laid out anew -- written
            // into a function it was not in -- is made as a clone that
            // captures the new slots.
            // A function the pass added captures what it is made with
            // here, as in a translation, and is given those captures when
            // the patch is finished.
            orig if fi >= array.length orig => {
                let known = (Emit.descriptors e2).[fi else ds];
                let e3 = if known != ds { problem ("function " + to_string fi + " is made capturing different slots") e2 }
                         else { settle (Emit.set_descriptors ((Emit.descriptors e2).[fi => ds]) e2) };
                push e3 (ir.with_flags fl (ir.node op fi ir.no_node ir.no_node))
            },
            orig => {
                let [e3, made] = if orig.[fi] == ds { [e2, fi] } else { clone e2 fi ds };
                push e3 (ir.with_flags fl (ir.node op made ir.no_node ir.no_node))
            },
        }
    },
    Term.trying(fl, body, err, h) => {
        let [e2, bi] = emit e body;
        let [e3, k] = slot e2 err;
        let [e4, hi] = emit e3 h;
        push e4 (ir.with_flags fl (ir.node :try bi hi k))
    },
    Term.prim(op, fl, a, b, c, cs) => {
        // Which children are in tail position when this is.
        let n_cs = list.length cs;
        let tails = match op {
            :if => [false, tail, tail],
            :force => [tail],
            o if o == :switch_head || o == :switch_atom =>
                list.map (fn k -> tail && k > 0 && (k % 2 == 0 || k == n_cs - 1)) (list.range 0 n_cs),
            _ => list.map (fn _ -> false) cs,
        };
        let [e2, rev] = list.fold (fn [ex, is] [x, xt] -> {
            let [ex2, xi] = emit_at ex xt x;
            [ex2, list.cons xi is]
        }) [e, []] (list.zip cs tails);
        let is = list.reverse rev;
        let flags = if op == :apply && Emit.origins e != () {
                        if tail { ir.add_flag fl ir.f_tail } else { untail_flags fl }
                    } else { fl };
        let n x y z = ir.with_flags flags (ir.node op x y z);
        // A count is the children's, whatever the term says: a term the
        // driver made, or one whose children it changed, need not say it.
        let k = list.length is;
        match layout op {
            :leaf => push e2 (n a b c),
            :a => push e2 (n (list.nth 0 is) b c),
            :ab => push e2 (n (list.nth 0 is) (list.nth 1 is) c),
            :abc => push e2 (n (list.nth 0 is) (list.nth 1 is) (list.nth 2 is)),
            :kids_bc => {
                let [e3, off] = push_kids e2 is;
                push e3 (n a off k)
            },
            :kids_ab => {
                let [e3, off] = push_kids e2 is;
                push e3 (n off k c)
            },
            :kids_ab2 => {
                let [e3, off] = push_kids e2 is;
                push e3 (n off (k / 2) c)
            },
            :a_kids2 => {
                let [e3, off] = push_kids e2 (list.drop 1 is);
                push e3 (n (list.head is) off ((k - 1) / 2))
            },
            _ => {
                let [e3, off] = push_kids e2 (list.drop 1 is);
                push e3 (n (list.head is) off (k - 1))
            },
        }
    },
};

/// The clone of function `fi` that captures `ds`, made if there is none.
let clone : Emit -> :integer -> [:integer] -> [Emit, :integer];
let clone !e fi ds = {
    // Keyed by a string: a map compares a list by identity.
    let key = to_string fi + ":" + str.join_str "," (list.map to_string ds);
    match (Emit.clones e).[key else ()] {
        () => {
            let made = Emit.next_fi e;
            [settle (e |> Emit.set_clones ((Emit.clones e).[key => [made, fi, ds]]) |> Emit.set_next_fi (made + 1)), made]
        },
        [made, _, _] => [e, made],
    }
};

/// One function's body, from its own names: its parameters are its first
/// slots, its captures what they always were, and the rest are given slots
/// as they are first seen. Answers the body's node and the frame's size.
let emit_fun : Emit -> Fun -> [Emit, [:integer | :atom, :integer]];
let emit_fun !e f = {
    let params = list.fold (fn m [k, n] -> m.[n => [:slot, k]]) %{} (list.enumerate (Fun.params f));
    let names = list.fold (fn m [i, n] -> m.[n => [:capture, i]]) params (list.enumerate (Fun.captures f));
    // Patching, the frame's own slots are where they were, so a name the
    // driver made starts after them; a translation numbers them all anew.
    let first = if Emit.origins e == () { list.length (Fun.params f) }
                else { num.max (list.length (Fun.params f)) ((Fun.record f).[:slots else 0]) };
    let inside = settle (e |> Emit.set_names names |> Emit.set_next first |> Emit.set_emitted %{});
    let [after, body] = emit_at inside (Emit.origins e != ()) (Fun.body f);
    let had = (Fun.record f).[:slots else 0];
    [after, [body, if Emit.next after > had { Emit.next after } else { had }]]
};

/// The image with every function's body, frame and captures written from
/// the core, into an arena of its own. Everything else -- the constant
/// pools, the globals, function and global indices -- is the image's as it
/// was, since no node of the core names a node of the old arena.
let to_image : ir.Image -> [Fun] -> Result;
let to_image img funs = {
    let [emitted, rev] = list.fold (fn [e, out] f -> {
        let [e2, done] = emit_fun e f;
        [e2, list.cons done out]
    }) [Emit.new ir.program |> Emit.set_share true, []] funs;
    let fresh = list.zip (list.range 0 (list.length funs)) (list.zip funs (list.reverse rev));
    let [final, recs] = list.fold (fn [e, out] [fi, [f, [body, slots]]] -> {
        let r = Fun.record f;
        let ds = (Emit.descriptors e).[fi else []];
        let [e2, off] = push_kids e ds;
        [e2, list.cons (r.[:body => body].[:slots => slots].[:captures_off => off]
                         .[:n_captures => list.length (Fun.captures f)]) out]
    }) [emitted, []] fresh;
    match Emit.problems final {
        [] => {
            let arena = ir.finish (Emit.prog final);
            Result.ok (img |> ir.Image.set_nodes (ir.Image.nodes arena) |> ir.Image.set_kids (ir.Image.kids arena)
                           |> ir.Image.set_funcs (list.reverse recs))
        },
        ps => Result.error (list.reverse ps),
    }
};

/// The image through the core and back, with nothing done in between: read
/// with its sharing kept (`read`) and written with it kept (`emit_at`), so
/// the arena comes back the size it went in and needs no sharing again.
let roundtrip : ir.Image -> Result;
let roundtrip img = {
    let rd = read img;
    to_image img (list.map (fn f -> fun_of f (body_of rd f)) (ir.Image.funcs img))
};

// --- patching an image ----------------------------------------------------------

/// The arena read as terms with its sharing kept: each node is read once,
/// into one term, and a node two parents share is the same term in both.
/// Read as trees, a shared arena is the unshared program -- a `match` lowers
/// to a switch whose targets are the tails of one chain of tests, quadratic
/// in its arms once copied -- and a self-compile's 57,000 nodes were written
/// back as 670,000. `origins` and `stmt_origins` say which node each term and
/// statement was read from, which is also how a term is known to be one the
/// driver handed back unchanged (`same`): a map keyed by a term keys it by
/// identity.
mapping Reading {
    terms
    stmts
    origins
    stmt_origins
}

let read : ir.Image -> Reading;
let read img = {
    let ar = Arena.make (array.of_list (ir.Image.nodes img)) (array.of_list (ir.Image.kids img));
    let funcs = array.of_list (ir.Image.funcs img);
    let n = array.length (Arena.nodes ar);
    let tables = read_tables ar funcs n;
    let [terms, stmts] = tables;
    // Every node's term is made here, which is every node read once.
    let origins = list.fold_strict (fn m i -> m.[terms.[i] => i]) %{} (list.range 0 n);
    let stmt_origins = list.fold_strict (fn m i -> match ir.node_op (node_of ar i) {
        :bind => m.[stmts.[i] => i],
        _ => m,
    }) %{} (list.range 0 n);
    Reading.make terms stmts origins stmt_origins
};

/// The two tables, each element reading its children from the tables
/// themselves: an element is a suspension until it is first read, and then
/// the one term every reader of that node shares.
let read_tables : Arena -> #[:map] -> :integer -> [#[Term], #[Stmt]];
let read_tables ar funcs n = {
    let rec tables = [array.of_list (list.map (fn i -> shared_term ar funcs tables i) (list.range 0 n)),
                      array.of_list (list.map (fn i -> shared_stmt ar tables i) (list.range 0 n))];
    tables
};

let shared_term : Arena -> #[:map] -> [#[Term], #[Stmt]] -> :integer -> Term;
let shared_term ar funcs tables i = {
    let [terms, stmts] = tables;
    let n = node_of ar i;
    let op = ir.node_op n;
    let [fl, a, b, c] = [ir.node_flags n, ir.node_a n, ir.node_b n, ir.node_c n];
    let t x = if x == ir.no_node { Term.absent } else { terms.[x] };
    match op {
        :local => Term.var (slot_name a) fl,
        :capture => Term.var (capture_name a) fl,
        :block => Term.block fl (list.map (fn k -> stmts.[k]) (kids_of ar a b)),
        :make_closure => Term.lam op fl a (capture_terms ar (funcs.[a])),
        :make_thunk => Term.lam op fl a (capture_terms ar (funcs.[a])),
        :try => Term.trying fl (t a) (slot_name c) (t b),
        _ => Term.prim op fl a b c (match layout op {
            :leaf => [],
            :a => [t a],
            :ab => [t a, t b],
            :abc => [t a, t b, t c],
            :a_kids => list.cons (t a) (list.map t (kids_of ar b c)),
            :kids_ab => list.map t (kids_of ar a b),
            :kids_ab2 => list.map t (kids_of ar a (2 * b)),
            :a_kids2 => list.cons (t a) (list.map t (kids_of ar b (2 * c))),
            :kids_bc => list.map t (kids_of ar b c),
        }),
    }
};

let shared_stmt : Arena -> [#[Term], #[Stmt]] -> :integer -> Stmt;
let shared_stmt ar tables i = {
    let [terms, _] = tables;
    let n = node_of ar i;
    match ir.node_op n {
        :bind => Stmt.bind (slot_name (ir.node_a n)) (ir.node_flags n)
                           (if ir.node_b n == ir.no_node { Term.absent } else { terms.[ir.node_b n] }),
        _ => Stmt.expr (terms.[i]),
    }
};

/// Function `fi`'s body as read.
let body_of : Reading -> :map -> Term;
let body_of rd f = match f.[:body else ir.no_node] {
    b if b == ir.no_node => Term.absent,
    b => (Reading.terms rd).[b],
};

/// Whether `b` is `a` handed back unchanged: both read from the same node,
/// or both nothing.
let same : Reading -> Term -> Term -> :bool;
let same rd a b = match [a, b] {
    [Term.absent, Term.absent] => true,
    _ => match (Reading.origins rd).[b else ()] {
        () => false,
        i => (Reading.origins rd).[a else ()] == i,
    },
};

/// Whether a statement is one read from the arena.
let read_stmt : Reading -> Stmt -> :bool;
let read_stmt rd s = map.has s (Reading.stmt_origins rd);

/// A term rebuilt from its parts, or the term itself when every part came
/// back as it was: what keeps a node the driver did not change the node it
/// was read from.
let rebuilt : Reading -> Term -> [Term] -> Term;
let rebuilt rd t cs2 = match t {
    Term.prim(op, fl, a, b, c, cs) =>
        if list.length cs == list.length cs2 && list.all (fn [x, y] -> same rd x y) (list.zip cs cs2) { t }
        else { Term.prim op fl a b c cs2 },
    _ => t,
};

/// A block rebuilt from its statements, or the block itself when they are
/// the ones it had.
let rebuilt_block : Reading -> Term -> :integer -> [Stmt] -> Term;
let rebuilt_block rd t fl ss2 = match t {
    Term.block(fl0, ss) if fl0 == fl && list.length ss == list.length ss2
                           && list.all (fn [x, y] -> same_stmt rd x y) (list.zip ss ss2) => t,
    _ => Term.block fl ss2,
};

let same_stmt : Reading -> Stmt -> Stmt -> :bool;
let same_stmt rd a b = match [a, b] {
    [Stmt.bind(n, f, x), Stmt.bind(n2, f2, y)] => n == n2 && f == f2 && same rd x y,
    [Stmt.expr(x), Stmt.expr(y)] => same rd x y,
    _ => false,
};

/// Whether a body binds one slot in two places. The resolver gives the
/// branches of an `if` and the arms of a `match` the same slots, since only
/// one of them runs in a call (scope.dr); but here a slot is a name, and a
/// rewrite that moves a term from one branch to another, or remembers what a
/// name was bound to, would read one binding as the other. Such a function
/// is left as it is.
let reuses_slots : Term -> :bool;
let reuses_slots t = {
    let rec walk t acc = {
        let [seen, names, twice] = acc;
        if twice || map.has t seen { acc }
        else {
            let here = [seen.[t => true], names, twice];
            match t {
                Term.prim(_, _, _, _, _, cs) => list.fold (fn a x -> walk x a) here cs,
                Term.block(_, ss) => list.fold (fn a st -> {
                    let [sn, nm, tw] = a;
                    match st {
                        Stmt.bind(n, _, x) => {
                            let again = tw || (map.has n nm && nm.[n] != st);
                            walk x [sn, nm.[n => st], again]
                        },
                        Stmt.expr(e) => walk e a,
                    }
                }) here ss,
                Term.trying(_, body, e, h) => {
                    let [sn, nm, tw] = walk h (walk body here);
                    [sn, nm.[e => t], tw || (map.has e nm && nm.[e] != t)]
                },
                _ => here,
            }
        }
    };
    list.nth 2 (walk t [%{}, %{}, false])
};

/// A function's own names: its parameters `s0`.., its captures `c0`...
let fun_of : :map -> Term -> Fun;
let fun_of f body = Fun.make (list.map slot_name (list.range 0 (f.[:arity else 0])))
                             (list.map capture_name (list.range 0 (f.[:n_captures else 0])))
                             body f;

/// The image with the functions in `changed` written anew and `added`
/// appended after the image's own, in that order, and `globals` after its
/// globals. Only what changed is written: its nodes go after the arena's,
/// which is left as it is, and a term or statement the driver handed back as
/// it was read is the node it was read from. Its tail calls are marked as
/// it is written (`emit_at`).
let patch : ir.Image -> Reading -> %{:integer => Fun} -> [Fun] -> [:map] -> Result;
let patch img rd changed added globals = {
    let funcs = array.of_list (ir.Image.funcs img);
    let n_funcs = array.length funcs;
    let kids = array.of_list (ir.Image.kids img);
    let original = array.of_list (list.map (fn f ->
        list.map (fn k -> kids.[(f.[:captures_off else 0]) + k]) (list.range 0 (f.[:n_captures else 0])))
        (ir.Image.funcs img));
    let n_nodes = list.length (ir.Image.nodes img);
    let start = Emit.new (ir.program |> ir.Program.set_node_count n_nodes |> ir.Program.set_kid_count (array.length kids))
        |> Emit.set_original original |> Emit.set_next_fi (n_funcs + list.length added)
        |> Emit.set_origins (Reading.origins rd) |> Emit.set_stmt_origins (Reading.stmt_origins rd)
        |> Emit.set_share true;
    let written = list.append (map.pairs changed) (list.map (fn [i, f] -> [n_funcs + i, f]) (list.enumerate added));
    let [emitted, rev] = list.fold (fn [e, out] [fi, f] -> {
        let [e2, [body, slots]] = emit_fun e f;
        [e2, list.cons [fi, (Fun.record f).[:body => body].[:slots => slots]] out]
    }) [start, []] written;
    // An added function made as a closure captures what it was made with.
    let [captured, made_rev] = list.fold (fn [e, out] [fi, r] -> match (Emit.descriptors e).[fi else ()] {
        () => [e, list.cons [fi, r] out],
        ds => {
            let [e2, off] = push_kids e ds;
            [e2, list.cons [fi, r.[:captures_off => off].[:n_captures => list.length ds]] out]
        },
    }) [emitted, []] rev;
    let records = list.fold (fn m [fi, r] -> m.[fi => r]) %{} made_rev;
    let record fi = records.[fi else funcs.[fi]];
    // A clone is its function's record, as patched, with captures of its own.
    let [final, clones_rev] = list.fold (fn [e, out] [made, fi, ds] -> {
        let [e2, off] = push_kids e ds;
        [e2, list.cons [made, (record fi).[:captures_off => off]] out]
    }) [captured, []] (list.sort_on (fn p -> list.head p) (map.values (Emit.clones emitted)));
    match Emit.problems final {
        [] => {
            let p = Emit.prog final;
            let new_nodes = list.map (fn i -> (ir.nodes p).[i]) (list.range n_nodes (ir.node_count p));
            let new_kids = list.map (fn i -> (ir.kids p).[i]) (list.range (array.length kids) (ir.kid_count p));
            let funcs_out = list.append (list.map record (list.range 0 (n_funcs + list.length added)))
                                        (list.map (fn c -> list.nth 1 c) (list.reverse clones_rev));
            let out = img |> ir.Image.set_nodes (list.append (ir.Image.nodes img) new_nodes)
                          |> ir.Image.set_kids (list.append (ir.Image.kids img) new_kids)
                          |> ir.Image.set_funcs funcs_out
                          |> ir.Image.set_globals (list.append (ir.Image.globals img) globals);
            // Settled before it is handed on: unsettled, what is written is
            // a suspension of this patch, and that holds the emitter and the
            // reading of the whole arena -- each pass's, with five passes
            // chained, which put a self-compile past a process's heap.
            if lazy.settled (ir.Image.nodes out) && lazy.settled (ir.Image.kids out)
               && lazy.settled (ir.Image.funcs out) && lazy.settled (ir.Image.globals out) { Result.ok out }
            else { Result.ok out }
        },
        ps => Result.error (list.reverse ps),
    }
};

// --- tail calls ------------------------------------------------------------------

let untail_flags : :integer -> :integer;
let untail_flags fl = if ir.has_flag fl ir.f_tail { fl - ir.f_tail } else { fl };
