// The compiler as a library: a loaded program in, a build out.
//
// Every consumer of `dreams` -- the command line, the REPL's session, and
// anything that imports the compiler the way `lucid` does -- wants the same
// pipeline: resolve, lower and link, hold the program to its signatures, run
// its compile-time contracts, share the arena, write the bytes. That pipeline
// used to be written out by hand in each of them, in five slightly different
// orders, and the differences were not decisions: `--time` checked types
// without contracts, the session never looked at a signature, and the JIT's
// parameter masks were worked out in the middle of the function that opened
// the output file. This is the one place the order is written, so a new stage
// is added once and every caller gets it.
//
// What comes back is a `Build`, and the shape is the point. Three stages run
// a VM -- a `comp` in lowering, a contract in the checker's answer, a macro in
// the loader before any of this -- and are impure, so they are forced here, in
// order, where the block says. Everything after them is pure and lazy: an
// image nobody asks for is never optimized, and bytes nobody writes are never
// laid out. So `build!` costs what a `--check` costs plus lowering, and a
// caller that only wants the diagnostics pays for nothing else.
//
// Nothing here opens a file. Writing an image -- where to, with what `#!`
// line, and the payload streamed after it -- is the command line's business,
// and the REPL writes somewhere else entirely.

import std.progress;
import std.list;
import std.str;
import std.path;

import dreams.debuginfo;
import dreams.diag;
import dreams.emit;
import dreams.ir;
import dreams.lower;
import dreams.modules;
import dreams.package;
import dreams.opt as optimizer;
import dreams.accum;
import dreams.drive;
import dreams.hoist;
import dreams.sc;
import dreams.scope;
import dreams.typecheck;
import dreams.contract;
import dreams.unit;
import std.vm;
import std.map;

// --- what to compile it as ------------------------------------------------------

/// The choices a build makes that are not the program's.
///
/// `types` holds the program to its signatures and runs its compile-time
/// contracts. A program always is: there is no flag to turn it off, and only
/// the REPL's scratch build below does, holding a session to nothing it has not
/// always been held to. `optimize` shares the arena
/// (`dreams/src/opt.dr`); off, the image is the arena exactly as `lower` built it,
/// which is what to reach for when an image misbehaves. `payloads` are the
/// *sizes* of what `--payload` appends, because they are part of the section
/// table and so of what the image is -- the bytes themselves never come near
/// a Dream string. `payload_names` are what `--payload NAME=FILE` called
/// them, one per payload, which become the image's `LNAM` section.
///
/// `parallel` spreads lowering and checking across processes, handing them
/// the program through the runtime's shared area (`vm.share!`). That is most
/// of what a large build costs cut by the number of cores, and it is for a
/// build that runs once: nothing shared is freed before the runtime is, so a
/// caller that builds again and again in one process -- a session, a server
/// -- would keep every program it ever built. The command line turns it on.
mapping Options {
    types = true
    optimize = true
    payloads = []
    parallel = false
    payload_names = []
    // Where parts are kept between builds (`--units DIR`, see `dreams/src/unit.dr`),
    // or `()`: only a parallel build is in parts, so only one reads or keeps
    // them.
    units = ()
    // Compile a dependency only as far as the program reaches it (`reached`).
    // The command line turns it on for a build and off for `--test`; a check
    // and an editor never prune, since what they are for is every diagnostic.
    prune = false
    // `[from, to]` per `--remap-path-prefix FROM=TO`: how the source paths the
    // image records are rewritten (`remap_sources`).
    remap = []
    // The supercompiler (docs/notes/supercompilation.md): `()` for none,
    // `:roundtrip` to take the image through its core and back with nothing
    // done in between (`--sc-roundtrip`, `dreams/src/sc.dr`), `:drive` to
    // drive it (`--supercompile`, `dreams/src/drive.dr`).
    supercompile = ()
    // Write what a debugger reads -- the name of each function's locals
    // (`--debug-info`, `dreams/src/debuginfo.dr`) -- into the image.
    debug_info = false
}

/// The defaults: checked, shared, no payload.
let options : Options;
let options = Options.new ();

/// The REPL's: a scratch image that runs once, compiled as `lower` left it and
/// held to nothing a session has not always been held to.
let scratch : Options;
let scratch = Options.make false false [] false [] () false [] () false;

// --- a build --------------------------------------------------------------------

/// A diagnostic, as `dreams/src/diag.dr` makes one.
type Diagnostics = [:map];

/// One program, compiled as far as it goes.
///
/// `diags` is everything the build had to say: the loader's, the resolver's,
/// lowering's, the checker's and the contracts', in that order and each only
/// if the one before it found no error -- a name that means nothing has no
/// type to check, and a contract on an argument the checker already rejected
/// would be a second report of the same mistake.
mapping Build {
    loader
    resolution
    lowered
    facts
    diags
    options
    shared = ()
}

/// Resolve names and select standard members from their types. Walk again
/// with the choices known so the usual fusion and scratch-slot plans apply.
///
/// Three steps, each its own function so that `--time` can charge them
/// separately: the walk (`resolve_names!`), the choice of each shorthand's
/// member (`select!`), and the walk again with the choices (`rechoose!`).
let resolve! : modules.Loader -> Options -> scope.Resolution;
let resolve! l o = {
    let d = scope.declare! l;
    let initial = resolve_names! l d o;
    let keep = kept l o initial;
    let selected = select! l o initial keep;
    rechoose! l d o initial selected keep
};

/// The first walk: every name resolved, a shorthand call to every member it
/// may mean. `d` is the program declared (`scope.declare!`), which both walks
/// start from.
let resolve_names! : modules.Loader -> scope.State -> Options -> scope.Resolution;
let resolve_names! l d o =
    if parted o { scope.resolve_parts_declared! l d (Options.units o) } else { scope.resolve_declared! l d %{} () };

/// Which member each shorthand call means, found from the types.
///
/// It is the type check's two passes -- every body for what it answers, then
/// again with what was inferred -- and in parts it is made as the type check
/// is, a process per part (`checked_in_parts!`), and kept as the type check is
/// under `--units`. Made in one process it was the largest stage of a
/// self-compile, 1.2 s against the 0.6 s of the walk it follows. The second
/// pass asks only the parts with a shorthand call in them.
///
/// Only the bodies `keep` names are asked, when it names any: what nothing
/// reaches has no call whose member matters, and a body that is reached has
/// every function it calls reached with it, so what the first pass infers
/// for those is all the second needs.
let select! : modules.Loader -> Options -> scope.Resolution -> (%{:integer => :bool} | :unit) -> scope.Resolution;
let select! l o initial keep =
    if not (typecheck.has_overloads initial) { initial }
    else if not (parted o) || scope.parts initial == () { typecheck.select_overloads l initial }
    else {
        let cache = Options.units o;
        let k = vm.share! (list.head (typecheck.prepared l initial %{}));
        let first = checked_in_parts! :first cache [k] initial keep;
        let k2 = match typecheck.inferring k (map (fn one -> list.nth 1 one) first) {
            () => k,
            next => vm.share! next,
        };
        typecheck.apply_choices initial (list.concat (checked_in_parts! :select cache [k2] initial keep))
    };

/// The walk again with the choices known and only the bodies `keep` names, or
/// the selection as it is when there was nothing to choose and nothing to
/// leave out, or choosing failed.
let rechoose! : modules.Loader -> scope.State -> Options -> scope.Resolution -> scope.Resolution -> (%{:integer => :bool} | :unit) -> scope.Resolution;
let rechoose! l d o initial selected keep =
    if diag.error_count (scope.r_diags selected) > 0 { selected }
    else if not (typecheck.has_overloads initial) && keep == () { selected }
    else if parted o {
        // A part walked before is kept only when nothing is left out: with a
        // body gone, every position after it has moved.
        let previous = if keep == () { scope.parts initial } else { () };
        scope.resolve_parts_from! l d (Options.units o) (scope.Resolution.selections selected) previous keep
    }
    else { scope.resolve_declared! l d (scope.Resolution.selections selected) keep };

// --- compiling what is reached ----------------------------------------------------
//
// A program loads every module it imports and reaches a sliver of most: an
// example that prints a few strings loads 469 bodies of the standard library
// and calls 59 of them. Everything after the first walk -- choosing, the walk
// again, lowering, the type check -- costs by the body, so a build that keeps
// only what is reached does a fraction of the work.
//
// Only a dependency is cut down. The package being built is compiled whole,
// reached or not, so that every mistake in it is still reported; a dependency
// has its own tests for its own mistakes. What is reached is read off the
// first walk, and a shorthand call reaches every member it might mean, since
// it is asked before anything is chosen (`scope.reached`).

/// The bodies to compile, or `()` for all of them. Asked of the first walk,
/// before anything is chosen, so a shorthand call reaches every member it
/// might mean: more than the program needs, and what lets the choosing be
/// asked of these bodies alone.
let kept : modules.Loader -> Options -> scope.Resolution -> %{:integer => :bool} | :unit;
let kept l o initial =
    if not (Options.prune o) || scope.parts initial == () || diag.error_count (scope.r_diags initial) > 0 { () }
    else {
        let keep = scope.reached initial (root_modules l);
        if len keep >= list.length (scope.bodies initial) { () } else { keep }
    };

/// The modules compiled whole: every one whose package is the one being
/// built, and every one in no package -- a program's own files.
///
/// A file's package is the *nearest* one around it. Packages nest: `mind`
/// writes a build script's driver, a package of its own, under the target
/// directory of the package whose script it runs, and taking the driver for
/// part of the outer package pruned its `main!` away.
let root_modules : modules.Loader -> %{:integer => :bool};
let root_modules l = {
    let ps = modules.packages l;
    let here = package.current_index ps;
    let dirs = list.enumerate (map package.src (package.packages ps));
    fold (fn acc mi -> {
        let file = modules.module_path (modules.module_at l mi);
        // `[depth inside, package]` for each package around the file.
        let around = list.concat (map (fn [i, dir] -> match path.relative_to dir file {
            Option.none => [],
            Option.some(inside) => [[list.length inside, i]],
        }) dirs);
        match list.sort_on list.head around {
            [] => acc.[mi => true],
            [[_, i], .._] => if i == here { acc.[mi => true] } else { acc },
        }
    }) %{} (list.range 0 (modules.module_count l))
};

/// Whether resolution runs in parts, one process per module.
let parted : Options -> :bool;
let parted o = Options.parallel o && Options.optimize o;

/// Resolve, lower, link and check the program. Lowering settles compile-time
/// expressions and checking runs contracts on a VM.
let build! : modules.Loader -> Options -> Build;
let build! l0 o = {
    let parallel = Options.parallel o;
    // In parts, the loader is shared once, here: each resolution walk shares
    // what its parts read, which holds the loader, and sharing the loader as
    // it was each time copied its 10 MB twice in the root, on the critical
    // path. Once it is shared, whatever holds it crosses with a pointer.
    let l = if parallel && Options.optimize o { vm.share! l0 } else { l0 };
    // A parallel build resolves in parts, in several processes, and lowers
    // and checks each part in a process of its own against the part's
    // resolution (see "resolving in parts" in `scope`).
    // Only a build that is also lowered in parts: a resolution made in parts
    // keeps each part's name uses in the part, and lowering the arena whole
    // (`--no-opt`) asks them all of one resolution.
    let parted = parallel && Options.optimize o;
    let r = resolve! l o;
    // A build that will be optimized is lowered in parts, in several processes
    // at once (`lower.link_parallel!`); one that will not keeps the arena
    // exactly as `lower` builds it, which the parts cannot, since each is
    // shared before it is merged.
    let low = if parted { lower.link_parallel! l r (Options.units o) } else { lower.link! l r };
    let front = list.append (modules.diags l) (lower.all_diags r low);
    // One checker for the diagnostics, the contracts and both of the JIT's
    // parameter masks. Lazy, so a build without types never makes it -- and
    // in a parallel build, one that is going to be checked is checked below,
    // once the arena has gone to be shared.
    let facts = typecheck.analyze l r (lower.comp_values low);
    // Sharing the arena needs nothing the checker says, and the checker needs
    // nothing sharing does, so the two run at once: the arena goes to a
    // process of its own before the checker starts, and comes back when the
    // checker is done. On a self-compile that is the checker's half second
    // taken off the critical path. A build that has already failed shares
    // nothing, and one whose checker fails never waits for the answer.
    let ahead = if not (Options.optimize o) || diag.error_count front > 0 { () }
                else {
                    match lower.sharing low {
                        () => share_elsewhere! (lower.prog low),
                        started => started,
                    }
                };
    let known = if parallel && Options.types o && diag.error_count front == 0 {
                    analyze_parallel! l r (lower.comp_values low) (Options.units o)
                } else { facts };
    let checked = type_diags! (Options.types o) known low front;
    let all = list.append front checked;
    let shared = if ahead == () || diag.error_count all > 0 { () }
                 else {
                     match join! ahead {
                         [:crashed, _] => (),
                         done => if lower.sharing low == () { done } else { lower.patched low done },
                     }
                 };
    Build.make l r low known all o shared
};

/// A process sharing this program's arena. What crosses is the program as
/// `lower` built it -- tables, not the flat lists `ir.finish` makes of them --
/// so flattening it happens in the child too. It is forced first, because what
/// crosses to the child is copied, and an unforced part of it would cross as a
/// suspension carrying the whole lowering state. The function is its own so
/// that the suspension handed to `spawn!` holds this frame and nothing else.
/// A raise in the child is not the child's to report: it answers `:crashed`,
/// and the image is shared again where it always was, where the raise happens
/// as it did before.
let share_elsewhere! p = {
    strict! p
    spawn! $( try! { strict! (optimizer.optimize_program p) } catch e { [:crashed, e] } )
};

/// The type analysis, with the bodies checked in `lower.part_count` processes
/// at once: the same answer `typecheck.analyze` gives, in about a quarter of
/// the time. The checker is built here, once, and shared, so each process is
/// handed a pointer to it; each answers what its bodies said, against their
/// positions, and `typecheck.concluded` lays them back in order. With a unit
/// cache, a part resolved in parts is checked once for a given walk and given
/// checker tables, and read back after (`check_unit!`).
///
/// Twice, as `typecheck.checked_twice` checks: the first time against the
/// signatures, which also says what each unsigned body answers, and the second
/// against those answers as well -- in parts again, with a checker made from
/// what all the parts of the first said. See "what an unsigned function
/// answers" in typecheck.dr.
let analyze_parallel! : modules.Loader -> scope.Resolution -> :map -> :any -> typecheck.Analysis;
let analyze_parallel! l r comps cache = {
    let kd = vm.share! (typecheck.prepared l r comps);
    let k = list.head kd;
    let first = checked_in_parts! :first cache [k] r ();
    let found = map (fn one -> list.nth 1 one) first;
    let said = map (fn one -> list.head one) first;
    let again = match typecheck.inferring k found {
        () => map (fn _ -> []) said,
        k2 => checked_in_parts! :second cache [k, vm.share! k2] r (),
    };
    strict! (typecheck.concluded k r (list.nth 1 kd) said again)
};

/// Every body's answer to one of the two checks, in the order of the bodies:
/// `how` is `:first` or `:second` (`check_bodies`), and `ks` the checkers it
/// asks -- the one, or the first and the one made from what it inferred. Each
/// kept under a kind of its own, since the two answer different things about
/// the same walk.
let checked_in_parts! : :atom -> :any -> [typecheck.Checker] -> scope.Resolution -> (%{:integer => :bool} | :unit) -> [:any];
let checked_in_parts! how cache ks r keep = {
    let asked : [[:any]] -> [[:any]];
    let asked nbs = match keep { () => nbs, _ => filter (fn nb -> map.has (list.head nb) keep) nbs };
    let tables = match cache { () => (), _ => unit.digest (typecheck.tables (list.last ks)) };
    strict! tables
    let kind = kind_of how;
    // Which of a part's bodies are asked is part of the key when not all of
    // them are, so that a part checked whole is never read back for a part
    // cut down, nor the other way round. A part asked whole keeps the key it
    // always had, which the type check after lowering shares.
    let key_of : scope.Resolution -> [[:any]] -> :string | :unit;
    let key_of pr nbs = match tables {
        () => (),
        digest => match scope.unit_key pr {
            () => (),
            walk =>
                if list.length nbs == list.length (scope.part_bodies pr) { unit.key [kind, walk, digest] }
                else { unit.key [kind, walk, digest, unit.digest (map list.head nbs)] },
        },
    };
    let work = match scope.parts r {
        () => {
            let all = scope.bodies r;
            let numbered = list.zip (list.range 0 (list.length all)) all;
            map (fn j -> [ks, asked (filter (fn nb -> list.head nb % lower.part_count == j) numbered), ()])
                     (list.range 0 lower.part_count)
        },
        walked => list.map (fn pr -> {
            let nbs = if how == :select && len (scope.Resolution.overload_uses pr) == 0 { [] }
                      else { asked (scope.part_bodies pr) };
            [map (fn k -> typecheck.with_resolution k pr) ks, nbs, key_of pr nbs]
        }) walked,
    };
    strict! work
    // Heaviest first, as lowering's parts are (`lower.balanced`). Not cut up:
    // a part checked whole is kept under the key the check after lowering
    // reads back, and a piece of one would be a stranger to it.
    let said = list.concat (progress.join_heaviest_first! (match how { :first => "checking", :select => "choosing", _ => "inferring" })
        (fn w -> lower.slice_weight (list.nth 1 w))
        (fn w -> check_elsewhere! how (match list.nth 2 w { () => (), _ => cache }) (list.nth 2 w) (list.head w) (list.nth 1 w))
        work);
    map (fn one -> list.nth 1 one) (list.sort_on (fn one -> list.head one) said)
};

/// A process checking some bodies against a shared checker. Its own function
/// for the reason `share_elsewhere!` is, and its cache and key strict for the
/// reason `lower.part_elsewhere!`'s are.
let check_elsewhere! how !cache !key ks slice = spawn! $( vm.share! (check_unit! how cache key ks slice) );

/// What some bodies said, or what they said the last time they were checked
/// against the same walk and the same tables. Kept with positions counted from
/// the part's first body, as a walk is, so a body added to an earlier module
/// does not make every later part's check a stranger.
let check_unit! : :atom -> :any -> :any -> [typecheck.Checker] -> [[:any]] -> [[:any]];
let check_unit! how cache key ks slice = match [cache, slice] {
    [(), _] => check_bodies how ks slice,
    [_, []] => check_bodies how ks slice,
    [_, [[from, .._], .._]] => {
        let kind = kind_of how;
        let said = match unit.recall! cache kind key {
            () => {
                let fresh = check_bodies how ks (unit.shifted (0 - from) slice);
                unit.keep! cache kind key fresh
                fresh
            },
            kept => kept,
        };
        unit.shifted from said
    },
};

/// `[position, answer]` for each body: the first check's answer is
/// `[diagnostics, inferred]` (`typecheck.check_decl_inferring`), the second's
/// the diagnostics alone (`typecheck.check_again`), and the selecting check's
/// what a check against the inferred types said, choices included
/// (`typecheck.check_decl`).
let check_bodies : :atom -> [typecheck.Checker] -> [[:any]] -> [[:any]];
let check_bodies how ks slice = match how {
    :first => map (fn nb -> [list.head nb, typecheck.check_decl_inferring (list.head ks) (list.nth 1 nb) []]) slice,
    :select => map (fn nb -> [list.head nb, typecheck.check_decl (list.head ks) (list.nth 1 nb) []]) slice,
    _ => map (fn nb -> [list.head nb, typecheck.check_again (list.head ks) (list.nth 1 ks) (list.nth 1 nb)]) slice,
};

/// What a pass's answers are kept as in the unit cache. The selecting check
/// has a kind of its own: it is asked of the same walk as the first, against
/// different tables, and answers something else.
let kind_of : :atom -> :string;
let kind_of how = match how { :first => "check", :select => "select", _ => "infer" };

/// What a program's signatures and contracts say is wrong with it, given what
/// the earlier stages said. Nothing, when they already found an error or the
/// types are off.
let type_diags! : :bool -> typecheck.Analysis -> lower.Lowering -> Diagnostics -> Diagnostics;
let type_diags! types facts low ds =
    if not types || diag.error_count ds > 0 { [] }
    else {
        let found = typecheck.Analysis.diags facts;
        if diag.error_count found > 0 { found }
        else { list.append found (contract.settle! low (typecheck.Analysis.contracts facts)) }
    };

/// Resolve and check the program without lowering it: what `--check` asks, and
/// what an editor asks on every keystroke. Lowering is where `comp`s run, so a
/// check never runs one -- which is why its type pass cannot see what a `comp`
/// came to, and why a contract on one is a build's to report, not a check's.
let check! : modules.Loader -> Options -> Diagnostics;
let check! l o = checked l (typecheck.select_overloads l (scope.resolve! l)) o;

/// The same, for a program already resolved. Separate because a language
/// server keeps the resolution -- it is what hover and go-to-definition read --
/// and must not resolve the program twice to be told what is wrong with it.
let checked : modules.Loader -> scope.Resolution -> Options -> Diagnostics;
let checked l r o = {
    let ds = list.append (modules.diags l) (scope.r_diags r);
    list.append ds (if not (Options.types o) || diag.error_count ds > 0 { [] }
                    else { typecheck.check_program l r })
};

// --- reading one ---------------------------------------------------------------

let loader : Build -> modules.Loader;
let loader b = Build.loader b;

let resolution : Build -> scope.Resolution;
let resolution b = Build.resolution b;

let lowered : Build -> lower.Lowering;
let lowered b = Build.lowered b;

let diags : Build -> Diagnostics;
let diags b = Build.diags b;

/// Did it compile? Warnings do not stop a build; errors do.
let ok : Build -> :bool;
let ok b = diag.error_count (diags b) == 0;

/// Every file the program was read from, as `diag.render_all` wants them.
let files : Build -> [:any];
let files b = modules.files (loader b);

/// The diagnostics, rendered against the source they point into.
let rendered : Build -> :string;
let rendered b = diag.render_all (files b) (diags b);

// --- the image ------------------------------------------------------------------

/// Which parameters of each function a signature declares, as
/// `[function, mask]` sorted by function: the shape the `TYPE` and `ITYP`
/// sections are written in, and what the JIT looks a function up by. A global
/// names its function through its record, and a global that is not a function
/// -- an alias of a module -- has no parameters to describe.
let param_masks : ir.Image -> %{ :integer => :integer } -> [[:integer, :integer]];
let param_masks img by_global = {
    let globals = ir.Image.globals img;
    let found = list.fold (fn acc [gi, mask] -> {
        let g = globals.[gi else ()];
        if g == () || g.[:kind else ir.global_module] != ir.global_function { acc }
        else { list.cons [g.[:target else 0], mask] acc }
    }) [] (map.pairs by_global);
    list.sort_on (fn e -> list.head e) found
};

/// The image as a map, ready for `emit.to_binary`: the arena, shared if the
/// options say so, with the payload sizes and the JIT's parameter hints. The
/// optimizer runs here rather than inside `lower` because what it rewrites is
/// the *finished* arena -- a node's flags are final only once every body has
/// been lowered and every `comp` settled, and two nodes that differ only in a
/// flag are two nodes.
let image : Build -> ir.Image;
let image b = match finished b {
    Result.ok(img) => img,
    Result.error(_) => finish b (shared_image b),
};

/// The image, or why the supercompiler could not translate it. Only the
/// command line asks this, since only it can say so; everything else takes
/// `image`, which falls back to the image as it was before the translation.
///
/// Both read the shared arena as the graph it is (`sc.read`) and write it
/// back as one, so there is nothing to share again.
let finished : Build -> Result;
let finished b = match Options.supercompile (Build.options b) {
    :roundtrip => Result.map (fn img -> finish b img) (sc.roundtrip (shared_image b)),
    // The driver reads the shared arena and writes only what it changed,
    // after it (`sc.patch`), so there is nothing to unshare or share again.
    // Loop invariants are hoisted out first (`dreams/src/hoist.dr`), so that
    // what the driver specialises is the loop that no longer recomputes them.
    :drive => Result.map (fn img -> finish b img)
                         (hoist.hoist (shared_image b) |> Result.and_then accum.accum |> Result.and_then drive.supercompile
                          // Again, over what the driver made: a specialisation
                          // of `fold` on a closure is the loop the closure's
                          // accumulator was in.
                          |> Result.and_then hoist.hoist |> Result.and_then accum.finishing),
    _ => Result.ok (finish b (shared_image b)),
};

/// The arena, shared if the options say so.
let shared_image : Build -> ir.Image;
let shared_image b = {
    let arena = lower.image (lowered b);
    if not (Options.optimize (Build.options b)) { arena }
    else { match Build.shared b { () => optimizer.optimize arena, done => done } }
};

/// What the build adds to an arena to make it the image.
let finish : Build -> ir.Image -> ir.Image;
let finish b built = {
    let o = Build.options b;
    let hints f = if Options.types o { param_masks built (f (Build.facts b)) } else { [] };
    built
        |> ir.Image.set_payloads (Options.payloads o)
        |> ir.Image.set_payload_names (Options.payload_names o)
        |> ir.Image.set_float_params (hints typecheck.Analysis.float_params)
        |> ir.Image.set_integer_params (hints typecheck.Analysis.integer_params)
        |> ir.Image.set_vm_options (vm_options (Build.loader b))
        |> named_locals b
        |> remap_sources (Options.remap o)
};

/// The image with its locals' names, when the build asked for them.
let named_locals : Build -> ir.Image -> ir.Image;
let named_locals b img =
    if not (Options.debug_info (Build.options b)) { img }
    else { debuginfo.with_local_names img (debuginfo.local_names (Build.loader b) (Build.resolution b)) };

// --- reproducible paths -----------------------------------------------------------
//
// An image records the path of every source file -- each function's, each
// module's, and the root's -- for the traces an error prints. They are the
// paths the files were read from, so the same source built in two directories,
// or on two machines whose standard library is in two places, makes two
// different images. `--remap-path-prefix FROM=TO` (rustc's and GCC's flag)
// rewrites them, which is what a build that must be reproduced elsewhere
// passes: `mind attest` maps each package's root to its name.
//
// It is done here, on the finished image, rather than where the paths are
// interned, because lowering is kept between builds (unit.dr) and a cached
// lowering would carry whichever paths it was made with. And it rewrites
// only the strings those records point at, in place, so the table keeps its
// order and no absolute path is left behind in it. A string constant that is
// exactly some source file's own path shares that entry and is rewritten
// with it; that is the one thing the flag changes beyond the traces.

/// The image with its source paths rewritten: the first `[from, to]` whose
/// `from` begins a path replaces that beginning with `to`, and what is left
/// is written with `/` -- so a Windows build, whose paths are `src\\main.dr`,
/// records the same names as any other.
let remap_sources : [[:string]] -> ir.Image -> ir.Image;
let remap_sources pairs img =
    match pairs {
        [] => img,
        _ => {
            let rewrite s =
                match list.filter (fn pair -> str.starts_with (list.head pair) s) pairs {
                    [[from, to], .._] => to + str.replace "\\" "/" (str.slice (str.byte_length from)
                                                                              (str.byte_length s - str.byte_length from) s),
                    _ => s,
                };
            // A function's `source` is an index plus one, zero for none; a
            // module's and the root's are the index itself.
            let used = list.concat [
                list.flat_map (fn f -> match f.[:source else 0] { 0 => [], i => [i - 1] }) (ir.Image.funcs img),
                list.map (fn m -> m.[:source else 0]) (ir.Image.modules img),
                [ir.Image.source_name img],
            ];
            let marked = list.fold (fn m i -> m.[i => true]) (%{}) used;
            ir.Image.set_strs (list.map (fn [i, s] -> if marked.[i else false] { rewrite s } else { s })
                                        (list.enumerate (ir.Image.strs img)))
                              img
        },
    };

/// The root package's `[vm]` settings, as the image's `VMOP` records. The root
/// package is the one the program's file is in, and only its settings count:
/// a library has no say in how the program that uses it is run.
let vm_options : modules.Loader -> [[:integer]];
let vm_options l = match package.current (modules.packages l) {
    () => [],
    p => list.concat [
        match package.Vm.nursery_max (package.vm p) { () => [], n => [[emit.vm_nursery_max, n]] },
        match package.Vm.max_heap (package.vm p) { () => [], n => [[emit.vm_max_heap, n]] },
    ],
};

/// The image as the bytes a `.dream` file holds, payload excepted.
let bytes : Build -> :string;
let bytes b = emit.to_binary (image b);

when test {
    import std.test;

    let tests = [
        test.case "remapped source paths are relative and written with /, and nothing else changes"
            $( {
                   let img = ir.Image.new ()
                       |> ir.Image.set_strs ["C:\\work\\app\\src\\main.dr", "C:\\work\\app\\x", "/home/u/std/src/list.dr"]
                       |> ir.Image.set_funcs [%{ :source => 1 }, %{ :source => 0 }]
                       |> ir.Image.set_modules [%{ :source => 2 }]
                       |> ir.Image.set_source_name 0;
                   test.eq! ["app/src/main.dr", "C:\\work\\app\\x", "std/src/list.dr"]
                            (ir.Image.strs (remap_sources [["C:\\work\\app\\", "app/"], ["/home/u/", ""]] img))
               } ),
        test.case "the defaults check and share"
            $( test.eq! [true, true, []]
                        [Options.types options, Options.optimize options, Options.payloads options] ),
        test.case "a scratch build does neither"
            $( test.eq! [false, false] [Options.types scratch, Options.optimize scratch] ),
        test.case "a mask is found through the global's function, sorted"
            $( test.eq! [[3, 1], [7, 2]]
                        (param_masks %{ :globals => [%{ :kind => ir.global_function, :target => 7 },
                                                     %{ :kind => ir.global_module },
                                                     %{ :kind => ir.global_function, :target => 3 }] }
                                     %{ 0 => 2, 1 => 4, 2 => 1 }) ),
    ];
}
